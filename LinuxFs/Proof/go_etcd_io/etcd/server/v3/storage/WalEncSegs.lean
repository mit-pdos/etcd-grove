/-- **A cut's header records** (wal.go:914-924): the CRC record (data nil; its CRC the chain's,
`encode` over nil data), the metadata, and the state `hs` unless it is empty. -/
def cutHdrDs (M : WalMarshal) (md : List w8) (hs : HardStateM) : List (w64 × List w8) :=
  [(crcType, []), (metadataType, md)] ++ (if hsEmptyP hs then [] else [(stateType, M.encState hs)])

/-- The header records of a file: `Create`'s for the first, a cut's after the operations `P`. -/
def segHdrDs (M : WalMarshal) (md : List w8) (first : Bool) (P : WalHist) :
    List (w64 × List w8) :=
  if first then hdrDs M md else cutHdrDs M md (walLastHS P)

/-- The records (type, data) of each file, for the segments `Ss` after the operations `P`. -/
def segsDs (M : WalMarshal) (md : List w8) : Bool → WalHist → List WalHist →
    List (List (w64 × List w8))
  | _, _, [] => []
  | first, P, S :: Ss => (segHdrDs M md first P ++ S.flatMap (opDs M)) :: segsDs M md false (P ++ S) Ss

/-- The chain's CRC after the records `D` (the encoder's: each record's data written in). -/
def crcAfter (C : WalCodec) (c : w32) (D : List (w64 × List w8)) : w32 :=
  D.foldl (fun c p => C.crc32c c p.2) c

/-- **The encoder's records of each file**, the CRC chained across the files (a cut's encoder
starts from the old one's CRC, wal.go:908). -/
def chainSegs (C : WalCodec) : w32 → List (List (w64 × List w8)) → List (List WalRec)
  | _, [] => []
  | c, D :: Ds => chainRecs C c D :: chainSegs C (crcAfter C c D) Ds

/-- **The records of the WAL with segments `Ss`**, all files in order. -/
def recsOfSegs (C : WalCodec) (M : WalMarshal) (md : List w8) (Ss : List WalHist) : List WalRec :=
  chainRecs C 0#32 (segsDs M md true [] Ss).flatten

/-- The segments of `H` at the cut positions `cuts` (increasing, each a `walCutPos`): `[0, c₁)`,
`[c₁, c₂)`, …, `[cₖ, |H|)`. -/
def segsOf (H : WalHist) (cuts : List Nat) : List WalHist :=
  (List.zip (0 :: cuts) (cuts ++ [H.length])).map (fun be => (H.drop be.1).take (be.2 - be.1))

/-- **The WAL's files**: each segment's frames, then its zero tail `z i` (preallocated space; 0 for
a file a cut truncated). -/
def streamFiles (C : WalCodec) (M : WalMarshal) (md : List w8) (H : WalHist) (cuts : List Nat)
    (z : Nat → Nat) : List (List w8) :=
  (chainSegs C 0#32 (segsDs M md true [] (segsOf H cuts))).mapIdx (fun i rs => segFile C rs (z i))

/-! ## Lemmas -/

theorem chainRecs_append (C : WalCodec) (c : w32) (D E : List (w64 × List w8)) :
    chainRecs C c (D ++ E) = chainRecs C c D ++ chainRecs C (crcAfter C c D) E := by
  induction D generalizing c with
  | nil => rfl
  | cons p D ih => obtain ⟨t, d⟩ := p; simp [chainRecs, ih, crcAfter]

theorem flatten_chainSegs (C : WalCodec) (c : w32) (Ds : List (List (w64 × List w8))) :
    (chainSegs C c Ds).flatten = chainRecs C c Ds.flatten := by
  induction Ds generalizing c with
  | nil => rfl
  | cons D Ds ih => simp [chainSegs, ih, chainRecs_append]

theorem chainEnd_chainRecs (C : WalCodec) (c : w32) (D : List (w64 × List w8)) :
    chainEnd C c (chainRecs C c D) = crcAfter C c D := by
  induction D generalizing c with
  | nil => rfl
  | cons p D ih =>
    obtain ⟨t, d⟩ := p
    have : crcNext C c ⟨t, C.crc32c c d, d⟩ = C.crc32c c d := by unfold crcNext; split <;> rfl
    simp only [chainRecs, chainEnd, this, ih, crcAfter, List.foldl_cons]

theorem opDs_noCrc (M : WalMarshal) (o : WalOp) : ∀ p ∈ opDs M o, p.1 ≠ crcType := by
  intro p hp ht
  cases o with
  | save h es =>
    simp only [opDs, List.mem_append, List.mem_map] at hp
    rcases hp with ⟨e, -, rfl⟩ | hp
    · exact absurd ht (by simp only; decide)
    · split at hp
      · simp at hp
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
        subst hp; exact absurd ht (by simp only; decide)
  | snap m =>
    simp only [opDs, List.mem_cons, List.not_mem_nil, or_false] at hp
    subst hp; exact absurd ht (by simp only; decide)

theorem segsDs_crcOk (M : WalMarshal) (md : List w8) :
    ∀ (first : Bool) (P : WalHist) (Ss : List WalHist),
    ∀ p ∈ (segsDs M md first P Ss).flatten, p.1 = crcType → p.2 = []
  | _, _, [] => by simp [segsDs]
  | first, P, S :: Ss => by
    intro p hp ht
    simp only [segsDs, List.flatten_cons, List.mem_append] at hp
    rcases hp with (hp | hp) | hp
    · unfold segHdrDs hdrDs cutHdrDs at hp
      split at hp
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl | rfl
        · rfl
        · exact absurd ht (by simp only; decide)
        · exact absurd ht (by simp only; decide)
      · simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with (rfl | rfl) | hp
        · rfl
        · exact absurd ht (by simp only; decide)
        · split at hp
          · simp at hp
          · simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
            subst hp; exact absurd ht (by simp only; decide)
    · simp only [List.mem_flatMap] at hp
      obtain ⟨o, -, ho⟩ := hp
      exact absurd ht (opDs_noCrc M o p ho)
    · exact segsDs_crcOk M md false (P ++ S) Ss p hp ht

/-- One segment is the one-file WAL. -/
theorem recsOfSegs_single (C : WalCodec) (M : WalMarshal) (md : List w8) (H : WalHist) :
    recsOfSegs C M md [H] = recsOf C M md H := by
  simp [recsOfSegs, recsOf, segsDs, segHdrDs]

/-- **(a) across files: the files the encoder wrote, segment by segment, decode to the WAL's
records** (the cuts' headers included), then the end. -/
theorem walDecodeFiles_streamFiles {C : WalCodec} (hC : C.Ok) (M : WalMarshal) (md : List w8)
    (H : WalHist) (cuts : List Nat) (z : Nat → Nat) (hz : ∀ i, z i = 0 ∨ 8 ≤ z i)
    (hfit : RecsFit C (recsOfSegs C M md (segsOf H cuts))) :
    (walDecodeFiles C (streamFiles C M md H cuts z) 0#32).recs = recsOfSegs C M md (segsOf H cuts) ∧
    (walDecodeFiles C (streamFiles C M md H cuts z) 0#32).stop = .eof := by
  let R := chainSegs C 0#32 (segsDs M md true [] (segsOf H cuts))
  have hR : R.flatten = recsOfSegs C M md (segsOf H cuts) := flatten_chainSegs _ _ _
  have hfiles : streamFiles C M md H cuts z =
      (R.mapIdx (fun i rs => (rs, z i))).map (fun s => segFile C s.1 s.2) := by
    apply List.ext_getElem (by simp [streamFiles, R])
    intro i h1 h2; simp [streamFiles, R]
  have hmap : (R.mapIdx (fun i rs => (rs, z i))).map Prod.fst = R := by
    apply List.ext_getElem (by simp)
    intro i h1 h2; simp
  have hfst : (R.mapIdx (fun i rs => (rs, z i))).flatMap Prod.fst = R.flatten := by
    rw [List.flatMap_def, hmap]
  have hzs : ∀ s ∈ R.mapIdx (fun i rs => (rs, z i)), s.2 = 0 ∨ 8 ≤ s.2 := by
    intro s hs
    rw [List.mem_mapIdx] at hs
    obtain ⟨i, -, rfl⟩ := hs
    exact hz i
  have hch : ChainOk C 0#32 (recsOfSegs C M md (segsOf H cuts)) :=
    chainOk_chainRecs hC _ _ (segsDs_crcOk M md true [] _)
  have := walDecodeFiles_segs hC (R.mapIdx (fun i rs => (rs, z i))) 0#32
    (by rw [hfst, hR]; exact hfit) (by rw [hfst, hR]; exact hch) hzs
  rw [hfiles, this.1, hfst, hR]
  exact ⟨rfl, this.2⟩

theorem segsOf_flatten_from (H : WalHist) : ∀ (cuts : List Nat) (a : Nat),
    (a :: cuts).Pairwise (· ≤ ·) → (∀ c ∈ a :: cuts, c ≤ H.length) →
    ((List.zip (a :: cuts) (cuts ++ [H.length])).map
      (fun be => (H.drop be.1).take (be.2 - be.1))).flatten = H.drop a := by
  intro cuts
  induction cuts with
  | nil =>
    intro a _ _
    simp only [List.nil_append, List.zip_cons_cons, List.zip_nil_left, List.map_cons, List.map_nil,
      List.flatten_cons, List.flatten_nil, List.append_nil]
    exact List.take_of_length_le (by simp)
  | cons c cuts ih =>
    intro a hp hle
    have hac : a ≤ c := List.rel_of_pairwise_cons hp List.mem_cons_self
    have hp' : (c :: cuts).Pairwise (· ≤ ·) := (List.pairwise_cons.1 hp).2
    have hle' : ∀ x ∈ c :: cuts, x ≤ H.length := fun x hx => hle x (List.mem_cons_of_mem _ hx)
    simp only [List.cons_append, List.zip_cons_cons, List.map_cons, List.flatten_cons]
    rw [ih c hp' hle']
    conv => rhs; rw [← List.take_append_drop (c - a) (H.drop a)]
    rw [List.drop_drop]
    congr 2
    omega

/-- **The segments of `H` at increasing cuts within it make up `H`.** -/
theorem segsOf_flatten (H : WalHist) (cuts : List Nat) (hcuts : cuts.Pairwise (· ≤ ·))
    (hle : ∀ c ∈ cuts, c ≤ H.length) : (segsOf H cuts).flatten = H := by
  unfold segsOf
  rw [segsOf_flatten_from H cuts 0 (List.pairwise_cons.2 ⟨fun _ _ => Nat.zero_le _, hcuts⟩)
    (by intro c hc; rcases List.mem_cons.1 hc with rfl | hc; exact Nat.zero_le _; exact hle c hc)]
  rfl

