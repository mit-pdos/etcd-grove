/-! ## The fold depends only on the hard state, the entries and the base index -/

theorem walSaveSnap_congr {τ τ' : StorContents} (m : SnapshotMetadataM) (hhs : τ.hs = τ'.hs)
    (he : τ.ents = τ'.ents) (hb : τ.b = τ'.b) :
    (walSaveSnap τ m).hs = (walSaveSnap τ' m).hs ∧ (walSaveSnap τ m).ents = (walSaveSnap τ' m).ents ∧
      (walSaveSnap τ m).b = (walSaveSnap τ' m).b := by
  have hc : τ.commit = τ'.commit := by simp only [StorContents.commit, hhs]
  unfold walSaveSnap
  by_cases h1 : uint.nat m.Index' < τ.b
  · rw [if_pos h1, if_pos (show uint.nat m.Index' < τ'.b by rw [← hb]; exact h1)]; exact ⟨hhs, he, hb⟩
  · rw [if_neg h1, if_neg (show ¬ uint.nat m.Index' < τ'.b by rw [← hb]; exact h1)]
    refine ⟨hhs, ?_, rfl⟩
    show (if uint.nat m.Index' ≤ τ.commit then τ.ents.drop (uint.nat m.Index' - τ.b) else []) =
      (if uint.nat m.Index' ≤ τ'.commit then τ'.ents.drop (uint.nat m.Index' - τ'.b) else [])
    rw [hc, he, hb]

theorem walFoldChkFrom_congr : ∀ (L : WalHist) (τ τ' σ : StorContents),
    τ.hs = τ'.hs → τ.ents = τ'.ents → τ.b = τ'.b → walFoldChkFrom τ L = some σ →
    ∃ σ', walFoldChkFrom τ' L = some σ' ∧ σ'.hs = σ.hs ∧ σ'.ents = σ.ents ∧ σ'.b = σ.b := by
  intro L
  induction L with
  | nil =>
    intro τ τ' σ h1 h2 h3 h
    simp only [walFoldChkFrom, Option.some.injEq] at h
    subst h
    exact ⟨τ', rfl, h1.symm, h2.symm, h3.symm⟩
  | cons o L ih =>
    intro τ τ' σ h1 h2 h3 h
    cases o with
    | snap m =>
      simp only [walFoldChkFrom] at h ⊢
      obtain ⟨e1, e2, e3⟩ := walSaveSnap_congr m h1 h2 h3
      exact ih _ _ σ e1 e2 e3 h
    | save hs es =>
      simp only [walFoldChkFrom, Option.bind_eq_bind, Option.bind_eq_some_iff] at h ⊢
      obtain ⟨ents, hf, h⟩ := h
      refine (ih { τ with hs := phsNext τ.hs hs, ents := ents }
        { τ' with hs := phsNext τ'.hs hs, ents := ents } σ (congrArg (phsNext · hs) h1) rfl
        h3 h).elim fun σ' hσ' => ⟨σ', ⟨ents, ?_, hσ'.1⟩, hσ'.2⟩
      rw [← h2, ← h3]; exact hf

/-- **From a cut file the fixed-base read is `walReadFrom`** (no condition): same hard state and
entries. -/
theorem walReadAt_from_eq {I : WalHist} {k : Nat} {s : w64 × w64} {σ' : StorContents} (hk : k ≠ 0)
    (hs : some s = walNewestPair (walValidSnaps I k)) (h : walReadAt I k s = some σ') :
    ∃ σ, walReadFrom I k = some σ ∧ σ.hs = σ'.hs ∧ σ.ents = σ'.ents := by
  have hnew := walNewest_eq_newestPair I hk
  rw [← hs] at hnew
  unfold walReadFrom
  simp only
  cases hN : walNewest ((I.drop k).filter (walKeep (uint.nat (walLastHS I).Commit'))) with
  | none => rw [hN] at hnew; cases hnew
  | some m =>
    rw [hN, Option.map_some, Option.some.injEq] at hnew
    subst hnew
    unfold walReadAt at h
    obtain ⟨σ, hf, e1, e2, -⟩ := walFoldChkFrom_congr _
      ⟨walLastHS (I.take k), none, entryID.mk m.Term' m.Index', []⟩
      ⟨walLastHS (I.take k), some (SnapshotM.mk [] m), entryID.mk m.Term' m.Index', []⟩ σ'
      rfl rfl rfl h
    exact ⟨σ, hf, e1, e2⟩

/-! ## The history condition -/

/-- **The history reads back** (W4b's premises of C2-C4): the restart's read of the whole history
succeeds (`walRead`) and its fold never has its commit above its last index (`walCommitLe`). The first
half is necessary: at `k = 0` the equation `walReadCut I 0 = walReadAt …` needs `walRead I ≠ none`
whenever `ReadAll` succeeds (`readAllFold_zero_dev` is a history without it). -/
def walReadsBack (I : WalHist) : Prop := walCommitLe I ∧ ∃ σ, walRead I = some σ

/-- **The restated post gives `walReadCut` back** at the read's position `k`, for the start `Open`
chose there: unconditionally from a cut file, under `walReadsBack` from the first. -/
theorem walReadAt_cut {I : WalHist} {k : Nat} {s : w64 × w64} {σ' : StorContents}
    (hs : some s = walNewestPair (walValidSnaps I k)) (hb : k = 0 → walReadsBack I)
    (h : walReadAt I k s = some σ') :
    ∃ σ, walReadCut I k = some σ ∧ σ.hs = σ'.hs ∧ σ.ents = σ'.ents := by
  by_cases hk : k = 0
  · subst hk
    obtain ⟨hcl, σ, hr⟩ := hb rfl
    obtain ⟨e1, e2⟩ := walReadAt_zero_eq hs hcl hr h
    exact ⟨σ, by rw [walReadCut_zero]; exact hr, e1.symm, e2.symm⟩
  · rw [walReadCut_pos hk]
    exact walReadAt_from_eq hk hs h

/-! ## The restated post -/

/-- **The pure part of `ReadAll`'s restated success post** (draft): `ReadAll` read the files from
the position `k` of the file `Open` selected (at or after the read position `cut`, at or before
`walOpenPos`, as `Open`'s spec raises `unl`), `s` is the newest valid pair from there (`ReadAll`
matched `s`'s record, which is the last of the newest index from `cut` on), and the read is the fold
at the fixed base `s` (`walReadAt`). In `WAL__ReadAll.spec`, `⌜walReadCut (d.H.map WalOpG.toM) d.cut =
some σ⌝` becomes `⌜walReadAllOk (d.H.map WalOpG.toM) d.cut s σ⌝`; the rest of the post is unchanged
(`hsOpt hp σ.hs`, `walSaveEnts false esL σ.ents`: only `σ.hs` and `σ.ents` are read). -/
def walReadAllOk (I : WalHist) (cut : Nat) (s : w64 × w64) (σ : StorContents) : Prop :=
  ∃ k, cut ≤ k ∧ k ≤ walOpenPos I s.1 ∧ some s = walNewestPair (walValidSnaps I k) ∧
    walReadAt I k s = some σ

/-- **A client's view: the read is `walRead`'s** (the unpurged restart read), under W4b's premises
(`walReadR_eq_openPos`'s) and `walReadsBack`. -/
theorem walReadAllOk_walRead {I : WalHist} {cut : Nat} {s : w64 × w64} {σ σ' : StorContents}
    (hpost : walReadAllOk I cut s σ') (hmax : ¬ walHasMaxIdx I)
    (ha : ∃ (i : Nat) (m : SnapshotMetadataM), I[i]? = some (WalOpG.snap m) ∧ m.Index' = s.1)
    (hac : uint.nat s.1 ≤ uint.nat (walLastHS I).Commit') (hcl : walCommitLe I)
    (h : walRead I = some σ) : σ'.hs = σ.hs ∧ σ'.ents = σ.ents := by
  obtain ⟨k, -, hk, hs, hat⟩ := hpost
  obtain ⟨σk, hcut, e1, e2⟩ := walReadAt_cut hs (fun _ => ⟨hcl, σ, h⟩) hat
  have := walReadR_eq_openPos (p := k) hk hmax ha hac hcl h ⟨k, Nat.le_refl _, hcut⟩
  subst this
  exact ⟨e1.symm, e2.symm⟩

/-! ## Preservation of the condition -/

theorem walLastHS_snoc_snap (I : WalHist) (m : SnapshotMetadataM) :
    walLastHS (I ++ [WalOpG.snap m]) = walLastHS I := by
  rw [walLastHS_eq, walLastHS_eq, List.foldl_append]; rfl

/-- `SaveSnapshot` keeps the commit within the last index. -/
theorem walSaveSnap_commitLe {τ : StorContents} (m : SnapshotMetadataM) (h : τ.commit ≤ τ.last) :
    (walSaveSnap τ m).commit ≤ (walSaveSnap τ m).last := by
  unfold walSaveSnap
  split
  · exact h
  · next hlt =>
    by_cases hc : uint.nat m.Index' ≤ τ.commit
    · rw [if_pos hc]
      simp only [StorContents.commit, StorContents.last, StorContents.b, List.length_drop] at h hlt hc ⊢
      omega
    · rw [if_neg hc]
      simp only [StorContents.commit, StorContents.last, StorContents.b, List.length_nil] at h hlt hc ⊢
      omega

/-- **`SaveSnapshot` (any index) keeps the history reading back.** -/
theorem walReadsBack_snap {I : WalHist} (m : SnapshotMetadataM) (h : walReadsBack I) :
    walReadsBack (I ++ [WalOpG.snap m]) := by
  obtain ⟨hcl, σ, hr⟩ := h
  unfold walReadsBack walCommitLe walRead
  unfold walRead at hr
  unfold walCommitLe at hcl
  rw [walLastHS_snoc_snap, List.filter_append]
  generalize hL : I.filter (walKeep (uint.nat (walLastHS I).Commit')) = L at hr hcl ⊢
  have hlast : σ.commit ≤ σ.last := by
    have := hcl L.length σ
    rw [List.take_length] at this
    exact this hr
  by_cases hk : walKeep (uint.nat (walLastHS I).Commit') (WalOpG.snap m) = true
  · have hF : [WalOpG.snap m].filter (walKeep (uint.nat (walLastHS I).Commit')) = [WalOpG.snap m] := by
      simp [List.filter_cons, hk]
    rw [hF]
    refine ⟨?_, walSaveSnap σ m, by rw [walFoldChkFrom_append, hr]; rfl⟩
    intro n τ' hτ
    by_cases hn : n ≤ L.length
    · rw [List.take_append_of_le_length hn] at hτ
      exact hcl n τ' hτ
    · rw [List.take_of_length_le (by simp; omega), walFoldChkFrom_append, hr, Option.bind_some] at hτ
      simp only [walFoldChkFrom, Option.some.injEq] at hτ
      subst hτ
      exact walSaveSnap_commitLe m hlast
  · have hF : [WalOpG.snap m].filter (walKeep (uint.nat (walLastHS I).Commit')) = [] := by
      simp [List.filter_cons, hk]
    rw [hF, List.append_nil]
    exact ⟨hcl, σ, hr⟩


/-- **`Save(h, es)` keeps the history reading back** when it raises the commit past no snapshot
record above the old one (`hfilt`: true between Readies, every record then being at or below the
commit; not for the `Save` right after a received snapshot's `SaveSnapshot`), its entries apply to
the read (`hent`: raft's `Ready` entries start at most one past the last index and above the base,
`WalSaveOk`), and its commit is within the resulting last index (`hcl'`: raft's
`committed ≤ lastIndex`). -/
theorem walReadsBack_save {I : WalHist} (h : HardStateM) (es : List EntryM) (hb : walReadsBack I)
    (hfilt : ∀ m, WalOpG.snap m ∈ I →
      (uint.nat m.Index' ≤ uint.nat (walLastHS (I ++ [WalOpG.save h es])).Commit' ↔
        uint.nat m.Index' ≤ uint.nat (walLastHS I).Commit'))
    (hent : ∀ σ, walRead I = some σ → ∃ ents, es.foldlM (fun ents e => readEnt σ.b ents e) σ.ents = some ents ∧
      uint.nat (phsNext σ.hs h).Commit' ≤ σ.b + ents.length) :
    walReadsBack (I ++ [WalOpG.save h es]) := by
  obtain ⟨hcl, σ, hr⟩ := hb
  obtain ⟨ents, hf, hcl'⟩ := hent σ hr
  unfold walReadsBack walCommitLe walRead
  unfold walRead at hr
  unfold walCommitLe at hcl
  have hF : (I ++ [WalOpG.save h es]).filter
      (walKeep (uint.nat (walLastHS (I ++ [WalOpG.save h es])).Commit')) =
      I.filter (walKeep (uint.nat (walLastHS I).Commit')) ++ [WalOpG.save h es] := by
    rw [List.filter_append]
    congr 1
    · apply List.filter_congr
      intro o ho
      cases o with
      | save _ _ => rfl
      | snap m => simp only [walKeep, decide_eq_decide]; exact hfilt m ho
  rw [hF]
  generalize hL : I.filter (walKeep (uint.nat (walLastHS I).Commit')) = L at hr hcl ⊢
  have hstep : walFoldChkFrom σ [WalOpG.save h es] = some { σ with hs := phsNext σ.hs h, ents := ents } := by
    simp [walFoldChkFrom, hf]
  refine ⟨?_, _, by rw [walFoldChkFrom_append, hr, Option.bind_some]; exact hstep⟩
  intro n τ' hτ
  by_cases hn : n ≤ L.length
  · rw [List.take_append_of_le_length hn] at hτ
    exact hcl n τ' hτ
  · rw [List.take_of_length_le (by simp; omega), walFoldChkFrom_append, hr, Option.bind_some, hstep,
      Option.some.injEq] at hτ
    subst hτ
    exact hcl'

end post

