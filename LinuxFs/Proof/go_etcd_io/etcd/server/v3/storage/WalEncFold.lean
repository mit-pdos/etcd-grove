      simp only [Option.bind_eq_bind, Option.bind_some]

theorem raStep_opDs (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (st : RAState) (o : WalOp) : (opDs M o).foldlM (raStep U s) st = goOp s st o := by
