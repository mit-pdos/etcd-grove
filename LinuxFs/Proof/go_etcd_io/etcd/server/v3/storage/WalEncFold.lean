  | snap m =>
    simp [opDs, goOp, raStep, hU.snap, snapshotType, entryType, stateType, metadataType, crcType]

theorem raStep_flatMap (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64) :
    ∀ (L : WalHist) (st : RAState),
