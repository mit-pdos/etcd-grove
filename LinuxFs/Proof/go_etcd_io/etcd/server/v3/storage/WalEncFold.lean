  | nil => intro st; rfl
  | cons o L ih =>
    intro st
    simp only [List.flatMap_cons, List.foldlM_append, List.foldlM_cons, raStep_opDs U M hU, ih]

/-! ## The loop against the fold at a fixed base -/

/-- **The loop's variables follow the fold at the base `s`**: the same hard state and entries, the
fold's base index `s`'s. -/
def RARel (s : w64 × w64) (st : RAState) (σ : StorContents) : Prop :=
  st.hs = σ.hs ∧ st.ents = σ.ents ∧ σ.b = uint.nat s.1

theorem w64_nat_ne {a b : w64} (h : a ≠ b) : uint.nat a ≠ uint.nat b := by
  intro h'; exact h (by word)

/-- A snapshot record of the start's index: `walSaveSnap` keeps the base index and empties the
entries exactly where the loop does. -/
theorem walSaveSnap_at {s : w64 × w64} {st : RAState} {σ : StorContents} {m : SnapshotMetadataM}
    (hr : RARel s st σ) (hm : m.Index' = s.1) :
    RARel s { st with matched := true,
                         ents := if uint.nat st.hs.Commit' < uint.nat m.Index' then [] else st.ents }
      (walSaveSnap σ m) := by
  obtain ⟨h1, h2, h3⟩ := hr
  have hb : ¬ uint.nat m.Index' < σ.b := by rw [h3, hm]; omega
  unfold walSaveSnap
  rw [if_neg hb]
  refine ⟨h1, ?_, by simp only [StorContents.b]; rw [hm]⟩
  have hcm : σ.commit = uint.nat st.hs.Commit' := by rw [h1]; rfl
  have hbs : σ.b = uint.nat m.Index' := by rw [h3, hm]
  show _ = if uint.nat m.Index' ≤ σ.commit then σ.ents.drop (uint.nat m.Index' - σ.b) else []
  rw [hcm, hbs, Nat.sub_self, List.drop_zero, ← h2]
  by_cases hc : uint.nat st.hs.Commit' < uint.nat m.Index'
  · rw [if_pos hc, if_neg (by omega)]
  · rw [if_neg hc, if_pos (by omega)]

/-- A snapshot record below the start's index changes nothing. -/
theorem walSaveSnap_below {s : w64 × w64} {st : RAState} {σ : StorContents} {m : SnapshotMetadataM}
    (hr : RARel s st σ) (hm : uint.nat m.Index' < uint.nat s.1) : walSaveSnap σ m = σ := by
  unfold walSaveSnap
  rw [if_pos (by rw [hr.2.2]; exact hm)]

/-- **The loop succeeds only with the fold's result** at the base `s`, over the operations `L` whose
kept snapshot records are at most `s`'s index. -/
theorem goOp_sim_ok (s : w64 × w64) (c : Nat) (hc : uint.nat s.1 ≤ c) :
    ∀ (L : WalHist) (st st' : RAState) (σ : StorContents),
    RARel s st σ →
    (∀ m, WalOpG.snap m ∈ L → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1) →
    L.foldlM (goOp s) st = .ok st' →
    ∃ σ', walFoldChkFrom σ (L.filter (walKeep c)) = some σ' ∧ RARel s st' σ' ∧ st'.md = st.md ∧
      st'.matched = (st.matched || L.any (snapAt s.1)) := by
  intro L
  induction L with
  | nil =>
    intro st st' σ hr _ h
    simp only [List.foldlM_nil, pure, Except.pure, Except.ok.injEq] at h
    subst h
    exact ⟨σ, rfl, hr, rfl, by simp⟩
  | cons o L ih =>
    intro st st' σ hr hle h
    have hle' : ∀ m, WalOpG.snap m ∈ L → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_cons_of_mem _ hm)
    rw [List.foldlM_cons, except_bind_ok] at h
    obtain ⟨st1, h1, h⟩ := h
    cases o with
    | save hs es =>
      simp only [goOp] at h1
      have hrd : es.foldlM (fun ents e => readEnt (uint.nat s.1) ents e) st.ents =
          es.foldlM (fun ents e => readEnt σ.b ents e) σ.ents := by rw [hr.2.1, hr.2.2]
      rw [hrd] at h1
      cases hf : es.foldlM (fun ents e => readEnt σ.b ents e) σ.ents with
      | none => rw [hf] at h1; cases h1
      | some ents =>
        rw [hf] at h1
        simp only [Except.ok.injEq] at h1
        subst h1
        obtain ⟨σ', h2, h3, h4, h5⟩ := ih _ st' { σ with hs := phsNext σ.hs hs, ents := ents }
          ⟨by rw [hr.1], rfl, hr.2.2⟩ hle' h
        refine ⟨σ', ?_, h3, h4, ?_⟩
        · simp only [List.filter_cons, walKeep, ite_true, walFoldChkFrom, hf, Option.bind_eq_bind,
            Option.bind_some]
          exact h2
        · rw [h5]; simp [snapAt]
    | snap m =>
      simp only [goOp] at h1
      by_cases hmi : m.Index' = s.1
      · rw [if_pos hmi] at h1
        by_cases hmt : m.Term' = s.2
        · rw [if_pos hmt] at h1
          simp only [Except.ok.injEq] at h1
          subst h1
          obtain ⟨σ', h2, h3, h4, h5⟩ := ih _ st' _ (walSaveSnap_at hr hmi) hle' h
          refine ⟨σ', ?_, h3, h4, ?_⟩
          · have hk : walKeep c (WalOpG.snap m) = true := by
              simp only [walKeep, decide_eq_true_eq]; rw [hmi]; exact hc
            simp only [List.filter_cons, hk, ite_true, walFoldChkFrom]
            exact h2
          · rw [h5]; simp [snapAt, hmi]
        · rw [if_neg hmt] at h1; cases h1
      · rw [if_neg hmi] at h1
        simp only [Except.ok.injEq] at h1
        subst h1
        obtain ⟨σ', h2, h3, h4, h5⟩ := ih _ st' σ hr hle' h
        refine ⟨σ', ?_, h3, h4, ?_⟩
        · by_cases hk : walKeep c (WalOpG.snap m) = true
          · have hkc : uint.nat m.Index' ≤ c := by simpa [walKeep] using hk
            have hlt : uint.nat m.Index' < uint.nat s.1 := by
              have := hle m List.mem_cons_self hkc
              have := w64_nat_ne hmi
              omega
            simp only [List.filter_cons, hk, ite_true, walFoldChkFrom, walSaveSnap_below hr hlt]
            exact h2
          · simp only [List.filter_cons, hk, Bool.false_eq_true, ite_false]
            exact h2
        · rw [h5]; simp [snapAt, hmi]

/-- **… and the loop succeeds whenever the fold does**, no record of the start's index with another
term. -/
theorem goOp_sim_complete (s : w64 × w64) (c : Nat) (hc : uint.nat s.1 ≤ c) :
    ∀ (L : WalHist) (st : RAState) (σ σ' : StorContents),
    RARel s st σ →
    (∀ m, WalOpG.snap m ∈ L → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1) →
    (∀ m, WalOpG.snap m ∈ L → m.Index' = s.1 → m.Term' = s.2) →
    walFoldChkFrom σ (L.filter (walKeep c)) = some σ' →
    L.foldlM (goOp s) st = .ok ⟨st.md, σ'.hs, σ'.ents, st.matched || L.any (snapAt s.1)⟩ := by
  intro L
  induction L with
  | nil =>
    intro st σ σ' hr _ _ h
    simp only [List.filter_nil, walFoldChkFrom, Option.some.injEq] at h
    subst h
    simp only [List.foldlM_nil, List.any_nil, Bool.or_false, ← hr.1, ← hr.2.1]
    rfl
  | cons o L ih =>
    intro st σ σ' hr hle hterm h
    have hle' : ∀ m, WalOpG.snap m ∈ L → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_cons_of_mem _ hm)
    have hterm' : ∀ m, WalOpG.snap m ∈ L → m.Index' = s.1 → m.Term' = s.2 :=
      fun m hm => hterm m (List.mem_cons_of_mem _ hm)
    rw [List.foldlM_cons]
    cases o with
    | save hs es =>
      simp only [List.filter_cons, walKeep, ite_true, walFoldChkFrom, Option.bind_eq_bind,
        Option.bind_eq_some_iff] at h
      obtain ⟨ents, hf, h⟩ := h
      have hrd : es.foldlM (fun ents e => readEnt (uint.nat s.1) ents e) st.ents = some ents := by
        rw [hr.2.1, ← hr.2.2]; exact hf
      simp only [goOp, hrd]
      show List.foldlM (goOp s) _ L = _
      rw [ih _ { σ with hs := phsNext σ.hs hs, ents := ents } σ' ⟨by rw [hr.1], rfl, hr.2.2⟩ hle' hterm' h]
      simp [snapAt]
    | snap m =>
      by_cases hmi : m.Index' = s.1
      · have hk : walKeep c (WalOpG.snap m) = true := by
          simp only [walKeep, decide_eq_true_eq]; rw [hmi]; exact hc
        simp only [List.filter_cons, hk, ite_true, walFoldChkFrom] at h
        simp only [goOp, if_pos hmi, if_pos (hterm m List.mem_cons_self hmi)]
        show List.foldlM (goOp s) _ L = _
        rw [ih _ _ σ' (walSaveSnap_at hr hmi) hle' hterm' h]
        simp [snapAt, hmi]
      · simp only [goOp, if_neg hmi]
        show List.foldlM (goOp s) _ L = _
        have h' : walFoldChkFrom σ (L.filter (walKeep c)) = some σ' := by
          by_cases hk : walKeep c (WalOpG.snap m) = true
          · have hkc : uint.nat m.Index' ≤ c := by simpa [walKeep] using hk
            have hlt : uint.nat m.Index' < uint.nat s.1 := by
              have := hle m List.mem_cons_self hkc
              have := w64_nat_ne hmi
              omega
            simpa only [List.filter_cons, hk, ite_true, walFoldChkFrom, walSaveSnap_below hr hlt]
              using h
          · simpa only [List.filter_cons, hk, Bool.false_eq_true, ite_false] using h
        rw [ih _ _ σ' hr hle' hterm' h']
        simp [snapAt, hmi]

/-! ## The headers and the segments -/

theorem chainRecs_map (C : WalCodec) (c : w32) (D : List (w64 × List w8)) :
    (chainRecs C c D).map (fun r => (r.typ, r.data)) = D := by
  induction D generalizing c with
  | nil => rfl
  | cons p D ih => obtain ⟨t, d⟩ := p; simp [chainRecs, ih]

theorem except_ok_bind {ε α β : Type} (a : α) (f : α → Except ε β) :
    (Except.ok a >>= f) = f a := rfl

theorem raStep_crc (U : WalUnmarshal) (s : w64 × w64) (st : RAState) (d : List w8) :
    raStep U s st (crcType, d) = .ok st := by
  simp [raStep, crcType, entryType, stateType, metadataType]

theorem raStep_meta (U : WalUnmarshal) (s : w64 × w64) (st : RAState) (d : List w8)
    (hmd : st.md = none ∨ st.md = some d) :
    raStep U s st (metadataType, d) = .ok { st with md := some d } := by
  rcases hmd with h | h
  · simp [raStep, h, metadataType, entryType, stateType]
  · simp [raStep, h, metadataType, entryType, stateType]
    cases st; simp only at h; subst h; rfl

theorem raStep_state (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (st : RAState) (h : HardStateM) :
    raStep U s st (stateType, M.encState h) = .ok { st with hs := h } := by
  simp [raStep, hU.state, stateType, entryType]

theorem raStep_snap0 (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (st : RAState) :
    raStep U s st (snapshotType, M.snap0) =
      if W64 0 = s.1 then
        (if W64 0 = s.2 then
          .ok { st with matched := true,
                        ents := if uint.nat st.hs.Commit' < uint.nat (W64 0) then [] else st.ents }
        else .error .snapshotMismatch)
      else .ok st := by
  simp only [raStep, hU.snap0]
  simp [snapshotType, entryType, stateType, metadataType, crcType]

/-- **A cut's header** (wal.go:914-924): the metadata set (or found equal), the state taken unless
it is empty. -/
theorem raStep_cutHdr (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (md : List w8) (hs : HardStateM) (st : RAState) (hmd : st.md = none ∨ st.md = some md) :
    (cutHdrDs M md hs).foldlM (raStep U s) st =
      .ok { st with md := some md, hs := if hsEmptyP hs then st.hs else hs } := by
  unfold cutHdrDs
  by_cases he : hsEmptyP hs
  · simp only [he, ite_true, List.append_nil, List.foldlM_cons, List.foldlM_nil, raStep_crc,
      except_ok_bind, raStep_meta U s st md hmd]
    rfl
  · simp only [he, ite_false, List.cons_append, List.nil_append, List.foldlM_cons,
      List.foldlM_nil, raStep_crc, except_ok_bind, raStep_meta U s st md hmd, raStep_state U M hU]
    rfl

/-- **`Create`'s header** (wal.go:174-183): the metadata, and the snapshot record `(0, 0)`. -/
theorem raStep_hdr (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (md : List w8) :
    (hdrDs M md).foldlM (raStep U s) raInit =
      if s.1 = W64 0 then
        (if s.2 = W64 0 then .ok ⟨some md, hsZero, [], true⟩ else .error .snapshotMismatch)
      else .ok ⟨some md, hsZero, [], false⟩ := by
  simp only [hdrDs, List.foldlM_cons, List.foldlM_nil, raStep_crc, except_ok_bind,
    raStep_meta U s raInit md (Or.inl rfl), raStep_snap0 U M hU]
  by_cases h1 : s.1 = W64 0
  · rw [if_pos h1.symm, if_pos h1]
    by_cases h2 : s.2 = W64 0
    · rw [if_pos h2.symm, if_pos h2]
      simp only [except_ok_bind]
      rfl
    · rw [if_neg (Ne.symm h2), if_neg h2]
      rfl
  · rw [if_neg (Ne.symm h1), if_neg h1]
    rfl


/-- The hard state of the fold after `S`, from `walLastHS P`. -/
theorem walFoldChkFrom_lastHS {c : Nat} {σ σ' : StorContents} {P S : WalHist}
    (hσ : σ.hs = walLastHS P) (h : walFoldChkFrom σ (S.filter (walKeep c)) = some σ') :
    σ'.hs = walLastHS (P ++ S) := by
  rw [walFoldChkFrom_hs h, walHsStep_filter, hσ, walLastHS_eq, walLastHS_eq, List.foldl_append]

/-- **The loop over the files after the operations `P`** (cut files: header, then the segment's
operations), against the fold at the base `s`. -/
theorem raStep_segs_ok (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (md : List w8) (c : Nat) (hc : uint.nat s.1 ≤ c) :
    ∀ (Ss : List WalHist) (P : WalHist) (st st' : RAState) (σ : StorContents),
    st.ents = σ.ents → σ.b = uint.nat s.1 → σ.hs = walLastHS P →
    (st.hs = walLastHS P ∨ st.hs = hsZero) → (st.md = none ∨ st.md = some md) →
    (∀ m, WalOpG.snap m ∈ Ss.flatten → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1) →
    (segsDs M md false P Ss).flatten.foldlM (raStep U s) st = .ok st' →
    ∃ σ', walFoldChkFrom σ (Ss.flatten.filter (walKeep c)) = some σ' ∧ st'.ents = σ'.ents ∧
      ((Ss = [] ∧ st' = st ∧ σ' = σ) ∨ (st'.hs = σ'.hs ∧ st'.md = some md)) ∧
      st'.matched = (st.matched || Ss.flatten.any (snapAt s.1)) := by
  intro Ss
  induction Ss with
  | nil =>
    intro P st st' σ he _ _ _ _ _ h
    simp only [segsDs, List.flatten_nil, List.foldlM_nil, pure, Except.pure, Except.ok.injEq] at h
    subst h
    exact ⟨σ, rfl, he, Or.inl ⟨rfl, rfl, rfl⟩, by simp⟩
  | cons S Ss ih =>
    intro P st st' σ he hb hσ hst hmd hle h
    simp only [segsDs, List.flatten_cons, List.foldlM_append] at h
    rw [except_bind_ok] at h
    obtain ⟨st2, h2, h⟩ := h
    rw [except_bind_ok] at h2
    obtain ⟨st1, h1, h2⟩ := h2
    simp only [segHdrDs, Bool.false_eq_true, ite_false] at h1
    rw [raStep_cutHdr U M hU s md _ st hmd, Except.ok.injEq] at h1
    subst h1
    rw [raStep_flatMap U M hU] at h2
    have hle1 : ∀ m, WalOpG.snap m ∈ S → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_left _ hm)
    have hle2 : ∀ m, WalOpG.snap m ∈ Ss.flatten → uint.nat m.Index' ≤ c →
        uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_right _ hm)
    have hr1 : RARel s { st with md := some md,
                                     hs := if hsEmptyP (walLastHS P) then st.hs else walLastHS P } σ := by
      refine ⟨?_, he, hb⟩
      show (if hsEmptyP (walLastHS P) then st.hs else walLastHS P) = σ.hs
      rw [hσ]
      by_cases hE : hsEmptyP (walLastHS P)
      · rw [if_pos hE]
        rcases hst with h0 | h0
        · exact h0
        · rw [h0, hsEmptyP_eq hE]
      · rw [if_neg hE]
    obtain ⟨σ1, hf1, hr2, hmd2, hm2⟩ := goOp_sim_ok s c hc S _ st2 σ hr1 hle1 h2
    simp only at hmd2 hm2
    have hσ1 : σ1.hs = walLastHS (P ++ S) := walFoldChkFrom_lastHS hσ hf1
    obtain ⟨σ', hf, he', hcase, hm'⟩ := ih (P ++ S) st2 st' σ1 hr2.2.1 hr2.2.2 hσ1
      (Or.inl (hr2.1.trans hσ1)) (Or.inr hmd2) hle2 h
    refine ⟨σ', ?_, he', ?_, ?_⟩
    · rw [List.flatten_cons, List.filter_append, walFoldChkFrom_append, hf1, Option.bind_some]
      exact hf
    · right
      rcases hcase with ⟨-, rfl, rfl⟩ | hcase
      · exact ⟨hr2.1, hmd2⟩
      · exact hcase
    · rw [hm', hm2, List.flatten_cons, List.any_append, Bool.or_assoc]

/-- **… and it succeeds whenever the fold does**, no record of the start's index with another term. -/
theorem raStep_segs_complete (U : WalUnmarshal) (M : WalMarshal) (hU : U.Ok M) (s : w64 × w64)
    (md : List w8) (c : Nat) (hc : uint.nat s.1 ≤ c) :
    ∀ (Ss : List WalHist) (P : WalHist) (st : RAState) (σ σ' : StorContents),
    st.ents = σ.ents → σ.b = uint.nat s.1 → σ.hs = walLastHS P →
    (st.hs = walLastHS P ∨ st.hs = hsZero) → (st.md = none ∨ st.md = some md) →
    (∀ m, WalOpG.snap m ∈ Ss.flatten → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1) →
    (∀ m, WalOpG.snap m ∈ Ss.flatten → m.Index' = s.1 → m.Term' = s.2) →
    walFoldChkFrom σ (Ss.flatten.filter (walKeep c)) = some σ' →
    ∃ st', (segsDs M md false P Ss).flatten.foldlM (raStep U s) st = .ok st' ∧ st'.ents = σ'.ents ∧
      ((Ss = [] ∧ st' = st ∧ σ' = σ) ∨ (st'.hs = σ'.hs ∧ st'.md = some md)) ∧
      st'.matched = (st.matched || Ss.flatten.any (snapAt s.1)) := by
  intro Ss
  induction Ss with
  | nil =>
    intro P st σ σ' he _ _ _ _ _ _ h
    simp only [List.flatten_nil, List.filter_nil, walFoldChkFrom, Option.some.injEq] at h
    subst h
    exact ⟨st, rfl, he, Or.inl ⟨rfl, rfl, rfl⟩, by simp⟩
  | cons S Ss ih =>
    intro P st σ σ' he hb hσ hst hmd hle hterm h
    rw [List.flatten_cons, List.filter_append, walFoldChkFrom_append, Option.bind_eq_some_iff] at h
    obtain ⟨σ1, hf1, h⟩ := h
    have hle1 : ∀ m, WalOpG.snap m ∈ S → uint.nat m.Index' ≤ c → uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_left _ hm)
    have hle2 : ∀ m, WalOpG.snap m ∈ Ss.flatten → uint.nat m.Index' ≤ c →
        uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_right _ hm)
    have ht1 : ∀ m, WalOpG.snap m ∈ S → m.Index' = s.1 → m.Term' = s.2 :=
      fun m hm => hterm m (List.mem_append_left _ hm)
    have ht2 : ∀ m, WalOpG.snap m ∈ Ss.flatten → m.Index' = s.1 → m.Term' = s.2 :=
      fun m hm => hterm m (List.mem_append_right _ hm)
    have hr1 : RARel s { st with md := some md,
                                     hs := if hsEmptyP (walLastHS P) then st.hs else walLastHS P } σ := by
      refine ⟨?_, he, hb⟩
      show (if hsEmptyP (walLastHS P) then st.hs else walLastHS P) = σ.hs
      rw [hσ]
      by_cases hE : hsEmptyP (walLastHS P)
      · rw [if_pos hE]
        rcases hst with h0 | h0
        · exact h0
        · rw [h0, hsEmptyP_eq hE]
      · rw [if_neg hE]
    have h2 := goOp_sim_complete s c hc S _ σ σ1 hr1 hle1 ht1 hf1
    have hσ1 : σ1.hs = walLastHS (P ++ S) := walFoldChkFrom_lastHS hσ hf1
    have hb1 : σ1.b = uint.nat s.1 := by
      obtain ⟨σ'', hf'', hr'', -⟩ := goOp_sim_ok s c hc S _ _ σ hr1 hle1 h2
      rw [hf1, Option.some.injEq] at hf''
      subst hf''; exact hr''.2.2
    obtain ⟨st', hfold, he', hcase, hm'⟩ := ih (P ++ S)
      ⟨some md, σ1.hs, σ1.ents, _⟩ σ1 σ' rfl hb1 hσ1
      (Or.inl hσ1) (Or.inr rfl) hle2 ht2 h
    refine ⟨st', ?_, he', ?_, ?_⟩
    · simp only [segsDs, segHdrDs, Bool.false_eq_true, ite_false, List.flatten_cons,
        List.foldlM_append, raStep_cutHdr U M hU s md _ st hmd, except_ok_bind,
        raStep_flatMap U M hU, h2]
      exact hfold
    · right
      rcases hcase with ⟨-, rfl, rfl⟩ | hcase
      · exact ⟨rfl, rfl⟩
      · exact hcase
    · rw [hm', List.flatten_cons, List.any_append, ← Bool.or_assoc]

/-- **The start `Open` chose bounds the snapshot records the read keeps**: the newest valid pair is
within the commit, and every kept record from the read's position is at most its index. -/
theorem validSnaps_bounds {I : WalHist} {k : Nat} {s : w64 × w64}
    (hs : some s = walNewestPair (walValidSnaps I k)) :
    uint.nat s.1 ≤ uint.nat (walLastHS I).Commit' ∧
    ∀ m, WalOpG.snap m ∈ I.drop k → uint.nat m.Index' ≤ uint.nat (walLastHS I).Commit' →
      uint.nat m.Index' ≤ uint.nat s.1 := by
  refine ⟨?_, fun m hm hmc => walNewestPair_max hs.symm (m.Index', m.Term') ?_⟩
  · have hmem := walNewestPair_mem hs.symm
    unfold walValidSnaps at hmem
    rcases List.mem_append.1 hmem with h0 | h0
    · split at h0
      · simp only [List.mem_cons, List.not_mem_nil, or_false] at h0
        subst h0; simp
      · cases h0
    · obtain ⟨o, -, ho⟩ := List.mem_filterMap.1 h0
      cases o with
      | save _ _ => cases ho
      | snap m' =>
        simp only at ho
        split at ho
        · next hle => simp only [Option.some.injEq] at ho; subst ho; exact hle
        · cases ho
  · unfold walValidSnaps
    apply List.mem_append_right
    exact List.mem_filterMap.2 ⟨WalOpG.snap m, hm, by simp [hmc]⟩

/-! ## The tail of `ReadAll` -/

/-- What a successful `ReadAll` returns: a match, and the loop's variables. -/
theorem readAllFold_ok {U : WalUnmarshal} {s : w64 × w64} {write : Bool} {recs : List WalRec}
    {stop : WalStop} {r : List w8 × HardStateM × List EntryM}
    (h : readAllFold U s write recs stop = .ok r) :
    ∃ st, (recs.map (fun r => (r.typ, r.data))).foldlM (raStep U s) raInit = .ok st ∧
      st.matched = true ∧ r = (st.md.getD [], st.hs, st.ents) := by
  unfold readAllFold at h
  rw [except_bind_ok] at h
  obtain ⟨st, h1, h⟩ := h
  refine ⟨st, h1, ?_⟩
  by_cases hc : (if write then stop ≠ .eof else stop ≠ .eof ∧ stop.unexpectedEOF = false)
  · rw [if_pos hc] at h; cases h
  · rw [if_neg hc] at h
    by_cases hm : st.matched = false
    · rw [if_pos hm] at h; cases h
    · rw [if_neg hm] at h
      simp only [Except.ok.injEq] at h
      exact ⟨by simpa using hm, h.symm⟩

/-- `ReadAll` succeeds when the loop does with a match, the stop accepted. -/
theorem readAllFold_of {U : WalUnmarshal} {s : w64 × w64} {write : Bool} {recs : List WalRec}
    {stop : WalStop} {st : RAState}
    (h : (recs.map (fun r => (r.typ, r.data))).foldlM (raStep U s) raInit = .ok st)
    (hm : st.matched = true) (hstop : stop = .eof ∨ (write = false ∧ stop.unexpectedEOF = true)) :
    readAllFold U s write recs stop = .ok (st.md.getD [], st.hs, st.ents) := by
  unfold readAllFold
  rw [h, except_ok_bind]
  have hc : ¬ (if write then stop ≠ .eof else stop ≠ .eof ∧ stop.unexpectedEOF = false) := by
    rcases hstop with h0 | ⟨h1, h2⟩
    · subst h0; cases write <;> simp
    · subst h1; simp [h2]
  rw [if_neg hc, if_neg (by simp [hm])]

/-! ## The main theorems -/

/-- **From a cut file: `ReadAll` succeeds only with `walReadFrom`'s read.** The WAL's segments are
`Spre ++ Ss`, the records read those after `Spre`'s (`walDecodeFiles_suffix`, with
`Ss = Smid ++ [histCut M S n]`), the start the newest valid pair of the history from the read's
position (`Open`'s, `walValidSnaps`). -/
theorem recsOfSegs_drop_map (C : WalCodec) (M : WalMarshal) (md : List w8) {Spre : List WalHist}
    (hpre : Spre ≠ []) (Ss : List WalHist) :
    ((recsOfSegs C M md (Spre ++ Ss)).drop (recsOfSegs C M md Spre).length).map
      (fun r => (r.typ, r.data)) = (segsDs M md false Spre.flatten Ss).flatten := by
  rw [recsOfSegs_append C M md hpre, List.drop_left, chainRecs_map]

theorem recsOfSegs_map (C : WalCodec) (M : WalMarshal) (md : List w8) (Ss : List WalHist) :
    (recsOfSegs C M md Ss).map (fun r => (r.typ, r.data)) = (segsDs M md true [] Ss).flatten := by
  rw [recsOfSegs, chainRecs_map]

theorem flatten_append_drop {Spre Ss : List WalHist} :
    (Spre ++ Ss).flatten.drop Spre.flatten.length = Ss.flatten := by
  rw [List.flatten_append, List.drop_left]

theorem flatten_append_take {Spre Ss : List WalHist} :
    (Spre ++ Ss).flatten.take Spre.flatten.length = Spre.flatten := by
  rw [List.flatten_append, List.take_left]

/-- **From a cut file: `ReadAll` succeeds only with `walReadFrom`'s read**, and the metadata `md`.
The WAL's segments are `Spre ++ Ss` (`Spre`'s operations not none), the records read those after
`Spre`'s (`walDecodeFiles_suffix`, with `Ss = Smid ++ [histCut M S n]`), the start the newest valid
pair of the history from the read's position (`Open`'s, `walValidSnaps`). -/
theorem readAllFold_from {C : WalCodec} {M : WalMarshal} {U : WalUnmarshal} (hU : U.Ok M)
    (md : List w8) (Spre Ss : List WalHist) (hk : Spre.flatten ≠ []) (s : w64 × w64) (write : Bool)
    (stop : WalStop) (r : List w8 × HardStateM × List EntryM)
    (hs : some s = walNewestPair (walValidSnaps (Spre ++ Ss).flatten Spre.flatten.length))
    (hok : readAllFold U s write
      ((recsOfSegs C M md (Spre ++ Ss)).drop (recsOfSegs C M md Spre).length) stop = .ok r) :
    ∃ σ, walReadFrom (Spre ++ Ss).flatten Spre.flatten.length = some σ ∧ r = (md, σ.hs, σ.ents) := by
  have hpre : Spre ≠ [] := by rintro rfl; exact hk rfl
  have hk0 : Spre.flatten.length ≠ 0 := fun h0 => hk (List.eq_nil_of_length_eq_zero h0)
  obtain ⟨hc, hle⟩ := validSnaps_bounds hs
  rw [flatten_append_drop] at hle
  obtain ⟨st, hfold, hm, rfl⟩ := readAllFold_ok hok
  rw [recsOfSegs_drop_map C M md hpre] at hfold
  have hnew := walNewest_eq_newestPair (Spre ++ Ss).flatten hk0
  rw [← hs, flatten_append_drop] at hnew
  unfold walReadFrom
  simp only [flatten_append_drop, flatten_append_take]
  cases hN : walNewest (Ss.flatten.filter (walKeep (uint.nat (walLastHS (Spre ++ Ss).flatten).Commit'))) with
  | none => rw [hN] at hnew; cases hnew
  | some m =>
    rw [hN, Option.map_some, Option.some.injEq] at hnew
    subst hnew
    obtain ⟨σ', hf, he, hcase, -⟩ := raStep_segs_ok U M hU _ md _ hc Ss Spre.flatten raInit st
      ⟨walLastHS Spre.flatten, some (SnapshotM.mk [] m), entryID.mk m.Term' m.Index', []⟩
      rfl rfl rfl (Or.inr rfl) (Or.inl rfl) hle hfold
    refine ⟨σ', hf, ?_⟩
    rcases hcase with ⟨-, rfl, -⟩ | ⟨hh, hmd⟩
    · simp [raInit] at hm
    · rw [hmd, hh, he]; rfl

/-- **… and it succeeds whenever `walReadFrom` does**, the stop accepted, unless a record of the
start's index has another term (`ErrSnapshotMismatch`, which `walReadFrom` does not check). -/
theorem readAllFold_from_complete {C : WalCodec} {M : WalMarshal} {U : WalUnmarshal} (hU : U.Ok M)
    (md : List w8) (Spre Ss : List WalHist) (hk : Spre.flatten ≠ []) (s : w64 × w64) (write : Bool)
    (stop : WalStop) (σ : StorContents)
    (hs : some s = walNewestPair (walValidSnaps (Spre ++ Ss).flatten Spre.flatten.length))
    (hterm : ∀ m, WalOpG.snap m ∈ Ss.flatten → m.Index' = s.1 → m.Term' = s.2)
    (hstop : stop = .eof ∨ (write = false ∧ stop.unexpectedEOF = true))
    (h : walReadFrom (Spre ++ Ss).flatten Spre.flatten.length = some σ) :
    readAllFold U s write
      ((recsOfSegs C M md (Spre ++ Ss)).drop (recsOfSegs C M md Spre).length) stop =
      .ok (md, σ.hs, σ.ents) := by
  have hpre : Spre ≠ [] := by rintro rfl; exact hk rfl
  have hk0 : Spre.flatten.length ≠ 0 := fun h0 => hk (List.eq_nil_of_length_eq_zero h0)
  obtain ⟨hc, hle⟩ := validSnaps_bounds hs
  rw [flatten_append_drop] at hle
  have hnew := walNewest_eq_newestPair (Spre ++ Ss).flatten hk0
  rw [← hs, flatten_append_drop] at hnew
  unfold walReadFrom at h
  simp only [flatten_append_drop, flatten_append_take] at h
  cases hN : walNewest (Ss.flatten.filter (walKeep (uint.nat (walLastHS (Spre ++ Ss).flatten).Commit'))) with
  | none => rw [hN] at h; cases h
  | some m =>
    rw [hN] at h
    rw [hN, Option.map_some, Option.some.injEq] at hnew
    subst hnew
    obtain ⟨st, hfold, he, hcase, hm'⟩ := raStep_segs_complete U M hU _ md _ hc Ss Spre.flatten
      raInit _ σ rfl rfl rfl (Or.inr rfl) (Or.inl rfl) hle hterm h
    obtain ⟨m', hm'mem, hidx⟩ := walNewest_mem hN
    have hmatch : st.matched = true := by
      rw [hm']
      simp only [raInit, Bool.false_or, List.any_eq_true]
      exact ⟨WalOpG.snap m', (List.mem_filter.1 hm'mem).1, by simp [snapAt, hidx]⟩
    rcases hcase with ⟨rfl, -, -⟩ | ⟨hh, hmd⟩
    · simp at hm'mem
    · rw [readAllFold_of (by rw [recsOfSegs_drop_map C M md hpre]; exact hfold) hmatch hstop,
        hmd, hh, he]
      rfl

/-- **From the first file: `ReadAll` succeeds only with the read at the fixed base `s`**, and the
metadata `md`. -/
theorem readAllFold_zero {C : WalCodec} {M : WalMarshal} {U : WalUnmarshal} (hU : U.Ok M)
    (md : List w8) (Ss : List WalHist) (s : w64 × w64) (write : Bool)
    (stop : WalStop) (r : List w8 × HardStateM × List EntryM)
    (hs : some s = walNewestPair (walValidSnaps Ss.flatten 0))
    (hok : readAllFold U s write (recsOfSegs C M md Ss) stop = .ok r) :
    ∃ σ, walReadAt Ss.flatten 0 s = some σ ∧ r = (md, σ.hs, σ.ents) := by
  obtain ⟨hc, hle⟩ := validSnaps_bounds hs
  simp only [List.drop_zero] at hle
  obtain ⟨st, hfold, hm, rfl⟩ := readAllFold_ok hok
  rw [recsOfSegs_map] at hfold
  cases Ss with
  | nil =>
    simp only [segsDs, List.flatten_nil, List.foldlM_nil, pure, Except.pure, Except.ok.injEq] at hfold
    subst hfold; simp [raInit] at hm
  | cons S Ss =>
    simp only [segsDs, segHdrDs, ite_true, List.flatten_cons, List.nil_append] at hfold
    rw [List.foldlM_append, except_bind_ok] at hfold
    obtain ⟨st2, h2, hfold⟩ := hfold
    rw [List.foldlM_append, except_bind_ok] at h2
    obtain ⟨st1, h1, h2⟩ := h2
    rw [raStep_hdr U M hU] at h1
    have hst1 : st1.md = some md ∧ st1.hs = hsZero ∧ st1.ents = [] := by
      split at h1
      · split at h1
        · simp only [Except.ok.injEq] at h1; subst h1; exact ⟨rfl, rfl, rfl⟩
        · cases h1
      · simp only [Except.ok.injEq] at h1; subst h1; exact ⟨rfl, rfl, rfl⟩
    rw [raStep_flatMap U M hU] at h2
    have hle1 : ∀ m, WalOpG.snap m ∈ S → uint.nat m.Index' ≤ uint.nat (walLastHS (S :: Ss).flatten).Commit' →
        uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_left _ hm)
    have hle2 : ∀ m, WalOpG.snap m ∈ Ss.flatten →
        uint.nat m.Index' ≤ uint.nat (walLastHS (S :: Ss).flatten).Commit' →
        uint.nat m.Index' ≤ uint.nat s.1 :=
      fun m hm => hle m (List.mem_append_right _ hm)
    obtain ⟨σ1, hf1, hr2, hmd2, -⟩ := goOp_sim_ok s _ hc S st1 st2
      ⟨hsZero, none, entryID.mk s.2 s.1, []⟩ ⟨hst1.2.1, hst1.2.2, rfl⟩ hle1 h2
    have hσ1 : σ1.hs = walLastHS S := by
      have := walFoldChkFrom_lastHS (P := []) rfl hf1
      simpa using this
    obtain ⟨σ', hf, he, hcase, -⟩ := raStep_segs_ok U M hU s md _ hc Ss S st2 st σ1 hr2.2.1 hr2.2.2 hσ1
      (Or.inl (hr2.1.trans hσ1)) (Or.inr (hmd2.trans hst1.1)) hle2 hfold
    refine ⟨σ', ?_, ?_⟩
    · rw [List.flatten_cons] at hf1 hf
      unfold walReadAt
      rw [List.take_zero, List.drop_zero, List.flatten_cons, List.filter_append, walFoldChkFrom_append]
      rw [show walLastHS [] = hsZero from rfl, hf1, Option.bind_some]
      exact hf
    · rcases hcase with ⟨-, rfl, rfl⟩ | ⟨hh, hmd⟩
      · rw [hmd2, hst1.1, hr2.1, hr2.2.1]; rfl
      · rw [hmd, hh, he]; rfl

/-- Two folds over operations without a snapshot record, from states of the same hard state,
entries and base index, end in the same hard state and entries. -/
theorem walFoldChkFrom_nosnap : ∀ (L : WalHist) (τ τ' σ σ' : StorContents),
    (∀ m, WalOpG.snap m ∉ L) → τ.hs = τ'.hs → τ.ents = τ'.ents → τ.b = τ'.b →
    walFoldChkFrom τ L = some σ → walFoldChkFrom τ' L = some σ' → σ.hs = σ'.hs ∧ σ.ents = σ'.ents := by
  intro L
  induction L with
  | nil =>
    intro τ τ' σ σ' _ h1 h2 _ h h'
    simp only [walFoldChkFrom, Option.some.injEq] at h h'
    subst h h'; exact ⟨h1, h2⟩
  | cons o L ih =>
    intro τ τ' σ σ' hns h1 h2 h3 h h'
    cases o with
    | snap m => exact absurd List.mem_cons_self (hns m)
    | save hs es =>
      have hns' : ∀ m, WalOpG.snap m ∉ L := fun m hm => hns m (List.mem_cons_of_mem _ hm)
      simp only [walFoldChkFrom, Option.bind_eq_bind, Option.bind_eq_some_iff] at h h'
      obtain ⟨ents, hf, h⟩ := h
      obtain ⟨ents', hf', h'⟩ := h'
      rw [h2, h3, hf'] at hf
      simp only [Option.some.injEq] at hf
      exact ih { τ with hs := phsNext τ.hs hs, ents := ents } { τ' with hs := phsNext τ'.hs hs, ents := ents' }
        σ σ' hns' (by simp only; rw [h1]) (by simp only; exact hf.symm) h3 h h'

/-- **The fixed-base read from the first file is `walRead`'s when that succeeds** (`walCommitLe`:
W4b's C2 premise): the same hard state and entries. -/
theorem walReadAt_zero_eq {I : WalHist} {s : w64 × w64} {σ σ' : StorContents}
    (hs : some s = walNewestPair (walValidSnaps I 0))
    (hcl : walCommitLe I) (h : walRead I = some σ) (h' : walReadAt I 0 s = some σ') :
    σ'.hs = σ.hs ∧ σ'.ents = σ.ents := by
  obtain ⟨hc, hle⟩ := validSnaps_bounds hs
  simp only [List.drop_zero] at hle
  unfold walReadAt at h'
  rw [List.take_zero, List.drop_zero, show walLastHS [] = hsZero from rfl] at h'
  unfold walRead at h
  unfold walCommitLe at hcl
  generalize hL : I.filter (walKeep (uint.nat (walLastHS I).Commit')) = L at h h' hcl
  have hleL : ∀ m, WalOpG.snap m ∈ L → uint.nat m.Index' ≤ uint.nat s.1 := by
    intro m hm
    rw [← hL] at hm
    obtain ⟨hm1, hm2⟩ := List.mem_filter.1 hm
    exact hle m hm1 (by simpa [walKeep] using hm2)
  by_cases hex : ∃ m, WalOpG.snap m ∈ L ∧ uint.nat m.Index' = uint.nat s.1
  · have := walFoldChk_sim (uint.nat s.1) L walFresh ⟨hsZero, none, entryID.mk s.2 s.1, []⟩ σ σ'
      hleL hex rfl rfl (by simp [walFresh, StorContents.b])
      (Or.inl (by simp [walFresh])) hcl h h'
    subst this; exact ⟨rfl, rfl⟩
  · -- the start is `Create`'s `(0, 0)`, and no record is kept
    have hs0 : uint.nat s.1 = 0 := by
      have hmem := walNewestPair_mem hs.symm
      unfold walValidSnaps at hmem
      rcases List.mem_append.1 hmem with h0 | h0
      · simp only [ite_true, List.mem_cons, List.not_mem_nil, or_false] at h0
        subst h0; simp
      · obtain ⟨o, ho, hoe⟩ := List.mem_filterMap.1 h0
        cases o with
        | save _ _ => cases hoe
        | snap m =>
          simp only at hoe
          split at hoe
          · next hmc =>
            simp only [Option.some.injEq] at hoe
            subst hoe
            exact absurd ⟨m, by rw [← hL]; exact List.mem_filter.2 ⟨ho, by simpa [walKeep] using hmc⟩,
              rfl⟩ hex
          · cases hoe
    have hns : ∀ m, WalOpG.snap m ∉ L := by
      intro m hm
      have := hleL m hm
      exact hex ⟨m, hm, by omega⟩
    obtain ⟨e1, e2⟩ := walFoldChkFrom_nosnap L walFresh ⟨hsZero, none, entryID.mk s.2 s.1, []⟩ σ σ'
      hns rfl rfl
      (by simp [walFresh, StorContents.b, hs0]) h h'
    exact ⟨e1.symm, e2.symm⟩


/-- **… which is `walRead`'s when that succeeds** (`walCommitLe`: W4b's C2 premise), and the
metadata `md`. -/
theorem readAllFold_zero_eq {C : WalCodec} {M : WalMarshal} {U : WalUnmarshal} (hU : U.Ok M)
    (md : List w8) (Ss : List WalHist) (s : w64 × w64) (write : Bool)
    (stop : WalStop) (r : List w8 × HardStateM × List EntryM) (σ : StorContents)
    (hs : some s = walNewestPair (walValidSnaps Ss.flatten 0))
    (hcl : walCommitLe Ss.flatten) (h : walRead Ss.flatten = some σ)
    (hok : readAllFold U s write (recsOfSegs C M md Ss) stop = .ok r) :
    r = (md, σ.hs, σ.ents) := by
  obtain ⟨σ', h', rfl⟩ := readAllFold_zero hU md Ss s write stop r hs hok
  obtain ⟨e1, e2⟩ := walReadAt_zero_eq hs hcl h h'
  rw [e1, e2]

/-- **The deviation: `ReadAll` from the first file succeeds where `walRead` fails.** `Save` of the
hard state `{Term 1, Commit 5}` with the entry 6, then `SaveSnapshot({Index 5, Term 1})`: the start
is `(5, 1)` (`walValidSnaps`'s newest: `5 ≤` the commit), and `ReadAll` keeps the entry 6 (offset 0
from the start), where `walRead`'s fold, at base 0 when it meets the entry, fails
(`ErrSliceOutOfRange`'s case). `walCommitLe` holds (vacuously: the fold fails). -/
theorem readAllFold_zero_dev {C : WalCodec} {M : WalMarshal} {U : WalUnmarshal} (hU : U.Ok M)
    (md : List w8) (cs : ConfStateM) (ty : raftpb.EntryType) :
    let h : HardStateM := ⟨W64 1, W64 0, W64 5⟩
    let e : EntryM := ⟨W64 1, W64 6, ty, []⟩
    let I : WalHist := [.save h [e], .snap ⟨cs, W64 5, W64 1⟩]
    some (W64 5, W64 1) = walNewestPair (walValidSnaps I 0) ∧ walCommitLe I ∧
    walRead I = none ∧
    readAllFold U (W64 5, W64 1) true (recsOfSegs C M md [I]) .eof = .ok (md, h, [e]) := by
  intro h e I
  have hc : walLastHS I = h := by simp [I, walLastHS, phsNext, h]
  have hhs : phsNext hsZero h = h := by simp [phsNext, h]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [walValidSnaps, hc]; simp [I, h, walNewestPair]
  · intro n τ' hf
    have hkeep : I.filter (walKeep (uint.nat (walLastHS I).Commit')) = I := by
      rw [hc]; simp [I, h, walKeep]
    rw [hkeep] at hf
    cases n with
    | zero =>
      simp only [List.take_zero, walFoldChkFrom, Option.some.injEq] at hf
      subst hf; simp [walFresh, StorContents.commit, StorContents.last, StorContents.b]
    | succ n =>
      simp [I, walFoldChkFrom, readEnt, walFresh, e, StorContents.b] at hf
  · unfold walRead
    have hkeep : I.filter (walKeep (uint.nat (walLastHS I).Commit')) = I := by
      rw [hc]; simp [I, h, walKeep]
    rw [hkeep]
    simp [I, walFoldChkFrom, readEnt, walFresh, e, StorContents.b]
  · have hfold : ((recsOfSegs C M md [I]).map (fun r => (r.typ, r.data))).foldlM
        (raStep U (W64 5, W64 1)) raInit = .ok ⟨some md, h, [e], true⟩ := by
      rw [recsOfSegs_map]
      simp only [segsDs, segHdrDs, ite_true, List.flatten_cons, List.flatten_nil, List.append_nil,
        List.foldlM_append, raStep_hdr U M hU, raStep_flatMap U M hU]
      rw [if_neg (by decide), except_ok_bind]
      simp [I, goOp, readEnt, e, hhs]
      rfl
    exact readAllFold_of hfold rfl (Or.inl rfl)

