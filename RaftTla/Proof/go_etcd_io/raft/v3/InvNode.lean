    (cd : context.ContextDesc (IProp GF)) (err : GoInterface) :
    nodeErrS (GF := GF) n γ N cd err ⊢ nodeErr cd err := by
  unfold nodeErrS nodeErr
  iintro (%H | ⟨#H, -⟩ | #H)
  · ileft; ipureintro; exact H
  · iright; ileft; iexact H
  · iright; iright; iexact H

