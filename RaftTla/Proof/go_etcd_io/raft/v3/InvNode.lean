    (cd : context.ContextDesc (IProp GF)) (err : GoInterface) :
    propErrS (GF := GF) n γ N cd err ⊢ propErr cd err := by
  unfold propErrS propErr
  iintro (H | #H)
  · ileft; iapply nodeErrS_nodeErr $$ H
  · iright; iexact H

