variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [StorageModel GF]
variable [sem : go.Semantics]
variable [package_sem : go_etcd_io.raft.v3.Assumptions]
/-- **A `MsgApp` is from the node that sent it** (`AppFrom`: its `From` is `src`): what rafthttp's
msgappv2 codec needs, whose frames carry no sender. -/
theorem sentMsg_appFrom (γ : Cluster) (N : Namespace) (src : w64) (st : MsgSt) :
    sentMsg (GF := GF) γ N src st ⊢ ⌜AppFrom src st⌝ := by
  unfold sentMsg; exact ApiImpl.sentMsg_appFrom_impl γ N src st

end apiHeap

section api
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [AllG GF] [ReceiptGS GF] [InvGS GF]
/-- (restart S7.3, 2026-11-14; `notes/restart-s7-p2a.md`) **A message's `MsgSnap` facts, in the
cluster `γ`** (persistent; raft's `snapToOk` at the cluster's raft names): a `MsgSnap` from node `id`
is not to `id`, and, in raft's dynamic mode only, to a voter or learner of a committed log's
configuration (in the static mode nothing more). Clients read it through
`InvNodeRule.snapTo_confAt`. -/
@[no_expose] def snapTo (γ : Cluster) (id : w64) (st : MsgSt) : IProp GF :=
  snapToOk γ.raft id st

instance snapTo_persistent (γ : Cluster) (id : w64) (st : MsgSt) :
    Persistent (snapTo (GF := GF) γ id st) := by
  unfold snapTo; infer_instance

/-- (restart S7.3, 2026-11-14; `notes/restart-s7-p2a.md`) **A sent `MsgSnap`'s destination** (`snapToOk`):
not its sender `src` (`send`'s panic), and, in raft's dynamic mode only, a voter or learner of a
committed log's configuration (`snapDstOk`: the sender's tracker's when it sent it); see
`InvNodeRule.snapTo_confAt`. -/
theorem sentMsg_snapTo (γ : Cluster) (N : Namespace) (src : w64) (st : MsgSt) :
    sentMsg (GF := GF) γ N src st ⊢ snapTo γ src st := by
  unfold sentMsg ApiImpl.sentMsg snapTo
  iintro ⟨-, #H, -⟩
  iapply isRaftMsg_snapTo $$ H

/-- A leader certificate retained with the snapshot's send or receipt. -/
@[no_expose] def snapshotLeader (γ : Cluster) (id t : w64) : IProp GF :=
  isLeader γ.raft id t

instance snapshotLeader_persistent (γ : Cluster) (id t : w64) :
    Persistent (snapshotLeader (GF := GF) γ id t) := by
  unfold snapshotLeader; infer_instance

theorem sentMsg_snapshotLeader (γ : Cluster) (N : Namespace) (id : w64) (st : MsgSt)
    (ht : st.msg.Type' = MsgSnap) :
    sentMsg (GF := GF) γ N id st ⊢ snapshotLeader γ st.msg.From' st.msg.Term' := by
  unfold sentMsg ApiImpl.sentMsg snapshotLeader
  iintro ⟨-, #H, -⟩
  iapply isRaftMsg_snapshotLeader γ.raft id st ht $$ H

/-- A snapshot in this node's outbox establishes its own leadership. -/
theorem sentMsg_localSnapshotLeader (γ : Cluster) (N : Namespace) (id : w64) (st : MsgSt)
    (ht : st.msg.Type' = MsgSnap) :
    sentMsg (GF := GF) γ N id st ⊢ snapshotLeader γ id st.msg.Term' := by
  iintro #H
  ihave #Hl := sentMsg_snapshotLeader γ N id st ht $$ H
  unfold sentMsg ApiImpl.sentMsg isRaftMsg
  icases H with ⟨-, ⟨-, -, -, %Hfr, -⟩, -⟩
  rw [← Hfr (Or.inr ht)]
  iexact Hl

/-- Election safety excludes a node restoring a snapshot from another leader
and sending as leader in the same term. -/
theorem snapshotLeader_terms_ne (γ : Cluster) (id sender t tr : w64) (hd : id ≠ sender) :
    ⊢ snapshotLeader (GF := GF) γ id t -∗ snapshotLeader γ sender tr -∗ ⌜t ≠ tr⌝ := by
  unfold snapshotLeader
  iintro #Hs #Hr
  by_cases he : t = tr
  · subst tr
    ihave %hid := isLeader_unique γ.raft id sender t $$ Hs Hr
    exact False.elim (hd hid)
  · ipureintro; exact he

/-- (raft-entsize [r3c], 2026-11-09) **A sent `MsgSnap` has no entries and no context**
(`SentMsgShape`'s: raft builds it as `pb.Message{To, Type: MsgSnap, Snapshot}`,
`maybeSendSnapshot`): what bounds the size of etcd's merged snapshot message, which keeps the rest
of raft's message. -/
theorem sentMsg_snap_empty (γ : Cluster) (N : Namespace) (src : w64) (st : MsgSt) :
    sentMsg (GF := GF) γ N src st ⊢ ⌜st.msg.Type' = MsgSnap → st.ents = [] ∧ st.ctx = []⌝ := by
  unfold sentMsg
  iintro Hs
  iunfold ApiImpl.sentMsg at Hs
  icases Hs with ⟨-, Hr, -⟩
  iunfold isRaftMsg at Hr
  icases Hr with ⟨%Hsh, -⟩
  ipureintro; exact fun h => Hsh.2.2.2.2.2.2.1 (Or.inr (Or.inr h))

/-- (open) **What a sent message carries for its receiver's `Step`** (today `rdCred`, one for a
`MsgReadIndex`, and `stTks`, a forwarded proposal's tickets). -/
@[no_expose] def msgCredits (γ : Cluster) (N : Namespace) (st : MsgSt) : IProp GF :=
  ApiImpl.msgCredits γ N st

/-- **The snapshot directory the client chose for the node `id`** (2026-11-01, J8a; `cluster_alloc`'s
`sl`): `some γd`, a ghost map `γd` of the indices of the snapshots saved there, or none. -/
@[no_expose] def Cluster.snapLoc (γ : Cluster) : w64 → Option GName := γ.raft.reSnapLoc

end api

section apiHeap
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [StorageModel GF]
variable [sem : go.Semantics]
variable [package_sem : go_etcd_io.raft.v3.Assumptions]
/-- An installed snapshot's original Raft message, retained through Ready. -/
@[no_expose] def nodeRestoreSource (γ : Cluster) (id : w64) (p : entryID) : IProp GF :=
  restoredSnapSource γ.raft id p

instance (γ : Cluster) (id : w64) (p : entryID) : Persistent (nodeRestoreSource (GF := GF) γ id p) := by
  unfold nodeRestoreSource; infer_instance

/-- The source was elected in the term in which it sent the snapshot. -/
theorem nodeRestoreSource_leader (γ : Cluster) (id : w64) (p : entryID) :
    nodeRestoreSource (GF := GF) γ id p ⊢ ∃ (sender term : w64), ⌜sender ≠ id⌝ ∗ snapshotLeader γ sender term := by
  unfold nodeRestoreSource restoredSnapSource snapshotLeader
  iintro ⟨%m, %hm, #Hm⟩
  iexists m.src, m.term
  isplitr
  · ipureintro; exact hm.2.1
  iapply isMessage_snapshotLeader γ.raft m hm.1 $$ Hm

end apiHeap

section api
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [AllG GF] [ReceiptGS GF] [InvGS GF]
/-- (open) **A snapshot of index `i` local to the node `id`** (2026-11-01, J8a; raft's `snapLocal`):
with a directory (`Cluster.snapLoc γ id = some γd`) the index saved there (`nodeSnapLocal_of_elem`,
`nodeSnapLocal_elem`), and nothing otherwise (`nodeSnapLocal_none`). What `node.Step` takes of a
message's snapshot (`snapLocalMsg`) and a snapshot `Ready` gives back (`readySnap`): raft installs only
a snapshot it was stepped. -/
@[no_expose] def nodeSnapLocal (γ : Cluster) (id i : w64) : IProp GF := snapLocal γ.raft id i

instance nodeSnapLocal_persistent (γ : Cluster) (id i : w64) :
    Persistent (nodeSnapLocal (GF := GF) γ id i) := by
  unfold nodeSnapLocal; infer_instance

/-- Without a directory for `id`, every snapshot is local. -/
theorem nodeSnapLocal_none (γ : Cluster) (id : w64) (h : γ.snapLoc id = none) (i : w64) :
    ⊢ nodeSnapLocal (GF := GF) γ id i := by
  unfold nodeSnapLocal; exact snapLocal_none h i

/-- With the directory `γd` for `id`, its saved index's element gives the fact. -/
theorem nodeSnapLocal_of_elem (γ : Cluster) (id : w64) (γd : GName) (h : γ.snapLoc id = some γd)
    (i : w64) :
    ghostMapElem (GF := GF) (K := w64) (V := Unit) γd i DFrac.discard () ⊢ nodeSnapLocal γ id i := by
  unfold nodeSnapLocal; exact snapLocal_of_elem h i

/-- With the directory `γd` for `id`, the fact is its saved index's element. -/
theorem nodeSnapLocal_elem (γ : Cluster) (id : w64) (γd : GName) (h : γ.snapLoc id = some γd)
    (i : w64) :
    nodeSnapLocal (GF := GF) γ id i ⊢ ghostMapElem (K := w64) (V := Unit) γd i DFrac.discard () := by
  unfold nodeSnapLocal snapLocal
  unfold Cluster.snapLoc at h
  rw [h]

/-- (open) **A `MsgSnap`'s snapshot local to the node `id`** (2026-11-01, J8a): what `node.Step` takes of
a message beside its certificates (`stepIn_intro`; nothing of another type, `snapLocalMsg_notSnap`). -/
@[no_expose] def snapLocalMsg (γ : Cluster) (id : w64) (st : MsgSt) : IProp GF :=
  ApiImpl.snapLocalMsg γ id st

instance snapLocalMsg_persistent (γ : Cluster) (id : w64) (st : MsgSt) :
    Persistent (snapLocalMsg (GF := GF) γ id st) := by
  unfold snapLocalMsg ApiImpl.snapLocalMsg; infer_instance

/-- A `MsgSnap`'s snapshot local, the message's fact. -/
theorem snapLocalMsg_intro (γ : Cluster) (id : w64) (st : MsgSt) :
    (□ ∀ sv : SnapshotM, ⌜st.msg.Type' = MsgSnap ∧ st.snap = some sv⌝ -∗
        nodeSnapLocal γ id sv.Metadata'.Index') ⊢
      snapLocalMsg (GF := GF) γ id st := by
  unfold snapLocalMsg ApiImpl.snapLocalMsg nodeSnapLocal; exact .rfl

/-- A message of another type has the fact. -/
theorem snapLocalMsg_notSnap (γ : Cluster) (id : w64) (st : MsgSt) (h : st.msg.Type' ≠ MsgSnap) :
    ⊢ snapLocalMsg (GF := GF) γ id st := by
  unfold snapLocalMsg ApiImpl.snapLocalMsg
  iintro !> %sv %Hs
  exact absurd Hs.1 h

/-- Without a directory for `id`, every message has the fact. -/
theorem snapLocalMsg_noDir (γ : Cluster) (id : w64) (h : γ.snapLoc id = none) (st : MsgSt) :
    ⊢ snapLocalMsg (GF := GF) γ id st := by
  unfold snapLocalMsg ApiImpl.snapLocalMsg
  iintro !> %sv %-
  have H := nodeSnapLocal_none (GF := GF) γ id h sv.Metadata'.Index'
  unfold nodeSnapLocal at H
  iapply H

end api

section apiHeap
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [StorageModel GF]
variable [sem : go.Semantics]
variable [package_sem : go_etcd_io.raft.v3.Assumptions]
/-- (2026-11-12, trace-check implementation step 1; the design's §3.1, moved here from
`TracedNodeApi.lean`) **A sent message's token** (gated): untraced nothing; traced, the message's type
is one a traced node hands out (`TrSent`: a traced network type, or a forwarded proposal of normal
entries) and the token of its specification message in flight, which the receive line consumes.
Sealed: a client carries it from `node.Advance` (`node.Advance.tracedSpec`) to `stepIn_intro`. The
design's `trTok`, named `sentTok` here: every client of raft imports this module, and etcd's rafthttp
has a `trTok` of its own (`TransportState.lean`); `TracedNodeApi.lean`'s `trTok` abbreviates this. -/
@[no_expose] def sentTok (γ : Cluster) (st : MsgSt) : IProp GF := trTokR γ.raft st

/-- An untraced cluster's tokens are free. -/
theorem sentTok_untraced (γ : Cluster) (st : MsgSt) (h : Cluster.trace γ = none) :
    ⊢ sentTok (GF := GF) γ st := by
  unfold sentTok; exact trTokR_none γ.raft st h

/-- **A token says its message is no `MsgSnap`** at a traced cluster (what the harness reads before
`Step` consumes the token: its `ReportSnapshot` calls are dead). -/
theorem sentTok_type (γ : Cluster) (st : MsgSt) :
    sentTok (GF := GF) γ st ⊢ sentTok γ st ∗ ⌜Cluster.trace γ ≠ none → st.msg.Type' ≠ MsgSnap⌝ := by
  unfold sentTok Cluster.trace trTokR
  cases γ.raft.reTrace with
  | none =>
    iintro H; iframe H; ipureintro; intro h; exact absurd rfl h
  | some γd =>
    iintro ⟨%Hs, H⟩
    isplitl [H]
    · dsimp only; iframe H; ipureintro; exact Hs
    ipureintro; intro _; exact Hs.ne_snap

/-- (open) **A message `node.Step` takes** at the node `id` (today `stepP`): the message at `ml`. -/
@[no_expose] def stepIn (γ : Cluster) (N : Namespace) (id : w64) (ml : Loc) : IProp GF :=
  ApiImpl.stepIn γ N id ml

/-- **Stepping a sent message**: a copy of it (its fields, entries and snapshot; no local
responses), owned with its entries slice fresh, addressed to `id`, with its credits (`msgCredits`:
a forwarded proposal's tickets; nothing for another type, `msgCredits_intro`) and (2026-11-01, J8a)
its snapshot, if any, local to `id` (`snapLocalMsg`). Any sent message, of
any type: (raft-final, 2026-10-29, U7: candidate 12's form) no `NetMsgOk`, no leader-transfer
exclusion (a stamped `MsgTransferLeader` carries its destination's leadership, `isRaftMsg`) and no
`MsgSnap` index premise (`sentMsg` bounds it, `sentMsg_shape`); until then those three premises.
(2026-10-27, for etcd's server: no premise on a forwarded proposal's context. 2026-10-29, stage U4:
no pre-vote premise: a node at term `0` has an empty log and grants a pre-vote request. 2026-10-29,
stage U7: `node.Step` takes its own time receipt, no tick credit for a `MsgTimeoutNow`.) -/
theorem stepIn_intro (γ : Cluster) (N : Namespace) (id : w64) (ml : Loc) (src : w64) (st : MsgSt)
    (c : MsgC) :
    st.msg.To' = id →
    -- (raft-entsize §2, 2026-11-09) the object at a content `c` (`msgPtsCC`; until then
    -- `msgPtsC ml 1 1 true ⟨st…, []⟩`, which is `c`'s model with no unknown fields in its snapshot's
    -- conf state, `msgPtsC_iff_CC`), of bounded size in a cluster with a bound on proposed data,
    -- but a `MsgSnap`
    c.model = ⟨st.msg, st.ents, st.snap, st.ctx, []⟩ → c.csUfNil →
    (∀ b, γ.maxData = some b → st.msg.Type' ≠ MsgSnap → msgSizeOk c) →
    sentMsg (GF := GF) γ N src st ∗
      msgPtsCC ml (DFrac.own 1) (DFrac.own 1) true c ∗
      msgCredits γ N st ∗ snapLocalMsg γ id st ∗
      -- (2026-11-12, trace-check implementation step 1: the design's F2) the message's token
      -- (`sentTok_untraced` at an untraced cluster)
      sentTok γ st ⊢
    |==> stepIn γ N id ml := by
  intro H3 Hc Hcs Hsz
  unfold sentMsg msgCredits stepIn snapLocalMsg sentTok
  unfold Cluster.maxData at Hsz
  exact ApiImpl.stepIn_intro_impl γ N id ml src st c H3 Hc Hcs Hsz

end apiHeap

section api
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [AllG GF] [ReceiptGS GF] [InvGS GF]
/-- (raft-final, 2026-10-29, U7: the design's §2.5, C12's `sentMsg_shape`) **A sent message has the
shape raft sends** (`SentMsgShape`: its type, a nonzero sender, stamped or not by type, from another
node but for the listed types, a `MsgApp` of raft's shape, the transfer messages with no entries and
no context, no responses), and a `MsgSnap` holds a snapshot of index below `2^61` (the storage's
snapshots are `snapshotValid`, which bounds it: the design's A10). What a transport needs to marshal
it and a receiver to step it. -/
theorem sentMsg_shape (γ : Cluster) (N : Namespace) (src : w64) (st : MsgSt) :
    sentMsg (GF := GF) γ N src st ⊢
      ⌜SentMsgShape st ∧
        (st.msg.Type' = MsgSnap → ∃ sv, st.snap = some sv ∧ uint.Z sv.Metadata'.Index' < 2 ^ 61)⌝ := by
  unfold sentMsg
  have H1 : ApiImpl.sentMsg (GF := GF) γ N src st ⊢ ⌜SentMsgShape st⌝ := by
    iintro Hs
    iunfold ApiImpl.sentMsg at Hs
    icases Hs with ⟨-, Hr, -⟩
    iunfold isRaftMsg at Hr
    icases Hr with ⟨%Hsh, -⟩
    ipureintro; exact Hsh
  have H2 : ApiImpl.sentMsg (GF := GF) γ N src st ⊢ ⌜st.msg.Type' = MsgSnap →
      ∃ sv, st.snap = some sv ∧ uint.Z sv.Metadata'.Index' < 2 ^ 61⌝ := by
    by_cases Hty : st.msg.Type' = MsgSnap
    · iintro Hs
      ihave %H := ApiImpl.sentMsg_snap_bound γ N src st Hty $$ Hs
      ipureintro; exact fun _ => H
    · iintro -
      ipureintro; exact fun h => absurd h Hty
  iintro Hs
  icases (persistent_entails_left H1) $$ Hs with ⟨Hs, %A⟩
  ihave %B := H2 $$ Hs
  ipureintro; exact ⟨A, B⟩

/-- (raft-final, 2026-10-29, U7: S1's `msgCredits_intro`, the design's §2.9) **A delivered copy of a
message other than a proposal needs nothing**: its credits are a forwarded proposal's tickets only
(a `MsgReadIndex`'s read credit is minted by its receiver, `rdPool`). -/
theorem msgCredits_intro (γ : Cluster) (N : Namespace) (st : MsgSt) :
    st.msg.Type' ≠ MsgProp → ⊢ |==> msgCredits (GF := GF) γ N st := by
  intro Hp
  unfold msgCredits ApiImpl.msgCredits stTks
  rw [if_neg Hp]
  iintro
  imodintro
  iempintro

/-! ## A node's durable state and its id's slot (2026-11-01, durability stage I-2)

`notes/raft-durability-proof-plan.md`; candidate 12 (`raftState`, `nodeVacant`). -/

/-- **Node `id`'s durable state is `S`** (exclusive; the client's): the state its storage must
hold for a restart (`RestartNode`'s update reads it), which only the client's *enter* of a
`Ready`'s batch moves (`readyEnter`). Allocation gives it at `RaftState.init` (`cluster_alloc`,
`joinAuth_join`). -/
@[no_expose] def raftState (γ : Cluster) (id : w64) (S : RaftState) : IProp GF :=
  ApiImpl.raftStateU γ id S

/-- **No node of `id` runs** (exclusive): what `RestartNode`/`StartNode` take and `node.Stop`
gives back, so that at most one node of an id runs at a time. Allocation gives it. -/
@[no_expose] def nodeVacant (γ : Cluster) (id : w64) : IProp GF :=
  ApiImpl.nodeVacantU γ id

variable [CrashGS GF] in
/-- (2026-11-21, the crash invariant: `notes/raft-crash-law-design.md` (i)) **No node of `id` runs,
armed for a crash at arm `x`** (exclusive): what `RestartNode`/`StartNode` take and `node.Stop`
gives back. `nodeVacant_arm` makes it, with the arm's crash token (`nodeCrashTok`). -/
@[no_expose] def nodeVacantA (γ : Cluster) (id : w64) (x : CrashNames) : IProp GF :=
  ApiImpl.nodeVacantAU γ id x

variable [CrashGS GF] in
/-- (2026-11-21) **The crash token of arm `x` of `id`** (exclusive): after a crash, it gives the
id's vacancy back (`nodeCrash`), whatever node of `id` ran from arm `x`. -/
@[no_expose] def nodeCrashTok (γ : Cluster) (id : w64) (x : CrashNames) : IProp GF :=
  ApiImpl.nodeCrashTokU γ id x

/-- (2026-11-21) **The node at `n` was started from arm `x`** (persistent): `StartNode`/`RestartNode`
give it with the node, and `node.Stop` gives the vacancy back at the arm the node was started from
(`nodeArm_agree`), so a client keeping the arm's crash token keeps it across a stop and restart. -/
@[no_expose] def nodeArm (n : NodeH) (γ : Cluster) (x : CrashNames) : IProp GF :=
  ApiImpl.nodeArmU n γ x

instance nodeArm_persistent (n : NodeH) (γ : Cluster) (x : CrashNames) :
    Persistent (nodeArm (GF := GF) n γ x) := by
  unfold nodeArm; exact ApiImpl.nodeArmU_persistent n γ x

theorem nodeArm_agree (n : NodeH) (γ : Cluster) (x x' : CrashNames) :
    ⊢ nodeArm (GF := GF) n γ x -∗ nodeArm n γ x' -∗ ⌜x = x'⌝ := by
  unfold nodeArm; exact ApiImpl.nodeArmU_agree n γ x x'

/-- (2026-11-24, the lifetime law: `notes/etcd-dist-d6.md`, T4 round 5) **The node at `n` was started
at term `T0`** (persistent, sealed): the stored term `RestartNode` read (`σ.hs.Term`, its durable
state's term). Every `MsgSnap` a `Ready` of `n` hands out is at a term past it
(`readySnapSources_startTerm`): it was sent by `n` itself, a leader of a term `n` won after the
restart, not by an earlier run of the same id at a term it led before. One per node
(`nodeStartTerm_agree`). -/
@[no_expose] def nodeStartTerm (n : NodeH) (T0 : w64) : IProp GF :=
  iprop(⌜n.names.sn.t0 = T0⌝)

instance nodeStartTerm_persistent (n : NodeH) (T0 : w64) :
    Persistent (nodeStartTerm (GF := GF) n T0) := by
  unfold nodeStartTerm; infer_instance

theorem nodeStartTerm_agree (n : NodeH) (T0 T0' : w64) :
    ⊢ nodeStartTerm (GF := GF) n T0 -∗ nodeStartTerm n T0' -∗ ⌜T0 = T0'⌝ := by
  unfold nodeStartTerm
  iintro %H1 %H2
  ipureintro; rw [← H1, ← H2]

/-! ## The storage contract at the node API (U8 v2, 2026-10-29; candidate 17 rev 3 §2;
2026-11-01, durability stage I-4: keyed by the storage key `K`) -/

/-- **Compacting the storage of key `K` up to `k` is safe** (persistent, timeless; raft-issued): the
node on it applied at least `k` (`node.Advance`'s post), or handed out a snapshot at `k` or later
(a snapshot `Ready`, `readySnap`), or `k` is at most the applied index it was started at (the
attach, `restartStorage`). (2026-11-01, durability stage I-4: keyed by the storage, not the node's
id; `snapGiven` merged into it, raft's own reading `raftBnd` being that disjunction.) -/
@[no_expose] def nodeAppliedLb (γ : Cluster) (K : GName) (k : Nat) : IProp GF :=
  ApiImpl.nodeAppliedLbU γ K k

end api

section apiHeap
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [StorageModel GF]
variable [sem : go.Semantics]
variable [package_sem : go_etcd_io.raft.v3.Assumptions]
/-- **The node on the storage of key `K` has committed at least `i`** (persistent, timeless;
raft-issued; until 2026-11-01 the open `storDL γ id i`, "delivered to some node of `id`"): the
committed log's terms up to `i` are certified for the storage. Given at the attach (at the stored
commit), by the `Ready` loop (`nodeDriver_nodeCommitLb`) and at a snapshot `Ready`
(`readySnap`). -/
@[no_expose] def nodeCommitLb (γ : Cluster) (K : GName) (i : Nat) : IProp GF :=
  ApiImpl.nodeCommitLbU γ K i

end apiHeap

section api
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [AllG GF] [ReceiptGS GF] [InvGS GF]
instance nodeAppliedLb_persistent (γ : Cluster) (K : GName) (k : Nat) :
    Persistent (nodeAppliedLb (GF := GF) γ K k) := by
  unfold nodeAppliedLb; exact ApiImpl.nodeAppliedLbU_persistent γ K k

instance nodeAppliedLb_timeless (γ : Cluster) (K : GName) (k : Nat) :
    Timeless (nodeAppliedLb (GF := GF) γ K k) := by
  unfold nodeAppliedLb; exact ApiImpl.nodeAppliedLbU_timeless γ K k

end api

