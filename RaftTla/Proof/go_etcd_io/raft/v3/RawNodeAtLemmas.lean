    iintro #Hd
    ihave Hrecs : logRecs (GF := GF) γ base0 ([] : List EntryM) $$ []
    · unfold logRecs; iempintro
    ihave %Hf := Hd $$ %(Or.inl Hsn) %([] : List EntryM) %(Hprev ▸ FullOk_base0) Hrecs
    ipureintro; intro _; simpa using Hf

