        · exfalso
          have := uint_Z_nonneg b.index'
          omega
      | self pv t =>
        iframe Hghost; ipureintro; intro _ _ _ _ h; cases h
      | applyAck ce =>
        iframe Hghost; ipureintro; intro _ _ _ _ h; cases h
    icases ownRaftPhysC_preFacts cf rnv.raft' id s1
        (RNMode.guard_of (fun h => Hpg1 fp (Hpvoff.1 h)) ca rs.cfg) $$ Hphys
      with ⟨%Hpf1, Hphys⟩
    icases ownRaftPhysC_logwf cf rnv.raft' id s1 $$ Hphys with ⟨%Hlw1, Hphys⟩
    -- A1 for the `MsgStorageApplyResp`, at the node's full log (dynamic mode)
    ihave Hres : (⌜∀ ce (m' : MessageM), p = .applyAck ce → m'.Type' = MsgStorageApplyResp →
        (rs.mode.toG ⟨ca, rs.cfg, fp, ds⟩).Pre m' ce s1⌝ ∗
        ownStepGhost γ (rs.mode.toG ⟨ca, rs.cfg, fp, ds⟩) cf id s1) $$ [Hghost]
    · cases hm : rs.mode with
      | static =>
        iframe Hghost
        ipureintro; intro _ _ _ _; trivial
      | dyn dec c0 h0 _ =>
        simp only [RNMode.toG]
        icases ownStepGhost_deliv γ dec c0 h0 ⟨ca, rs.cfg, fp, ds⟩ cf id s1 rs.delivered
          (by rw [Hdlen]; have := uint_Z_nonneg s.logst.applying; rw [← Hs1.1] at *; omega)
          $$ Hdeliv Hghost with ⟨%Hpre, Hghost⟩
        iframe Hghost
        ipureintro
        intro ce m' hp hty
        subst hp
        refine ⟨by have H := Hpf1.1; rw [hm] at H; exact H,
          fun _ e He => ?_,
          fun h => absurd (hty.symm.trans h) (by simp [MsgStorageApplyResp, MsgProp])⟩
        have He' := (Hpok e He).2
        rw [Hs1.1] at He'
        have HA := Ha1 _ _ _ _ hm
        refine (HA.mono Hca.1 ?_).prefix Hpre ?_
        · have := uint_nat_eq e.Index'; rw [Hdlen]; omega
        · have := uint_nat_eq e.Index'; rw [Hdlen]; omega
    icases Hres with ⟨%Hpre1, Hghost⟩
    -- (#33 S4) the scope's facts at `s1`, for the protocol reading of the step
    icases pendingRel_pure γ id rs.bw st p $$ Hpm with ⟨%Hpst, Hpm⟩
    icases ownRaftPhysC_precand cf rnv.raft' id s1 $$ Hphys with ⟨%Hpc1, Hphys⟩
    icases ownRaftPhysC_trkDoms cf rnv.raft' id s1 $$ Hphys with ⟨%Hdom1, Hphys⟩
    icases ownStepGhost_followerVotes γ _ cf id s1 $$ Hghost with ⟨%Hfv1, Hghost⟩
    icases ownRaftPhysC_cq cf rnv.raft' id s1 $$ Hphys with ⟨#Hcqs1, Hphys⟩
    icombine Hcq0 Hcqs1 gives %Hcqe1
    have Hcq1 : s1.cq = s.cq := by first | exact Hcqe1.symm | exact Hcqe1
    icases ownRaftPhysC_sdr cf rnv.raft' id s1 $$ Hphys with ⟨#Hsds1, Hphys⟩
    icombine Hsd0 Hsds1 gives %Hsde1
    have Hsd1e : s1.sdr = s.sdr := by first | exact Hsde1.symm | exact Hsde1
    have Hkt1 : KTie rs s1 := by
      unfold KTie at Hkt ⊢; rw [Hsg1.2.1, Hcq1, Hsd1e]; exact Hkt
    have Hlift1 : LiftScopeK rs.k cf id s1 :=
      liftScopeK_of hmd.2.1 Hsc1.1 Hcin Hkt1 HC Hpc1 Hfv1 Hdom1.1 Hdom1.2
    have hq1 := preCand_noQuorum_of hmd.2.1 Hsc1.1 Hcfe Hpc1
    ihave #Hcap1 : storCapF s1.logst.storage 0 $$ []
    · rw [Hsg1.1]; iexact Hcap
