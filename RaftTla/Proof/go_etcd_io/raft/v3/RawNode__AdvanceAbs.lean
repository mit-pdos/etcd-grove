/-- **One queued step at the protocol level** (antithesis parity B1, step C3: at the node's flags,
`LiftScopeK`, a pre-candidate's tally not a quorum): a self-addressed response (an append, vote or
pre-vote response) is `RecvEndR` at the node's configuration, `applied` frozen; a storage
acknowledgement keeps the loop's reading (`advR_ack`). Both keep the read-index requests and an empty
read-only queue, give the role facts (`RoleFn`), and keep, clear or take as the node itself the
protocol leader. -/
theorem advStep_pure {cf : CfgM} {rs : RNState} {fp : List EntryM} {a : w64} {id : w64}
    {s1 s2 : NState} {st : MsgSt} {p : Pending}
    (Hcfe : rs.cfg.cfg = cf) (Hl : LiftScopeK k cf id s1)
    (hq : s1.role = .preCandidate → ¬ JQuorum cf (granted s1.votes)) (Hpst : pendSt id st p)
    (Hend : StepEnd cf id st.msg st.ents st.ctx s1 s2) (Hack : AckEnd st.msg s1 s2)
    (Hns : NoSnapL s2.outbox) (Hsn : s2.logst.snap = s1.logst.snap)
    (Hpv : s2.logst.prev = s1.logst.prev)
    (Hrl : s2.role = .preCandidate → s1.role = .preCandidate) :
    (∀ (Adm : List EntryM → CCState → Prop) (dec : CCDec) rest re,
      AdvanceEndRNoSnap Adm dec k id (advR rs fp a s2) rest re →
      AdvanceEndRNoSnap Adm dec k id (advR rs fp a s1) (advHead st p ++ rest) re) ∧
    (s1.rd.pend = [] → (toPState s1).rd.ro.pending = [] →
      s2.rd.pend = s1.rd.pend ∧ (toPState s2).rd.ro.pending = []) ∧
    RoleFn cf id s1 s2 ∧
    ((toPState s2).lead = (toPState s1).lead ∨ (toPState s2).lead = W64 0 ∨
      ((toPState s2).lead = id ∧ (toPState s2).role = .leader)) := by
  cases p with
  | self pv t =>
    obtain ⟨⟨Hty, Hfrid, -, Hnz, -, Hcx, -⟩, -, -⟩ := Hpst
    have hnk : st.msg.Type' ∈ netTypesK := by
      rcases Hty with h | h | h <;> rw [h] <;> simp [netTypesK]
    obtain ⟨ty, hty, hq', hnp, hresp⟩ : ∃ ty, mtypeOf st.msg.Type' = some ty ∧
        absMsgOf st = some (absMsg ty st.msg st.ents st.ctx) ∧ ty ≠ .propose ∧
        (ty = .appResp ∨ ty = .voteResp ∨ ty = .preVoteResp) := by
      rcases Hty with h | h | h
      · exact ⟨.appResp, by rw [h]; rfl, by unfold absMsgOf; rw [h]; rfl, (fun h => by cases h), .inl rfl⟩
      · exact ⟨.voteResp, by rw [h]; rfl, by unfold absMsgOf; rw [h]; rfl, (fun h => by cases h),
          .inr (.inl rfl)⟩
      · exact ⟨.preVoteResp, by rw [h]; rfl, by unfold absMsgOf; rw [h]; rfl, (fun h => by cases h),
          .inr (.inr rfl)⟩
    have h0r : st.msg.Type' = MsgReadIndex → st.msg.Term' = W64 0 := fun e => by
      exfalso
      rcases Hty with h | h | h <;> rw [h] at e <;>
        simp [MsgAppResp, MsgVoteResp, MsgPreVoteResp, MsgReadIndex] at e
    have HR := recvEnd_of_stepEnd_netK Hl hq hnk (fun _ => Hnz) h0r (noSnapSent_of_noSnapL Hns) Hend
      ty hty
    have HR' : RecvEnd k rs.cfg.cfg id (toPState s1) (absMsg ty st.msg st.ents st.ctx) (toPState s2) := by
      rw [Hcfe]; exact HR
    have Hbk : BkStep s1 s2 := (bkLog_of_stepEnd_netK Hl hnk Hns Hend).1
    have hresp' : (absMsg ty st.msg st.ents st.ctx).ty = .appResp ∨
        (absMsg ty st.msg st.ents st.ctx).ty = .voteResp ∨
        (absMsg ty st.msg st.ents st.ctx).ty = .preVoteResp := by rw [absMsg_ty]; exact hresp
    refine ⟨fun Adm dec rest re H => ?_, fun hpd hp => ?_, roleFn_of_stepEnd hnk Hl.2.2.2.2.2.2 Hns Hend,
      recvEnd_lead_resp hresp' HR⟩
    · simp only [advHead, hq', Option.toList_some, List.singleton_append]
      exact .cons _ _ _ _ _ (recvEndR_advR HR' Hbk Hsn Hpv (by rw [absMsg_ty]; exact hnp)) H
    · rw [← toPState_rd_pend s2, ← toPState_rd_pend s1]
      refine recvEnd_rd_nr (k := k) ?_ HR (by rw [toPState_rd_pend]; exact hpd) hp
      rw [absMsg_ty]
      rcases hresp with rfl | rfl | rfl <;> exact ⟨by decide, by decide, by decide, by decide⟩
  | appendAck t b e sn =>
    have Hst : st = ⟨appendAckM id t (e.getD (entryID.mk (W64 0) (W64 0))), [], sn, [], []⟩ := Hpst
    have Ha := Hack (by rw [Hst]; exact .inl rfl)
    refine ⟨fun Adm dec rest re H => ?_, fun _ hp => ⟨by rw [Ha.2.2.1], by rw [Ha.1]; exact hp⟩,
      roleFn_ack Ha Hrl, .inl (by rw [Ha.1])⟩
    simp only [advHead, List.nil_append]
    rw [← advR_ack Ha Hsn]; exact H
  | applyAck ce =>
    have Hst : st = ⟨applyAckM id, ce, none, [], []⟩ := Hpst
    have Ha := Hack (by rw [Hst]; exact .inr rfl)
    refine ⟨fun Adm dec rest re H => ?_, fun _ hp => ⟨by rw [Ha.2.2.1], by rw [Ha.1]; exact hp⟩,
      roleFn_ack Ha Hrl, .inl (by rw [Ha.1])⟩
    simp only [advHead, List.nil_append]
    rw [← advR_ack Ha Hsn]; exact H

/-- (antithesis parity B1, item 2b) A log at base `0` holding the committed log `D` handed out, read
entry by entry (`ownStepGhost_cmt_ents`), starts with it. -/
theorem AdvAbs.take_eq_of_ents {prev : entryID} {L D : List EntryM}
    (hp : uint.Z prev.index' = 0) (hlen : D.length ≤ L.length)
    (hent : ∀ k e, L[k]? = some e → uint.nat prev.index' + k < D.length →
      D[uint.nat prev.index' + k]? = some e) :
    L.take D.length = D := by
  have h0 : uint.nat prev.index' = 0 := by have := uint_nat_eq prev.index'; omega
  apply List.ext_getElem?
  intro k
  by_cases hk : k < D.length
  · rw [List.getElem?_take_of_lt hk]
    obtain ⟨e, he⟩ : ∃ e, L[k]? = some e := ⟨L[k]'(by omega), List.getElem?_eq_getElem _⟩
    have := hent k e he (by omega)
    rw [h0, Nat.zero_add] at this
    rw [he, this]
  · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by omega)]

/-- (antithesis parity B1, item 2b) No undecided conf entry in `[lo, hi)` depends only on the first
`hi` entries. -/
theorem AdvAbs.noUndec_of_take {dec : CCDec} {l l' : List EntryM} {lo hi : Nat}
    (h : l.take hi = l'.take hi) (H : NoUndecConfIn dec l lo hi) : NoUndecConfIn dec l' lo hi := by
  intro k e h1 h2 he hc
  have hk : l[k]? = l'[k]? := by
    rw [← List.getElem?_take_of_lt h2, h, List.getElem?_take_of_lt h2]
  have ht : l.take k = l'.take k := by
    have := congrArg (List.take k) h
    simpa [List.take_take, Nat.min_eq_left (Nat.le_of_lt h2)] using this
  rw [← ht]
  exact H k e h1 h2 (hk ▸ he) hc

/-- (antithesis parity B1, item 2b) A common prefix in front of two lists that agree on their first
`n` entries. -/
theorem AdvAbs.take_append_congr {fp a b : List EntryM} {n : Nat} (h : a.take n = b.take n) :
    (fp ++ a).take n = (fp ++ b).take n := by
  rw [List.take_append, List.take_append]
  congr 1
  have ha : a.take (n - fp.length) = (a.take n).take (n - fp.length) := by
    rw [List.take_take, Nat.min_eq_left (Nat.sub_le _ _)]
  have hb : b.take (n - fp.length) = (b.take n).take (n - fp.length) := by
    rw [List.take_take, Nat.min_eq_left (Nat.sub_le _ _)]
  rw [ha, hb, h]

/-- Outside the harness's scope: the old proof. -/
theorem RawNode.Advance.absProofOut (wp_raft_Step : raft.Step.spec (GF := GF) (hG := hG)) :
    RawNode.Advance.form (GF := GF) (hG := hG)
      (fun γ rn id rs ps qs ip => ownRawNodeAt (GF := GF) γ rn id rs ps qs ip none)
      (fun md => (none : Option RnMode) = some md) := by
  intro γ rn id rs ps qs ip rd H1 H2 H3 _
  wp_start_folded as H
  iNamed H
  ihave Hrn := ownRawNodeAt_ownRawNode γ rn id rs ps qs ip none $$ Hrn
  wp_apply RawNode.Advance.tracedSpec_proof wp_raft_Step γ rn id rs rd H1 H2 H3
    $$ [$Hrn $Hret $HA1 $Hbw] as %t %ca ⟨Hrn, %Ht1, %Ht2, %Hca, %Hca2⟩
  icases ownRawNode_at γ rn id (advRS rs t ca) $$ Hrn with ⟨%ps', %qs', %ip', Hrn⟩
  ihave Hrn := ownRawNodeAt_steps_nil γ rn id (advRS rs t ca) ps' qs' ip' none
    (by unfold advRS; split <;> rfl) $$ Hrn
  iapply HΦ $$ %t %ca %ps' %ip'
  iframe Hrn
  ipureintro
  exact ⟨Ht1, Ht2, Hca, Hca2, fun md h => by cases h⟩


set_option maxHeartbeats 2000000 in
/-- In the harness's scope `some md` (see the file header). (antithesis parity B1, step C3) At every
mode without snapshots, conf changes, forwarding or async writes: a queued pre-vote response (a
pre-candidate's self answer) is stepped as any self-addressed response (`advStep_pure`); the scope's
pre-candidate facts are kept by the storage acknowledgements (`AckEnd`'s leader and tally). -/
theorem RawNode.Advance.absProofIn (wp_raft_Step : raft.Step.spec (GF := GF) (hG := hG))
    (md : RnMode) (hmd : md.snapshots = false ∧ md.confChanges = false ∧ md.forwarding = false ∧
      md.async = false) :
    RawNode.Advance.form (GF := GF) (hG := hG)
      (fun γ rn id rs ps qs ip => ownRawNodeAt (GF := GF) γ rn id rs ps qs ip (some md))
      (fun md' => some md = some md') := by
  intro γ rn id rs ps qs ip rd Hunp0 Hunst0 _ _
  wp_start as H
  iNamed H
  iNamed Hrn
  have Htcb : uint.Z s.gh.tc < 2 ^ 64 := by word
  -- the scope's facts at the start state
  icases rnScopeAt_pureOpt (some md) rs s $$ Hsc with ⟨%Hscope0, Hsc⟩
  icases rnScopeAt_capOpt (sc := some md) rfl hmd.1 rs s $$ Hsc with ⟨#Hcap, Hsc⟩
  obtain ⟨Hscope, Hcin, Hkt, Hxs0⟩ := Hscope0 md rfl
  have Hsn5 := Hscope.2.2.2.2.1 hmd.1
  have hsl : rs.slent = none := Hsn5.1
  have HtrG : γ.reTrace = none := Hcin.2.2.1
  have HtrS : s.gh.tr = none := Hgtr.trans HtrG
  icases ownStepGhost_cfgScope γ rs fp _ cf id s $$ Hghost with ⟨%Hcfm, Hghost⟩
  obtain ⟨HC, HCl, Hcfe⟩ := cfgScope_ofMd hmd.2.1 Hscope Hcin Hcfm
  icases ownRaftPhysC_ackScope cf rnv.raft' id s $$ Hphys with ⟨%Hal0, Hphys⟩
  have Hal : AckScope cf := Hal0 HC.2.1
  icases ownRaftPhysC_cq cf rnv.raft' id s $$ Hphys with ⟨#Hcq0, Hphys⟩
  icases ownRaftPhysC_sdr cf rnv.raft' id s $$ Hphys with ⟨#Hsd0, Hphys⟩
  icases ownRaftPhysC_ipFacts cf rnv.raft' id s $$ Hphys with ⟨%Hipf, Hphys⟩
  have Hprev0 : uint.Z s.logst.prev.index' = 0 := by rw [Hsn5.2.1]; rfl
  have Hsnn : s.logst.snap = none := Hsn5.2.2.1
  -- the storage holds the whole log when the boundary is at the log's end
  have Hst0 : ip = ps.p.log.length → s.logst.stored = s.logst.sents ++ s.logst.uents := by
    intro hl
    apply Hipf.2 Hsnn
    rw [← Hps] at hl
    simp only [toRState_p, toPState, List.length_append] at hl
    have := uint_nat_eq s.logst.inprogress
    rw [Hprev0]; omega
  -- no snapshot `Ready`: the queue holds no snapshot acknowledgement
  have Hunp' : s.logst.unpersisted = [] := Hunp ▸ Hunp0 hsl
  icases ownRaftPhysC_sn cf rnv.raft' id s $$ Hphys with ⟨%Hsn0, Hphys⟩
  -- (antithesis parity B1, item 2b) the log starts with the committed log handed out
  icases ownRaftPhysC_logwf cf rnv.raft' id s $$ Hphys with ⟨%Hlw0, Hphys⟩
  icases ownRaftPhysC_commitLe cf rnv.raft' id s $$ Hphys with ⟨%Hcm0, Hphys⟩
  icases ownStepGhost_cmt_ents γ _ cf id s rs.delivered
    (by rw [Hdlen]; have := uint_Z_nonneg s.logst.applying; omega) $$ Hdeliv Hghost
    with ⟨%Hen0, Hghost⟩
  have Htk0 : (s.logst.sents ++ s.logst.uents).take rs.delivered.length = rs.delivered :=
    AdvAbs.take_eq_of_ents (prev := s.logst.prev) Hprev0
      (by simp only [List.length_append]; rw [Hdlen]; have := uint_Z_nonneg s.logst.applying; omega)
      Hen0
  ihave #HA1n := HA1 $$ %hsl
  iunfold undecFree at HA1n
  icases HA1n with ⟨%Ma, #HMa, %HMa⟩
  icases ownStepGhost_absorbM γ rs.mode ⟨rs.capplied, rs.cfg, fp, ds⟩ cf id s Ma
    $$ [$HMa $Hghost] with ⟨%Hsuba, Hghost⟩
  have Ha1 : ∀ dec c0 h0 h1, rs.mode = .dyn dec c0 h0 h1 →
      NoUndecConfIn (effDec dec (ds ∪ Ma)) rs.delivered rs.capplied rs.delivered.length := by
    intro dec c0 h0 h1 hm
    rcases Hsuba with h | h
    · exact (HMa dec c0 h0 h1 hm).mono_dec (effDec_mono dec h)
    · rw [hm] at h; cases h
  generalize ds ∪ Ma = ds at Ha1 ⊢
  ihave Hpend := pendAt_none_elim γ id rs.bw hsl steps rs.steps qs $$ Hpend
  icases Hpend with ⟨%sts, %Hpa, Hpend⟩
  iclear Hret
  wp_auto
  rw [Hasync]
  wp_auto
  ihave %Hlen0 := BigSepL2.bigSepL2_length $$ Hpend
  have Hlen : steps.length = rs.steps.length := by
    rw [Hlen0, List.length_zip, Hpa.1, Nat.min_self]
  ihave %Hsl := ownSlice_len _ _ _ $$ Hsteps
  rename_i ibp
  irename: (ibp ↦ (_ : w64)) => ib
  ihave IH : iprop(∃ (n : w64) (s1 : NState) (steps1 : List Loc)
        (mv : Loc) (iv : w64) (ca : Nat),
      "i" ∷ i_ptr ↦ n ∗ "m" ∷ m_ptr ↦ mv ∗ "ib" ∷ ibp ↦ iv ∗
      "Hphys" ∷ ownRaftPhysCV cf cf.voters rnv.raft' id s1 ∗
      "Hghost" ∷ ownStepGhost γ (rs.mode.toG ⟨ca, rs.cfg, fp, ds⟩) cf id s1 ∗
      "Hsteps" ∷ rnv.stepsOnAdvance' ↦* steps1 ∗
      "%Hn" ∷ ⌜0 ≤ sint.Z n ∧ sint.Z n ≤ (steps.length : Int)⌝ ∗
      "%Hsteps1" ∷ ⌜steps1.length = steps.length ∧
                    steps1.drop (sint.nat n) = steps.drop (sint.nat n)⌝ ∗
      "%Hwf1" ∷ ⌜NStateWf s1⌝ ∗
      "%Hs1" ∷ ⌜s1.logst.applying = s.logst.applying ∧
                s1.logst.unpersisted = s.logst.unpersisted ∧ s1.logst.snap = s.logst.snap ∧
                s1.logst.prev = s.logst.prev ∧ logStoreRec s1.logst = logStoreRec s.logst⌝ ∗
      "%Hsg1" ∷ ⌜s1.logst.storage = s.logst.storage ∧ s1.prevote = s.prevote ∧ s1.gh = s.gh⌝ ∗
      "%Hc1" ∷ ⌜uint.Z s.logst.committed ≤ uint.Z s1.logst.committed⌝ ∗
      "%Hq1" ∷ ⌜SnapQueueStep (toPState s) (toPState s1)⌝ ∗
      "%Hph1" ∷ ⌜HsLe (hsOf s) (hsOf s1) ∧ uint.Z s.logst.inprogress ≤ uint.Z s1.logst.inprogress⌝ ∗
      "%Hca" ∷ ⌜rs.capplied ≤ ca ∧ ca ≤ max rs.capplied rs.delivered.length ∧
                (rs.mode = .static → ca = rs.capplied)⌝ ∗
      "%Hok1" ∷ ⌜StepsOk s1 (rs.steps.drop (sint.nat n))⌝ ∗
      "%Hsb1" ∷ ⌜AdvAbs.SelfBound s (rs.steps.drop (sint.nat n))⌝ ∗
      "%Hti1" ∷ ⌜AdvAbs.TermInv s s1 (rs.steps.drop (sint.nat n))⌝ ∗
      "%Hfl1" ∷ ⌜s1.logst.fl = s.logst.fl ∧ uint.Z s.logst.applied ≤ uint.Z s1.logst.applied ∧
        (uint.Z s1.logst.applied < uint.Z s.logst.applying →
          ∃ ce e, Pending.applyAck ce ∈ rs.steps.drop (sint.nat n) ∧ ce.getLast? = some e ∧
            uint.Z s.logst.applying ≤ uint.Z e.Index')⌝ ∗
      "%Hpg1" ∷ ⌜∀ fp, PreGuardF fp s → PreGuardF fp s1⌝ ∗
      "%Hsf1" ∷ ⌜SnapFol s1⌝ ∗
      -- (#33 S4) the protocol messages still to step, a suffix of `qs`, and the prefix stepped
      -- (antithesis parity B1 stage 3b) over `RState`, `applied` frozen at the start's (`advR`)
      "%Hae1" ∷ ⌜advQ (sts.drop (sint.nat n)) (rs.steps.drop (sint.nat n)) <:+ qs ∧
        ∀ (Adm : List EntryM → CCState → Prop) (dec : CCDec) re,
          AdvanceEndRNoSnap Adm dec rs.k id (advR rs fp s.logst.applied s1)
            (advQ (sts.drop (sint.nat n)) (rs.steps.drop (sint.nat n))) re →
          AdvanceEndRNoSnap Adm dec rs.k id ps qs re⌝ ∗
      -- (#33 S4) the scope at the current state; (antithesis parity B1, step C3) at the mode `md`, with
      -- the transfer facts
      "%Hsc1" ∷ ⌜RnScope md id rs s1 ∧ (md.transfer = true → XScopeOk γ md s1)⌝ ∗
      "Hpend" ∷ ([∗list] l;x ∈ steps.drop (sint.nat n);(sts.drop (sint.nat n)).zip
          (rs.steps.drop (sint.nat n)),
        msgIn l DFrac.discard x.1 ∗ pendingRel γ id rs.bw x.1 x.2))
    $$ [i m ib Hphys Hghost Hsteps Hpend]
  · iexists W64 0, s, steps, null, zero_val w64, rs.capplied
    have H0 : sint.nat (W64 0) = 0 := rfl
    rw [H0, List.drop_zero, List.drop_zero, List.drop_zero]
    simp only [named]
    iframe
    ipureintro
    refine ⟨by word, ⟨trivial, trivial⟩, Hwf, by simp, ⟨trivial, trivial, trivial⟩, Int.le_refl _, (fun _ h _ => .inl h),
      ⟨HsLe.refl _, Int.le_refl _⟩,
      (by simp [Nat.le_max_left]),
      Hstok,
      AdvAbs.stepsOk_selfBound s rs.steps Hstok, ⟨Int.le_refl _, by omega, fun _ _ => rfl,
      Hpvoff.2.2.1, Hpvoff.2.2.2.1⟩, ?_, fun _ h => h, Hpvoff.2.2.2.2,
      ⟨by rw [← pendAbs_advQ Hpa]; exact List.suffix_refl _,
        fun Adm dec re h => by rw [← Hps, pendAbs_advQ Hpa]; exact h⟩, Hscope, Hxs0⟩
    exact ⟨trivial, Int.le_refl _, Hrnfl.2⟩
  wp_for IH
  wp_if_destruct
  · have Hlt : sint.Z n < sint.Z rnv.stepsOnAdvance'.len := by
      first | exact Hif | exact of_decide_eq_true (GoGlobalContext.intoVal_inj_bool Hif)
    clear Hif
    -- the next pending message
    list_elem steps (sint.nat n) as mm
    list_elem rs.steps (sint.nat n) as p
    have Hnst : sint.nat n < sts.length := by
      have := (List.getElem?_eq_some_iff.1 Hp_lookup).1; rw [Hpa.1]; exact this
    have Hst_lookup : sts[sint.nat n]? = some sts[sint.nat n] := List.getElem?_eq_getElem Hnst
    generalize sts[sint.nat n] = st at Hst_lookup
    -- no snapshot handed out, so no snapshot acknowledgement queued
    have Hnoack : ∀ t b e sn, p = .appendAck t b e sn → sn = none := by
      intro t b e sn hp
      cases sn with
      | none => rfl
      | some sv =>
        exfalso
        exact (Hloan.none_noack hsl).2 t b e sv (hp ▸ List.mem_of_getElem? Hp_lookup)
    have Hpmem : p ∈ rs.steps := List.mem_of_getElem? Hp_lookup
    have Hmm1 : steps1[sint.nat n]? = some mm := by
      have H := congrArg (fun l => l[0]?) Hsteps1.2
      simp only [List.getElem?_drop, Nat.add_zero] at H
      rw [H]; exact Hmm_lookup
    rw [ite_eq_left_of_eq_true _ _ (eq_true ⟨Hn.1, Hlt⟩)]
    wp_apply (lc := 1) wp_load_slice_index rnv.stepsOnAdvance' (sint.Z n) steps1 (DFrac.own 1) mm Hn.1
      $$ [Hsteps] with Hsteps
    · iframe
      ipureintro
      exact Hmm1
    rw [AdvAbs.drop_cons_of_lookup Hp_lookup] at Hok1 Hsb1 Hti1 Hfl1 Hae1
    rw [AdvAbs.drop_cons_of_lookup Hst_lookup, advQ_cons] at Hae1
    rw [AdvAbs.drop_cons_of_lookup Hmm_lookup, AdvAbs.drop_cons_of_lookup Hp_lookup,
      AdvAbs.drop_cons_of_lookup Hst_lookup, List.zip_cons_cons]
    icases (BigSepL2.bigSepL2_cons (Φ := fun _ l (x : MsgSt × Pending) =>
        iprop(msgIn (GF := GF) l DFrac.discard x.1 ∗ pendingRel γ id rs.bw x.1 x.2))).1 $$ Hpend
      with ⟨⟨Hmin, Hpm⟩, Hpend⟩
    have HnS : sint.nat n + 1 = sint.nat (n + W64 1) := by word
    rw [HnS] at Hok1 Hsb1 Hti1 Hfl1 Hae1 ⊢
    obtain ⟨Hpok, Hrest⟩ := stepsOk_cons _ _ _ Hok1
    have Hnw1 : ∀ pv t, p = .self pv t → s1.role = .preCandidate →
        uint.Z s1.term + 1 < 2 ^ 64 := by
      intro pv t _ hr
      have := Hti1.2.2.2.2 hr
      omega
    -- the acknowledgement's `StableOk`: no restore since the `Ready` (the boundary at `0`)
    ihave ⟨%Hack, Hghost⟩ : ⌜∀ t b e sn, p = .appendAck t b e sn → sn = none ∧
        ∀ x, e = some x → (t = W64 0 ∨ t = s1.term) → StableOk s1.logst x⌝ ∗
        ownStepGhost γ (rs.mode.toG ⟨ca, rs.cfg, fp, ds⟩) cf id s1 $$ [Hghost]
    · cases hp : p with
      | appendAck t b e sn =>
        have Hmem : Pending.appendAck t b e sn ∈ rs.steps := hp ▸ Hpmem
        have Hsn0 := Hnoack t b e sn hp
        subst Hsn0
        rw [hp] at Hpok
        icases Hstrecs $$ %t %b %e %none %Hmem with ⟨#Hr0, #Harm⟩
        iunfold ownStepGhost at Hghost
        icases Hghost with ⟨Hg, Hgr⟩
        unfold ackArm
        icases Harm with (⟨%Hp, -⟩ | ⟨%Hbp, -⟩)
        · obtain ⟨Hpb, Hsnn'⟩ := Hp
          ihave #Hr1 : storedRecs γ s1.logst.prev s1.logst.stored $$ []
          · rw [Hs1.2.2.2.1, logStoreRec_stored Hs1.2.2.2.2, Hpb]; iexact Hr0
          icases stableOk_of_stored γ id s1 _ rfl (by rw [Hs1.2.2.1]; exact Hsnn')
              (Hs1.2.1.trans Hunp') $$ Hr1 Hg with ⟨%Hsok, Hg⟩
          ihave Hghost : ownStepGhost γ (rs.mode.toG ⟨ca, rs.cfg, fp, ds⟩) cf id s1 $$ [Hg Hgr]
          · iunfold ownStepGhost; iframe Hg Hgr
          iframe Hghost
          ipureintro
          intro t' b' e' sn' h
          cases h
          refine ⟨rfl, fun x hx _ => ?_⟩
          rw [← (Hpok.2 x hx).1, ← Hpb, ← Hs1.2.2.2.1]
