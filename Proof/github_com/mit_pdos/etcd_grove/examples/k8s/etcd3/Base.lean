/-
Lean-first (no Rocq counterpart).

The driver's package `k8setcd3` (`examples/k8s/etcd3`, phase 6 of `notes/k8s-etcd3-plan.md`): its
package fact `drvInit`. Its error variables (`errNotObj`, `errBadData`, `errBadRV`,
`errDeleteRejected`, `errUpdateRejected`: translated `errors.New` calls) each hold a fixed non-nil
error whose `Error()` returns a string (`errorStringSpec`) and whose `errorString` holds its
message, read-only (its cell, `errStrCell_of_struct`, D19k: what tells the callbacks' sentinels
apart from the client's errors; the whole struct since k8s 7g, for `reflect.DeepEqual`'s view
`k8sDeep.DeepV.errString`). Its
initializer allocates them and initializes its imports, among them the etcd3 store's packages, `etcdserver` and `v3rpc`,
`cluster3`, `lintest` and `porcupine` (its `Init.lean`, to be generated by `etc/gen-init.py`, stage 6g).
-/
module

public import GeneratedProof.github_com.mit_pdos.etcd_grove.examples.k8s.etcd3
public import Proof.k8s_io.apiserver.pkg.storage.etcd3.Base
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.api.v3rpc.Base
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.apply.Base
public import Proof.go_etcd_io.etcd.cache.v3.Base
public import Proof.errors.NewVarCell
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Base
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.Base
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.lintest.Base
public import Proof.github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.correctness.Base

@[expose] public section

noncomputable section

namespace Perennial
namespace github_com.mit_pdos.etcd_grove.examples.k8s.etcd3

open Iris Iris.BI Iris.ProgramLogic Iris.Std

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- The error variable `x` holds a fixed `*errorString` (what `errors.New(msg)` returns:
`errors.newVar`) whose `Error()` returns a string and which holds `msg`, read-only. -/
abbrev errVarOk (x msg : GoString) : IProp GF :=
  iprop(∃ l : Loc,
    globalAddr x ↦□ interface.mkOk (go.GoType.PointerType _root_.Perennial.errors.errorString.ty) #l ∗
    _root_.Perennial.go_etcd_io.etcd.cache.v3.errorStringSpec
      ⟨go.GoType.PointerType _root_.Perennial.errors.errorString.ty, #l⟩ ∗
    l ↦□ _root_.Perennial.errors.errorString.mk msg)

/-- **The driver package's fact** (see the file header). -/
abbrev drvInit : IProp GF :=
  iprop(errVarOk errNotObj go!"k8setcd3: not an *Obj" ∗
    errVarOk errBadData go!"k8setcd3: data does not decode" ∗
    errVarOk errBadRV go!"k8setcd3: resource version does not parse" ∗
    errVarOk errDeleteRejected go!"k8setcd3: deletion rejected" ∗
    errVarOk errUpdateRejected go!"k8setcd3: update rejected")

instance isPkgInit_inst [EtcdGrove.k8s.CompactorRegistry] :
    IsPkgInit (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.k8s.etcd3 :=
  define_is_pkg_init drvInit
instance get_isPkgInit_wf_inst [EtcdGrove.k8s.CompactorRegistry] [EtcdGrove.prometheus.PromRegGS GF] :
    GetIsPkgInitWf (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.k8s.etcd3 :=
  build_get_is_pkg_init_wf

end init

section errstr
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]

open Iris.ProofMode in
/-- An `errorString` read-only gives its cell. -/
theorem errStrCell_of_struct (x : Loc) (msg : GoString) :
    (x ↦□ _root_.Perennial.errors.errorString.mk msg : IProp GF) ⊢ EtcdGrove.errStrCell x msg := by
  iintro #Hx
  iStructNamed Hx
  unfold EtcdGrove.errStrCell
  iexact s

variable [errors_sem : _root_.Perennial.errors.Assumptions]

open Iris.ProgramLogic Iris.Std Iris.ProofMode in
/-- **`errors.New(msg)`, its `errorString` read-only** (`EtcdGrove.wp_New_errorString_cell`'s
proof, keeping the whole struct). -/
theorem wp_New_errorString_struct (msg : GoString) :
    {{ (True : IProp GF) }}
      (App (Val (@! _root_.Perennial.errors.New)) (Val #msg))
    {{ (x : Loc), RET #(interface.mkOk (go.GoType.PointerType _root_.Perennial.errors.errorString.ty) #x);
        (□ ∀ Φ : val → IProp GF, ▷ Φ #msg -∗
          WP (App (Val #(methods (go.GoType.PointerType _root_.Perennial.errors.errorString.ty)
            go!"Error" #x)) (Val #())) {{ Φ }}) ∗
        x ↦□ _root_.Perennial.errors.errorString.mk msg }} := by
  wp_start
  wp_auto
  wp_alloc x as Hx
  ipersist Hx
  wp_auto
  iapply HΦ
  isplitl
  · imodintro
    iintro %Φ HΦ
    rw [method_unfold]
    wp_auto
    iStructNamed Hx
    wp_auto
    iexact HΦ
  · iexact Hx

end errstr

end github_com.mit_pdos.etcd_grove.examples.k8s.etcd3
end Perennial
