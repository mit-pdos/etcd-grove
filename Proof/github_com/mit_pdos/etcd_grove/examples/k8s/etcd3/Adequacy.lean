/-! ## The ghost-state bundle -/

/-- The functors: putget's (`putgetGF`: the universal camera `AllG` at slot 0, then invariants,
later credits, GooseLang's heap, prophecies and package state), and
iris-lean's non-atomic invariants at slot 11 (as the counter's `counterGF`). Every other slot is
the unit functor. -/
def k8setcd3GF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | 11 => ⟨NaInvF, inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def k8setcd3GF_allG : AllG k8setcd3GF := ⟨⟨0, rfl⟩⟩

instance k8setcd3GF_gooseGpreS : GooseGpreS k8setcd3GF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGExts := (⟨k8setcd3GF_allG⟩, PUnit.unit)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := k8setcd3GF_allG

/-- iris-lean's camera of non-atomic invariants, at slot 11: the instance porcupine's results
take. -/
instance k8setcd3GF_naInvG : NaInvG k8setcd3GF := ⟨⟨11, rfl⟩⟩

/-- **A ghost-state instance at the local context `lctx`** (as putget's `heapAt`). -/
abbrev k8setcd3HeapAt (hG : HeapGS .hasLC k8setcd3GF) (lctx : GoLocalContext) : HeapGS .hasLC k8setcd3GF :=
  ⟨hG.goose_globalGS, { hG.goose_localGS with goose_go_local_context := lctx }⟩

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `k8setcd3`'s initialization, then `Main(clients, ops)`. -/
def k8setcd3Program [GoSemanticsFunctions] (clients ops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.Main) #clients #ops

/-- The read package's two metric names, which `k8setcd3`'s initialization registers (`readRegPerm`,
D16). -/
def k8setcd3Names : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The Kubernetes etcd3 store's linearizability instance is safe** (see the file header): every real execution of
`k8setcd3Program clients ops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok` (porcupine found the history linearizable) or `Unknown` (a step before
the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem k8s_etcd3_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [k8s_io.apiserver.pkg.storage.etcd3.Assumptions] [k8s_io.apimachinery.pkg.runtime.Assumptions]
    [k8s_io.apimachinery.pkg.runtime.schema.Assumptions] [k8s_io.apiserver.pkg.storage.Assumptions]
    [k8s_io.apiserver.pkg.storage.value.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC k8setcd3GF, ContextReadErrs (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx))
    (id : w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hbf : etcd_putget.BootFacts id ctxs boot)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (HNs : prometheus.namesUnclaimed (k8setcd3Program clients ops) k8setcd3Names)
    (HAs : addrsUnclaimed (k8setcd3Program clients ops) [go!"127.0.0.1:23896"])
    -- (2026-11-03, the WAL's API, change 6; sweep repairs 1, W3/W4) the member's data directory, fresh at start (`dataDirsAbsent`)
    (HDs : dataDirsAbsent (k8setcd3Program clients ops) [go!"k8setcd3.etcd"])
    -- (sweep repairs 1, B4) `ETCD_VERIFY` off for the run
    (HEnv : verifyEnvOff (k8setcd3Program clients ops))
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC k8setcd3GF,
      ⊢ k8s_etcd3.premises (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx) n id ctxs boot)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([k8setcd3Program clients ops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  suffices H : (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
      (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧ (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) by
    refine ⟨H.1, H.2.1, fun v hv => ?_⟩
    cases h : v.isPanic
    · rfl
    · obtain ⟨p, rfl⟩ := val.isPanic_eq_true h
      exact absurd (UnrecoveredPanic.panic p) (H.2.2 _ hv)
  refine goose_adequacy_start (GF := k8setcd3GF) (hAsLit := by decide) (hEnv := HEnv) (n + 1) (max (n + 2) srvLevelK) (k8setcd3Program clients ops) σ g
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown"))
    (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) ⟨trivial, trivial⟩ ⟨trivial, trivial⟩
    k8setcd3Names [go!"127.0.0.1:23896"] [go!"k8setcd3.etcd"] (by decide) (by decide)
    (List.nodup_cons.2 ⟨List.not_mem_nil, List.nodup_nil⟩) HNs HAs HDs ?_
    n κs t2 σ2 Hsteps (Nat.lt_succ_self n) Hthreads
    (realThreadsBelow_mono (Nat.le_max_left _ _) (realThreadsBelow_of_one Hthreads))
  intro hG HN HT HL
  have Hprem0 := Hprem hG
  have Hctx0 := Hctx hG
  obtain ⟨G, ⟨fl, lc, nh, gs, th, cr⟩⟩ := hG
  subst Hlctx
  subst HL
  letI : HeapGS .hasLC k8setcd3GF := ⟨G, ⟨fl, σ.goState.goLctx, nh, gs, th, cr⟩⟩
  -- (Q1 (c), 2026-11-05) the compactor registry's name (`etcd3`'s package fact): the program
  -- registers no compactor (`StartCompactorPerEndpoint` is not called), so any name will do
  letI : EtcdGrove.k8s.CompactorRegistry := ⟨0⟩
  haveI := Hctx0
  unfold IsInit at Hinit
  rw [Hinit]
  iintro _ _ Hgs Htok Hrights
  ihave Hown : ownInitializing
      (github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.getIsPkgInit (GF := k8setcd3GF)) $$ [Hgs]
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    imodintro
    iapply BigSepM.bigSepM_empty.2
    itrivial
  iunfold startRights at Hrights
  icases Hrights with ⟨Hns, Hrs⟩
  -- (hub step 7) the one member's start bundle: its client address, its data directory
  ihave Hms := etcdstart.memberStartRes_intro [(go!"k8setcd3", ⟨none, some go!"127.0.0.1:23896"⟩)] []
    [go!"127.0.0.1:23896"] [go!"k8setcd3.etcd"] (List.Perm.refl _)
    (List.Perm.refl _) $$ Hrs
  simp only [k8setcd3Names, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Hns with ⟨Hn1, Hn2, -⟩
  icases Hms with ⟨⟨Hstart, -⟩, -⟩
  ihave #Hprem' := Hprem0
  imodintro
  unfold k8setcd3Program
  wp_apply (github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.wp_initialize' _
      github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.getIsPkgInit_wf) $$ [Hown Hn1 Hn2]
    as ⟨_, #Hinit⟩
  · iframe Hown
    iunfold read.readRegPerm
    iframe
  have hM := k8s_etcd3.wp_Main (GF := k8setcd3GF) n id ctxs boot clients ops Hbf
    (by rw [HT]; word) (srvLevels_of_max HT) (by rw [HN]; omega) (by rw [HN]; omega) (by unfold bootWB backend.wbInit; omega) Hck Haf Hbuq Hrf Hdbo inferInstance EtcdGrove.rpctypesEtcdError_asTarget
    k8s_etcd3.storageErrTyOk_holds k8s_etcd3.objTyOk_holds Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Hstart Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl


