    (Val #(W64 (k : Int)))) (Val #clients)) (Val #ops)) (Val #watchers)) (Val #wops)) (schedLit steps)

/-- **The Kubernetes etcd3 store's linearizability instance over `k` members under any partition
schedule is safe** (see the file header): `k8s_etcd3_cluster_adequate`'s conclusion for every real
execution of `k8setcd3PProgram k clients ops watchers wops steps`, for every `1 ≤ k ≤ 1000` and every schedule
`steps` (of fewer than `2 ^ 63` steps). -/
theorem k8s_etcd3_partition_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [k8s_io.apiserver.pkg.storage.etcd3.Assumptions] [k8s_io.apimachinery.pkg.runtime.Assumptions]
    [k8s_io.apimachinery.pkg.runtime.schema.Assumptions] [k8s_io.apiserver.pkg.storage.Assumptions]
    [k8s_io.apiserver.pkg.storage.value.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC k8setcd3GF, ContextReadErrs (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC k8setcd3GF, ContextErrsClient (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx))
    (k : Nat) (hk1 : 1 ≤ k) (hk : k ≤ 1000)
    (ids : List w64) (ps : List w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hlen : ids.length = k) (Hbf : k8s_etcd3N.BootFacts ids ps ctxs boot)
    (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    (clients ops watchers wops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hw0 : 0 ≤ sint.Z watchers) (Hc31 : sint.Z clients + sint.Z watchers < 2 ^ 31)
    (Hops : 0 ≤ sint.Z ops) (Hwops : 0 ≤ sint.Z wops)
    (Hmul : sint.Z clients * sint.Z ops + sint.Z watchers * sint.Z wops < 2 ^ 60)
    (steps : List github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step)
    (Hsteps : steps.length < 2 ^ 63)
    (HNs : prometheus.namesUnclaimed (k8setcd3PProgram k clients ops watchers wops steps) k8setcd3Names)
    (HAs : addrsUnclaimed (k8setcd3PProgram k clients ops watchers wops steps) (k8s_etcd3N.k8setcd3NAddrs k))
    -- the members' data directories, fresh at start (`dataDirsAbsent`)
    (HDs : dataDirsAbsent (k8setcd3PProgram k clients ops watchers wops steps) (k8s_etcd3N.k8setcd3NDirs k))
    -- (sweep repairs 1, B4) `ETCD_VERIFY` off for the run
    (HEnv : verifyEnvOff (k8setcd3PProgram k clients ops watchers wops steps))
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC k8setcd3GF,
      ⊢ k8s_etcd3N.premises (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx) k n ids ps ctxs boot)
    (σ : state) (g : GlobalState)
    (Hfs : Fs.FsInit (extLocal Fs.fsExt σ.world))
    (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps' : RealNsteps n ([k8setcd3PProgram k clients ops watchers wops steps], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) := by
  refine etcd_adequate_members (GF := k8setcd3GF)
    (hAsLit := k8s_etcd3N.k8setcd3NAddrs_lit k hk) (HEnv := HEnv)
    github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.initialize'
    (App (App (App (App (App (App (Val (@! github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.MainPartition))
      (Val #(W64 (k : Int)))) (Val #clients)) (Val #ops)) (Val #watchers)) (Val #wops)) (schedLit steps))
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown")) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm))
    (k8s_etcd3N.k8setcd3NAddrs k) (k8s_etcd3N.k8setcd3NAddrs_nodup k hk)
    (k8s_etcd3N.k8setcd3NDirs k) (k8s_etcd3N.k8setcd3NDirs_nodup k hk)
    (k8s_etcd3N.startAddrs k) (k8s_etcd3N.bridges k)
    (k8s_etcd3N.k8setcd3NAddrs_perm k) (k8s_etcd3N.k8setcd3NDirs_perm k)
    σ g ⟨trivial, trivial, trivial⟩ ⟨trivial, Hfs, trivial⟩ Hlctx Hinit Hthreads HNs HAs HDs
    n κs t2 σ2 Hsteps' fun hG HN HT => ?_
  letI : HeapGS .hasLC k8setcd3GF := k8setcd3HeapAt hG lctx
  letI : EtcdGrove.k8s.CompactorRegistry := ⟨0⟩
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.wp_initialize' _
    github_com.mit_pdos.etcd_grove.examples.k8s.etcd3.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Hms, Hbs⟩
  unfold k8s_etcd3N.startAddrs
  rw [BigSepL.bigSepL_map]
  -- the schedule's slice literal (as `k8s_compactor_partition_adequate`)
  wp_bind (schedLit steps)
  unfold schedLit
  iapply (wp_slice_literal (V := github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step) (l := steps)
    (kvs := steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
  have hp := pure_wp_array_lit_full (hlc := HasLC.hasLC) (GF := k8setcd3GF)
    (go.arrayLiteralSize
      (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
    github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty steps _ rfl
    (by rw [arrayLiteralSize_vals]; simp)
    (by rw [arrayLiteralSize_vals]; simpa using Hsteps)
  have hp' : ∀ Ψ : val → IProp k8setcd3GF,
      iprop(▷ (£ 1 -∗ WP (Val #(array.mk
          (go.arrayLiteralSize
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
          steps)) {{ Ψ }})) ⊢
        WP (App (Val (GoInstruction (CompositeLiteral (go.ArrayType
            (go.arrayLiteralSize
              (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
            github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty))))
          (Val (LiteralValueV
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))))
          {{ Ψ }} :=
    fun Ψ => hp.pure_wp_wp _ _ Ψ [] trivial
  iapply (hp' _)
  inext
  iintro -
  wp_auto
  isplitr
  · ipureintro; rfl
  iintro %sl ⟨Hsl, -⟩
  imod ownSlice_persist _ _ _ $$ Hsl with #Hsl
  (try wp_auto)
  haveI : ThreadBoundLe k8setcd3GF (2 ^ 28) := ⟨by rw [HT]; word⟩
  haveI : ReceiptBoundLe k8setcd3GF (2 ^ 48) := ⟨by rw [HN]; omega⟩
  haveI : ReceiptBoundLe k8setcd3GF (n + 1) := ⟨by rw [HN]; omega⟩
  have hM := k8s_etcd3.wp_MainPartition (GF := k8setcd3GF) k n ids ps ctxs boot clients ops watchers wops
    (slice.mk sl
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty))))
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))))
    steps (srvLevels_of_max HT) hk1 hk Hlen Hbf (by unfold bootWB backend.wbInit; omega)
    Haf Hbuq Hrf Hdbo inferInstance EtcdGrove.rpctypesEtcdError_asTarget
    k8s_etcd3.storageErrTyOk_holds k8s_etcd3.objTyOk_holds Hc0 Hw0 Hc31 Hops Hwops Hmul
  wp_apply hM $$ [Hms Hbs Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

