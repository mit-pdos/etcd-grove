  have hM := k8s_etcd3.wp_MainCluster (GF := k8setcd3GF) n id₁ id₂ id₃ ps ctxs boot clients ops (srvLevels_of_max HT) Hbf
    (by unfold bootWB backend.wbInit; omega)
