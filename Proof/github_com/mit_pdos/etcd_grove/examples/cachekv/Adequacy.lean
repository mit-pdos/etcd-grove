/- Lean-first (no Rocq counterpart).

# The cache watch example's closed theorem (2026-10-20)

A closed theorem about the operational semantics of `cachekv`'s program (`examples/cachekv`): the
package's initialization (which initializes its import closure: etcd's server, its gRPC layer,
the client, the cache, raft, ...) followed by `Main(nw, nops)` -- the writers' `nw * nops` Puts
picked, one etcd member started in process, a client with etcd's default configuration, a
cache of the prefix `ck/` over it, the cache's watch of the prefix from revision `2`, `nw` writer
goroutines, the watch read up to the highest revision a successful Put returned, and watchkv's
check, which panics unless the watched events are exactly the writes (puts only, gap-free from
revision `2`, each of a Put attempted, every successful Put the event at its revision) -- started
from a fresh state (no package initialized, one thread): for every real execution of `n` steps,
the main thread's result, if it has one, is `Ok` (`0`), `Failed` (`1`) or `WatchEnded` (`2`), no
thread is stuck, and no thread has ended in a panic (in particular the check did not panic).

It follows, as watchkv's (`Proof/.../watchkv/Adequacy.lean`), from
`EtcdGrove.goose_adequacy_start` (through `common/Adequacy.lean`'s `etcd_adequate`) with the read package's two metric names and the client address
`127.0.0.1:23873`, at putget's ghost-state bundle `putgetGF` and trivial extension, from `cachekv`'s
`wp_initialize'` (`Init.lean`, over the program's package table `PkgTable.lean`, both generated by
`etc/gen-init.py`) and `cachekv.wp_Main` (`Link.lean`).

**Its hypotheses** are watchkv's (`watch_adequate`) at cachekv's configuration
(`cachekv.premises`: putget's, until 2026-10-20 also the watch stream's transport premise
`noRetryableStreamErr`, gone with D25; the address `127.0.0.1:23873`): the cache adds none.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.common.Adequacy
public import Proof.github_com.mit_pdos.etcd_grove.examples.cachekv.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.cachekv.PkgTable
public import Proof.github_com.mit_pdos.etcd_grove.examples.putget.Adequacy
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Proof.github_com.mit_pdos.etcd_grove.examples.common.TrivialExt

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] trivialExts trivialExtsSemantics trivialExtsInterp

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `cachekv`'s initialization, then `Main(nw, nops)`. -/
def cachekvProgram [GoSemanticsFunctions] (nw nops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.cachekv.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.cachekv.Main) #nw #nops

/-- The read package's two metric names, which `cachekv`'s initialization registers. -/
def cachekvNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The cache watch example is safe** (see the file header): every real execution of
`cachekvProgram nw nops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok`, `Failed` or `WatchEnded`; no thread is stuck; no thread has ended in
a panic. -/
theorem cache_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.cachekv.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [_root_.Perennial.errors.Assumptions] [_root_.Perennial.fmt.Assumptions]
    [go_etcd_io.etcd.api.v3.v3rpc.rpctypes.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [ErrorStringNoGRPCStatus] [RpctypesEtcdErrorMethods]
    [context.ErrorStringIsError] [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC putgetGF, ContextReadErrs (GF := putgetGF) (hG := heapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC putgetGF, ContextErrsClient (GF := putgetGF) (hG := heapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (id : w64) (bootLog : List EntryM) (Hbf : putget.BootFacts id bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hdbo : storage.dbOpensOk)
    (nw nops : w64)
    (H0 : 0 ≤ sint.Z nw) (H31 : sint.Z nw < 2 ^ 31) (Hops : 0 ≤ sint.Z nops)
    (Hmul : sint.Z nw * sint.Z nops < 2 ^ 62)
    (HNs : prometheus.namesUnclaimed (cachekvProgram nw nops) cachekvNames)
    (HAs : addrsUnclaimed (cachekvProgram nw nops) [go!"127.0.0.1:23873"])
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC putgetGF,
      ⊢ cachekv.premises (GF := putgetGF) (hG := heapAt hG lctx) n id bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([cachekvProgram nw nops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 29) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  refine etcd_adequate (GF := putgetGF) github_com.mit_pdos.etcd_grove.examples.cachekv.initialize'
    ((@! github_com.mit_pdos.etcd_grove.examples.cachekv.Main) #nw #nops)
    (fun v => v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
        (fun h => intoVal_ne_PanicV _ p h.symm))) [go!"127.0.0.1:23873"] (by decide) σ g ⟨trivial, trivial⟩ ⟨trivial, trivial⟩ Hlctx Hinit Hthreads HNs HAs
    n κs t2 σ2 Hsteps fun hG HN HT => ?_
  letI : HeapGS .hasLC putgetGF := heapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.cachekv.wp_initialize' _ github_com.mit_pdos.etcd_grove.examples.cachekv.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Has, -⟩
  icases BigSepL.bigSepL_cons.1 $$ Has with ⟨Haddr, -⟩
  have hM := cachekv.wp_Main (GF := putgetGF) n id bootLog nw nops Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hdbo Hms hAs
    H0 H31 Hops Hmul
  wp_apply hM $$ [Haddr Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)

end adequacy

end EtcdGrove
end Perennial
