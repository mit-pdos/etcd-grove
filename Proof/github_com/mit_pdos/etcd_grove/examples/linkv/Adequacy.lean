/- Lean-first (no Rocq counterpart).

# The linearizability instance's closed theorem (D20 (c), 2026-10-19)

A closed theorem about the operational semantics of `linkv`'s program (`examples/linkv`): the
package's initialization (which initializes its import closure: etcd's server, its gRPC layer,
the client, raft, porcupine, the driver `lintest`, ...) followed by `Main(clients, ops)` -- one
etcd member started in process, a client configured for one attempt per call, `clients` clients
of `ops` random operations each through it (`lintest.Run`), the recorded history checked by
porcupine against the model of a key-value store, and a panic ("linkv: porcupine found the history
not linearizable") if porcupine answers `Illegal` -- started from a fresh state (no package
initialized, one thread): for every real execution of `n` steps, the main thread's result, if it
has one, is `Ok` or `Unknown`, no thread is stuck, and no thread has ended in a panic (in
particular `Main` did not panic on `Illegal`).

It follows, as putget's (`Proof/.../putget/Adequacy.lean`), from `EtcdGrove.goose_adequacy_start`
with the read package's two metric names and the client address `127.0.0.1:23791`, instantiated
with the disk FFI and a ghost-state bundle `linkvGF` (putget's, with iris-lean's non-atomic
invariants at slot 11 for porcupine's checker, as the counter's `counterGF`), from `linkv`'s
`wp_initialize'` (`Init.lean`, over the program's package table `PkgTable.lean`, both generated by
`etc/gen-init.py`) and `linkv.wp_Main` (`Link.lean`).

**Its hypotheses** are putget's (`putget_adequate`; D19a, `notes/decisions.md`, D19r) at linkv's
configuration (`linkv.premises`, the address `127.0.0.1:23791`; until 2026-10-20 also the two
marked ones, `EofFromIoInit` and `ClosedchanFromContextInit`, now theorems of `io`'s and
`context`'s package facts: linkv's initialization is of the ordinary form, at a table of its
closure's `isPkgInit`s, and `context`'s now holds `isClosedchanInit`); and `Run`'s bounds on
`clients` and `ops`
(`0 ≤ clients < 2^31`, `0 ≤ ops`, `clients * ops < 2^60`).
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.linkv.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.linkv.PkgTable
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Perennial.GooseLang.Ffi.DiskFfi.Adequacy

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] disk_op disk_model disk_semantics disk_interp

/-! ## The ghost-state bundle -/

/-- The functors: putget's (`putgetGF`: the universal camera `AllG` at slot 0, then invariants,
later credits, GooseLang's heap, prophecies and package state, and the disk FFI's heap), and
iris-lean's non-atomic invariants at slot 11 (as the counter's `counterGF`). Every other slot is
the unit functor. -/
def linkvGF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | 8 => ⟨constOF (HeapView Int (Agree (DiscreteO Block)) (GMap Int)), inferInstance⟩
  | 9 => ⟨constOF (HeapView Int (Agree (DiscreteO GName)) (GMap Int)), inferInstance⟩
  | 10 => ⟨constOF MetaUR, inferInstance⟩
  | 11 => ⟨NaInvF, inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def linkvGF_allG : AllG linkvGF := ⟨⟨0, rfl⟩⟩

instance linkvGF_gooseGpreS : GooseGpreS disk_model linkvGF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGFfi := (⟨⟨⟨⟨8, rfl⟩⟩, ⟨⟨9, rfl⟩⟩, ⟨10, rfl⟩⟩⟩ : DiskPreG linkvGF)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := linkvGF_allG

/-- iris-lean's camera of non-atomic invariants, at slot 11: the instance porcupine's results
take. -/
instance linkvGF_naInvG : NaInvG linkvGF := ⟨⟨11, rfl⟩⟩

/-- **A ghost-state instance at the local context `lctx`** (as putget's `heapAt`). -/
abbrev linkvHeapAt (hG : HeapGS .hasLC linkvGF) (lctx : GoLocalContext) : HeapGS .hasLC linkvGF :=
  ⟨hG.goose_globalGS, ⟨hG.goose_localGS.gooseFfiLocalGS, lctx,
    hG.goose_localGS.goose_na_heapGS, hG.goose_localGS.goose_go_stateGS⟩⟩

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `linkv`'s initialization, then `Main(clients, ops)`. -/
def linkvProgram [GoSemanticsFunctions] (clients ops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.linkv.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.linkv.Main) #clients #ops

/-- The read package's two metric names, which `linkv`'s initialization registers (`readRegPerm`,
D16). -/
def linkvNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The linearizability instance is safe** (see the file header): every real execution of
`linkvProgram clients ops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok` (porcupine found the history linearizable) or `Unknown` (a step before
the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem linkv_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.linkv.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [RpctypesEtcdErrorMethods] [context.ErrorStringIsError]
    [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC linkvGF, ContextReadErrs (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (id : w64) (bootLog : List EntryM) (Hbf : putget.BootFacts id bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hnoc : mvcc.backendNoCompaction)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (HNs : prometheus.namesUnclaimed (linkvProgram clients ops) linkvNames)
    (HAs : addrsUnclaimed (linkvProgram clients ops) [go!"127.0.0.1:23791"])
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC linkvGF,
      ⊢ linkv.premises (GF := linkvGF) (hG := linkvHeapAt hG lctx) n id bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : g.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([linkvProgram clients ops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 31) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  suffices H : (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
      (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧ (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) by
    refine ⟨H.1, H.2.1, fun v hv => ?_⟩
    cases h : v.isPanic
    · rfl
    · obtain ⟨p, rfl⟩ := val.isPanic_eq_true h
      exact absurd (UnrecoveredPanic.panic p) (H.2.2 _ hv)
  refine goose_adequacy_start (GF := linkvGF) (n + 1) (n + 2) (linkvProgram clients ops) σ g
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown"))
    (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) trivial trivial
    linkvNames [go!"127.0.0.1:23791"] (by decide) (by decide) HNs HAs ?_
    n κs t2 σ2 Hsteps (Nat.lt_succ_self n) Hthreads (realThreadsBelow_of_one Hthreads)
  intro hG HN HT HL
  have Hprem0 := Hprem hG
  have Hctx0 := Hctx hG
  obtain ⟨G, ⟨fl, lc, nh, gs⟩⟩ := hG
  subst Hlctx
  subst HL
  letI : HeapGS .hasLC linkvGF := ⟨G, ⟨fl, σ.goState.goLctx, nh, gs⟩⟩
  haveI := Hctx0
  unfold IsInit at Hinit
  rw [Hinit]
  iintro _ _ Hgs Htok Hrights
  ihave Hown : ownInitializing
      (github_com.mit_pdos.etcd_grove.examples.linkv.getIsPkgInit (GF := linkvGF)) $$ [Hgs]
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    imodintro
    iapply BigSepM.bigSepM_empty.2
    itrivial
  iunfold startRights at Hrights
  simp only [linkvNames, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Hrights with ⟨⟨Hn1, Hn2, -⟩, ⟨Haddr, -⟩⟩
  ihave #Hprem' := Hprem0
  imodintro
  unfold linkvProgram
  wp_apply (github_com.mit_pdos.etcd_grove.examples.linkv.wp_initialize' _
      github_com.mit_pdos.etcd_grove.examples.linkv.getIsPkgInit_wf) $$ [Hown Hn1 Hn2]
    as ⟨_, #Hinit⟩
  · iframe Hown
    iunfold read.readRegPerm
    iframe
  have hM := linkv.wp_Main (GF := linkvGF) n id bootLog clients ops Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hnoc Hms hAs
    Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Haddr Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

end EtcdGrove
end Perennial
