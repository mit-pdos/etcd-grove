/- Lean-first (no Rocq counterpart).

# The Kubernetes etcd3 store's linearizability instance's closed theorem (stage 6g)

As `k8setcd3/Adequacy.lean`'s, for `examples/k8setcd3`: the package's initialization (which
initializes its import closure) followed by `Main(clients, ops)` -- one etcd member started in
process, a kubernetes client configured for one attempt per call, the two seed objects written in
the older encoding, the Kubernetes API server's etcd3 store (`k8s.io/apiserver/pkg/storage/etcd3`)
over the client with the driver's codec, versioner, transformer and decoder, `clients` clients of
`ops` random store operations each through it (`lintest.Run`: `Create`, `Get`, `Delete` and
`GuaranteedUpdate`, with preconditions, validations, updates that may be rejected and the
store's read-modify-write retries), the recorded history checked by porcupine against the
driver's Go model of the store (`model.go`), and a panic ("k8setcd3: porcupine found the history
not linearizable") if porcupine answers `Illegal` -- started from a fresh state: for every real
execution of `n` steps, the main thread's result, if it has one, is `Ok` or `Unknown`, no thread
is stuck, and no thread has ended in a panic.

It follows from `EtcdGrove.goose_adequacy_start` with the read package's two metric names and
the client address `127.0.0.1:23896`, at the ghost-state bundle `k8setcd3GF` (k8setcd3's), from
`k8setcd3`'s `wp_initialize'` (`Init.lean`, over `PkgTable.lean`, both generated by
`etc/gen-init.py`) and `k8setcd3.wp_Main` (`Link.lean`). **Its hypotheses** are k8setcd3's at
`k8setcd3`'s configuration (`k8setcd3.premises`, the address `127.0.0.1:23896`), the semantics
assumptions of the Kubernetes packages, the method-set facts the store asks of the driver's
objects (`objTyOk`) and the driver's `errOut` of `*storage.StorageError` (`storageErrTyOk`: it has
`Unwrap`) and `Run`'s bounds on `clients` and `ops`.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.k8setcd3.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.k8setcd3.PkgTable
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Proof.github_com.mit_pdos.etcd_grove.examples.common.TrivialExt

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] trivialExts trivialExtsSemantics trivialExtsInterp

/-! ## The ghost-state bundle -/

/-- The functors: putget's (`putgetGF`: the universal camera `AllG` at slot 0, then invariants,
later credits, GooseLang's heap, prophecies and package state), and
iris-lean's non-atomic invariants at slot 11 (as the counter's `counterGF`). Every other slot is
the unit functor. -/
def k8setcd3GF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | 11 => ⟨NaInvF, inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def k8setcd3GF_allG : AllG k8setcd3GF := ⟨⟨0, rfl⟩⟩

instance k8setcd3GF_gooseGpreS : GooseGpreS k8setcd3GF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGExts := ((), PUnit.unit)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := k8setcd3GF_allG

/-- iris-lean's camera of non-atomic invariants, at slot 11: the instance porcupine's results
take. -/
instance k8setcd3GF_naInvG : NaInvG k8setcd3GF := ⟨⟨11, rfl⟩⟩

/-- **A ghost-state instance at the local context `lctx`** (as putget's `heapAt`). -/
abbrev k8setcd3HeapAt (hG : HeapGS .hasLC k8setcd3GF) (lctx : GoLocalContext) : HeapGS .hasLC k8setcd3GF :=
  ⟨hG.goose_globalGS, { hG.goose_localGS with goose_go_local_context := lctx }⟩

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `k8setcd3`'s initialization, then `Main(clients, ops)`. -/
def k8setcd3Program [GoSemanticsFunctions] (clients ops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.k8setcd3.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.k8setcd3.Main) #clients #ops

/-- The read package's two metric names, which `k8setcd3`'s initialization registers (`readRegPerm`,
D16). -/
def k8setcd3Names : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The Kubernetes etcd3 store's linearizability instance is safe** (see the file header): every real execution of
`k8setcd3Program clients ops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok` (porcupine found the history linearizable) or `Unknown` (a step before
the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem k8setcd3_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.k8setcd3.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [k8s_io.apiserver.pkg.storage.etcd3.Assumptions] [k8s_io.apimachinery.pkg.runtime.Assumptions]
    [k8s_io.apimachinery.pkg.runtime.schema.Assumptions] [k8s_io.apiserver.pkg.storage.Assumptions]
    [k8s_io.apiserver.pkg.storage.value.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [RpctypesEtcdErrorMethods] [context.ErrorStringIsError]
    [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC k8setcd3GF, ContextReadErrs (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (hse : k8setcd3.storageErrTyOk) (Hty : k8setcd3.objTyOk)
    (id : w64) (bootLog : List EntryM) (Hbf : putget.BootFacts id bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hdbo : storage.dbOpensOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (HNs : prometheus.namesUnclaimed (k8setcd3Program clients ops) k8setcd3Names)
    (HAs : addrsUnclaimed (k8setcd3Program clients ops) [go!"127.0.0.1:23896"])
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC k8setcd3GF,
      ⊢ k8setcd3.premises (GF := k8setcd3GF) (hG := k8setcd3HeapAt hG lctx) n id bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([k8setcd3Program clients ops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 31) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  suffices H : (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
      (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧ (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) by
    refine ⟨H.1, H.2.1, fun v hv => ?_⟩
    cases h : v.isPanic
    · rfl
    · obtain ⟨p, rfl⟩ := val.isPanic_eq_true h
      exact absurd (UnrecoveredPanic.panic p) (H.2.2 _ hv)
  refine goose_adequacy_start (GF := k8setcd3GF) (n + 1) (n + 2) (k8setcd3Program clients ops) σ g
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown"))
    (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) ⟨trivial, trivial⟩ ⟨trivial, trivial⟩
    k8setcd3Names [go!"127.0.0.1:23896"] (by decide) (by decide) HNs HAs ?_
    n κs t2 σ2 Hsteps (Nat.lt_succ_self n) Hthreads (realThreadsBelow_of_one Hthreads)
  intro hG HN HT HL
  have Hprem0 := Hprem hG
  have Hctx0 := Hctx hG
  obtain ⟨G, ⟨fl, lc, nh, gs, th, cr⟩⟩ := hG
  subst Hlctx
  subst HL
  letI : HeapGS .hasLC k8setcd3GF := ⟨G, ⟨fl, σ.goState.goLctx, nh, gs, th, cr⟩⟩
  haveI := Hctx0
  unfold IsInit at Hinit
  rw [Hinit]
  iintro _ _ Hgs Htok Hrights
  ihave Hown : ownInitializing
      (github_com.mit_pdos.etcd_grove.examples.k8setcd3.getIsPkgInit (GF := k8setcd3GF)) $$ [Hgs]
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    imodintro
    iapply BigSepM.bigSepM_empty.2
    itrivial
  iunfold startRights at Hrights
  simp only [k8setcd3Names, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Hrights with ⟨⟨Hn1, Hn2, -⟩, ⟨Haddr, -⟩, -⟩
  ihave #Hprem' := Hprem0
  imodintro
  unfold k8setcd3Program
  wp_apply (github_com.mit_pdos.etcd_grove.examples.k8setcd3.wp_initialize' _
      github_com.mit_pdos.etcd_grove.examples.k8setcd3.getIsPkgInit_wf) $$ [Hown Hn1 Hn2]
    as ⟨_, #Hinit⟩
  · iframe Hown
    iunfold read.readRegPerm
    iframe
  have hM := k8setcd3.wp_Main (GF := k8setcd3GF) n id bootLog clients ops Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hdbo Hms hAs
    hse Hty Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Haddr Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

end EtcdGrove
end Perennial
