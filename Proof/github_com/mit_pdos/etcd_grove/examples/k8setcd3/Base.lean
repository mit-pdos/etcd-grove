/-
Lean-first (no Rocq counterpart).

The driver's package `k8setcd3` (`examples/k8setcd3`, phase 6 of `notes/k8s-etcd3-plan.md`): its
package fact `drvInit`. Its error variables (`errNotObj`, `errBadData`, `errBadRV`, `errNoList`,
`errDeleteRejected`, `errUpdateRejected`: translated `errors.New` calls) each hold a fixed non-nil
error whose `Error()` returns a string (`errorStringSpec`) and whose cell holds its message
(`errStrCell`, D19k: what tells the callbacks' sentinels apart from the client's errors). Its
initializer allocates them and initializes its imports, among them the etcd3 store's packages, `etcdserver` and `v3rpc`,
`lintest` and `porcupine` (its `Init.lean`, to be generated by `etc/gen-init.py`, stage 6g).
-/
module

public import GeneratedProof.github_com.mit_pdos.etcd_grove.examples.k8setcd3
public import Proof.k8s_io.apiserver.pkg.storage.etcd3.Base
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.api.v3rpc.Base
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.apply.Base
public import Proof.go_etcd_io.etcd.cache.v3.Base
public import Proof.errors.NewVarCell
public import Proof.github_com.mit_pdos.etcd_grove.examples.common.Base
public import Proof.github_com.mit_pdos.etcd_grove.examples.lintest.Base

@[expose] public section

noncomputable section

namespace Perennial
namespace github_com.mit_pdos.etcd_grove.examples.k8setcd3

open Iris Iris.BI Iris.ProgramLogic Iris.Std

section init
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- The error variable `x` holds a fixed `*errorString` (what `errors.New(msg)` returns:
`errors.newVar`) whose `Error()` returns a string and whose cell holds `msg`. -/
abbrev errVarOk (x msg : GoString) : IProp GF :=
  iprop(∃ l : Loc,
    globalAddr x ↦□ interface.mkOk (go.GoType.PointerType _root_.Perennial.errors.errorString.ty) #l ∗
    _root_.Perennial.go_etcd_io.etcd.cache.v3.errorStringSpec
      ⟨go.GoType.PointerType _root_.Perennial.errors.errorString.ty, #l⟩ ∗
    EtcdGrove.errStrCell l msg)

/-- **The driver package's fact** (see the file header). -/
abbrev drvInit : IProp GF :=
  iprop(errVarOk errNotObj go!"k8setcd3: not an *Obj" ∗
    errVarOk errBadData go!"k8setcd3: data does not decode" ∗
    errVarOk errBadRV go!"k8setcd3: resource version does not parse" ∗
    errVarOk errNoList go!"k8setcd3: lists are not supported" ∗
    errVarOk errDeleteRejected go!"k8setcd3: deletion rejected" ∗
    errVarOk errUpdateRejected go!"k8setcd3: update rejected")

instance isPkgInit_inst :
    IsPkgInit (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.k8setcd3 :=
  define_is_pkg_init drvInit
instance get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.k8setcd3 :=
  build_get_is_pkg_init_wf

end init

end github_com.mit_pdos.etcd_grove.examples.k8setcd3
end Perennial
