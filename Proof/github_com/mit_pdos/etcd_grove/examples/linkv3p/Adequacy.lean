/-! ## The ghost-state bundle -/

/-- The functors: putget's (`putgetGF`: the universal camera `AllG` at slot 0, then invariants,
later credits, GooseLang's heap, prophecies and package state, and the disk FFI's heap), and
iris-lean's non-atomic invariants at slot 11 (as the counter's `counterGF`). Every other slot is
the unit functor. -/
def linkvGF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | 8 => ⟨constOF (HeapView Int (Agree (DiscreteO Block)) (GMap Int)), inferInstance⟩
  | 9 => ⟨constOF (HeapView Int (Agree (DiscreteO GName)) (GMap Int)), inferInstance⟩
  | 10 => ⟨constOF MetaUR, inferInstance⟩
  | 11 => ⟨NaInvF, inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def linkvGF_allG : AllG linkvGF := ⟨⟨0, rfl⟩⟩

instance linkvGF_gooseGpreS : GooseGpreS disk_model linkvGF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGFfi := (⟨⟨⟨⟨8, rfl⟩⟩, ⟨⟨9, rfl⟩⟩, ⟨10, rfl⟩⟩⟩ : DiskPreG linkvGF)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := linkvGF_allG

/-- iris-lean's camera of non-atomic invariants, at slot 11: the instance porcupine's results
take. -/
instance linkvGF_naInvG : NaInvG linkvGF := ⟨⟨11, rfl⟩⟩

/-- **A ghost-state instance at the local context `lctx`** (as putget's `heapAt`). -/
abbrev linkvHeapAt (hG : HeapGS .hasLC linkvGF) (lctx : GoLocalContext) : HeapGS .hasLC linkvGF :=
  ⟨hG.goose_globalGS, ⟨hG.goose_localGS.gooseFfiLocalGS, lctx,
    hG.goose_localGS.goose_na_heapGS, hG.goose_localGS.goose_go_stateGS⟩⟩

/-! ## The schedule as a slice literal -/

section lit
variable [ext : FfiSyntax] [go_gctx : GoGlobalContext]

/-- The fold of `go.arrayLiteralSize` over the keyed elements of values counts them. -/
theorem foldl_arrayLitKE {V : Type} (t : go.GoType) (F : Int × Int → keyed_element → Int × Int)
    (hF : ∀ (i m : Int) (x : V), F (i, m) (arrayLitKE t x) = (i + 1, m)) :
    ∀ (l : List V) (i m : Int), List.foldl F (i, m) (l.map (arrayLitKE t)) = (i + l.length, m)
  | [], i, m => by simp
  | x :: xs, i, m => by
    rw [List.map_cons, List.foldl_cons, hF, foldl_arrayLitKE t F hF xs]
    simp only [List.length_cons]
    congr 1
    push_cast
    omega

/-- **A literal of values has the values' count as size** (`go.arrayLiteralSize`). -/
theorem arrayLiteralSize_vals {V : Type} (t : go.GoType) (l : List V) :
    go.arrayLiteralSize (l.map (arrayLitKE t)) = l.length := by
  unfold go.arrayLiteralSize
  rw [foldl_arrayLitKE t _ (fun _ _ _ => rfl) l 0 0]
  simp

/-- **The schedule `steps` as the Go slice literal `[]Step{...}`**: what a caller of `Main` builds
(its keyed elements as the value they take one pure step to become, `LiteralValueV`). -/
def schedLit (steps : List github_com.mit_pdos.etcd_grove.examples.linkv3p.Step) : Expr :=
  App (Val (GoInstruction (CompositeLiteral
    (go.GoType.SliceType github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty))))
    (Val (LiteralValueV
      (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty))))

end lit

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `linkv3p`'s initialization, then `Main(clients, ops, sched)` with the schedule
built as a slice literal. -/
def linkv3pProgram [GoSemanticsFunctions] (clients ops : w64)
    (steps : List github_com.mit_pdos.etcd_grove.examples.linkv3p.Step) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.linkv3p.initialize' #() ;;
  App (App (App (Val (@! github_com.mit_pdos.etcd_grove.examples.linkv3p.Main)) (Val #clients))
    (Val #ops)) (schedLit steps)

/-- The program's addresses: the three members' peer addresses, their client addresses, and the
bridges' addresses (2026-10-21, `notes/client-cut-plan.md`). -/
def linkv3pAddrs : List GoString :=
  [linkv3p.peerAddr₁, linkv3p.peerAddr₂, linkv3p.peerAddr₃,
    linkv3p.clientAddr₁, linkv3p.clientAddr₂, linkv3p.clientAddr₃,
    linkv3p.bridgeAddr₁, linkv3p.bridgeAddr₂, linkv3p.bridgeAddr₃]

/-- The read package's two metric names, which `linkv3p`'s initialization registers (`readRegPerm`,
D16). -/
def linkv3pNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The partitioned three-member instance is safe** (see the file header): every real
execution of `linkv3pProgram clients ops steps` from a fresh state with one thread, of `n` steps: if
the main thread has finished, its result is `Ok` (porcupine found the history linearizable) or
`Unknown` (a step before the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem linkv3p_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.linkv3p.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [RpctypesEtcdErrorMethods] [context.ErrorStringIsError]
    [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC linkvGF, ContextReadErrs (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC linkvGF, ContextErrsClient (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (id₁ id₂ id₃ : w64) (bootLog : List EntryM) (Hbf : linkv3p.BootFacts id₁ id₂ id₃ bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hdbo : storage.dbOpensOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (steps : List github_com.mit_pdos.etcd_grove.examples.linkv3p.Step)
    (Hsteps : steps.length < 2 ^ 63)
    (HNs : prometheus.namesUnclaimed (linkv3pProgram clients ops steps) linkv3pNames)
    (HAs : addrsUnclaimed (linkv3pProgram clients ops steps) linkv3pAddrs)
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC linkvGF,
      ⊢ linkv3p.premises (GF := linkvGF) (hG := linkvHeapAt hG lctx) n id₁ id₂ id₃ bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : g.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps' : RealNsteps n ([linkv3pProgram clients ops steps], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 29) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  refine etcd_adequate (GF := linkvGF) github_com.mit_pdos.etcd_grove.examples.linkv3p.initialize'
    (App (App (App (Val (@! github_com.mit_pdos.etcd_grove.examples.linkv3p.Main)) (Val #clients))
      (Val #ops)) (schedLit steps))
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown")) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) linkv3pAddrs (by decide) σ g trivial trivial Hlctx Hinit Hthreads HNs HAs
    n κs t2 σ2 Hsteps' fun hG HN HT => ?_
  letI : HeapGS .hasLC linkvGF := linkvHeapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.linkv3p.wp_initialize' _ github_com.mit_pdos.etcd_grove.examples.linkv3p.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok Has
  simp only [linkv3pAddrs, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Has with ⟨Ha₁, Ha₂, Ha₃, Hc₁, Hc₂, Hc₃, Hba₁, Hba₂, Hba₃, -⟩
  -- the schedule's slice literal: the array of an abstract list takes one pure step
  -- (`pure_wp_array_lit_full`, before the generic automation unfolds it), then the slice over it
  -- (`wp_slice_literal`)
  wp_bind (schedLit steps)
  unfold schedLit
  iapply (wp_slice_literal (V := github_com.mit_pdos.etcd_grove.examples.linkv3p.Step) (l := steps)
    (kvs := steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))
  have hp := pure_wp_array_lit_full (hlc := HasLC.hasLC) (GF := linkvGF)
    (go.arrayLiteralSize
      (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))
    github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty steps _ rfl
    (by rw [arrayLiteralSize_vals]; simp)
    (by rw [arrayLiteralSize_vals]; simpa using Hsteps)
  have hp' : ∀ Ψ : val → IProp linkvGF,
      iprop(▷ (£ 1 -∗ WP (Val #(array.mk
          (go.arrayLiteralSize
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))
          steps)) {{ Ψ }})) ⊢
        WP (App (Val (GoInstruction (CompositeLiteral (go.ArrayType
            (go.arrayLiteralSize
              (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))
            github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty))))
          (Val (LiteralValueV
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))))
          {{ Ψ }} :=
    fun Ψ => hp.pure_wp_wp _ _ Ψ [] trivial
  iapply (hp' _)
  inext
  iintro -
  wp_auto
  isplitr
  · ipureintro; rfl
  iintro %sl ⟨Hsl, -⟩
  imod ownSlice_persist _ _ _ $$ Hsl with #Hsl
  (try wp_auto)
  have hM := linkv3p.wp_Main (GF := linkvGF) n id₁ id₂ id₃ bootLog clients ops
    (slice.mk sl
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty))))
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.linkv3p.Step.ty)))))
    steps Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hdbo Hms hAs
    Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Ha₁ Ha₂ Ha₃ Hc₁ Hc₂ Hc₃ Hba₁ Hba₂ Hba₃ Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl


end adequacy

