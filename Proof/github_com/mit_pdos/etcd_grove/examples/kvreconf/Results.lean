theorem kvreconf_Get : kvreconf.Cluster.Get.spec (GF := GF) (hG := hG) := kvreconf.Cluster.wp_Get
theorem kvreconf_Read : kvreconf.Cluster.Read.spec (GF := GF) (hG := hG) := kvreconf.Cluster.wp_Read
