section closed
attribute [local instance] durableExts durableExtsSemantics durableExtsInterp durableExts_hasExt
variable [go_gctx : GoGlobalContext]

/-- **The durable store's randomized linearizability test never fails** (`raft_kvdurable_adequate`,
`AdequacyLinked.lean`): every real execution of `kvdurableProgram dir` -- the store package's
initialization, then `Main(dir)`: a cluster of random options with its files in `dir`, 4 clients of
100 random `Put`s, `Get`s and `Read`s, one to three proposers of configuration changes, leadership
disruptions, crashes with restarts from the files, porcupine's check of the trace, and a panic unless
it answers `Ok` -- from a fresh state with one thread whose files hold none of the replicas' files in
`dir`, of `n < 2^61` steps, has no stuck thread and no thread that ended in a panic: porcupine always
answers `Ok`. -/
theorem raft_kvdurable_porcupine_safe [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.raft.kvdurable.Assumptions]
    [hLog : log.NewModel] (dir : GoString)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (Hfiles : ∀ i ∈ raft_kvreconf.allIds,
      extLocal durableExt σ.world !! raft_kvdurable.kdFileName dir i = none)
    (n : Nat) (Hn : n < 2 ^ 61) (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([kvdurableProgram dir], ((σ, g) : CfgState)) κs (t2, σ2)) :
    (∀ v t2', t2 = Val v :: t2' → v = #()) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) :=
  raft_kvdurable_adequate dir σ g Hlctx Hinit Hthreads Hfiles n Hn κs t2 σ2 Hsteps

end closed

#print axioms raft_kvdurable_porcupine_safe

end EtcdGrove
end Perennial
