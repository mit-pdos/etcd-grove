/-
Lean-first (no Rocq counterpart).

# The Go checker's package initialization (2026-11-08; its fact, 2026-11-09)

`examples/raft/tracecheck/etcdraft` has package-level variables (`EmptyBag`, `Invariants`, the
tables `RaftMsgType`, `RaftMsgSubtype`, `ReceiveMessageTraceNames`). Its package fact
(`etcdraftInit`) is what the proofs read of them: `Invariants` holds the invariants
`Traceetcdraft.cfg` checks, in its order, each named and with its closure (`invariantsV`; the
closures are the translation's func literals, `Closures.lean`, generated, each calling its `State`
method), read-only, which `State.Violated`'s proof reads; and the three tables (layer C's `trace.go`),
each at a map Go never writes after initialization, holding its literal (`raftMsgTypeMap`,
`raftMsgSubtypeMap`, `receiveNamesMap`). A Go client that assigns one of these variables or writes
into them is outside the specs. The package's initializer gives the fact (`Init.lean`, generated by
`etc/gen-init.py`).
-/
module

public import GeneratedProof.github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft
public import Proof.github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft.Closures
public import Perennial.Proof.fmt
public import Perennial.Proof.strconv
public import Perennial.Proof.strings

@[expose] public section

noncomputable section

namespace Perennial

open Iris Iris.BI

namespace github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft

/-- `RaftMsgType`'s literal (`trace.go`; `MsgType`'s values are `iota`'s, `types.go`), its keys
inserted in the literal's order (the last outermost), as the initializer builds it. -/
def raftMsgTypeMap : GMap GoString w8 :=
  GMap.insert go!"MsgPreVoteResp" (W8 5) <| GMap.insert go!"MsgPreVote" (W8 4) <|
  GMap.insert go!"MsgSnap" (W8 2) <| GMap.insert go!"MsgHeartbeatResp" (W8 3) <|
  GMap.insert go!"MsgHeartbeat" (W8 2) <| GMap.insert go!"MsgVoteResp" (W8 1) <|
  GMap.insert go!"MsgVote" (W8 0) <| GMap.insert go!"MsgAppResp" (W8 3) <|
  GMap.insert go!"MsgApp" (W8 2) <| GMap.empty

/-- `RaftMsgSubtype`'s literal. -/
def raftMsgSubtypeMap : GMap GoString GoString :=
  GMap.insert go!"MsgSnap" go!"snapshot" <| GMap.insert go!"MsgAppResp" go!"app" <|
  GMap.insert go!"MsgApp" go!"app" <| GMap.insert go!"MsgHeartbeatResp" go!"heartbeat" <|
  GMap.insert go!"MsgHeartbeat" go!"heartbeat" <| GMap.empty

/-- `ReceiveMessageTraceNames`' literal. -/
def receiveNamesMap : GMap GoString Bool :=
  GMap.insert go!"ReceiveSnapshot" true <| GMap.insert go!"ReceiveRequestVoteResponse" true <|
  GMap.insert go!"ReceiveRequestVoteRequest" true <|
  GMap.insert go!"ReceiveAppendEntriesResponse" true <|
  GMap.insert go!"ReceiveAppendEntriesRequest" true <| GMap.empty

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft.Assumptions]

/-- The invariants `Invariants` holds: `Traceetcdraft.cfg`'s, in its order, each named and with its
closure (`s.LogInv()`, ...). -/
def invariantsV : List Invariant :=
  [ ⟨go!"LogInv", logInvV⟩, ⟨go!"MoreThanOneLeaderInv", moreThanOneLeaderInvV⟩,
    ⟨go!"ElectionSafetyInv", electionSafetyInvV⟩, ⟨go!"LogMatchingInv", logMatchingInvV⟩,
    ⟨go!"QuorumLogInv", quorumLogInvV⟩, ⟨go!"LeaderCompletenessInv", leaderCompletenessInvV⟩,
    ⟨go!"CommittedIsDurableInv", committedIsDurableInvV⟩ ]

/-- The package's facts: `Invariants` holds `invariantsV`, read-only; the three tables, each a map
holding its literal for good. -/
abbrev etcdraftInit : IProp GF :=
  iprop((∃ sl : GoSlice, globalAddr Invariants ↦□ sl ∗ sl ↦*□ invariantsV) ∗
    (∃ m : Loc, globalAddr RaftMsgType ↦□ m ∗ m ↦$□ raftMsgTypeMap) ∗
    (∃ m : Loc, globalAddr RaftMsgSubtype ↦□ m ∗ m ↦$□ raftMsgSubtypeMap) ∗
    (∃ m : Loc, globalAddr ReceiveMessageTraceNames ↦□ m ∗ m ↦$□ receiveNamesMap))

instance isPkgInit_inst :
    IsPkgInit (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft :=
  define_is_pkg_init etcdraftInit
instance get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft :=
  build_get_is_pkg_init_wf

end init

end github_com.mit_pdos.etcd_grove.examples.raft.tracecheck.etcdraft

