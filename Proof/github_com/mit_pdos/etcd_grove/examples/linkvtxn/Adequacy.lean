/- Lean-first (no Rocq counterpart).

# The KV-workload linearizability instance's closed theorem (linkv-txn stage G)

As `linkv/Adequacy.lean`'s, for `examples/linkvtxn`: the package's initialization (which
initializes its import closure) followed by `Main(clients, ops)` -- one etcd member started in
process, a client with etcd's default configuration, `clients` clients of `ops` random
operations each through it (`lintest.Run`: gets, lists, puts, deletes, multi-operation
transactions and compare-and-sets, robustness's `EtcdPutDeleteLease` workload without leases and
stale reads), the recorded history checked by porcupine against the model of etcd's KV
(`linkv/TxnModel.lean`'s, robustness's `EtcdState`), and a panic ("linkvtxn: porcupine found the
history not linearizable") if porcupine answers `Illegal` -- started from a fresh state: for every
real execution of `n` steps, the main thread's result, if it has one, is `Ok` or `Unknown`, no
thread is stuck, and no thread has ended in a panic.

It follows from `EtcdGrove.goose_adequacy_start` with the read package's two metric names and
the client address `127.0.0.1:23796`, at the ghost-state bundle `linkvtxnGF` (linkv's), from
`linkvtxn`'s `wp_initialize'` (`Init.lean`, over `PkgTable.lean`, both generated by
`etc/gen-init.py`) and `linkvtxn.wp_Main` (`Link.lean`). **Its hypotheses** are linkv's at
linkvtxn's configuration (`linkvtxn.premises`, the address `127.0.0.1:23796`) and `Run`'s bounds
on `clients` and `ops`.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.linkvtxn.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.linkvtxn.PkgTable
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Perennial.GooseLang.Ffi.DiskFfi.Adequacy

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] disk_op disk_model disk_semantics disk_interp

/-! ## The ghost-state bundle -/

/-- The functors: putget's (`putgetGF`: the universal camera `AllG` at slot 0, then invariants,
later credits, GooseLang's heap, prophecies and package state, and the disk FFI's heap), and
iris-lean's non-atomic invariants at slot 11 (as the counter's `counterGF`). Every other slot is
the unit functor. -/
def linkvtxnGF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | 8 => ⟨constOF (HeapView Int (Agree (DiscreteO Block)) (GMap Int)), inferInstance⟩
  | 9 => ⟨constOF (HeapView Int (Agree (DiscreteO GName)) (GMap Int)), inferInstance⟩
  | 10 => ⟨constOF MetaUR, inferInstance⟩
  | 11 => ⟨NaInvF, inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def linkvtxnGF_allG : AllG linkvtxnGF := ⟨⟨0, rfl⟩⟩

instance linkvtxnGF_gooseGpreS : GooseGpreS disk_model linkvtxnGF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGFfi := (⟨⟨⟨⟨8, rfl⟩⟩, ⟨⟨9, rfl⟩⟩, ⟨10, rfl⟩⟩⟩ : DiskPreG linkvtxnGF)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := linkvtxnGF_allG

/-- iris-lean's camera of non-atomic invariants, at slot 11: the instance porcupine's results
take. -/
instance linkvtxnGF_naInvG : NaInvG linkvtxnGF := ⟨⟨11, rfl⟩⟩

/-- **A ghost-state instance at the local context `lctx`** (as putget's `heapAt`). -/
abbrev linkvtxnHeapAt (hG : HeapGS .hasLC linkvtxnGF) (lctx : GoLocalContext) : HeapGS .hasLC linkvtxnGF :=
  ⟨hG.goose_globalGS, ⟨hG.goose_localGS.gooseFfiLocalGS, lctx,
    hG.goose_localGS.goose_na_heapGS, hG.goose_localGS.goose_go_stateGS⟩⟩

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `linkvtxn`'s initialization, then `Main(clients, ops)`. -/
def linkvtxnProgram [GoSemanticsFunctions] (clients ops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.linkvtxn.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.linkvtxn.Main) #clients #ops

/-- The read package's two metric names, which `linkvtxn`'s initialization registers (`readRegPerm`,
D16). -/
def linkvtxnNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The linearizability instance is safe** (see the file header): every real execution of
`linkvtxnProgram clients ops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok` (porcupine found the history linearizable) or `Unknown` (a step before
the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem linkvtxn_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.linkvtxn.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [RpctypesEtcdErrorMethods] [context.ErrorStringIsError]
    [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC linkvtxnGF, ContextReadErrs (GF := linkvtxnGF) (hG := linkvtxnHeapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (id : w64) (bootLog : List EntryM) (Hbf : putget.BootFacts id bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hdbo : storage.dbOpensOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (HNs : prometheus.namesUnclaimed (linkvtxnProgram clients ops) linkvtxnNames)
    (HAs : addrsUnclaimed (linkvtxnProgram clients ops) [go!"127.0.0.1:23796"])
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC linkvtxnGF,
      ⊢ linkvtxn.premises (GF := linkvtxnGF) (hG := linkvtxnHeapAt hG lctx) n id bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : g.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([linkvtxnProgram clients ops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 31) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  suffices H : (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
      (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧ (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) by
    refine ⟨H.1, H.2.1, fun v hv => ?_⟩
    cases h : v.isPanic
    · rfl
    · obtain ⟨p, rfl⟩ := val.isPanic_eq_true h
      exact absurd (UnrecoveredPanic.panic p) (H.2.2 _ hv)
  refine goose_adequacy_start (GF := linkvtxnGF) (n + 1) (n + 2) (linkvtxnProgram clients ops) σ g
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown"))
    (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) trivial trivial
    linkvtxnNames [go!"127.0.0.1:23796"] (by decide) (by decide) HNs HAs ?_
    n κs t2 σ2 Hsteps (Nat.lt_succ_self n) Hthreads (realThreadsBelow_of_one Hthreads)
  intro hG HN HT HL
  have Hprem0 := Hprem hG
  have Hctx0 := Hctx hG
  obtain ⟨G, ⟨fl, lc, nh, gs⟩⟩ := hG
  subst Hlctx
  subst HL
  letI : HeapGS .hasLC linkvtxnGF := ⟨G, ⟨fl, σ.goState.goLctx, nh, gs⟩⟩
  haveI := Hctx0
  unfold IsInit at Hinit
  rw [Hinit]
  iintro _ _ Hgs Htok Hrights
  ihave Hown : ownInitializing
      (github_com.mit_pdos.etcd_grove.examples.linkvtxn.getIsPkgInit (GF := linkvtxnGF)) $$ [Hgs]
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    imodintro
    iapply BigSepM.bigSepM_empty.2
    itrivial
  iunfold startRights at Hrights
  simp only [linkvtxnNames, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Hrights with ⟨⟨Hn1, Hn2, -⟩, ⟨Haddr, -⟩⟩
  ihave #Hprem' := Hprem0
  imodintro
  unfold linkvtxnProgram
  wp_apply (github_com.mit_pdos.etcd_grove.examples.linkvtxn.wp_initialize' _
      github_com.mit_pdos.etcd_grove.examples.linkvtxn.getIsPkgInit_wf) $$ [Hown Hn1 Hn2]
    as ⟨_, #Hinit⟩
  · iframe Hown
    iunfold read.readRegPerm
    iframe
  have hM := linkvtxn.wp_Main (GF := linkvtxnGF) n id bootLog clients ops Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hdbo Hms hAs
    Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Haddr Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

end EtcdGrove
end Perennial
