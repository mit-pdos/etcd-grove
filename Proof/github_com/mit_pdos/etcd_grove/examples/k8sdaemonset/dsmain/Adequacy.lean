/-! ## The ghost-state bundle -/

attribute [local instance] trivialExts trivialExtsSemantics trivialExtsInterp trivialExts_hasExt

/-- The functors: the universal camera `AllG` at slot 0, then invariants, later credits,
GooseLang's heap, prophecies and package state (the counter's `counterGF`'s). Every other slot is
the unit functor. -/
def dsGF : BundledGFunctors := fun i =>
  match i with
  | 0 => ⟨AllURF, inferInstance⟩
  | 1 => ⟨InvMapF, inferInstance⟩
  | 2 => ⟨constOF CoPsetDisjL, inferInstance⟩
  | 3 => ⟨constOF (DisjointLeibnizSet PosSet), inferInstance⟩
  | 4 => ⟨Auth.AuthURF (constOF Credit), inferInstance⟩
  | 5 => ⟨constOF (NaHeapUR Loc val), inferInstance⟩
  | 6 => ⟨constOF (HeapView proph_id (Agree (DiscreteO (List val))) (GMap proph_id)),
          inferInstance⟩
  | 7 => ⟨GhostVarF (GMap GoString Bool), inferInstance⟩
  | _ => ⟨constOF Unit, inferInstance⟩

/-- The universal camera at slot 0. -/
def dsGF_allG : AllG dsGF := ⟨⟨0, rfl⟩⟩

instance dsGF_gooseGpreS : GooseGpreS dsGF where
  goose_preG_iris := ⟨⟨⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩⟩, ⟨⟨4, rfl⟩⟩⟩
  goose_preG_heap := ⟨⟨5, rfl⟩⟩
  goose_preG_proph := ⟨⟨⟨6, rfl⟩⟩⟩
  goosePreGExts := (⟨dsGF_allG⟩, PUnit.unit)
  goose_preG_go_state := ⟨@GhostVarG.mk _ _ ⟨7, rfl⟩⟩
  goosePreGAllG := dsGF_allG

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: the driver's initialization, then `Main(checks)`. -/
def dsProgram [GoSemanticsFunctions] (nchk : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.Main) #nchk

/-- **The DaemonSet controller never puts two pods of a DaemonSet on one node** (see the file
header): every real execution of `dsProgram nchk` from a fresh state with one thread, of `n`
steps (`n + 2 ≤ 2^30 - 1`): if the main thread has finished, its result is `#()`; no thread is
stuck; no thread has ended in a panic (the checker panics on two pods of the DaemonSet on one
node). Parametric in the Go semantics and the translation's assumptions. -/
theorem dsonepod_safe [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.Assumptions]
    (nchk : w64)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (n : Nat) (Hn : n + 2 ≤ 2 ^ 30 - 1) (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([dsProgram nchk], ((σ, g) : CfgState)) κs (t2, σ2)) :
    (∀ v t2', t2 = Val v :: t2' → v = #()) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  refine init_adequate (GF := dsGF)
    github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.initialize'
    ((@! github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.Main) #nchk)
    (fun v => v = #()) (fun p h => intoVal_ne_PanicV () p h.symm) σ g ⟨trivial, trivial⟩
    ⟨trivial, trivial⟩ Hlctx Hinit Hthreads n κs t2 σ2 Hsteps fun hG HN HT => ?_
  letI : HeapGS .hasLC dsGF := heapWith hG lctx
  have Hrb : receiptBound dsGF ≤ 2 ^ 63 := by rw [HN]; omega
  have Htb : threadBound dsGF ≤ 2 ^ 30 - 1 := by rw [HT]; omega
  unfold progOk0
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.wp_initialize' _
    github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.dsmain.getIsPkgInit_wf, ?_⟩
  iintro #Hpkg Htok
  wp_apply (wp_Main_closed nchk) $$ [Hpkg Htok]
  · iframe
    iframe #
    ipureintro
    exact ⟨Htb, Hrb⟩
  ipureintro
  rfl

end adequacy

end dsmain
end EtcdGrove
end Perennial
