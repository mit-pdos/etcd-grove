module

public import Spec.github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.apimodel.podClient__Get
public import Spec.github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.apimodel.Server__get
public import Proof.github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.apimodel.HistLemmas
public import Proof.github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.apimodel.WriteLemmas
public import Proof.github_com.mit_pdos.etcd_grove.examples.k8sdaemonset.apimodel.SrvLemmas

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial
namespace EtcdGrove
namespace apimodel

open Iris Iris.BI Iris.ProofMode
open github_com.mit_pdos.etcd_grove.examples.k8sdaemonset

section proof
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : apimodel.Assumptions]

theorem podClient.Get.wp_proof
    (wp_get : Server.get.spec (GF := GF) (hG := hG)) :
    podClient.Get.spec (GF := GF) (hG := hG) := by
  intro _ c γ cfg ns admin ctx name opts
  wp_start as Hc
  unfold podClientAt
  icases Hc with ⟨%s, #Hs, #Hns, #Ha, #Hsrv⟩
  ihave #Hsrv' := Hsrv
  iunfold isServer at Hsrv'
  icases Hsrv' with ⟨%L, #Hfx⟩
  iNamed Hfx
  ihave #Htab := Htp
  iunfold tableOf at Htab
  simp only [resField]
  wp_auto
  wp_apply (wp_get s γ cfg Res.pods L.tp.t ns name admin) $$ [$Hpkg $Hsrv $Htp]
  iapply (au_mono_read γ _ _)
  isplitl [HΦ]
  · iexact HΦ
  iintro %σ %hwf HK %x %err Hret
  iunfold getRet at Hret
  icases Hret with (⟨⟨%hm, %hx⟩, #He⟩ | Hr)
  · iunfold errIs at He
    icases He with ⟨%p, %st, %herr, #Hp, %hst⟩
    subst herr hx
    wp_auto
    iapply HK
    unfold getRetP
    ileft
    isplitr
    · ipureintro; exact ⟨hm, rfl⟩
    unfold errIs
    iexists p, st
    iframe #
    ipureintro; exact ⟨rfl, hst⟩
  · cases ho : getObj Res.pods ns name σ with
    | none =>
      icases Hr with ⟨%hx, #He⟩
      iunfold errIs at He
      icases He with ⟨%p, %st, %herr, #Hp, %hst⟩
      subst herr hx
      wp_auto
      iapply HK
      unfold getRetP
      iright
      isplitr
      · ipureintro; rfl
      unfold errIs
      iexists p, st
      iframe #
      ipureintro; exact ⟨rfl, hst⟩
    | some o =>
      have hres := (wf_stored hwf ho).1
      cases o with
      | pod d =>
        icases Hr with ⟨%herr, Hr⟩
        iunfold objAt at Hr
        icases Hr with ⟨%l, %hx, Hl⟩
        subst herr hx
        wp_auto
        iapply HK
        unfold getRetP
        iright
        isplitr
        · ipureintro; rfl
        unfold objPtrAt
        iexact Hl
      | node d => simp [Obj.res] at hres
      | ds d => simp [Obj.res] at hres
      | cr d => simp [Obj.res] at hres

end proof

end apimodel
end EtcdGrove
end Perennial
