theorem daemonSetClient.List.wp_proof
    (wp_list : Server.list.spec (GF := GF) (hG := hG)) :
    daemonSetClient.List.spec (GF := GF) (hG := hG) := by
  intro _ c γ cfg ns admin ctx opts dq lo
  wp_start as ⟨Hc, Ho⟩
  unfold dsClientAt
  icases Hc with ⟨%s, #Hs, #Hns, #Ha, #Hsrv⟩
  ihave #Hsrv' := Hsrv
  iunfold isServer at Hsrv'
  icases Hsrv' with ⟨%L, #Hfx⟩
  iNamed Hfx
  ihave #Htab := Htd
  iunfold tableOf at Htab
  simp only [resField]
  wp_auto
  wp_apply (wp_list s γ cfg Res.daemonSets L.td.t ns opts dq lo admin) $$ [$Hpkg $Hsrv $Htd $Ho]
  iapply (au_mono_read γ _ _) $$ [$HΦ]
  iintro %σ %hwf HK %sl %rv %err ⟨Ho, Hret⟩
  iunfold listRet at Hret
  by_cases hsel : lo.LabelSelector' ≠ go!"" ∨ lo.FieldSelector' ≠ go!""
  · rw [if_pos hsel]
    iunfold errIs at Hret
    icases Hret with ⟨%p, %st, %herr, #Hp, %hst⟩
    subst herr
    wp_auto
    iapply HK
    iframe Ho
    unfold typedListRet
    rw [if_pos hsel]
    isplitr
    · ipureintro; rfl
    unfold errIs
    iexists p, st
    iframe #
    ipureintro; exact ⟨rfl, hst⟩
  · rw [if_neg hsel]
    icases Hret with (⟨%hm, #He⟩ | ⟨%herr, Hl⟩)
    · iunfold errIs at He
      icases He with ⟨%p, %st, %herr, #Hp, %hst⟩
      subst herr
      wp_auto
      iapply HK
      iframe Ho
      unfold typedListRet
      rw [if_neg hsel]
      ileft
      isplitr
      · ipureintro; exact ⟨hm, rfl⟩
      unfold errIs
      iexists p, st
      iframe #
      ipureintro; exact ⟨rfl, hst⟩
    · subst herr
      iunfold listedAt at Hl
      icases Hl with ⟨%xs, %os, Hsl, Hxs, %hlist, #Hpast⟩
      ihave %Hsll := ownSlice_len _ _ _ $$ Hsl
      ihave %Hxl := (BigSepL2.bigSepL2_length (PROP := IProp GF)) $$ Hxs
      wp_auto
      wp_apply (wp_slice_make2 (V := k8s_io.api.apps.v1.DaemonSet) sl.len) as %isl ⟨Hisl, Hicap⟩
      · ipureintro; exact Hsll.2
      (try wp_auto)
      have hres := listOk_res hwf hlist.1
      rename_i igo
      irename : (igo ↦ zero_val w64 : IProp GF) => Higo
      icases typedPointsto_not_null_dup _ _ _ $$ «$r0» with ⟨«$r0», %Hqnn⟩
      iStructNamedSuffix «$r0» "_q"
      ihave IH : iprop(∃ (n k : w64) (ox : GoInterface) (vs : List k8s_io.api.apps.v1.DaemonSet) (ds : List kd.apps.DaemonSet),
          "i" ∷ i_ptr ↦ n ∗ "Higo" ∷ igo ↦ k ∗ "o" ∷ o_ptr ↦ ox ∗
          "Hisl" ∷ isl ↦* (vs ++ List.replicate (sint.nat sl.len - sint.nat n) (zero_val k8s_io.api.apps.v1.DaemonSet)) ∗
          "Hds" ∷ ([∗list] v;d ∈ vs;ds, kd.apps.DaemonSet.own v (DFrac.own 1) d) ∗
          "Hrest" ∷ ([∗list] x;o ∈ xs.drop (sint.nat n);os.drop (sint.nat n), objAt x (DFrac.own 1) o) ∗
          "Hsl" ∷ sl ↦* xs ∗
          "%Hn" ∷ ⌜0 ≤ sint.Z n ∧ sint.nat n ≤ xs.length ∧ vs.length = sint.nat n ∧
            os.take (sint.nat n) = ds.map Obj.ds⌝) $$ [i Higo o Hisl Hxs Hsl]
      · iexists W64 0, _, _, [], []
        simp only [named, List.nil_append, List.drop_zero, List.take_zero, List.map_nil]
        iframe
        isplitr
        · iapply BigSepL2.bigSepL2_nil.2; itrivial
        ipureintro
        refine ⟨by word, by word, rfl, rfl⟩
      wp_for IH
      wp_if_destruct
      · have Hlt : sint.nat n < xs.length := by word
        have Hlto : sint.nat n < os.length := by omega
        have Hbnd : 0 ≤ sint.Z n ∧ sint.Z n < sint.Z sl.len := ⟨Hn.1, Hif⟩
        simp only [Hbnd, and_self, ↓reduceIte]
        obtain ⟨x, Hx⟩ : ∃ x, xs[sint.nat n]? = some x := ⟨_, List.getElem?_eq_getElem Hlt⟩
        wp_apply wp_load_slice_index sl (sint.Z n) xs (DFrac.own 1) x Hn.1 $$ [Hsl] as Hsl
        · iframe; ipureintro; exact Hx
        rw [List.drop_eq_getElem_cons Hlt, List.drop_eq_getElem_cons Hlto]
        icases Hrest with ⟨Hx1, Hrest⟩
        have hxe : xs[sint.nat n]'Hlt = x := by
          rw [List.getElem?_eq_getElem Hlt] at Hx; exact Option.some.inj Hx
        rw [hxe]
        obtain ⟨on, hon⟩ : ∃ on, os[sint.nat n]? = some on := ⟨_, List.getElem?_eq_getElem Hlto⟩
        have hone : os[sint.nat n]'Hlto = on := by
          rw [List.getElem?_eq_getElem Hlto] at hon; exact Option.some.inj hon
        have hro := hres _ (List.mem_of_getElem? hon)
        rw [hone]
        cases on with
        | ds d =>
          iunfold objAt at Hx1
          icases Hx1 with ⟨%l', %hl', Hl'⟩
          iunfold dsAt at Hl'
          icases Hl' with ⟨%v, Hl', Hd⟩
          subst hl'
          (try wp_auto)
          ihave %Hil := ownSlice_len _ _ _ $$ Hisl
          obtain ⟨Hbnd2, Hbnd3, Hpos⟩ := list_bnd vs _ n isl.len sl.len Hn.1 Hif Hn.2.2.1 Hil Hsll.2
          simp only [Hbnd2, and_self, ↓reduceIte]
          wp_apply (wp_store_slice_index isl (sint.Z n) _ v) $$ [Hisl] as Hisl
          · iframe; ipureintro; exact Hbnd3
          rw [show (sint.Z n).toNat = vs.length by rw [Hn.2.2.1],
            list_set_app_replicate vs (sint.nat sl.len - sint.nat n) _ v Hpos]
          wp_for_post
          iframe
          iexists n + W64 1, n, _, vs ++ [v], ds ++ [d]
          simp only [named]
          have hn1 : sint.nat (n + W64 1) = sint.nat n + 1 := by word
          rw [hn1, show sint.nat sl.len - (sint.nat n + 1) = sint.nat sl.len - sint.nat n - 1 by omega]
          iframe
          isplitl []
          · iapply BigSepL2.bigSepL2_nil.2; itrivial
          ipureintro
          refine ⟨by word, by omega, by simp [Hn.2.2.1], ?_⟩
          rw [List.take_succ, Hn.2.2.2, hon]
          simp
        | _ => simp [Obj.res] at hro
      · -- the loop is done
        have Hge : xs.length ≤ sint.nat n := by word
        have Hnl : sint.nat n = xs.length := by omega
        have Hos : os = ds.map Obj.ds := by
          rw [← Hn.2.2.2, Hnl, Hxl, List.take_of_length_le (Nat.le_refl _)]
        rw [show sint.nat sl.len - sint.nat n = 0 by omega, List.replicate_zero, List.append_nil]
        (try wp_auto)
        iapply HK
        iframe Ho
        unfold typedListRet
        rw [if_neg hsel]
        iright
        isplitr
        · ipureintro; rfl
        iexists os
        isplitl [TypeMeta_q ListMeta_q Items_q Hisl Hds]
        · simp only [typedListAt]
          iexists (⟨(zero_val k8s_io.apimachinery.pkg.apis.«meta».v1.TypeMeta), ⟨[], rv, [], null, null⟩, isl⟩ :
            k8s_io.api.apps.v1.DaemonSetList), vs, ds
          isplitl [TypeMeta_q ListMeta_q Items_q]
          · iapply typedPointsto_combine _ _ _ Hqnn
            simp only [TypedPointsto.typedPointstoDef]
            iframe
          isplitr
          · ipureintro; exact ⟨hlist.2, Hos⟩
          iframe
        isplitr
        · ipureintro; exact hlist.1
        iframe #

end proof

