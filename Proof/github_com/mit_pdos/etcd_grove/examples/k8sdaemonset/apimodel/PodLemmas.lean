/-- The facts `podGrace` reads off a pod. -/
theorem pod_grace_facts (v : k8s_io.api.core.v1.Pod) (dq : DFrac) (d : kd.core.Pod) :
    kd.core.Pod.own (GF := GF) v dq d ⊢ kd.core.Pod.own v dq d ∗
      ⌜v.Spec'.NodeName' = d.Spec'.NodeName' ∧ v.Status'.Phase' = d.Status'.Phase' ∧
        (v.Spec'.TerminationGracePeriodSeconds' = null ↔ d.Spec'.TerminationGracePeriodSeconds' = none)⌝ := by
  unfold kd.core.Pod.own
  iintro ⟨TypeMeta, ObjectMeta, Spec, Status⟩
  iunfold kd.core.PodSpec.own at Spec
  iunfold kd.core.PodStatus.own at Status
  icases Spec with ⟨Volumes, InitContainers, Containers, EphemeralContainers, RestartPolicy, TerminationGracePeriodSeconds, ActiveDeadlineSeconds, DNSPolicy, NodeSelector, ServiceAccountName, DeprecatedServiceAccount, AutomountServiceAccountToken, %hn, HostNetwork, HostPID, HostIPC, ShareProcessNamespace, SecurityContext, ImagePullSecrets, Hostname, Subdomain, Affinity, SchedulerName, Tolerations, HostAliases, PriorityClassName, Priority, DNSConfig, ReadinessGates, RuntimeClassName, EnableServiceLinks, PreemptionPolicy, Overhead, TopologySpreadConstraints, SetHostnameAsFQDN, OS, HostUsers, SchedulingGates, ResourceClaims, Resources, HostnameOverride, SchedulingGroup, EvictionResponders⟩
  icases Status with ⟨ObservedGeneration, %hp, Conditions, Message, Reason, NominatedNodeName, HostIP, HostIPs, PodIP, PodIPs, StartTime, InitContainerStatuses, ContainerStatuses, QOSClass, EphemeralContainerStatuses, Resize, ResourceClaimStatuses, ExtendedResourceClaimStatus, AllocatedResources, Resources, NodeAllocatableResourceClaimStatuses, VolumeHealth⟩
  icases ownPtrD_null _ _ _ _ $$ TerminationGracePeriodSeconds with ⟨TerminationGracePeriodSeconds, %ht⟩
  isplitl
  · unfold kd.core.PodSpec.own kd.core.PodStatus.own
    simp only [named]
    iframe
    ipureintro; exact ⟨hn, hp⟩
  · ipureintro; exact ⟨hn, hp, ht⟩

/-- A pod's termination grace period, read. -/
theorem pod_tgps_acc (v : k8s_io.api.core.v1.Pod) (dq : DFrac) (d : kd.core.Pod) (g : w64)
    (h : d.Spec'.TerminationGracePeriodSeconds' = some g) :
    kd.core.Pod.own (GF := GF) v dq d ⊢ v.Spec'.TerminationGracePeriodSeconds' ↦{dq} g ∗
      (v.Spec'.TerminationGracePeriodSeconds' ↦{dq} g -∗ kd.core.Pod.own v dq d) := by
  unfold kd.core.Pod.own
  iintro ⟨TypeMeta, ObjectMeta, Spec, Status⟩
  iunfold kd.core.PodSpec.own at Spec
  icases Spec with ⟨Volumes, InitContainers, Containers, EphemeralContainers, RestartPolicy, TerminationGracePeriodSeconds, ActiveDeadlineSeconds, DNSPolicy, NodeSelector, ServiceAccountName, DeprecatedServiceAccount, AutomountServiceAccountToken, NodeName, HostNetwork, HostPID, HostIPC, ShareProcessNamespace, SecurityContext, ImagePullSecrets, Hostname, Subdomain, Affinity, SchedulerName, Tolerations, HostAliases, PriorityClassName, Priority, DNSConfig, ReadinessGates, RuntimeClassName, EnableServiceLinks, PreemptionPolicy, Overhead, TopologySpreadConstraints, SetHostnameAsFQDN, OS, HostUsers, SchedulingGates, ResourceClaims, Resources, HostnameOverride, SchedulingGroup, EvictionResponders⟩
  rw [h]
  ihave TerminationGracePeriodSeconds := (ownPtrD_base_some _ _ _).1 $$ TerminationGracePeriodSeconds
  iframe TerminationGracePeriodSeconds
  iintro TerminationGracePeriodSeconds
  ihave TerminationGracePeriodSeconds := (ownPtrD_base_some _ _ _).2 $$ TerminationGracePeriodSeconds
  unfold kd.core.PodSpec.own
  rw [h]
  simp only [named]
  iframe

