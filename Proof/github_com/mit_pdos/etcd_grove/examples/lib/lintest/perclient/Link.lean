/-
The porcupine driver's per-client variant's proofs (`examples/lib/lintest/perclient`), every proof instantiated with its
callees' results. All of them are Lean-first, listed with their callees in
`etc/link-lean-first-perclient.txt`. Generated by `etc/gen-link.py --perclient` -- do not edit by
hand.

`#print axioms` on a result is its trust base.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.lintest.perclient.Run
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.lintest.perclient.runClient
public import Proof.github_com.anishathalye.porcupine.Link

@[expose] public section

noncomputable section

namespace Perennial
namespace EtcdGrove
namespace perclient

open Iris Iris.BI github_com.mit_pdos.etcd_grove.examples.lib.lintest.perclient github_com.anishathalye.porcupine

section links
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.lib.lintest.perclient.Assumptions]
variable [NaInvG GF]

end links

/-! The specs stated at `HeapGS HasLC.hasLC GF`: those using channels, `sync.Once` or
`context` (Perennial states them there: their invariants need later credits). -/
section links_hasLC
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.lib.lintest.perclient.Assumptions]
variable [NaInvG GF]

theorem wp_runClient :
    EtcdGrove.perclient.runClient.spec (GF := GF) (hG := hG) :=
  EtcdGrove.perclient.runClient.wp_proof

theorem wp_Run :
    EtcdGrove.perclient.Run.spec (GF := GF) (hG := hG) :=
  EtcdGrove.perclient.Run.wp_proof wp_runClient porcupine.wp_CheckOperationsVerbose

end links_hasLC

end perclient
end EtcdGrove
end Perennial
