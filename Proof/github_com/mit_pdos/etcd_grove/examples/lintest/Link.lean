/-
The porcupine driver's proofs (`examples/lintest`), every proof instantiated with its
callees' results. All of them are Lean-first, listed with their callees in
`etc/link-lean-first-lintest.txt`. Generated by `etc/gen-link.py --lintest` -- do not edit by
hand.

`#print axioms` on a result is its trust base.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.lintest.CounterClock
public import Proof.github_com.mit_pdos.etcd_grove.examples.lintest.Run
public import Proof.github_com.mit_pdos.etcd_grove.examples.lintest.runClient
public import Proof.github_com.anishathalye.porcupine.Link

@[expose] public section

noncomputable section

namespace Perennial
namespace EtcdGrove
namespace lintest

open Iris Iris.BI github_com.mit_pdos.etcd_grove.examples.lintest github_com.anishathalye.porcupine

section links
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.lintest.Assumptions]

end links

/-! The specs stated at `HeapGS HasLC.hasLC GF`: those using channels, `sync.Once` or
`context` (Perennial states them there: their invariants need later credits). -/
section links_hasLC
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.lintest.Assumptions]

theorem wp_CounterClock :
    EtcdGrove.lintest.CounterClock.spec (GF := GF) (hG := hG) :=
  EtcdGrove.lintest.CounterClock.wp_proof

theorem wp_runClient :
    EtcdGrove.lintest.runClient.spec (GF := GF) (hG := hG) :=
  EtcdGrove.lintest.runClient.wp_proof

theorem wp_Run :
    EtcdGrove.lintest.Run.spec (GF := GF) (hG := hG) :=
  EtcdGrove.lintest.Run.wp_proof wp_runClient porcupine.wp_CheckOperationsVerbose

end links_hasLC

end lintest
end EtcdGrove
end Perennial
