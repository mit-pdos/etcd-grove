/- Lean-first (no Rocq counterpart).

# The three-member linearizability instance's closed theorem (D20, D21, 2026-10-19)

linkv's closed theorem (`linkv/Adequacy.lean`) for `examples/linkv3`: the package's initialization
(which initializes its import closure: etcd's server, its gRPC layer, the client, raft, linkv,
porcupine, the driver `lintest`, ...) followed by `Main(clients, ops)` -- three etcd members started
in process (putget3's `startMember`: each serving its raft handler on its own peer listener), a
client to the first with etcd's default configuration, linkv's `Check(cli, clients, ops, 0)`
(`clients` clients of `ops` random operations each, the history checked by porcupine against the
key-value model), and a panic ("linkv3: porcupine found the history not linearizable") if porcupine
answers `Illegal` -- started from a fresh state (no package initialized, one thread): for every real
execution of `n` steps, the main thread's result, if it has one, is `Ok` or `Unknown`, no thread is
stuck, and no thread has ended in a panic.

It follows, as linkv's and putget3's, from `EtcdGrove.goose_adequacy_start` with the read package's
two metric names and the four addresses (the three peer addresses and the first member's client
address), over linkv's ghost-state bundle `linkvGF` (putget's with iris-lean's non-atomic
invariants at slot 11), from `linkv3`'s `wp_initialize'` (`Init.lean`, over the program's package
table `PkgTable.lean`, both generated by `etc/gen-init.py`) and `linkv3.wp_Main` (`Link.lean`).

**Its hypotheses** are putget3's (`putget3_adequate`) at linkv3's configuration
(`linkv3.BootFacts`: the member ids in `bootstrap`'s order; `linkv3.premises`; `linkv3Addrs`)
and `Run`'s bounds on `clients` and `ops` (linkv's).
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.linkv3.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.linkv3.PkgTable
public import Proof.github_com.mit_pdos.etcd_grove.examples.linkv.Adequacy

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] disk_op disk_model disk_semantics disk_interp

/-! ## The closed theorem -/

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `linkv3`'s initialization, then `Main(clients, ops)`. -/
def linkv3Program [GoSemanticsFunctions] (clients ops : w64) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.linkv3.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.linkv3.Main) #clients #ops

/-- The program's addresses: the three members' peer addresses and the first's client address. -/
def linkv3Addrs : List GoString :=
  [linkv3.peerAddr₁, linkv3.peerAddr₂, linkv3.peerAddr₃, linkv3.clientAddr₁]

/-- The read package's two metric names, which `linkv3`'s initialization registers (`readRegPerm`,
D16). -/
def linkv3Names : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **The three-member linearizability instance is safe** (see the file header): every real
execution of `linkv3Program clients ops` from a fresh state with one thread, of `n` steps: if the main thread has
finished, its result is `Ok` (porcupine found the history linearizable) or `Unknown` (a step before
the check failed); no thread is stuck; no thread has ended in a panic. -/
theorem linkv3_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.linkv3.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [Float64ToInt64Semantics] [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [ErrorStringLeaf] [RpctypesEtcdErrorMethods] [context.ErrorStringIsError]
    [context.DeadlineExceededIsError] [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC linkvGF, ContextReadErrs (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (Hms : v3rpc.ServerMethodSets)
    (hAs : errors.AsTarget go_etcd_io.etcd.api.v3.v3rpc.rpctypes.EtcdError.ty)
    (id₁ id₂ id₃ : w64) (bootLog : List EntryM) (Hbf : linkv3.BootFacts id₁ id₂ id₃ bootLog)
    (Hck : ckptEffectsOk) (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hdbo : storage.dbOpensOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (HNs : prometheus.namesUnclaimed (linkv3Program clients ops) linkv3Names)
    (HAs : addrsUnclaimed (linkv3Program clients ops) linkv3Addrs)
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC linkvGF,
      ⊢ linkv3.premises (GF := linkvGF) (hG := linkvHeapAt hG lctx) n id₁ id₂ id₃ bootLog)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : g.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([linkv3Program clients ops], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 31) (Hwb : n + 7 ≤ backend.wbInit) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  suffices H : (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
      (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧ (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) by
    refine ⟨H.1, H.2.1, fun v hv => ?_⟩
    cases h : v.isPanic
    · rfl
    · obtain ⟨p, rfl⟩ := val.isPanic_eq_true h
      exact absurd (UnrecoveredPanic.panic p) (H.2.2 _ hv)
  refine goose_adequacy_start (GF := linkvGF) (n + 1) (n + 2) (linkv3Program clients ops) σ g
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown"))
    (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) trivial trivial
    linkv3Names linkv3Addrs (by decide) (by decide) HNs HAs ?_
    n κs t2 σ2 Hsteps (Nat.lt_succ_self n) Hthreads (realThreadsBelow_of_one Hthreads)
  intro hG HN HT HL
  have Hprem0 := Hprem hG
  have Hctx0 := Hctx hG
  obtain ⟨G, ⟨fl, lc, nh, gs⟩⟩ := hG
  subst Hlctx
  subst HL
  letI : HeapGS .hasLC linkvGF := ⟨G, ⟨fl, σ.goState.goLctx, nh, gs⟩⟩
  haveI := Hctx0
  unfold IsInit at Hinit
  rw [Hinit]
  iintro _ _ Hgs Htok Hrights
  ihave Hown : ownInitializing
      (github_com.mit_pdos.etcd_grove.examples.linkv3.getIsPkgInit (GF := linkvGF)) $$ [Hgs]
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    imodintro
    iapply BigSepM.bigSepM_empty.2
    itrivial
  iunfold startRights at Hrights
  simp only [linkv3Names, linkv3Addrs, BigSepL.bigSepL_cons, BigSepL.bigSepL_nil]
  icases Hrights with ⟨⟨Hn1, Hn2, -⟩, ⟨Ha₁, Ha₂, Ha₃, Hac, -⟩, ⟨Hf₁, Hf₂, Hf₃, -, -⟩⟩
  ihave #Hprem' := Hprem0
  imodintro
  unfold linkv3Program
  wp_apply (github_com.mit_pdos.etcd_grove.examples.linkv3.wp_initialize' _
      github_com.mit_pdos.etcd_grove.examples.linkv3.getIsPkgInit_wf) $$ [Hown Hn1 Hn2]
    as ⟨_, #Hinit⟩
  · iframe Hown
    iunfold read.readRegPerm
    iframe
  have hM := linkv3.wp_Main (GF := linkvGF) n id₁ id₂ id₃ bootLog clients ops Hbf
    (by rw [HT]; omega) (by rw [HN]; omega) (by rw [HN]; omega) Hck Haf Hbuq Hdbo Hms hAs
    Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Ha₁ Ha₂ Ha₃ Hac Hf₁ Hf₂ Hf₃ Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

end EtcdGrove
end Perennial
