/- Lean-first (no Rocq counterpart).

# authlease's closed theorem (auth-lease S4, statement `notes/auth-lease-s4-draft.md` §2, 2026-11-19)

A closed theorem about the operational semantics of `authlease`'s program (`examples/etcd/authlease`): the
package's initialization followed by `Main(k)` -- `k` etcd members of one new cluster started in process
with the simple token provider and the revocable lease mode (`etcdstart.Members`, `etcdstart.StartMembersAuth`),
then the lease checks across them (`run`: every member's gRPC API served, the set-up and the lease set-up through
member `0`, root's barriers at every member, the clients with no and with an invalid token, `u` and `v` through
members `0`, `1 mod k`, `2 mod k`) -- started from a fresh state (no package initialized, one thread): for every
member count `1 ≤ k ≤ 1000` and every real execution of `n` steps, the main thread's result, if it has one, is
`Ok` (`0`) or `Failed` (`1`), no thread is stuck, and no thread has ended in a panic.

It is authN's (`authN/Adequacy.lean`) with the lease premises of leaseexpiryN's and `etcd_leasegrant_safe`'s: the
members' ids apart (`leaseIdsApart`), the peers' `/leases/internal` answers (`leasePeersOk`), and no lease
expiring during the run (`lease.leasesNoExpiry`); from `authlease`'s `wp_initialize'` (`Init.lean`, over
`PkgTable.lean`, both generated by `etc/gen-init.py`) and `etcd_authlease.wp_Main` (`MainLinked.lean`). Over Linux
files, as authN's (`Hfs`).
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.AdequacyMembers
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.authlease.MainLinked
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.authlease.PkgTable
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.putget.Adequacy
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.Results
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.FsExts
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.authlease.InitLinked

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] etcdFsExts etcdFsExtsSemantics etcdFsExtsInterp etcdFsExts_hasIdIssue
  etcdFsExts_hasFs etcdFsSem etcdFsSemOk etcdFsNoErr

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `authlease`'s initialization, then `Main(k)`. -/
def authleaseProgram [GoSemanticsFunctions] (k : Nat) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.etcd.authlease.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.etcd.authlease.Main) #(W64 (k : Int))

/-- The read package's two metric names, which `authlease`'s initialization registers (authN's). -/
def authleaseNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **authlease is safe** (see the file header). -/
theorem etcd_authlease_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.etcd.authlease.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [_root_.Perennial.errors.Assumptions] [_root_.Perennial.fmt.Assumptions]
    [go_etcd_io.etcd.api.v3.v3rpc.rpctypes.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC putgetGF, ContextReadErrs (GF := putgetGF) (hG := heapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC putgetGF, ContextErrsClient (GF := putgetGF) (hG := heapAt hG lctx))
    -- (D22) the auth store's backend with auth on: trusted text, a named hypothesis
    (hD22 : ∀ hG : HeapGS .hasLC putgetGF, ⊢ authSchemaSrv (GF := putgetGF) (hG := heapAt hG lctx))
    (k : Nat) (hk1 : 1 ≤ k) (hk : k ≤ 1000)
    (ids : List w64) (ps : List w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hlen : ids.length = k) (Hbf : etcd_putgetN.BootFacts ids ps ctxs boot)
    -- the members' ids distinct in their 15 low bits (`TestMemberIDs`)
    (Hap : leaseIdsApart ids)
    (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    -- peers answer `/leases/internal` as etcd's handler does or not with 200; no lease expires in the run
    (Hlp : leasePeersOk) (Hlne : lease.leasesNoExpiry)
    (HNs : prometheus.namesUnclaimed (authleaseProgram k) authleaseNames)
    (HAs : addrsUnclaimed (authleaseProgram k) (etcd_authlease.authleaseAddrs k))
    -- the members' data directories, fresh at start (`dataDirsAbsent`)
    (HDs : dataDirsAbsent (authleaseProgram k) (etcd_authlease.authleaseDirs k))
    -- `ETCD_VERIFY` off for the run
    (HEnv : verifyEnvOff (authleaseProgram k))
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC putgetGF,
      ⊢ etcd_authlease.premises (GF := putgetGF) (hG := heapAt hG lctx) k n ids ps ctxs boot)
    (σ : state) (g : GlobalState)
    (Hfs : Fs.FsInit (extLocal Fs.fsExt σ.world))
    (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([authleaseProgram k], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(W64 0) ∨ v = #(W64 1)) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) := by
  refine etcd_adequate_members (GF := putgetGF) (hAsLit := etcd_authlease.authleaseAddrs_lit k hk)
    (HEnv := HEnv) github_com.mit_pdos.etcd_grove.examples.etcd.authlease.initialize'
    ((@! github_com.mit_pdos.etcd_grove.examples.etcd.authlease.Main) #(W64 (k : Int)))
    (fun v => v = #(W64 0) ∨ v = #(W64 1)) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm)) (etcd_authlease.authleaseAddrs k)
    (etcd_authlease.authleaseAddrs_nodup k hk) (etcd_authlease.authleaseDirs k)
    (etcd_authlease.authleaseDirs_nodup k hk) (etcd_authlease.startAddrs k) []
    (etcd_authlease.authleaseAddrs_perm k) (etcd_authlease.authleaseDirs_perm k)
    σ g ⟨trivial, trivial, trivial⟩ ⟨trivial, Hfs, trivial⟩ Hlctx Hinit Hthreads HNs HAs HDs
    n κs t2 σ2 Hsteps fun hG HN HT => ?_
  letI : HeapGS .hasLC putgetGF := heapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.etcd.authlease.wp_initialize' _
    github_com.mit_pdos.etcd_grove.examples.etcd.authlease.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Hms, -⟩
  unfold etcd_authlease.startAddrs
  rw [BigSepL.bigSepL_map]
  have hM := etcd_authlease.wp_Main (GF := putgetGF) (hD22 hG) k n ids ps ctxs boot hk1 hk Hlen Hbf Hap
    (by rw [HT]; word) (srvLevels_of_max HT) (by rw [HN]; omega) (by rw [HN]; omega)
    (by unfold bootWB backend.wbInit; omega) Haf Hbuq Hrf Hdbo Hlp Hlne inferInstance
    EtcdGrove.rpctypesEtcdError_asTarget
  wp_apply hM $$ [Hms Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

end EtcdGrove
end Perennial
