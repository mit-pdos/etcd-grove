variable [go_gctx : GoGlobalContext]

/-- The program: the package's initialization, then `Main(k, clients, ops, sched)` with the schedule
built as a slice literal. -/
def txnlinfaultsNProgram [GoSemanticsFunctions] (k : Nat) (clients ops : w64)
    (steps : List github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.initialize' #() ;;
  App (App (App (App (Val (@! github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.Main))
    (Val #(W64 (k : Int)))) (Val #clients)) (Val #ops)) (schedLit steps)

/-- The read package's two metric names (partition's). -/
def txnlinfaultsNNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **txnlinfaultsN is safe** (see the file header): for every member count `1 ≤ k ≤ 1000` and every
schedule, every real execution of `txnlinfaultsNProgram k clients ops steps` from a fresh state with one
thread, of `n` steps: if the main thread has finished, its result is `Ok` or `Unknown`; no thread is stuck;
no thread has ended in a panic. -/
theorem etcd_txnlinfaultsN_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC linkvGF, ContextReadErrs (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC linkvGF, ContextErrsClient (GF := linkvGF) (hG := linkvHeapAt hG lctx))
    (k : Nat) (hk1 : 1 ≤ k) (hk : k ≤ 1000)
    (ids : List w64) (ps : List w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hlen : ids.length = k) (Hbf : etcd_txnlinfaultsN.BootFacts ids ps ctxs boot)
    (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    (clients ops : w64)
    (Hc0 : 0 ≤ sint.Z clients) (Hc31 : sint.Z clients < 2 ^ 31) (Hops : 0 ≤ sint.Z ops)
    (Hmul : sint.Z clients * sint.Z ops < 2 ^ 60)
    (steps : List github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step)
    (Hsteps : steps.length < 2 ^ 63)
    (HNs : prometheus.namesUnclaimed (txnlinfaultsNProgram k clients ops steps) txnlinfaultsNNames)
    (HAs : addrsUnclaimed (txnlinfaultsNProgram k clients ops steps)
      (etcd_txnlinfaultsN.txnlinfaultsNAddrs k))
    (HDs : dataDirsAbsent (txnlinfaultsNProgram k clients ops steps)
      (etcd_txnlinfaultsN.txnlinfaultsNDirs k))
    (HEnv : verifyEnvOff (txnlinfaultsNProgram k clients ops steps))
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC linkvGF,
      ⊢ etcd_txnlinfaultsN.premises (GF := linkvGF) (hG := linkvHeapAt hG lctx) k n ids ps ctxs boot)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps' : RealNsteps n ([txnlinfaultsNProgram k clients ops steps], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(go!"Ok") ∨ v = #(go!"Unknown")) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  refine etcd_adequate_members (GF := linkvGF)
    (hAsLit := etcd_txnlinfaultsN.txnlinfaultsNAddrs_lit k hk) (HEnv := HEnv)
    github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.initialize'
    (App (App (App (App (Val (@! github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.Main))
      (Val #(W64 (k : Int)))) (Val #clients)) (Val #ops)) (schedLit steps))
    (fun v => v = #(go!"Ok") ∨ v = #(go!"Unknown")) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => intoVal_ne_PanicV _ p h.symm))
    (etcd_txnlinfaultsN.txnlinfaultsNAddrs k) (etcd_txnlinfaultsN.txnlinfaultsNAddrs_nodup k hk)
    (etcd_txnlinfaultsN.txnlinfaultsNDirs k) (etcd_txnlinfaultsN.txnlinfaultsNDirs_nodup k hk)
    (etcd_txnlinfaultsN.startAddrs k) (etcd_txnlinfaultsN.bridges k)
    (etcd_txnlinfaultsN.txnlinfaultsNAddrs_perm k) (etcd_txnlinfaultsN.txnlinfaultsNDirs_perm k)
    σ g ⟨trivial, trivial⟩ ⟨trivial, trivial⟩ Hlctx Hinit Hthreads HNs HAs HDs
    n κs t2 σ2 Hsteps' fun hG HN HT => ?_
  letI : HeapGS .hasLC linkvGF := linkvHeapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.wp_initialize' _
    github_com.mit_pdos.etcd_grove.examples.etcd.txnlinfaultsN.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Hms, Hbs⟩
  unfold etcd_txnlinfaultsN.startAddrs
  rw [BigSepL.bigSepL_map]
  wp_bind (schedLit steps)
  unfold schedLit
  iapply (wp_slice_literal (V := github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step) (l := steps)
    (kvs := steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
  have hp := pure_wp_array_lit_full (hlc := HasLC.hasLC) (GF := linkvGF)
    (go.arrayLiteralSize
      (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
    github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty steps _ rfl
    (by rw [arrayLiteralSize_vals]; simp)
    (by rw [arrayLiteralSize_vals]; simpa using Hsteps)
  have hp' : ∀ Ψ : val → IProp linkvGF,
      iprop(▷ (£ 1 -∗ WP (Val #(array.mk
          (go.arrayLiteralSize
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
          steps)) {{ Ψ }})) ⊢
        WP (App (Val (GoInstruction (CompositeLiteral (go.ArrayType
            (go.arrayLiteralSize
              (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))
            github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty))))
          (Val (LiteralValueV
            (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))))
          {{ Ψ }} :=
    fun Ψ => hp.pure_wp_wp _ _ Ψ [] trivial
  iapply (hp' _)
  inext
  iintro -
  wp_auto
  isplitr
  · ipureintro; rfl
  iintro %sl ⟨Hsl, -⟩
  imod ownSlice_persist _ _ _ $$ Hsl with #Hsl
  (try wp_auto)
  have hM := etcd_txnlinfaultsN.wp_Main (GF := linkvGF) k n ids ps ctxs boot clients ops
    (slice.mk sl
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty))))
      (W64 (go.arrayLiteralSize
        (steps.map (arrayLitKE github_com.mit_pdos.etcd_grove.examples.lib.cluster3.Step.ty)))))
    steps hk1 hk Hlen Hbf
    (by rw [HT]; word) (srvLevels_of_max HT) (by rw [HN]; omega) (by rw [HN]; omega)
    (by unfold bootWB backend.wbInit; omega) Haf Hbuq Hrf Hdbo inferInstance
    EtcdGrove.rpctypesEtcdError_asTarget Hc0 Hc31 Hops Hmul
  wp_apply hM $$ [Hms Hbs Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

end adequacy

