namespace Perennial

namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] etcdFsExts etcdFsExtsSemantics etcdFsExtsInterp etcdFsExts_hasIdIssue
  etcdFsExts_hasFs

section adequacy

variable [go_gctx : GoGlobalContext]

/-- The program: `putgetc`'s initialization, then `Main()`. -/
def putgetcProgram [GoSemanticsFunctions] : Expr :=
  github_com.mit_pdos.etcd_grove.examples.etcd.compacted.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.etcd.compacted.Main) #()

/-- The metric names the program's initialization registers (its closure's `PRE_RES` packages', D16;
mustreg, 2026-11-20, until then the read package's two, `readRegPerm`): its `initNames`. -/
def putgetcNames : List GoString := _root_.Perennial.github_com.mit_pdos.etcd_grove.examples.etcd.compacted.initNames

end adequacy
end EtcdGrove
end Perennial

end

