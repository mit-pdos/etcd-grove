/- Lean-first (no Rocq counterpart).

# auth3's closed theorem (the auth3 Scope's A1, `notes/auth3-scope.md`, 2026-11-14)

A closed theorem about the operational semantics of `auth3`'s program (`examples/etcd/auth3`): the
package's initialization (which initializes its import closure, `examples/etcd/auth` among it)
followed by `Main()` -- three etcd members of one new cluster started in process with the simple
token provider, each serving its raft handler on its own peer listener, then authkv's run on the
first (`auth.Run`: its gRPC API served, the auth state set up and auth enabled, the four principals'
workloads, root's last write and the history's check, `u`'s watch check), every client a client of
the first member -- started from a fresh state (no package initialized, one thread): for every real
execution of `n` steps, the main thread's result, if it has one, is `Ok` (`0`), `Failed` (`1`) or
`WatchEnded` (`2`), no thread is stuck, and no thread has ended in a panic.

It is putget3's (`putget3/Adequacy.lean`) at auth3's program, addresses (the three peer addresses
and the first member's client address), data directories and members, with authkv's result
values and its named hypothesis `hD22`, from `auth3`'s `wp_initialize'` (`Init.lean`, over
`PkgTable.lean`, both generated by `etc/gen-init.py`) and `etcd_auth3.wp_Main` (`MainLinked.lean`)
over the members' start with auth on (`startMember.lean`, at `server_new_auth_on` and
`server_Start`).

**Its hypotheses** are putget3's at auth3's configuration (`etcd_auth3.premises`, putget3's with
`AuthToken = "simple"`) and authkv's **`hD22`**, D22's `authSchemaSrv` (trusted text, a named
hypothesis: `auth/Adequacy.lean`'s header), which each member's `NewServer` uses.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.AdequacyMembers
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.auth3.MainLinked
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.auth3.PkgTable
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.putget.Adequacy
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.Results
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.TrivialExt

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] trivialExts trivialExtsSemantics trivialExtsInterp trivialExts_hasExt

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `auth3`'s initialization, then `Main()`. -/
def auth3Program [GoSemanticsFunctions] : Expr :=
  github_com.mit_pdos.etcd_grove.examples.etcd.auth3.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.etcd.auth3.Main) #()

/-- The program's addresses: the three members' peer addresses and the first's client address. -/
def auth3Addrs : List GoString :=
  [etcd_auth3.peerAddr₁, etcd_auth3.peerAddr₂, etcd_auth3.peerAddr₃, etcd_auth3.clientAddr₁]

/-- The read package's two metric names, which `auth3`'s initialization registers. -/
def auth3Names : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **auth3 is safe** (see the file header). -/
theorem etcd_auth3_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.etcd.auth3.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [_root_.Perennial.errors.Assumptions] [_root_.Perennial.fmt.Assumptions]
    [go_etcd_io.etcd.api.v3.v3rpc.rpctypes.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC putgetGF, ContextReadErrs (GF := putgetGF) (hG := heapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC putgetGF, ContextErrsClient (GF := putgetGF) (hG := heapAt hG lctx))
    -- (D22) the auth store's backend with auth on: trusted text, a named hypothesis
    (hD22 : ∀ hG : HeapGS .hasLC putgetGF, ⊢ authSchemaSrv (GF := putgetGF) (hG := heapAt hG lctx))
    (id₁ id₂ id₃ : w64) (ps : List w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hbf : etcd_putget3.BootFacts id₁ id₂ id₃ ps ctxs boot)
    (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    (HNs : prometheus.namesUnclaimed auth3Program auth3Names)
    (HAs : addrsUnclaimed auth3Program auth3Addrs)
    -- the members' data directories, fresh at start (`dataDirsAbsent`)
    (HDs : dataDirsAbsent auth3Program [(etcd_auth3.name₁ ++ go!".etcd"), (etcd_auth3.name₂ ++ go!".etcd"), (etcd_auth3.name₃ ++ go!".etcd")])
    -- `ETCD_VERIFY` off for the run
    (HEnv : verifyEnvOff auth3Program)
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC putgetGF,
      ⊢ etcd_auth3.premises (GF := putgetGF) (hG := heapAt hG lctx) n id₁ id₂ id₃ ps ctxs boot)
    (σ : state) (g : GlobalState) (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([auth3Program], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ v, Val v ∈ t2 → v.isPanic = false) := by
  refine etcd_adequate_members (GF := putgetGF) (hAsLit := by decide) (HEnv := HEnv) github_com.mit_pdos.etcd_grove.examples.etcd.auth3.initialize'
    ((@! github_com.mit_pdos.etcd_grove.examples.etcd.auth3.Main) #())
    (fun v => v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
        (fun h => intoVal_ne_PanicV _ p h.symm))) auth3Addrs (by decide)
    [(etcd_auth3.name₁ ++ go!".etcd"), (etcd_auth3.name₂ ++ go!".etcd"), (etcd_auth3.name₃ ++ go!".etcd")] (by decide)
    -- the members' start bundles: the three peers, member 1's client
    [(etcd_auth3.name₁, ⟨some etcd_auth3.peerAddr₁, some etcd_auth3.clientAddr₁⟩),
      (etcd_auth3.name₂, ⟨some etcd_auth3.peerAddr₂, none⟩),
      (etcd_auth3.name₃, ⟨some etcd_auth3.peerAddr₃, none⟩)] [] (by decide) (List.Perm.refl _)
    σ g ⟨trivial, trivial⟩ ⟨trivial, trivial⟩ Hlctx Hinit Hthreads HNs HAs HDs
    n κs t2 σ2 Hsteps fun hG HN HT => ?_
  letI : HeapGS .hasLC putgetGF := heapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.etcd.auth3.wp_initialize' _ github_com.mit_pdos.etcd_grove.examples.etcd.auth3.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Hms, -⟩
  icases Hms with ⟨Hs₁, Hs₂, Hs₃, -⟩
  have hM := etcd_auth3.wp_Main (GF := putgetGF) (hD22 hG) n id₁ id₂ id₃ ps ctxs boot Hbf
    (by rw [HT]; word) (srvLevels_of_max HT) (by rw [HN]; omega) (by rw [HN]; omega)
    (by unfold bootWB backend.wbInit; omega) Haf Hbuq Hrf Hdbo inferInstance
    EtcdGrove.rpctypesEtcdError_asTarget
  wp_apply hM $$ [Hs₁ Hs₂ Hs₃ Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)

end adequacy

end EtcdGrove
end Perennial
