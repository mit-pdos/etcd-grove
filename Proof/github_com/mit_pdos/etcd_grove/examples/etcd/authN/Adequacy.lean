/- Lean-first (no Rocq counterpart).

# authN's closed theorem (authN, `notes/authN-plan.md`, statement `notes/authN-draft.md`, 2026-11-16)

A closed theorem about the operational semantics of `authN`'s program (`examples/etcd/authN`): the
package's initialization followed by `Main(k)` -- `k` etcd members of one new cluster started in process
with the simple token provider (`etcdstart.Members`, `etcdstart.StartMembersAuth`), then authkv's run
across them (`run`: every member's gRPC API served, the set-up through member `0`, root's barrier read at
every member, the client with no token through member `0`, `u` and the client with an invalid token
through member `1 mod k`, `v` through member `2 mod k`, root's history check through member `0` and `u`'s
watch check through `u`'s member) -- started from a fresh state (no package initialized, one thread):
for every member count `1 ≤ k ≤ 1000` and every real execution of `n` steps, the main thread's result,
if it has one, is `Ok` (`0`), `Failed` (`1`) or `WatchEnded` (`2`), no thread is stuck, and no thread has
ended in a panic.

It is auth3's (`auth3/Adequacy.lean`) with putgetN's generalization to `k` members (`putgetN/Adequacy.lean`):
the program's `2k` addresses and `k` data directories (`authN/Dir.lean`), from `authN`'s `wp_initialize'`
(`Init.lean`, over `PkgTable.lean`, both generated by `etc/gen-init.py`) and `etcd_authN.wp_Main`
(`MainLinked.lean`).

**Its hypotheses** are auth3's at `k` members: putgetN's `BootFacts ids ps ctxs boot`, the size facts,
the program start's names, addresses and data directories unclaimed, `ETCD_VERIFY` off, the execution's
length and the trust-boundary contracts `etcd_authN.premises` at every ghost-state instance (authkv's
`hD22`, D22's `authSchemaSrv`, is proved since auth-schema-srv A7: `auth/Adequacy.lean`'s header).

**Over Linux files** (2026-11-16, the user's decision (A) on `wal-lean`, applied on the merge of `lean`):
the program's extensions are `[idIssueExt, fsExt]` (`lib/etcdstart/FsExts.lean`: the file extension's own
semantics, no premise on the environment), since `fileutil`'s package initializer, which the server's
initialization runs, probes `F_OFD_GETLK` through `syscall.FcntlFlock` over the file extension; the
theorem's one new premise is the file extension's initial state, `Fs.FsInit` (`Hfs`: the files as on
disk, the roots well formed), so it says that the program runs on a real file system. Until then the
extensions were `TrivialExt.lean`'s `[idIssueExt]`.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.AdequacyMembers
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.authN.MainLinked
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.authN.PkgTable
public import Proof.github_com.mit_pdos.etcd_grove.examples.etcd.putget.Adequacy
public import Proof.go_etcd_io.etcd.server.v3.etcdserver.Results
public import Proof.runtime.Start
public import Proof.runtime.Threads
public import Proof.github_com.mit_pdos.etcd_grove.examples.lib.etcdstart.FsExts

@[expose] public section

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode go_etcd_io.raft.v3

attribute [local instance] etcdFsExts etcdFsExtsSemantics etcdFsExtsInterp etcdFsExts_hasIdIssue
  etcdFsExts_hasFs

section adequacy
variable [go_gctx : GoGlobalContext]

/-- The program: `authN`'s initialization, then `Main(k)`. -/
def authNProgram [GoSemanticsFunctions] (k : Nat) : Expr :=
  github_com.mit_pdos.etcd_grove.examples.etcd.authN.initialize' #() ;;
  (@! github_com.mit_pdos.etcd_grove.examples.etcd.authN.Main) #(W64 (k : Int))

/-- The read package's two metric names, which `authN`'s initialization registers (auth3's). -/
def authNNames : List GoString := [read.slowReadIndexName, read.readIndexFailedName]

/-- **authN is safe** (see the file header). -/
theorem etcd_authN_adequate [lctx : GoLocalContext] [sem : go.Semantics]
    [package_sem : github_com.mit_pdos.etcd_grove.examples.etcd.authN.Assumptions]
    [cache_sem : go_etcd_io.etcd.cache.v3.Assumptions]
    [_root_.Perennial.errors.Assumptions] [_root_.Perennial.fmt.Assumptions]
    [go_etcd_io.etcd.api.v3.v3rpc.rpctypes.Assumptions]
    [go_etcd_io.etcd.client.v3.DialWithBalancerBody]
    [log.NewModel]
    (Hctx : ∀ hG : HeapGS .hasLC putgetGF, ContextReadErrs (GF := putgetGF) (hG := heapAt hG lctx))
    (Hcec : ∀ hG : HeapGS .hasLC putgetGF, ContextErrsClient (GF := putgetGF) (hG := heapAt hG lctx))
    (k : Nat) (hk1 : 1 ≤ k) (hk : k ≤ 1000)
    (ids : List w64) (ps : List w64) (ctxs : List (List w8)) (boot : List LogEntry)
    (Hlen : ids.length = k) (Hbf : etcd_putgetN.BootFacts ids ps ctxs boot)
    (Haf : authRecordsFit)
    (Hbuq : apply.backendUnderQuota) (Hrf : grpcRepliesFit) (Hdbo : storage.diskOk)
    (HNs : prometheus.namesUnclaimed (authNProgram k) authNNames)
    (HAs : addrsUnclaimed (authNProgram k) (etcd_authN.authNAddrs k))
    -- the members' data directories, fresh at start (`dataDirsAbsent`)
    (HDs : dataDirsAbsent (authNProgram k) (etcd_authN.authNDirs k))
    -- `ETCD_VERIFY` off for the run
    (HEnv : verifyEnvOff (authNProgram k))
    (n : Nat)
    (Hprem : ∀ hG : HeapGS .hasLC putgetGF,
      ⊢ etcd_authN.premises (GF := putgetGF) (hG := heapAt hG lctx) k n ids ps ctxs boot)
    (σ : state) (g : GlobalState)
    (Hfs : Fs.FsInit (extLocal Fs.fsExt σ.world))
    (Hlctx : σ.goState.goLctx = lctx) (Hinit : IsInit σ)
    (Hthreads : σ.threads = 1)
    (κs : List Observation) (t2 : List Expr) (σ2 : CfgState)
    (Hsteps : RealNsteps n ([authNProgram k], ((σ, g) : CfgState)) κs (t2, σ2))
    (Hn : n + 2 ≤ 2 ^ 28) :
    (∀ v t2', t2 = Val v :: t2' → v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) ∧
    (∀ e2, e2 ∈ t2 → RealNotStuck e2 σ2) ∧
    (∀ e2, e2 ∈ t2 → ¬ UnrecoveredPanic e2) := by
  refine etcd_adequate_members (GF := putgetGF) (hAsLit := etcd_authN.authNAddrs_lit k hk)
    (HEnv := HEnv) github_com.mit_pdos.etcd_grove.examples.etcd.authN.initialize'
    ((@! github_com.mit_pdos.etcd_grove.examples.etcd.authN.Main) #(W64 (k : Int)))
    (fun v => v = #(W64 0) ∨ v = #(W64 1) ∨ v = #(W64 2)) (fun p h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
      (fun h => h.elim (fun h => intoVal_ne_PanicV _ p h.symm)
        (fun h => intoVal_ne_PanicV _ p h.symm))) (etcd_authN.authNAddrs k)
    (etcd_authN.authNAddrs_nodup k hk) (etcd_authN.authNDirs k)
    (etcd_authN.authNDirs_nodup k hk) (etcd_authN.startAddrs k) []
    (etcd_authN.authNAddrs_perm k) (etcd_authN.authNDirs_perm k)
    σ g ⟨trivial, trivial, trivial⟩ ⟨trivial, Hfs, trivial⟩ Hlctx Hinit Hthreads HNs HAs HDs
    n κs t2 σ2 Hsteps fun hG HN HT => ?_
  letI : HeapGS .hasLC putgetGF := heapAt hG lctx
  haveI := Hctx hG
  haveI := Hcec hG
  unfold progOk
  refine ⟨_, _, github_com.mit_pdos.etcd_grove.examples.etcd.authN.wp_initialize' _
    github_com.mit_pdos.etcd_grove.examples.etcd.authN.getIsPkgInit_wf, ?_⟩
  ihave #Hprem' := Hprem hG
  iintro #Hinit Htok ⟨Hms, -⟩
  unfold etcd_authN.startAddrs
  rw [BigSepL.bigSepL_map]
  have hM := etcd_authN.wp_Main (GF := putgetGF) k n ids ps ctxs boot hk1 hk Hlen Hbf
    (by rw [HT]; word) (srvLevels_of_max HT) (by rw [HN]; omega) (by rw [HN]; omega)
    (by unfold bootWB backend.wbInit; omega) Haf Hbuq Hrf Hdbo inferInstance
    EtcdGrove.rpctypesEtcdError_asTarget
  wp_apply hM $$ [Hms Htok]
  · iframe; iframe #
  iintro %r %Hr
  ipureintro
  rcases Hr with rfl | rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)

end adequacy

