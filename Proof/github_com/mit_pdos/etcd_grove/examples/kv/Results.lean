/-
The exported results of the key-value store example (`examples/kv/{kv,cluster,check}.go`),
restated at top level, with the trust base of each printed in the build log (`#print axioms`).
Every Go function of the package has a `Spec`/`Proof` pair and a linked result (`Link.lean`,
generated by `etc/gen-link.py --kv`); raft's functions it calls are linked in raft's
`Link.lean`, the porcupine driver's (`Run`, `CounterClock`) in lintest's, porcupine's checker in
porcupine's.

* **`Put`/`Get`/`Append`** (`kv_Put`, `kv_Get`, `kv_Append`): logically atomic over the store's
  map (`rkvVal`): a client hands in an atomic update (`opAu`) at `kvMask`, which runs when raft
  commits the operation's first entry -- the linearization point -- and gets `Φ` back, of the
  key's value after the operation.
* **`Read`** (`kv_Read`): a linearizable read by raft's read index (`Node.ReadIndex`,
  `ReadOnlySafe`), stated with lower bounds on the store's history (`kvLb`); the history at any
  moment is a lower bound, at the client's map (`kv_regLb_current`).
* **`New`** (`kv_New`): a replica on its running node and storage; its `run` goroutine drives
  the node (`kv_run`), applying committed entries and conf changes.
* **`RemoveMember`, `TransferLeadership`** (`kv_RemoveMember`, `kv_TransferLeadership`):
  propose a conf change / a leadership transfer; nothing promised of the outcome.
* **The storage** (`kv_NewStorage`, `kv_storage_isStorage`, `kv_storage_initialState`):
  `*kv.Storage` meets raft's `Storage` contract (`isStorage`).
* **The ghost state's allocation** (`kvStorInv_alloc`, `rkvInv_alloc`, `Alloc.lean`).
* **The cluster** (`kv_StartCluster`, `cluster.go`) and **the randomized linearizability test**
  (`kv_Check`, `check.go`): `Check` over replicas of one store, from the empty store, returns
  `Ok`: porcupine accepts the trace of `Gen`'s random traffic against the store's model.
* **The top-level driver** (`kv_Main`): `{{ isPkgInit kv ∗ context.isClosedchanInit }} Main()
  {{ RET #(); True }}` for executions of fewer than `2^63` steps: the cluster is started, the
  test runs, and `Main`'s panic unless porcupine answers `Ok` is unreachable.
* **Adequacy** (`kv_adequate`, `AdequacyLinked.lean`, from `Adequacy.lean`'s `kv_adequate_of`):
  the same in the operational semantics, with package initialization proved (`Init.lean`):
  every execution of `initialize'(); Main()` from a fresh state, of fewer than `2^63` steps,
  has no stuck thread and no panic, so porcupine never rejects the store's trace.

Every result here assumes `[NaInvG GF]` (iris-lean's non-atomic invariants, which porcupine's
checker uses; the linked results of `Link.lean` take it), except the closed `kv_adequate`, whose
bundle `kvGF` provides it.
-/
module

public import Proof.github_com.mit_pdos.etcd_grove.examples.kv.Link
public import Proof.github_com.mit_pdos.etcd_grove.examples.kv.KVStorageInstance
public import Proof.github_com.mit_pdos.etcd_grove.examples.kv.Alloc
public import Proof.github_com.mit_pdos.etcd_grove.examples.kv.AdequacyLinked

@[expose] public section

-- `#print axioms` prints the axioms by their full names: shortening each name to the
-- shortest unambiguous one in this environment took most of this module's build (25s of
-- 31s for the server's `txn/Results.lean`).
set_option pp.fullNames true

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI Iris.ProofMode go_etcd_io.raft.v3

section results
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.kv.Assumptions]
variable [NaInvG GF]
variable [KVStor GF]

/-- `r.Put(key, val)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__Put.lean`). -/
theorem kv_Put : kv.KV.Put.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_Put

/-- `r.Get(key)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__Get.lean`). -/
theorem kv_Get : kv.KV.Get.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_Get

/-- `r.Append(key, val)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__Append.lean`). -/
theorem kv_Append : kv.KV.Append.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_Append

/-- `r.Read(key)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__Read.lean`). -/
theorem kv_Read : kv.KV.Read.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_Read

/-- **The history now is a lower bound** for `Read` (`kvLb`), at the client's map. -/
theorem kv_regLb_current (γr : RKVNames) (x : KVMap) :
    ⊢ rkvInv (GF := GF) γr -∗ raftCommitInv γr.raft -∗ rkvVal γr x ={⊤}=∗
      rkvVal γr x ∗ ∃ L, kvLb γr L ∗ ⌜kvFold L = x⌝ :=
  kvLb_current γr x ⊤ CoPset.subseteq_top raftN_regN

/-- `New(id, node, storage, send)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/New.lean`). -/
theorem kv_New : kv.New.spec (GF := GF) (hG := hG) :=
  kv.wp_New

/-- `r.RemoveMember(id)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__RemoveMember.lean`). -/
theorem kv_RemoveMember : kv.KV.RemoveMember.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_RemoveMember

/-- `r.TransferLeadership(to)`
(`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__TransferLeadership.lean`). -/
theorem kv_TransferLeadership : kv.KV.TransferLeadership.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_TransferLeadership

/-- `r.run(send)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/KV__run.lean`). -/
theorem kv_run : kv.KV.run.spec (GF := GF) (hG := hG) :=
  kv.KV.wp_run

/-- `NewStorage(voters)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/NewStorage.lean`). -/
theorem kv_NewStorage : kv.NewStorage.spec (GF := GF) (hG := hG) :=
  kv.wp_NewStorage

/-- **A store's storage is a raft `Storage`**: the storage `NewStorage` returns (its record,
`kvStorRec`) meets raft's `Storage` contract against the store's storage model. -/
theorem kv_storage_isStorage (s ms : Loc) (γs : MemStorNames) :
    ⊢ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.kv -∗
      kvStorRec (GF := GF) s ms γs -∗ isStorage (kvStorIface s) :=
  kvStorage_isStorage kv.Storage.wp_Snapshot s ms γs

/-- ... and its `InitialState` is a fresh empty hard state and the voters' conf state, read-only
for good, as `RestartNode` asks of its storage (raft v3.7: `RestartNode.spec`'s premise). -/
theorem kv_storage_initialState (s : Loc) (vsl : GoSlice) (voters : List w64)
    (σ : StorState) :
    ⊢ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.kv -∗
      s.[RStorage, go!"voters"] ↦□ vsl -∗ vsl ↦*□ voters -∗
      □ (∀ (Φ : val → IProp GF) (ss' : entryID),
           ownStorage (kvStorIface s) { σ with ss := ss' } -∗
           (∀ (hp cs : Loc) (al : Bool), ownStorage (kvStorIface s) { σ with ss := ss' } -∗
            hsOpt hp (HardStateM.mk (W64 0) (W64 0) (W64 0)) -∗
            csPts cs DFrac.discard (kv.kvConfState voters) al -∗
            Φ (PairV (PairV #hp #cs) #interface.nil)) -∗
           WP (App (Val #(methods (go.GoType.PointerType rStorageTy) go!"InitialState" #s))
             (Val #())) {{ Φ }}) :=
  kvStorage_initialState kv.Storage.wp_InitialState s vsl voters σ

/-- `StartCluster(ids)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/StartCluster.lean`). -/
theorem kv_StartCluster : kv.StartCluster.spec (GF := GF) (hG := hG) :=
  kv.wp_StartCluster

/-- **The randomized linearizability test** `Check(kvs, clock, clients, ops)`
(`Spec/github_com/mit_pdos/etcd_grove/examples/kv/Check.lean`): porcupine answers `Ok`. -/
theorem kv_Check : kv.Check.spec (GF := GF) (hG := hG) :=
  kv.wp_Check

end results

/-! The top-level driver, at no storage registry (the section has no `KVStor`). -/
section main
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.kv.Assumptions]
variable [NaInvG GF]

/-- **The top-level driver** `Main()` (`Spec/github_com/mit_pdos/etcd_grove/examples/kv/Main.lean`):
from package initialization (with `context`'s `isClosedchanInit`), for executions of fewer
than `2^63` steps, it returns: porcupine accepts the test's trace. Stated at no storage
registry: the proof allocates one. -/
theorem kv_Main : kv.Main.spec (GF := GF) (hG := hG) :=
  kv.wp_Main

end main

