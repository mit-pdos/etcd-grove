/-
The package-initialization instances of bbolt's packages (`go.etcd.io/bbolt`, its `errors`,
`internal/common`, `internal/freelist`, translated with bodies by project bbolt) and of
`encoding/hex` (names only, the etcd project's; bbolt's `hexKvStringer` calls it), in one module of
their own, so that a bbolt proof imports them without the backend (2026-11-03: moved here from
`storage/backend/Base.lean` and `internal/common/Init.lean`). Each instance's well-formedness needs
the instances of every package it imports: Perennial's, `os`'s (`Proof/os/PkgInit.lean`),
`hash`'s and `hash/fnv`'s (`Proof/hash/PkgInit.lean`), `reflect`'s (`Proof/reflect/PkgInit.lean`)
and this repository's `syscall`'s and `golang.org/x/sys/unix`'s.

The facts are `True`, but for the root package (`bboltRootInit`: `runtime.GOOS` is `"linux"`, `GOARCH` `"amd64"`),
`errors` (`bboltErrorsInit`: `ErrBucketNotFound`, an `errors.New`
error, which the backend compares with `errors.Is`, and the other errors' values) and
`internal/common` (`bboltCommonInit`: `DefaultPageSize` holds 4096). Each package's `wp_initialize'` is its
`Init.lean` (`internal/common`'s `Initialize.lean`), generated by `etc/gen-init.py`.
-/
module

public import GeneratedProof.go_etcd_io.bbolt
public import Perennial.Proof.ProofPrelude
public import Perennial.Proof.bytes
public import Perennial.Proof.errors
public import Perennial.Proof.fmt
public import Perennial.Proof.io
public import Perennial.Proof.log
public import Perennial.Proof.math
public import Perennial.Proof.runtime
public import Perennial.Proof.sort
public import Perennial.Proof.strings
public import Perennial.Proof.sync
public import Perennial.Proof.sync.atomic
public import Perennial.Proof.time
public import Perennial.Proof.unsafe
public import Proof.os.PkgInit
public import Proof.hash.PkgInit
public import Proof.reflect.PkgInit
public import Proof.golang_org.x.sys.unix.PkgInit
public import Spec.fmt.ErrorOk

@[expose] public section

set_option linter.iris.style.nameCheck false

noncomputable section

namespace Perennial

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

namespace encoding.hex

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.encoding.hex :=
  define_is_pkg_init iprop(True)
instance get_isPkgInit_wf_inst : GetIsPkgInitWf (IProp GF) pkg_id.encoding.hex :=
  build_get_is_pkg_init_wf

end encoding.hex

namespace go_etcd_io.bbolt.errors

/-- The variable at `a` holds an `errors.New` error for good: a pointer error, a `*errorString`
(batch 36: `err != ErrInvalid` tells another pointer error from it), that `fmt` formats
(`bboltErrorsVars`' clause; a `def` with its own instance, as `bboltErrorsVars`). -/
def bboltErrVar (a : Loc) : IProp GF :=
  iprop(∃ e : GoInterfaceOk, a ↦□ GoInterface.ok e ∗
    ⌜_root_.Perennial.errors.IsPointerError e ∧
      e.ty = go.GoType.PointerType _root_.Perennial.errors.errorString.ty⌝ ∗
    EtcdGrove.fmtErrorOk (GoInterface.ok e))

instance bboltErrVar_persistent (a : Loc) : Persistent (bboltErrVar (GF := GF) a) := by
  unfold bboltErrVar; infer_instance

/-- The other variables of bbolt's `errors` hold fixed values, each an `errors.New` error: a
pointer error (`IsPointerError`: `err == ErrX` compares it at a pointer type) that `fmt` formats
(`fmtErrorOk`, `EtcdGrove.errorString_fmtErrorOk`: bbolt logs and returns them). bbolt's root
package's initializer loads them into its deprecated aliases (`errors.go`); `Meta.Validate`'s spec
needs `ErrInvalid`, `ErrVersionMismatch` and `ErrChecksum` non-`nil`; `DB.allocate` compares
`DB.mmap`'s error with `ErrMaxSizeReached`; `Begin`'s errors are logged (batch 30). -/
def bboltErrorsVars : IProp GF :=
  iprop(bboltErrVar (globalAddr ErrDatabaseNotOpen) ∗
    bboltErrVar (globalAddr ErrInvalid) ∗
    bboltErrVar (globalAddr ErrInvalidMapping) ∗
    bboltErrVar (globalAddr ErrVersionMismatch) ∗
    bboltErrVar (globalAddr ErrChecksum) ∗
    bboltErrVar (globalAddr ErrTimeout) ∗
    bboltErrVar (globalAddr ErrTxNotWritable) ∗
    bboltErrVar (globalAddr ErrTxClosed) ∗
    bboltErrVar (globalAddr ErrDatabaseReadOnly) ∗
    bboltErrVar (globalAddr ErrFreePagesNotLoaded) ∗
    bboltErrVar (globalAddr ErrBucketExists) ∗
    bboltErrVar (globalAddr ErrBucketNameRequired) ∗
    bboltErrVar (globalAddr ErrKeyRequired) ∗
    bboltErrVar (globalAddr ErrKeyTooLarge) ∗
    bboltErrVar (globalAddr ErrValueTooLarge) ∗
    bboltErrVar (globalAddr ErrMaxSizeReached) ∗
    bboltErrVar (globalAddr ErrIncompatibleValue) ∗
    bboltErrVar (globalAddr ErrSameBuckets) ∗
    bboltErrVar (globalAddr ErrDifferentDB) ∗
    bboltErrVar (globalAddr ErrBucketNotFound))

/-- (A `def` with its own instance: the instance search through the nineteen conjuncts exceeds its
size limit inside `bboltErrorsInit`.) -/
instance bboltErrorsVars_persistent : Persistent (bboltErrorsVars (GF := GF)) := by
  unfold bboltErrorsVars; infer_instance

/-- bbolt's `errors` package facts: `ErrBucketNotFound` (`errors.New("bucket not found")`, which
`DeleteBucket` returns and the backend compares with `errors.Is`) is a fixed `errors.New` error: a
pointer error, a leaf of an error tree, with no `Is` method (`*errorString` has only `Error`;
the model's method sets are uninterpreted, so this is stated, as `apply`'s `errLeaf`); and the
other variables hold fixed values (`bboltErrorsVars`). -/
abbrev bboltErrorsInit : IProp GF :=
  iprop(∃ e : GoInterfaceOk, globalAddr ErrBucketNotFound ↦□ GoInterface.ok e ∗
    ⌜_root_.Perennial.errors.IsPointerError e ∧ _root_.Perennial.errors.isLeafError e ∧
      methodSet e.ty !! go!"Is" ≠ some (go.Signature [go.error] false [go.bool])⌝ ∗
    bboltErrorsVars)

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.go_etcd_io.bbolt.errors :=
  define_is_pkg_init bboltErrorsInit
instance get_isPkgInit_wf_inst : GetIsPkgInitWf (IProp GF) pkg_id.go_etcd_io.bbolt.errors :=
  build_get_is_pkg_init_wf

end go_etcd_io.bbolt.errors

namespace go_etcd_io.bbolt.internal.common

/-- `internal/common`'s package facts: its one variable, `DefaultPageSize = os.Getpagesize()`
(`types.go`), holds 4096 for good (linux/amd64, `Spec/os/Getpagesize.lean`; Go never writes it
after initialization). Its other names are constants, which the translation unfolds. -/
abbrev bboltCommonInit : IProp GF :=
  iprop(globalAddr DefaultPageSize ↦□ (W64 4096))

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.go_etcd_io.bbolt.internal.common :=
  define_is_pkg_init bboltCommonInit
instance get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.go_etcd_io.bbolt.internal.common :=
  build_get_is_pkg_init_wf

end go_etcd_io.bbolt.internal.common

namespace go_etcd_io.bbolt.internal.freelist

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.go_etcd_io.bbolt.internal.freelist :=
  define_is_pkg_init iprop(True)
instance get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.go_etcd_io.bbolt.internal.freelist :=
  build_get_is_pkg_init_wf

end go_etcd_io.bbolt.internal.freelist

namespace go_etcd_io.bbolt

/-- bbolt's root package facts: the program runs on linux/amd64, `runtime.GOOS = "linux"` and
`runtime.GOARCH = "amd64"` (the trust-boundary axioms `runtime.GOOS_linux`/`GOARCH_amd64` of
`Proof/runtime/Init.lean`, which bbolt's `wp_initialize'` uses; `runtime`'s own `IsPkgInit` is
Perennial's, with the fact `True`). bbolt compares `GOOS` with `"windows"` in `DB.grow`, `DB.mmap`
and `DB.allocate`, and its loggers format both; a proof gets the equations from `isPkgInit` by
`bboltRootInit_goos`/`bboltRootInit_goarch`. And (batch 34) `discardLogger` holds `&nopLogger{}`
for good, a `*nopLogger` (`db.go`'s `lg != discardLogger` compares it at that pointer type):
`bboltRootInit_discard`. -/
abbrev bboltRootInit : IProp GF :=
  iprop(⌜_root_.Perennial.runtime.GOOS = #(go!"linux") ∧
    _root_.Perennial.runtime.GOARCH = #(go!"amd64")⌝ ∗
    ∃ l : Loc, globalAddr discardLogger ↦□
      interface.mkOk (go.GoType.PointerType nopLogger.ty) #l)

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.go_etcd_io.bbolt :=
  define_is_pkg_init bboltRootInit
instance get_isPkgInit_wf_inst : GetIsPkgInitWf (IProp GF) pkg_id.go_etcd_io.bbolt :=
  build_get_is_pkg_init_wf

/-- **`runtime.GOOS` is `"linux"`**, from bbolt's package facts. -/
theorem bboltRootInit_goos :
    isPkgInit (PROP := IProp GF) pkg_id.go_etcd_io.bbolt ⊢
      ⌜_root_.Perennial.runtime.GOOS = #(go!"linux")⌝ := 
  (isPkgInit_access _).trans (BIBase.Entails.trans sep_elim_left (pure_mono And.left))

/-- **`runtime.GOARCH` is `"amd64"`**, from bbolt's package facts. -/
theorem bboltRootInit_goarch :
    isPkgInit (PROP := IProp GF) pkg_id.go_etcd_io.bbolt ⊢
      ⌜_root_.Perennial.runtime.GOARCH = #(go!"amd64")⌝ := 
  (isPkgInit_access _).trans (BIBase.Entails.trans sep_elim_left (pure_mono And.right))

/-- **`discardLogger` holds a `*nopLogger`**, from bbolt's package facts (batch 34). -/
theorem bboltRootInit_discard :
    isPkgInit (PROP := IProp GF) pkg_id.go_etcd_io.bbolt ⊢
      ∃ l : Loc, globalAddr discardLogger ↦□
        interface.mkOk (go.GoType.PointerType nopLogger.ty) #l := 
  (isPkgInit_access _).trans sep_elim_right

end go_etcd_io.bbolt

end init

end Perennial
