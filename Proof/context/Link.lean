/-
etcd-grove's trust boundary of `context` (axioms), every proof instantiated with its
callees' results. All of them are Lean-first, listed with their callees in
`etc/link-lean-first-context.txt`. Generated by `etc/gen-link.py --context` -- do not edit by
hand.

`#print axioms` on a result is its trust base.
-/
module

public import Proof.context.Err

@[expose] public section

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI

section links
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]
variable [package_sem : _root_.Perennial.context.Assumptions]

end links

/-! The specs stated at `HeapGS HasLC.hasLC GF`: those using channels, `sync.Once` or
`context` (Perennial states them there: their invariants need later credits). -/
section links_hasLC
variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : _root_.Perennial.context.Assumptions]

theorem context.wp_Err :
    context.Err.spec (GF := GF) (hG := hG) :=
  context.Err.wp_proof

end links_hasLC

end EtcdGrove
end Perennial
