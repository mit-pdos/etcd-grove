/-- The bytes of a hex string. -/
def h (s : String) : List w8 :=
  let d (c : Char) : Nat := if c.toNat ≤ '9'.toNat then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10
  let rec go : List Char → List w8
    | a :: b :: t => BitVec.ofNat 8 (16 * d a + d b) :: go t
    | _ => []
  go s.toList

