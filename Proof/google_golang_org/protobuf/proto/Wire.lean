/-
**The protobuf wire format, as protobuf-go v1.36.12 writes and reads a flat message** (protobuf
trust-boundary stage S1, mit-pdos/etcd-grove#37): a generic encoder and decoder over `List w8`,
for messages whose known fields are scalars and `bytes` (no group or nested message is decoded
here; a per-type decoder decodes a nested message's bytes with its own schema), and the round trip.
Pure and computable: the per-type codecs built on it (raft's `Entry`, `ConfChangeV2`:
`Proof/go_etcd_io/raft/v3/PbWireRaft.lean`) are checked against protobuf-go by `#guard`
(`Proof/google_golang_org/protobuf/proto/EntryWireVectors.lean`, generated by
`examples/pbschema/wirevectors_test.go`).

**The encoding** (`encode`): a message's records, then its unknown fields' bytes verbatim
(`internal/impl/encode.go`: the coder fields in field-number order, then `unknownFields`); a
record is its tag `varint(num * 8 + wire type)` (`protowire.AppendTag`) and its value: a varint
(wire type 0), 8 or 4 little-endian bytes (1, 5), a length and the bytes (2). Proto2 explicit
presence (`optF`): a field is written iff it is present, zero or not (`encode.go`, `isPointer`
fields skipped when nil). The per-type encoder lists the records in field-number order.

**The decoding** (`decode`; `internal/impl/decode.go`, `unmarshalPointer`), the input's records in
order:
- a tag: a varint (`readVarint`: at most 10 bytes, the 10th 0 or 1, `protowire.ConsumeVarint`;
  possibly not minimal), its number in `1 .. 2^29 - 1`, its wire type not 4 (end group: no group
  is open at a message's level), else an error;
- a field the schema declares with that wire type (`known`): its value (`readKnown`: a varint, a
  length-delimited value whose length fits the input, fixed bytes), recorded in `ks` in input
  order (a scalar's last record wins, `lastVarint`; a repeated field's records are all kept);
- any other record (the coders' `errUnknown`): skipped by `protowire.ConsumeFieldValue` (`skip`:
  groups nested at most 10001 deep, ended by the end-group tag of their number, inner numbers in
  `1 .. 2^31 - 1`, wire types 6 and 7 errors) and kept in the unknown fields as its tag
  re-encoded minimally (`protowire.AppendTag`) and its value verbatim.

**The round trip** (`decode_encode`): records of known fields and unknown fields as the decoder
leaves them (`ufWire`, `UfWire.lean`) decode back to themselves.
-/
module

public import Proof.google_golang_org.protobuf.proto.UfWire

@[expose] public section

namespace Perennial
namespace EtcdGrove
namespace Wire

/-! ## The encoding -/

/-- A record's value: a varint (wire type 0), 8 little-endian bytes (1), a length-delimited value
(2), 4 little-endian bytes (5). -/
inductive FVal where
  | varint (n : Nat)
  | i64 (n : Nat)
  | len (bs : List w8)
  | i32 (n : Nat)
  deriving DecidableEq, Repr

/-- The wire type of a value. -/
def FVal.wt : FVal → Nat
  | .varint _ => 0
  | .i64 _ => 1
  | .len _ => 2
  | .i32 _ => 5

/-- `k` little-endian bytes of `n` (`protowire.AppendFixed64`/`AppendFixed32`). -/
def fixedLE : Nat → Nat → List w8
  | 0, _ => []
  | k + 1, n => BitVec.ofNat 8 n :: fixedLE k (n / 256)

/-- A value's bytes (after its tag). -/
def FVal.payload : FVal → List w8
  | .varint n => varintEnc n
  | .i64 n => fixedLE 8 n
  | .len bs => varintEnc bs.length ++ bs
  | .i32 n => fixedLE 4 n

/-- A value fits its wire type (what Go's `uint64`/`uint32` and slice lengths allow). -/
def FVal.Fits : FVal → Prop
  | .varint n => n < 2 ^ 64
  | .i64 n => n < 2 ^ 64
  | .len bs => bs.length < 2 ^ 64
  | .i32 n => n < 2 ^ 32

/-- A tag (`protowire.AppendTag`). -/
def tag (num wt : Nat) : List w8 := varintEnc (num * 8 + wt)

/-- One record. -/
def record (num : Nat) (v : FVal) : List w8 := tag num v.wt ++ v.payload

/-- The records, in order. -/
def encFields : List (Nat × FVal) → List w8
  | [] => []
  | p :: ks => record p.1 p.2 ++ encFields ks

/-- **A message's encoding**: its records, then its unknown fields. -/
def encode (ks : List (Nat × FVal)) (uf : List w8) : List w8 := encFields ks ++ uf

/-- A proto2 optional field numbered `num` (explicit presence): its record iff present. -/
def optF {α : Type} (num : Nat) (f : α → FVal) : Option α → List (Nat × FVal)
  | none => []
  | some a => [(num, f a)]

/-! ## The decoding -/

/-- `protowire.ConsumeVarint` from its `k`-th byte on: the value of the bytes from there (Horner:
`b mod 128 + 128 * rest`), and the input after it; at most 10 bytes, the 10th (`k = 9`) 0 or 1. -/
def readVarintK (k : Nat) : List w8 → Option (Nat × List w8)
  | [] => none
  | b :: bs =>
    if k = 9 then (if b.toNat < 2 then some (b.toNat, bs) else none)
    else if b.toNat < 128 then some (b.toNat, bs)
    else match readVarintK (k + 1) bs with
      | none => none
      | some (v, r) => some (b.toNat - 128 + 128 * v, r)

/-- **`protowire.ConsumeVarint`**: a varint's value and the input after it. -/
def readVarint (bs : List w8) : Option (Nat × List w8) := readVarintK 0 bs

/-- The little-endian value of bytes. -/
def leNat : List w8 → Nat
  | [] => 0
  | b :: bs => b.toNat + 256 * leNat bs

/-- `protowire.ConsumeFixed64`/`ConsumeFixed32` (`k = 8, 4`). -/
def readFixed (k : Nat) (bs : List w8) : Option (Nat × List w8) :=
  if bs.length < k then none else some (leNat (bs.take k), bs.drop k)

/-- **`protowire.ConsumeBytes`**: a length, then that many bytes. -/
def readLen (bs : List w8) : Option (List w8 × List w8) :=
  match readVarint bs with
  | none => none
  | some (m, r) => if r.length < m then none else some (r.take m, r.drop m)

/-- A tag whose number is in `1 .. lim - 1`: its number, its wire type, the input after it
(`protowire.ConsumeTag` inside a group: `lim = 2^31`; a message's level: `2^29`). -/
def readTag (lim : Nat) (bs : List w8) : Option (Nat × Nat × List w8) :=
  match readVarint bs with
  | none => none
  | some (t, r) => if t / 8 = 0 ∨ lim ≤ t / 8 then none else some (t / 8, t % 8, r)

/-- **`protowire.ConsumeFieldValue`** of a field numbered `num` of wire type `wt`, groups nested
at most `g` deep (`g = 10001` at a message's level: `DefaultRecursionLimit` 10000, a group
refused below 0): the input after the value. A group (3) is read as its fields up to its end-group
tag (4) of the same number. `fuel` above the input's length never runs out (each step reads a
byte). -/
def skip : (fuel g num wt : Nat) → List w8 → Option (List w8)
  | 0, _, _, _, _ => none
  | fuel + 1, g, num, wt, bs =>
    match wt with
    | 0 => (readVarint bs).map (·.2)
    | 1 => (readFixed 8 bs).map (·.2)
    | 2 => (readLen bs).map (·.2)
    | 5 => (readFixed 4 bs).map (·.2)
    | 3 =>
      if g = 0 then none
      else
        match readTag (2 ^ 31) bs with
        | none => none
        | some (num2, wt2, r) =>
          if wt2 = 4 then (if num2 = num then some r else none)
          else
            match skip fuel (g - 1) num2 wt2 r with
            | none => none
            | some r' => skip fuel g num 3 r'
    | _ => none

/-- The schema declares the field `num` with wire type `wt` (its coder takes it; else
`errUnknown`). -/
def known (s : FieldSchema) (num wt : Nat) : Bool :=
  s.any fun p => p.1 == num && p.2.contains wt

/-- A known field's value (no schema here declares a group field). -/
def readKnown (wt : Nat) (bs : List w8) : Option (FVal × List w8) :=
  match wt with
  | 0 => (readVarint bs).map fun p => (.varint p.1, p.2)
  | 1 => (readFixed 8 bs).map fun p => (.i64 p.1, p.2)
  | 2 => (readLen bs).map fun p => (.len p.1, p.2)
  | 5 => (readFixed 4 bs).map fun p => (.i32 p.1, p.2)
  | _ => none

/-- The decoder's loop (`unmarshalPointer`): the known records in input order and the unknown
fields' bytes. `fuel` above the input's length never runs out. -/
def decodeLoop (s : FieldSchema) : Nat → List w8 → Option (List (Nat × FVal) × List w8)
  | 0, _ => none
  | fuel + 1, bs =>
    if bs = [] then some ([], [])
    else
      match readTag (2 ^ 29) bs with
      | none => none
      | some (num, wt, r) =>
        if wt = 4 then none
        else if known s num wt then
          match readKnown wt r with
          | none => none
          | some (v, r') => (decodeLoop s fuel r').map fun p => ((num, v) :: p.1, p.2)
        else
          match skip (r.length + 1) 10001 num wt r with
          | none => none
          | some r' =>
            (decodeLoop s fuel r').map fun p => (p.1, tag num wt ++ r.take (r.length - r'.length) ++ p.2)

/-- **`proto.Unmarshal`** of `bs` into a message of schema `s` (a flat one: the field values as
read, nested messages' bytes undecoded): the known records in input order and the unknown fields;
`none` where it returns an error. -/
def decode (s : FieldSchema) (bs : List w8) : Option (List (Nat × FVal) × List w8) :=
  decodeLoop s (bs.length + 1) bs

/-- A scalar field's value: its last varint record (proto2/3 "last one wins"). -/
def lastVarint (ks : List (Nat × FVal)) (num : Nat) : Option Nat :=
  (ks.filterMap fun p => if p.1 = num then (match p.2 with | .varint n => some n | _ => none)
    else none).getLast?

/-- A `bytes` field's value: its last length-delimited record. -/
def lastLen (ks : List (Nat × FVal)) (num : Nat) : Option (List w8) :=
  (ks.filterMap fun p => if p.1 = num then (match p.2 with | .len bs => some bs | _ => none)
    else none).getLast?

/-- A repeated message field's elements' bytes, in order (each record appends one). -/
def allLen (ks : List (Nat × FVal)) (num : Nat) : List (List w8) :=
  ks.filterMap fun p => if p.1 = num then (match p.2 with | .len bs => some bs | _ => none)
    else none

/-! ## Varints -/

theorem varintEnc_lt128 {n : Nat} (h : n < 128) : varintEnc n = [W8 n] := by
  rw [varintEnc]; simp [h]

theorem varintEnc_ge128 {n : Nat} (h : ¬ n < 128) :
    varintEnc n = W8 (n % 128 + 128 : Nat) :: varintEnc (n / 128) := by
  rw [varintEnc]; simp [h]

theorem w8_toNat_of_lt {n : Nat} (h : n < 256) : (W8 (n : Int)).toNat = n := by
  simp only [W8, BitVec.toNat_ofInt]; omega

theorem varintEnc_ne_nil (n : Nat) : varintEnc n ≠ [] := by
  by_cases h : n < 128
  · rw [varintEnc_lt128 h]; simp
  · rw [varintEnc_ge128 h]; simp

theorem pow_seven_step (k : Nat) (hk : k ≤ 8) : 2 ^ (64 - 7 * k) = 128 * 2 ^ (64 - 7 * (k + 1)) := by
  have : 64 - 7 * k = 7 + (64 - 7 * (k + 1)) := by omega
  rw [this, Nat.pow_add]

theorem readVarintK_varintEnc (n : Nat) : ∀ (k : Nat) (rest : List w8), k ≤ 9 →
    n < 2 ^ (64 - 7 * k) → readVarintK k (varintEnc n ++ rest) = some (n, rest) := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro k rest hk hn
    by_cases h : n < 128
    · rw [varintEnc_lt128 h]
      simp only [List.cons_append, List.nil_append, readVarintK, w8_toNat_of_lt (by omega : n < 256)]
      by_cases h9 : k = 9
      · subst h9
        have : n < 2 := by simpa using hn
        simp [this]
      · simp [h9, h]
    · rw [varintEnc_ge128 h]
      have h9 : k ≠ 9 := by
        intro h9; subst h9
        have : n < 2 := by simpa using hn
        omega
      simp only [List.cons_append, readVarintK, h9, ite_false,
        w8_toNat_of_lt (by omega : n % 128 + 128 < 256)]
      have hstep := pow_seven_step k (by omega)
      rw [ih (n / 128) (by omega) (k + 1) rest (by omega) (by
        rw [hstep] at hn; exact (Nat.div_lt_iff_lt_mul (by decide)).2 (by omega))]
      simp only [show ¬ n % 128 + 128 < 128 by omega, ite_false]
      congr 2
      omega

theorem readVarint_varintEnc (n : Nat) (rest : List w8) (h : n < 2 ^ 64) :
    readVarint (varintEnc n ++ rest) = some (n, rest) :=
  readVarintK_varintEnc n 0 rest (by omega) (by simpa using h)

/-- The shape of a varint's bytes: every byte but the last with its continuation bit. -/
def VShape : List w8 → Prop
  | [] => False
  | [b] => b.toNat < 128
  | b :: b' :: t => 128 ≤ b.toNat ∧ VShape (b' :: t)

theorem readVarintK_shape : ∀ (bs : List w8) (k : Nat) (rest : List w8), VShape bs →
    bs.length + k ≤ 10 → varintVal bs < 2 ^ (64 - 7 * k) →
    readVarintK k (bs ++ rest) = some (varintVal bs, rest)
  | [], _, _, h, _, _ => h.elim
  | [b], k, rest, h, _, hv => by
    simp only [VShape] at h
    simp only [varintVal] at hv ⊢
    simp only [List.cons_append, List.nil_append, readVarintK]
    have hb : b.toNat % 128 = b.toNat := Nat.mod_eq_of_lt h
    by_cases h9 : k = 9
    · subst h9
      have : b.toNat < 2 := by simp at hv; omega
      simp [this]; omega
    · simp [h9, h]; omega
  | b :: b' :: t, k, rest, h, hl, hv => by
    simp only [VShape] at h
    simp only [List.length_cons] at hl
    have h9 : k ≠ 9 := by omega
    have hb := b.isLt
    rw [List.cons_append, readVarintK]
    simp only [h9, ite_false]
    have hstep := pow_seven_step k (by omega)
    rw [varintVal] at hv
    rw [readVarintK_shape (b' :: t) (k + 1) rest h.2 (by simp; omega) (by
      rw [hstep] at hv; omega)]
    simp only [show ¬ b.toNat < 128 by omega, ite_false]
    rw [show varintVal (b :: b' :: t) = b.toNat % 128 + 128 * varintVal (b' :: t) from rfl]
    rw [show b.toNat - 128 = b.toNat % 128 by omega]

theorem isVarint_shape : ∀ (bs : List w8), IsVarint bs → VShape bs
  | [], h => by simp [IsVarint] at h
  | [b], h => by
    obtain ⟨-, -, -, hl, -⟩ := h
    exact hl b (by simp)
  | b :: b' :: t, h => by
    obtain ⟨h1, h2, hc, hl, hv⟩ := h
    refine ⟨hc 0 (by simp), isVarint_shape (b' :: t) ⟨by simp, by simp at h2 ⊢; omega, ?_, ?_, ?_⟩⟩
    · intro i hi
      have := hc (i + 1) (by simp at hi ⊢; omega)
      simpa using this
    · intro x hx
      exact hl x (by rw [List.getLast?_cons_cons]; exact hx)
    · simp only [varintVal] at hv ⊢; omega

theorem readVarint_isVarint {bs : List w8} (h : IsVarint bs) (rest : List w8) :
    readVarint (bs ++ rest) = some (varintVal bs, rest) :=
  readVarintK_shape bs 0 rest (isVarint_shape bs h) (by have := h.2.1; omega) (by
    simpa using h.2.2.2.2)

/-! ## Fixed and length-delimited values -/

theorem leNat_fixedLE : ∀ (k n : Nat), n < 256 ^ k → leNat (fixedLE k n) = n
  | 0, n, h => by simp at h; simp [fixedLE, leNat]; omega
  | k + 1, n, h => by
    simp only [fixedLE, leNat, BitVec.toNat_ofNat]
    rw [leNat_fixedLE k (n / 256) (by
      rw [Nat.pow_succ] at h; exact (Nat.div_lt_iff_lt_mul (by decide)).2 h)]
    omega

theorem fixedLE_length : ∀ (k n : Nat), (fixedLE k n).length = k
  | 0, _ => rfl
  | k + 1, n => by simp [fixedLE, fixedLE_length k]

theorem readFixed_exact (k : Nat) (bs rest : List w8) (h : bs.length = k) :
    readFixed k (bs ++ rest) = some (leNat bs, rest) := by
  subst h
  simp [readFixed]

theorem readLen_exact (pre body rest : List w8) (hp : IsVarint pre) (hv : varintVal pre = body.length) :
    readLen (pre ++ body ++ rest) = some (body, rest) := by
  simp only [readLen, List.append_assoc, readVarint_isVarint hp, hv]
  simp

theorem readLen_enc (body rest : List w8) (h : body.length < 2 ^ 64) :
    readLen (varintEnc body.length ++ body ++ rest) = some (body, rest) := by
  simp only [readLen, List.append_assoc, readVarint_varintEnc _ _ h]
  simp

/-! ## Tags -/

theorem readTag_minimal {num wt : Nat} {tg : List w8} (rest : List w8) (lim : Nat)
    (h : TagOk true num wt tg) (hw : wt < 8) (hl : 2 ^ 29 ≤ lim) :
    readTag lim (tg ++ rest) = some (num, wt, rest) := by
  obtain ⟨h1, h2, h3⟩ := h
  simp only [ite_true] at h2 h3
  subst h3
  simp only [readTag, readVarint_varintEnc _ _ (by omega : num * 8 + wt < 2 ^ 64)]
  have : (num * 8 + wt) / 8 = num := by omega
  have : (num * 8 + wt) % 8 = wt := by omega
  simp [*]; omega

theorem readTag_inner {num wt : Nat} {tg : List w8} (rest : List w8)
    (h : TagOk false num wt tg) (hw : wt < 8) :
    readTag (2 ^ 31) (tg ++ rest) = some (num, wt, rest) := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  simp only [Bool.false_eq_true, ite_false] at h2
  simp only [readTag, readVarint_isVarint h3, h4]
  have : (num * 8 + wt) / 8 = num := by omega
  have : (num * 8 + wt) % 8 = wt := by omega
  simp [*]; omega

theorem readTag_tag (num wt : Nat) (rest : List w8) (lim : Nat) (h1 : 1 ≤ num) (h2 : num < lim)
    (h3 : lim ≤ 2 ^ 31) (hw : wt < 8) :
    readTag lim (tag num wt ++ rest) = some (num, wt, rest) := by
  simp only [tag, readTag, readVarint_varintEnc _ _ (by omega : num * 8 + wt < 2 ^ 64)]
  have : (num * 8 + wt) / 8 = num := by omega
  have : (num * 8 + wt) % 8 = wt := by omega
  simp [*]; omega

theorem tag_ne_nil (num wt : Nat) : tag num wt ≠ [] := varintEnc_ne_nil _

/-! ## Skipping a value -/

theorem wval_wt {d num wt : Nat} {v : List w8} (h : WVal d num wt v) :
    wt = 0 ∨ wt = 1 ∨ wt = 2 ∨ wt = 3 ∨ wt = 5 := by
  cases h <;> simp

theorem isVarint_ne_nil {bs : List w8} (h : IsVarint bs) : bs ≠ [] := by
  intro e; subst e; have := h.1; simp at this

theorem tagOk_ne_nil {m : Bool} {num wt : Nat} {tg : List w8} (h : TagOk m num wt tg) : tg ≠ [] := by
  obtain ⟨-, -, h⟩ := h
  cases m
  · exact isVarint_ne_nil (by simpa using h.1)
  · simp only [ite_true] at h; subst h; exact varintEnc_ne_nil _

/-- **`ConsumeFieldValue` reads exactly a well-formed value** (`WVal`, `UfWire.lean`). -/
theorem skip_wval {d num wt : Nat} {v : List w8} (h : WVal d num wt v) :
    ∀ (fuel : Nat) (rest : List w8), v.length < fuel → skip fuel d num wt (v ++ rest) = some rest := by
  refine WVal.rec
    (motive_1 := fun d num wt v _ => ∀ (fuel : Nat) (rest : List w8), v.length < fuel →
      skip fuel d num wt (v ++ rest) = some rest)
    (motive_2 := fun d body _ => ∀ (fuel num : Nat) (etag rest : List w8), TagOk false num 4 etag →
      (body ++ etag).length < fuel → skip fuel (d + 1) num 3 (body ++ etag ++ rest) = some rest)
    ?varint ?i64 ?len ?group ?i32 ?nil ?cons h
  case varint =>
    intro d num bs hb fuel rest hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp [skip, readVarint_isVarint hb]
  case i64 =>
    intro d num bs hb fuel rest hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp [skip, readFixed_exact 8 bs rest hb]
  case len =>
    intro d num pre body hp hv fuel rest hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp only [skip]
    rw [readLen_exact pre body rest hp hv]; rfl
  case i32 =>
    intro d num bs hb fuel rest hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp [skip, readFixed_exact 4 bs rest hb]
  case group =>
    intro d num body etag _ he ih fuel rest hf
    exact ih fuel num etag rest he hf
  case nil =>
    intro d fuel num etag rest he hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp only [List.nil_append] at hf ⊢
    simp only [skip, Nat.add_one_ne_zero, ite_false, readTag_inner rest he (by omega)]
    simp
  case cons =>
    intro d num wt tg v rest' ht hv _ ihv ihr fuel num' etag rest he hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    have hw := wval_wt hv
    have htl : tg.length ≥ 1 := by
      have := tagOk_ne_nil ht; cases tg <;> simp_all
    simp only [List.length_append] at hf
    have e : tg ++ v ++ rest' ++ etag ++ rest = tg ++ (v ++ (rest' ++ etag ++ rest)) := by simp
    rw [e]
    simp only [skip, Nat.add_one_ne_zero, ite_false, readTag_inner _ ht (by omega),
      show wt ≠ 4 by omega, Nat.add_sub_cancel]
    rw [ihv f (rest' ++ etag ++ rest) (by omega)]
    exact ihr f num' etag rest he (by simp; omega)

/-! ## The round trip -/

/-- A record the decoder reads back: a number in `1 .. 2^29 - 1`, a wire type the schema declares
for it, a value that fits. -/
def RecOk (s : FieldSchema) (p : Nat × FVal) : Prop :=
  1 ≤ p.1 ∧ p.1 < 2 ^ 29 ∧ known s p.1 p.2.wt = true ∧ p.2.Fits

theorem val_wt_lt (v : FVal) : v.wt < 8 ∧ v.wt ≠ 4 := by cases v <;> simp [FVal.wt]

theorem readKnown_payload (v : FVal) (rest : List w8) (h : v.Fits) :
    readKnown v.wt (v.payload ++ rest) = some (v, rest) := by
  cases v with
  | varint n => simp [FVal.wt, FVal.payload, readKnown, readVarint_varintEnc n rest h]
  | i64 n =>
    simp only [FVal.wt, FVal.payload, readKnown, readFixed_exact 8 _ rest (fixedLE_length 8 n)]
    simp [leNat_fixedLE 8 n (by simpa [FVal.Fits] using h)]
  | len bs =>
    simp only [FVal.wt, FVal.payload, readKnown]
    rw [readLen_enc bs rest h]; rfl
  | i32 n =>
    simp only [FVal.wt, FVal.payload, readKnown, readFixed_exact 4 _ rest (fixedLE_length 4 n)]
    simp [leNat_fixedLE 4 n (by simpa [FVal.Fits] using h)]

theorem known_routed {s : FieldSchema} {num wt : Nat} (h : Routed s num wt) : known s num wt = false := by
  simp only [known, List.any_eq_false, Bool.and_eq_true, beq_iff_eq, List.contains_iff_mem]
  rintro p hp ⟨h1, h2⟩
  exact h p hp h1 h2

/-- The unknown fields decode to themselves. -/
theorem decodeLoop_uf {s : FieldSchema} {uf : List w8} (h : ufWire s uf) :
    ∀ fuel, uf.length < fuel → decodeLoop s fuel uf = some ([], uf) := by
  induction h with
  | nil =>
    intro fuel hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    simp [decodeLoop]
  | cons num wt tg v rest ht hv hr _ ih =>
    intro fuel hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    have hw := wval_wt hv
    have htl : tg.length ≥ 1 := by
      have := tagOk_ne_nil ht; cases tg <;> simp_all
    simp only [List.length_append] at hf
    have hne : tg ++ v ++ rest ≠ [] := by
      intro e; have := congrArg List.length e
      simp only [List.length_append, List.length_nil] at this; omega
    rw [List.append_assoc]
    simp only [decodeLoop, List.append_assoc] at hne ⊢
    simp only [hne, ite_false, readTag_minimal (v ++ rest) (2 ^ 29) ht (by omega) (by decide),
      show wt ≠ 4 by omega, known_routed hr, Bool.false_eq_true]
    rw [skip_wval hv _ rest (by simp only [List.length_append]; omega)]
    simp only
    rw [ih f (by omega)]
    obtain ⟨-, -, htg⟩ := ht
    simp only [ite_true] at htg
    simp [htg, tag]

/-- **The round trip**: a message's records (each one the decoder reads back) and its unknown
fields (as the decoder leaves them) decode to themselves. -/
theorem decodeLoop_encode {s : FieldSchema} {uf : List w8} (hu : ufWire s uf) :
    ∀ (ks : List (Nat × FVal)) (fuel : Nat), (∀ p ∈ ks, RecOk s p) →
      (encode ks uf).length < fuel → decodeLoop s fuel (encode ks uf) = some (ks, uf)
  | [], fuel, _, hf => decodeLoop_uf hu fuel hf
  | p :: ks, fuel, hk, hf => by
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    obtain ⟨h1, h2, h3, h4⟩ := hk p (by simp)
    have hw := val_wt_lt p.2
    simp only [encode, encFields, record, List.append_assoc] at hf ⊢
    have hne : tag p.1 p.2.wt ++ (p.2.payload ++ (encFields ks ++ uf)) ≠ [] := by
      simp [tag_ne_nil]
    have htl : (tag p.1 p.2.wt).length ≥ 1 := by
      have := tag_ne_nil p.1 p.2.wt; cases h : tag p.1 p.2.wt <;> simp_all
    simp only [decodeLoop, hne, ite_false, readTag_tag _ _ _ _ h1 h2 (by decide) hw.1, hw.2, h3,
      ite_true, readKnown_payload _ _ h4]
    simp only [List.length_append] at hf
    rw [show encFields ks ++ uf = encode ks uf from rfl,
      decodeLoop_encode hu ks f (fun q hq => hk q (by simp [hq])) (by simp [encode]; omega)]
    rfl

theorem decode_encode {s : FieldSchema} {uf : List w8} {ks : List (Nat × FVal)}
    (hk : ∀ p ∈ ks, RecOk s p) (hu : ufWire s uf) : decode s (encode ks uf) = some (ks, uf) :=
  decodeLoop_encode hu ks _ hk (by omega)

theorem decode_nil (s : FieldSchema) : decode s [] = some ([], []) := by
  simp [decode, decodeLoop]

/-! ## Lengths -/

theorem encode_length (ks : List (Nat × FVal)) (uf : List w8) :
    (encode ks uf).length = (encFields ks).length + uf.length := by
  simp [encode]

theorem encFields_append (a b : List (Nat × FVal)) : encFields (a ++ b) = encFields a ++ encFields b := by
  induction a with
  | nil => rfl
  | cons p a ih => simp [encFields, ih]

theorem tag_length_small (num wt : Nat) (h : num * 8 + wt < 128) : (tag num wt).length = 1 := by
  simp [tag, varintEnc_lt128 h]

theorem record_length (num : Nat) (v : FVal) :
    (record num v).length = (tag num v.wt).length + v.payload.length := by
  simp [record]

/-! ## Reading fields back -/

theorem lastVarint_nil (num : Nat) : lastVarint [] num = none := rfl

theorem lastLen_nil (num : Nat) : lastLen [] num = none := rfl

