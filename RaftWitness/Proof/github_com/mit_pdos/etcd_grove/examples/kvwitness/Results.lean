variable [ext : FfiSyntax] [ffi : FfiModel] [FfiInterp ffi] [FfiSemantics ext ffi]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : github_com.mit_pdos.etcd_grove.examples.kvwitness.Assumptions]
variable [NaInvG GF]
variable [KVStor GF]

/-- `r.Put(key, val)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__Put.lean`). -/
theorem kv_Put : kvwitness.KV.Put.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_Put

/-- `r.Get(key)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__Get.lean`). -/
theorem kv_Get : kvwitness.KV.Get.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_Get

/-- `r.Append(key, val)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__Append.lean`). -/
theorem kv_Append : kvwitness.KV.Append.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_Append

/-- `r.Read(key)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__Read.lean`). -/
theorem kv_Read : kvwitness.KV.Read.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_Read

/-- **The history now is a lower bound** for `Read` (`kvLb`), at the client's map. -/
theorem kv_regLb_current (γr : RKVNames) (x : KVMap) :
    ⊢ rkvInv (GF := GF) γr -∗ raftCommitInv γr.raft -∗ rkvVal γr x ={⊤}=∗
      rkvVal γr x ∗ ∃ L, kvLb γr L ∗ ⌜kvFold L = x⌝ :=
  kvLb_current γr x ⊤ CoPset.subseteq_top raftN_regN

/-- `New(id, node, storage, send)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/New.lean`). -/
theorem kv_New : kvwitness.New.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_New

/-- `r.RemoveMember(id)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__RemoveMember.lean`). -/
theorem kv_RemoveMember : kvwitness.KV.RemoveMember.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_RemoveMember

/-- `r.TransferLeadership(to)`
(`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__TransferLeadership.lean`). -/
theorem kv_TransferLeadership : kvwitness.KV.TransferLeadership.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_TransferLeadership

/-- `r.run(send)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/KV__run.lean`). -/
theorem kv_run : kvwitness.KV.run.spec (GF := GF) (hG := hG) :=
  kvwitness.KV.wp_run

/-- `NewStorage(voters)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/NewStorage.lean`). -/
theorem kv_NewStorage : kvwitness.NewStorage.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_NewStorage

/-- **A store's storage is a raft `Storage`**: the storage `NewStorage` returns (its record,
`kvStorRec`) meets raft's `Storage` contract against the store's storage model. -/
theorem kv_storage_isStorage (s ms : Loc) (γs : MemStorNames) :
    ⊢ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.kvwitness -∗
      kvStorRec (GF := GF) s ms γs -∗ isStorage (kvStorIface s) :=
  kvStorage_isStorage kvwitness.Storage.wp_Snapshot s ms γs

/-- ... and its `InitialState` is a fresh empty hard state and the voters' conf state, read-only
for good, as `RestartNode` asks of its storage (raft v3.7: `RestartNode.spec`'s premise), for a
storage of a cluster without a witness (`NewStorage`'s). -/
theorem kv_storage_initialState (s : Loc) (vsl : GoSlice) (voters : List w64)
    (σ : StorState) :
    ⊢ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.kvwitness -∗
      s.[RStorage, go!"voters"] ↦□ vsl -∗ vsl ↦*□ voters -∗
      s.[RStorage, go!"witness"] ↦□ W64 0 -∗
      □ (∀ (Φ : val → IProp GF) (ss' : entryID),
           ownStorage (kvStorIface s) { σ with ss := ss' } -∗
           (∀ (hp cs : Loc) (al : Bool), ownStorage (kvStorIface s) { σ with ss := ss' } -∗
            hsOpt hp (HardStateM.mk (W64 0) (W64 0) (W64 0)) -∗
            csPts cs DFrac.discard (kvwitness.kvConfState voters) al -∗
            Φ (PairV (PairV #hp #cs) #interface.nil)) -∗
           WP (App (Val #(methods (go.GoType.PointerType rStorageTy) go!"InitialState" #s))
             (Val #())) {{ Φ }}) :=
  kvStorage_initialState kvwitness.Storage.wp_InitialState s vsl voters σ

/-- **The witness storage**: `NewWitnessStore()` is a store at the zero state, of any ghost
counterpart `P` given there (and the value of raft's `ErrWitnessStateModified`, `wErrOk`)... -/
theorem kv_NewWitnessStore : kvwitness.NewWitnessStore.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_NewWitnessStore

/-- ... which meets raft's witness storage contract at any `P` and namespace `N`. -/
theorem kv_wstore_isWitnessStorage (s : Loc) (N : Namespace) (P : WHS → IProp GF) :
    ⊢ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.kvwitness -∗
      isWStore s P -∗ isWitnessStorage (kvWStoreIface s) N P :=
  kvWStore_isWitnessStorage kvwitness.WitnessStore.wp_GetWitnessState kvwitness.WitnessStore.wp_Close
    kvwitness.witnessRead.wp_GetState kvwitness.witnessRead.wp_Update s N P

/-- `StartCluster(ids)` (`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/StartCluster.lean`). -/
theorem kv_StartCluster : kvwitness.StartCluster.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_StartCluster

/-- **The randomized linearizability test** `Check(kvs, clock, clients, ops)`
(`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/Check.lean`): porcupine answers `Ok`. -/
theorem kv_Check : kvwitness.Check.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_Check

/-- `StartClusterWitness(voters, witness)` at the voters `[1, 2]` and the witness `3`
(`Spec/github_com/mit_pdos/etcd_grove/examples/kvwitness/StartClusterWitness.lean`): two replicas of
one store, from the empty store. -/
theorem kv_StartClusterWitness : kvwitness.StartClusterWitness.spec (GF := GF) (hG := hG) :=
  kvwitness.wp_StartClusterWitness

end results

