/-! ## The driver package's initialization -/

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]

/-- The `driver` package has no package-level state. -/
instance driver.isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.dsverify_lab.harness.driver :=
  define_is_pkg_init iprop(True)
instance driver.get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.dsverify_lab.harness.driver :=
  build_get_is_pkg_init_wf

variable [package_sem : driver.Assumptions]

set_option goose.wp.extras true in
/-- The driver package's initialization: it initializes its imports (`log`, `time`, `clients`,
porcupine). -/
theorem driver.wp_initialize' (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.dsverify_lab.harness.driver get_is_pkg_init) :
    {{ ownInitializing get_is_pkg_init }}
      (App (Val driver.initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗
        isPkgInit (PROP := IProp GF) pkg_id.dsverify_lab.harness.driver }} := by
  wp_start as Hown
  iapply wp_package_init (heq := Hinit.1) $$ [Hown] HΦ
  iframe Hown
  iintro Hown
  wp_auto
  wp_apply github_com.anishathalye.porcupine.wp_initialize' _ Hinit.2.2.2.2.1 $$ Hown
    as ⟨Hown, #Hporc⟩
  wp_apply clients.wp_initialize' _ Hinit.2.2.2.1 $$ Hown as ⟨Hown, #Hcl⟩
  wp_apply time.wp_initialize' _ Hinit.2.2.1 $$ Hown as ⟨Hown, #Htime⟩
  wp_apply log.wp_initialize' _ Hinit.2.1 $$ Hown as ⟨Hown, #Hlog⟩
  iframe Hown
  is_pkg_init_finish

end init

/-! ## The kit's code and its client spec -/

section defs
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]

/-- A kit's code (kit v2), as the statement refers to it: the test package `pkg` (initialized by
`initialize'`), the address constants `addrs` (`Addrs()`'s), the names of the functions `Main`
passes to the driver (`newF`, `opF`, `genF`, `checkF`, `startF`) and of `Addrs` and `Main`, the
driver's constants (`nC` clients, `k` operations each, a wait of `waitMs` ms), the encodings of
the model's inputs and outputs (`encI`, `encO`, the checker's), and the input premise `pre`. -/
structure DriverKit (M : Model) where
  pkg : GoString
  initialize' : val
  addrs : List GoString
  addrsF : GoString
  newF : GoString
  opF : GoString
  genF : GoString
  checkF : GoString
  startF : GoString
  mainF : GoString
  nC : w64
  k : w64
  waitMs : w64
  encI : M.Input → GoInterface
  encO : M.Output → GoInterface
  pre : M.Input → Prop

/-- The client spec of a kit's code `K` for the model `M`, at the client node, from its share
`start` of the network's start resources (what a run proves): abstract predicates of its choice
(`Γ`, `is_sys`, `client_tok`, `own_state`) and the specs of the package's initialization and of
the function values `New`, `Op`, `Gen` and `Start`. The system is an interface value (`New`'s
result, `Op`'s first argument). -/
structure DriverClientSpec (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] (start : IProp GF) where
  /-- the system's ghost names -/
  Γ : Type
  /-- `sys` is the system (persistent) -/
  is_sys : GoInterface → Γ → IProp GF
  /-- client `c` may call its `j`-th operation (one at a time) -/
  client_tok : Γ → w64 → Nat → IProp GF
  /-- the abstract state (timeless, so a client keeps it in an invariant) -/
  own_state : Γ → M.State → IProp GF
  is_sys_persistent : ∀ sys γ, Persistent (is_sys sys γ)
  own_state_timeless : ∀ γ σ, Timeless (own_state γ σ)
  /-- the package's initialization -/
  wp_initialize' : ∀ (get_is_pkg_init : GoString → IProp GF),
    GetIsPkgInitProp K.pkg get_is_pkg_init →
    {{ ownInitializing get_is_pkg_init }}
      (App (Val K.initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗ isPkgInit (PROP := IProp GF) K.pkg }}
  /-- `New(addrs)`, from the client node's share: the system, its initial state, one token per
  client, at its operation 0 -/
  wp_New : ∀ (sl : GoSlice),
    {{ isPkgInit (PROP := IProp GF) K.pkg ∗ start ∗ sl ↦*□ K.addrs }}
      (App (Val (@! K.newF)) (Val #sl))
    {{ (sys : GoInterface) (γ : Γ), RET #sys; is_sys sys γ ∗ own_state γ M.init ∗
        [∗list] c ∈ List.range (uint.nat K.nC), client_tok γ (W64 ((c : Nat) : Int)) 0 }}
  /-- `Op(sys, c, in)`, client `c`'s `j`-th operation (`j < k`): logically atomic at `↑clientN`,
  with a maybe-committed error (B) -/
  wp_Op : ∀ (sys : GoInterface) (γ : Γ) (c : w64) (j : Nat) (i : M.Input),
    uint.nat c < uint.nat K.nC → j < uint.nat K.k → K.pre i →
    ⊢ isPkgInit (PROP := IProp GF) K.pkg -∗ is_sys sys γ -∗ client_tok γ c j -∗
      opAwpMaybe (App (App (App (Val (@! K.opF)) (Val #sys)) (Val #c)) (Val #(K.encI i)))
        (↑clientN) (own_state γ)
        (fun σ σ' o => iprop(own_state γ σ' ∗ ⌜M.step σ i σ' o⌝))
        (fun o => PairV #(K.encO o) #true) (fun v => ∃ x : GoInterface, v = PairV #x #false)
        (client_tok γ c (j + 1))
  /-- `Gen(c, j)`: an encoded input that meets the premise -/
  wp_Gen : ∀ (c j : w64),
    {{ isPkgInit (PROP := IProp GF) K.pkg }}
      (App (App (Val (@! K.genF)) (Val #c)) (Val #j))
    {{ (i : M.Input), RET #(K.encI i); ⌜K.pre i⌝ }}
  /-- `Start(c)`: client `c`'s start delay, any number -/
  wp_Start : ∀ (c : w64),
    {{ isPkgInit (PROP := IProp GF) K.pkg }}
      (App (Val (@! K.startF)) (Val #c))
    {{ (d : w64), RET #d; True }}

/-- The budget-free client spec (`DriverClientSpec`'s form before the operation budget): a token
`client_tok γ c` per client, which `Op` keeps, so `Op` holds for any number of operations. -/
structure DriverClientSpec0 (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] (start : IProp GF) where
  Γ : Type
  is_sys : GoInterface → Γ → IProp GF
  client_tok : Γ → w64 → IProp GF
  own_state : Γ → M.State → IProp GF
  is_sys_persistent : ∀ sys γ, Persistent (is_sys sys γ)
  own_state_timeless : ∀ γ σ, Timeless (own_state γ σ)
  wp_initialize' : ∀ (get_is_pkg_init : GoString → IProp GF),
    GetIsPkgInitProp K.pkg get_is_pkg_init →
    {{ ownInitializing get_is_pkg_init }}
      (App (Val K.initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗ isPkgInit (PROP := IProp GF) K.pkg }}
  wp_New : ∀ (sl : GoSlice),
    {{ isPkgInit (PROP := IProp GF) K.pkg ∗ start ∗ sl ↦*□ K.addrs }}
      (App (Val (@! K.newF)) (Val #sl))
    {{ (sys : GoInterface) (γ : Γ), RET #sys; is_sys sys γ ∗ own_state γ M.init ∗
        [∗list] c ∈ List.range (uint.nat K.nC), client_tok γ (W64 ((c : Nat) : Int)) }}
  wp_Op : ∀ (sys : GoInterface) (γ : Γ) (c : w64) (i : M.Input), uint.nat c < uint.nat K.nC →
    K.pre i →
    ⊢ isPkgInit (PROP := IProp GF) K.pkg -∗ is_sys sys γ -∗ client_tok γ c -∗
      opAwpMaybe (App (App (App (Val (@! K.opF)) (Val #sys)) (Val #c)) (Val #(K.encI i)))
        (↑clientN) (own_state γ)
        (fun σ σ' o => iprop(own_state γ σ' ∗ ⌜M.step σ i σ' o⌝))
        (fun o => PairV #(K.encO o) #true) (fun v => ∃ x : GoInterface, v = PairV #x #false)
        (client_tok γ c)
  wp_Gen : ∀ (c j : w64),
    {{ isPkgInit (PROP := IProp GF) K.pkg }}
      (App (App (Val (@! K.genF)) (Val #c)) (Val #j))
    {{ (i : M.Input), RET #(K.encI i); ⌜K.pre i⌝ }}
  wp_Start : ∀ (c : w64),
    {{ isPkgInit (PROP := IProp GF) K.pkg }}
      (App (Val (@! K.startF)) (Val #c))
    {{ (d : w64), RET #d; True }}

/-- A budget-free client spec gives the client spec (its token ignores the operation index): a
proof of `DriverClientSpec0` ports to the budgeted statement as `S.toSpec`. -/
def DriverClientSpec0.toSpec {M : Model} {K : DriverKit M} [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] {start : IProp GF} (S : DriverClientSpec0 M K start) :
    DriverClientSpec M K start where
  Γ := S.Γ
  is_sys := S.is_sys
  client_tok γ c _ := S.client_tok γ c
  own_state := S.own_state
  is_sys_persistent := S.is_sys_persistent
  own_state_timeless := S.own_state_timeless
  wp_initialize' := S.wp_initialize'
  wp_New := S.wp_New
  wp_Op sys γ c _ i hc _ hpre := S.wp_Op sys γ c i hc hpre
  wp_Gen := S.wp_Gen
  wp_Start := S.wp_Start

end defs

/-! ## `driver.Run`'s spec -/

section run
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics] [package_sem : driver.Assumptions]

set_option goose.wp.extras true

/-- `driver.Run(addrs, New, Op, Gen, check, nC, k, Start, waitMs)` with a kit's functions does
not panic, from the kit's client spec, a checker spec of `check` with the kit's encodings, and
`clients.Run`'s spec. -/
theorem wp_driver_Run (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] (start : IProp GF) (S : DriverClientSpec M K start)
    (C : CheckerSpec (GF := GF) M) (hI : C.encI = K.encI) (hO : C.encO = K.encO)
    (hE : ∀ sl, C.checkE sl = App (Val (@! K.checkF)) (Val #sl))
    (hRun : RunSpec (GF := GF) M K.encI K.encO)
    (hn : uint.Z K.nC < 2 ^ 32) (hnk : uint.Z K.nC * uint.Z K.k < 2 ^ 61) (sl : GoSlice) :
    {{ isPkgInit (PROP := IProp GF) pkg_id.dsverify_lab.harness.driver ∗
        isPkgInit (PROP := IProp GF) K.pkg ∗ C.ready ∗ start ∗ sl ↦*□ K.addrs }}
      (App (App (App (App (App (App (App (App (App (Val (@! driver.Run)) (Val #sl))
        (Val (@! K.newF))) (Val (@! K.opF))) (Val (@! K.genF))) (Val (@! K.checkF)))
        (Val #K.nC)) (Val #K.k)) (Val (@! K.startF))) (Val #K.waitMs))
    {{ RET #(); True }} := by
  haveI := S.is_sys_persistent
  haveI := S.own_state_timeless
  haveI := C.ready_persistent
  wp_start as H
  icases H with ⟨#Hready, Hst, #Hsl⟩
  wp_auto
  wp_apply S.wp_New sl $$ [$Hpkg2 $Hst $Hsl] as %sys %γ ⟨#Hsys, Hst, Htoks⟩
  iapply fupd_wp
  ipersist sys
  ipersist start
  ipersist op
  ipersist gen
  imodintro
  wp_apply (hRun K.nC K.k _ _ _ (S.own_state γ) (S.client_tok γ) K.pre
    (S.own_state_timeless γ) hn hnk) $$ [Hst Htoks]
  · isplitl [Hst]
    · iexact Hst
    isplitl [Htoks]
    · iexact Htoks
    isplitr
    · -- the closure over `gen` and `start`
      unfold GenFuncSpec
      imodintro
      iintro %c %j
      wp_auto
      wp_if_destruct
      · wp_apply S.wp_Start c $$ [Hpkg2] as %d
        iintro -
        wp_apply time.wp_Sleep
        wp_apply S.wp_Gen c _ $$ [Hpkg2] as %i %hpre
        iexists i
        ipureintro
        exact ⟨rfl, hpre⟩
      · wp_apply S.wp_Gen c _ $$ [Hpkg2] as %i %hpre
        iexists i
        ipureintro
        exact ⟨rfl, hpre⟩
    · -- the closure over `op` and the system
      unfold OpFuncSpec
      imodintro
      iintro %c %j %i %hc %hj %hpre Htok
      unfold opAwpMaybe
      iintro %Q AU
      wp_auto
      have hop := S.wp_Op sys γ c j i hc hj hpre
      unfold opAwpMaybe at hop
      ihave Hop := hop $$ Hpkg2 Hsys Htok
      ihave Hwp := Hop $$ %Q AU
      wp_bind (App (App (App (Val (@! K.opF)) (Val #sys)) (Val #c)) (Val #(K.encI i)))
      iapply wp_wand $$ Hwp
      iintro %v ⟨Htok, Hv⟩
      icases Hv with (⟨%σ, %σ', %o, %hv, HQ⟩ | %hv)
      · subst hv
        wp_auto
        iframe Htok
        ileft; iexists σ, σ', o; iframe HQ; ipureintro; rfl
      · obtain ⟨x, rfl⟩ := hv
        wp_auto
        iframe Htok
        iright; ipureintro; exact ⟨_, rfl⟩
  iintro %ops_sl %ops ⟨Hops, %hh⟩
  obtain ⟨h, hdec, hcr, hpl, hlin⟩ := hh
  iapply fupd_wp
  imod ownSlice_persist _ _ _ $$ Hops with #Hops
  imodintro
  have hck := C.wp_check ops_sl ops h DFrac.discard (by rw [hI, hO]; exact hdec) hcr hpl hlin
  rw [hE] at hck
  wp_auto
  wp_apply hck $$ [Hops]
  · iframe Hready Hops
  ihave %Hlen := ownSlice_len _ _ _ $$ Hops
  ihave HI : (∃ (i : w64) (nv : w64) (xv : Operation),
      "i" ∷ i_ptr ↦ i ∗ "n" ∷ n_ptr ↦ nv ∗ "x" ∷ x_ptr ↦ xv ∗
      "%Hi" ∷ ⌜0 ≤ sint.Z i ∧ sint.Z i ≤ sint.Z ops_sl.len⌝ : IProp GF) $$ [i n x]
  · iexists W64 0, _, _
    iframe
    ipureintro
    exact ⟨by word, by word⟩
  wp_for HI
  by_cases Hlt : sint.Z i < sint.Z ops_sl.len
  · simp only [Hlt, _root_.decide_true, ↓reduceIte]
    wp_auto
    simp only [Hi.1, Hlt, _root_.and_self, ↓reduceIte]
    list_elem ops (sint.nat i) as op
    wp_apply wp_load_slice_index ops_sl (sint.Z i) ops _ op Hi.1 $$ [Hops] with Hops2
    · isplitl; · iexact Hops
      ipureintro
      rw [show (sint.Z i).toNat = sint.nat i by word]; exact Hop_lookup
    rcases op with ⟨cid, inp, call, out, ret, md, z⟩
    cases out with
    | nil =>
      wp_auto
      wp_for_post
      iframe
      iexists _, nv, _
      iframe
      ipureintro
      exact ⟨by word, by word⟩
    | ok v =>
      wp_auto
      wp_for_post
      iframe
      iexists _, _, _
      iframe
      ipureintro
      exact ⟨by word, by word⟩
  simp only [Hlt, _root_.decide_false, Bool.false_eq_true, ↓reduceIte]
  wp_auto
  wp_bind (App (Val (GoInstruction (CompositeLiteral (go.SliceType go.any))))
    (Val (LiteralValueV _)))
  iapply wp_slice_literal (V := GoInterface) (t := go.any)
    [interface.mkOk go.uint64 #nv, interface.mkOk go.uint64 #(K.nC * K.k)]
  wp_auto
  isplitl []
  · ipureintro; rfl
  iintro %args_sl ⟨Hargs, -⟩
  have hwf : fmt.ArgsWf [interface.mkOk go.uint64 #nv, interface.mkOk go.uint64 #(K.nC * K.k)] :=
    fmt.ArgsWf.cons_int _ _ _ (.uint64 nv) (fmt.ArgsWf.cons_int _ _ _ (.uint64 (K.nC * K.k))
      fmt.ArgsWf.nil)
  wp_apply log.wp_Printf _ _ _ _ hwf $$ [Hargs]
  · iframe
  iintro -
  wp_auto
  iapply HΦ
  ipureintro; trivial

end run

/-! ## `Main`: the generated one-line test program -/

section main
variable [GooseExts] [GoGlobalContext]

/-- Goose's translation of the generated `Main`,
`func Main() { driver.Run(Addrs(), New, Op, Gen, check.X, NC, K, Start, WaitMs) }`, as a
function of the names and constants it mentions. A kit's `Main.impl` is this by `rfl`. -/
def mainImpl (addrsF newF opF genF checkF startF : GoString) (nC k waitMs : val) : val :=
  (LamV BAnon
  (Seq (App (Val exceptionDo)
  (App (Val doExecute)
  (Let "$a0" (App (App (Val (GoInstruction (FuncResolve addrsF []))) (Val #())) (Val #()))
  (Let "$a1" (App (Val (GoInstruction (FuncResolve newF []))) (Val #()))
  (Let "$a2" (App (Val (GoInstruction (FuncResolve opF []))) (Val #()))
  (Let "$a3" (App (Val (GoInstruction (FuncResolve genF []))) (Val #()))
  (Let "$a4" (App (Val (GoInstruction (FuncResolve checkF []))) (Val #()))
  (Let "$a5" (Val nC)
  (Let "$a6" (Val k)
  (Let "$a7" (App (Val (GoInstruction (FuncResolve startF []))) (Val #()))
  (Let "$a8" (Val waitMs)
  (App (App (App (App (App (App (App (App (App (App
    (Val (GoInstruction (FuncResolve dsverify_lab.harness.driver.Run []))) (Val #()))
    (Var "$a0")) (Var "$a1")) (Var "$a2")) (Var "$a3")) (Var "$a4")) (Var "$a5")) (Var "$a6"))
    (Var "$a7")) (Var "$a8")))))))))))))
  (Val #())))

end main

section main_wp
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]

/-- What the generic lemma needs of a kit at its client node, beyond the client spec (under the
node's assumptions). kitgen generates each field's proof by a fixed script. -/
structure DriverFacts (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] : Prop where
  /-- the driver package's assumptions (its import of `clients` among them) -/
  driver_assumptions : driver.Assumptions
  /-- `Main` is the generated one -/
  main : (@! K.mainF : val) =
    mainImpl K.addrsF K.newF K.opF K.genF K.checkF K.startF #K.nC #K.k #K.waitMs
  /-- `Addrs()` returns a new slice of the address constants -/
  addrs : {{ isPkgInit (PROP := IProp GF) K.pkg }}
      (App (Val (@! K.addrsF)) (Val #()))
    {{ (sl : GoSlice), RET #sl; sl ↦* K.addrs }}
  /-- a `get_is_pkg_init` for the test package's import closure -/
  get : ∃ g : GoString → IProp GF, GetIsPkgInitProp K.pkg g
  /-- the test package imports the driver -/
  deps : isPkgInit (PROP := IProp GF) K.pkg ⊢
    isPkgInit (PROP := IProp GF) pkg_id.dsverify_lab.harness.driver
  /-- `check` (`K.checkF`) meets a checker spec with the kit's encodings -/
  checker : ∃ C : CheckerSpec (GF := GF) M, C.encI = K.encI ∧ C.encO = K.encO ∧
    (∀ sl, C.checkE sl = App (Val (@! K.checkF)) (Val #sl)) ∧
    (isPkgInit (PROP := IProp GF) K.pkg ⊢ C.ready)

set_option goose.wp.extras true

/-- The generated `Main`, from the client spec and the kit's facts. -/
theorem wp_driver_main (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] (start : IProp GF) (S : DriverClientSpec M K start)
    (F : DriverFacts (GF := GF) M K) (hn : uint.Z K.nC < 2 ^ 32)
    (hnk : uint.Z K.nC * uint.Z K.k < 2 ^ 61) :
    {{ isPkgInit (PROP := IProp GF) K.pkg ∗ start }}
      (App (Val (@! K.mainF)) (Val #()))
    {{ RET #(); True }} := by
  haveI := F.driver_assumptions
  obtain ⟨C, hI, hO, hE, hR⟩ := F.checker
  iintro %Φ ⟨#Hpkg, Hst⟩ HΦ
  rw [F.main]
  unfold mainImpl
  wp_call
  wp_apply F.addrs $$ [Hpkg] as %asl Hasl
  iapply fupd_wp
  imod ownSlice_persist _ _ _ $$ Hasl with #Hasl
  imodintro
  ihave #Hdrv := F.deps $$ Hpkg
  ihave #Hready := hR $$ Hpkg
  wp_apply wp_driver_Run M K start S C hI hO hE (wp_Run M K.encI K.encO) hn hnk asl $$
    [$Hdrv $Hpkg $Hready $Hst $Hasl]
  iapply HΦ
  ipureintro; trivial

end main_wp

/-! ## Checkers as function values -/

section checkers
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics] [package_sem : dsverify_lab.harness.check.Assumptions]

/-- `check.WriteOnce`, passed as a function value, as the write-once register's checker, for a
test package `pkg` that imports `check`. -/
theorem writeOnce_checker_fn (pkg : GoString) [IsPkgInit (IProp GF) pkg]
    (hdep : isPkgInit (PROP := IProp GF) pkg ⊢
      isPkgInit (PROP := IProp GF) pkg_id.dsverify_lab.harness.check) :
    ∃ C : CheckerSpec (GF := GF) (writeOnce GoString), C.encI = encStr ∧ C.encO = encStr ∧
      (∀ sl, C.checkE sl = App (Val (@! check.WriteOnce)) (Val #sl)) ∧
      (isPkgInit (PROP := IProp GF) pkg ⊢ C.ready) := by
  obtain ⟨C, hI, hO, hE, hR⟩ := writeOnce_checker (GF := GF)
  refine ⟨C, hI, hO, ?_, ?_⟩
  · intro sl
    have hf : (@! check.WriteOnce : val) = check.WriteOnce.impl := func_unfold
    rw [hE, hf]
  · rw [hR]; exact hdep

end checkers

/-! ## The generic lemma -/

section lemma

attribute [local instance] netConnExts netConnExtsSemantics netConnExtsInterp
  GooseGlobalGS.gooseInvGS netConnExts_has

set_option goose.wp.extras true in
/-- The client node's boot program (the test package's initialization, then the generated
`Main`), from its share `start`, the client spec and the kit's facts. -/
theorem wp_driver_boot [GoGlobalContext] {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
    [go.Semantics] (M : Model) (K : DriverKit M) [IsPkgInit (IProp GF) K.pkg]
    [GetIsPkgInitWf (IProp GF) K.pkg] (start : IProp GF) (S : DriverClientSpec M K start)
    (F : DriverFacts (GF := GF) M K) (hn : uint.Z K.nC < 2 ^ 32)
    (hnk : uint.Z K.nC * uint.Z K.k < 2 ^ 61) (client : Node)
    (hinit : client.init = K.initialize') (hmain : client.main = K.mainF)
    (hargs : client.args = []) :
    start ⊢ ownGoState (hG := hG.goose_localGS.goose_go_stateGS) ∅ -∗
      WP client.boot @ Stuckness.NotStuck; ⊤ {{ v, ⌜v = #()⌝ }} := by
  obtain ⟨g, hg⟩ := F.get
  rw [Node.boot_nil client hargs, hinit, hmain]
  iintro Hst Hgs
  unfold boot
  wp_apply S.wp_initialize' g hg $$ [Hgs] as ⟨_, #Hpkg⟩
  · rw [ownInitializing_unseal]
    unfold ownInitializingDef
    iexists ∅
    iframe Hgs
    iintro !>
    iapply BigSepM.bigSepM_empty.2
    iempintro
  wp_pures
  wp_apply wp_driver_main M K start S F hn hnk $$ [$Hpkg $Hst]
  ipureintro; rfl

/-- What a run of a kit-v2 kit proves, for the client node `client` (running the generated
`Main`), the server nodes `servers` and the configuration `cfg`, at the global ghost state `G`:
as `DistSpec` (`Harness/DistLemma.lean`), with the client spec over the kit's functions
(`DriverClientSpec`) given the client node's IP (the fact `nodeIp ip` for `cfg.ips[0]`, stated
as `netIp = ip.spell`), and each server's boot program given its node's IP (`NodeBootWpAt`: the
fact `nodeIp ip`, which a `Listen` on a wildcard host needs, `wp_ListenWild`). The client's fact
lets its proof tell its node from the servers' (e.g. to own a package variable a server node's
state could otherwise be about). -/
structure DriverDistSpec [GoGlobalContext] (M : Model) (K : DriverKit M)
    [pkgInst : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      IsPkgInit (IProp GF) K.pkg]
    [pkgWf : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      GetIsPkgInitWf (IProp GF) K.pkg]
    (client : Node) (servers : List Node) (cfg : NetConfig) [G : GooseGlobalGS .hasLC netDistGF]
    where
  /-- the run's ghost names, chosen in `start` -/
  Γs : Type
  /-- the client node's share -/
  clientRes : Γs → IProp netDistGF
  /-- server node `i`'s share (`i` counts from 0: node `i + 1`) -/
  serverRes : Γs → Nat → IProp netDistGF
  /-- the start: shared ghost state, invariants and protocols, from the network's resources -/
  start : ⊢ ([∗list] a ∈ cfg.addrs, addrTokG netDistGS a ∗ addrUnsetG netDistGS a) ={⊤}=∗
    ∃ γ : Γs, clientRes γ ∗ [∗list] i ↦ _nd ∈ servers, serverRes γ i
  /-- the client spec at the client node, on its IP (node 0's, `cfg.ips[0]`): given the fact
  that the node's IP is `ip` (`nodeIp ip.spell`, as a Lean fact: `netIp = ip.spell`), which the
  servers also get (`servers_boot`) -/
  client_spec : ∀ (γ : Γs) (hG : HeapGS .hasLC netDistGF) (s : go.Semantics),
    hG.goose_globalGS = G →
    @Node.Assumptions client hG.goose_localGS.goose_go_local_context s.sem_fn →
    ∀ (ip : IPv4), cfg.ips[0]? = some ip →
      netIp (L := hG.goose_localGS) (GF := netDistGF) = ip.spell →
    DriverClientSpec (GF := netDistGF) M K (clientRes γ)
  /-- each server node's boot program, on its IP (node `i + 1`'s, `cfg.ips[i + 1]`) -/
  servers_boot : ∀ (γ : Γs) (i : Nat) (nd : Node) (ip : IPv4), servers[i]? = some nd →
    cfg.ips[i + 1]? = some ip → NodeBootWpAt nd ip (serverRes γ i)

/-- The kit's facts at its client node (generated by kitgen, `DriverFacts`): the node runs the
test package's initialization and `Main`, the driver's bounds on `nC` and `k` hold, and, under the
node's assumptions, `DriverFacts`. -/
def DriverMainFacts [GoGlobalContext] (M : Model) (K : DriverKit M)
    [pkgInst : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      IsPkgInit (IProp GF) K.pkg]
    [pkgWf : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      GetIsPkgInitWf (IProp GF) K.pkg]
    (client : Node) : Prop :=
  client.init = K.initialize' ∧ client.main = K.mainF ∧ client.args = [] ∧
  uint.Z K.nC < 2 ^ 32 ∧ uint.Z K.nC * uint.Z K.k < 2 ^ 61 ∧
  ∀ [HeapGS .hasLC netDistGF] [go.Semantics], client.Assumptions →
    DriverFacts (GF := netDistGF) M K

/-- **The generic lemma** (kit v2): a run's `DriverDistSpec` and the kit's facts give the safety
of the client node and the servers, over Go's `net`. -/
theorem driver_dist_safe [GoGlobalContext] (M : Model) (K : DriverKit M)
    [pkgInst : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      IsPkgInit (IProp GF) K.pkg]
    [pkgWf : ∀ {GF : BundledGFunctors} [HeapGS HasLC.hasLC GF] [go.Semantics],
      GetIsPkgInitWf (IProp GF) K.pkg]
    {client : Node} {servers : List Node} {cfg : NetConfig}
    (Hcfg : cfg.WellFormed (servers.length + 1))
    (hF : DriverMainFacts M K (pkgInst := pkgInst) (pkgWf := pkgWf) client)
    (hD : ∀ [GooseGlobalGS .hasLC netDistGF],
      Nonempty (DriverDistSpec M K (pkgInst := pkgInst) (pkgWf := pkgWf) client servers cfg)) :
    SafeDist (client :: servers) cfg := by
  obtain ⟨hinit, hmain, hargs, hn, hnk, hfacts⟩ := hF
  apply safeDist_of_bootAt _ _ Hcfg
  intro G
  obtain ⟨⟨Γs, clientRes, serverRes, hstart, hspec, hservers⟩⟩ := hD
  iintro Hs
  imod hstart $$ Hs with ⟨%γ, Hc, Hsv⟩
  imodintro
  iexists fun i => Nat.casesOn i (clientRes γ) (fun j => serverRes γ j)
  isplitr
  · ipureintro
    intro i nd ip hnd hip
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hnd
      subst hnd
      intro hG s hGG hA
      subst hGG
      iintro HP %Hnip
      iapply wp_driver_boot M K _ (hspec γ hG s rfl hA ip hip Hnip) (hfacts hA) hn hnk client hinit
        hmain hargs $$ HP
    | succ j =>
      simp only [List.getElem?_cons_succ] at hnd
      exact hservers γ j nd ip hnd hip
  · iapply BigSepL.bigSepL_cons.2
    isplitl [Hc]
    · iexact Hc
    · iexact Hsv

end lemma

end dsverify_lab.harness

end Perennial
