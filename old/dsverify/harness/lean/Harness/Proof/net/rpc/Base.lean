/-
Shared definitions of the proofs of the lab's model of `net/rpc` (`harness/rpcmodel/src/net/rpc`,
`notes/craq-net.md` decision 1): its package-initialized state.

**`isPkgInit pkg_id.net.rpc`** (`isInit`, persistent), stated with no parameter so that any
package importing `net/rpc` gets its `IsPkgInit` instance:
* `ErrShutdown`, `errHTTP` and `errFrame` hold their `errors.New` errors (`errors.newVar`);
* `codecMu` is a mutex guarding `codec` (`codecInv`): `codec` is nil (with full ownership), or a
  non-nil `*Codec` for good (`↦□`, so that every reader agrees on the registered codec: the
  first `SetCodec` wins) whose fields hold the kit's codec functions, for good (`kitFns`: the
  functions `rpcEncode`, `rpcDecode`, `rpcMethods`, `rpcCall`, `rpcName` that kitgen generates into the
  kit's package `RpcKit.pkg`). The kit is a type class (`RpcKit`), its instance generated by
  kitgen into the kit's goal; so every `SetCodec` of a proved program registers the same
  functions (its spec requires them), and whichever call wins, every reader knows what the
  registered codec runs.
* `DefaultServer` holds a fixed `*Server` (`↦□`) that is a server (`isServer`): its `services`
  field holds a fixed map, owned by the invariant of its mutex `mu` with a ghost map equal to it
  (`servicesInv`), whose persistent elements are the server's registrations (`svcReg`,
  `ServerDefs.lean`).
-/
module

public import Harness.GeneratedProof.net.rpc
public import Harness.Proof.net.http.Base

@[expose] public section

noncomputable section

namespace Perennial

open Iris Iris.BI Iris.ProgramLogic Iris.Std

namespace net.rpc

/-- The kit whose codec the program registers: its package path (generated by kitgen into the
kit's goal from kit.toml's `[rpc]`). -/
class RpcKit where
  /-- the package of the kit's generated `registerRPC` and codec functions -/
  pkg : GoString

/-- The kit's generated function `name` (in `RpcKit.pkg`). -/
def kitFn [GooseExts] [GoSemanticsFunctions] [RpcKit] (name : GoString) : GoFunc :=
  functions (RpcKit.pkg ++ go!"." ++ name) []

section init
variable [RpcKit]
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- The `*Codec` `c` holds the kit's codec functions, for good (persistent). -/
def codecFns [RpcKit] (c : Loc) : IProp GF :=
  iprop(structFieldRef net.rpc.Codec go!"Encode" c ↦□ kitFn go!"rpcEncode" ∗
    structFieldRef net.rpc.Codec go!"Decode" c ↦□ kitFn go!"rpcDecode" ∗
    structFieldRef net.rpc.Codec go!"Methods" c ↦□ kitFn go!"rpcMethods" ∗
    structFieldRef net.rpc.Codec go!"Call" c ↦□ kitFn go!"rpcCall" ∗
    structFieldRef net.rpc.Codec go!"Name" c ↦□ kitFn go!"rpcName")

instance codecFns_persistent [RpcKit] (c : Loc) : Persistent (codecFns (GF := GF) c) := by
  unfold codecFns; infer_instance

/-- The invariant of `codecMu`: `codec` is nil, or a non-nil codec holding the kit's functions,
that stays. -/
def codecInv [RpcKit] : IProp GF :=
  iprop(globalAddr codec ↦ (null : Loc) ∨
    ∃ c : Loc, ⌜c ≠ null⌝ ∗ globalAddr codec ↦□ c ∗ codecFns c)

/-- The mutex invariant of a server whose `services` field holds `mp`: the map, and a ghost map
`γ` equal to it (whose elements, persistent, are the server's registrations: `svcReg`). -/
def servicesInv (mp : Loc) (γ : GName) : IProp GF :=
  iprop(∃ m : GMap GoString GoInterface, ownMap mp (DFrac.own 1) m ∗ ghostMapAuth γ 1 m)

/-- `s` is a server (persistent): a fixed `services` map owned by `mu`'s invariant, with the
ghost map `γ` of its registrations. -/
def isServerG (s : Loc) (γ : GName) : IProp GF :=
  iprop(∃ mp : Loc,
    "#Hservices" ∷ structFieldRef net.rpc.Server go!"services" s ↦□ mp ∗
    "#Hmu" ∷ sync.isMutex (structFieldRef net.rpc.Server go!"mu" s) (servicesInv mp γ))

instance isServerG_persistent (s : Loc) (γ : GName) : Persistent (isServerG (GF := GF) s γ) := by
  unfold isServerG; infer_instance

/-- `s` is a server (persistent). -/
def isServer (s : Loc) : IProp GF := iprop(∃ γ : GName, isServerG s γ)

instance isServer_persistent (s : Loc) : Persistent (isServer (GF := GF) s) := by
  unfold isServer; infer_instance

/-- The package-initialized state of `net/rpc` (persistent); see the file header. -/
abbrev isInit : IProp GF :=
  iprop("#HErrShutdown" ∷ errors.newVar ErrShutdown go!"connection is shut down" ∗
    "#HerrHTTP" ∷ errors.newVar errHTTP go!"unexpected HTTP response" ∗
    "#HerrFrame" ∷ errors.newVar errFrame go!"rpc: malformed frame" ∗
    "#HcodecMu" ∷ sync.isMutex (globalAddr codecMu) codecInv ∗
    "#HDefaultServer" ∷ (∃ s : Loc, globalAddr DefaultServer ↦□ s ∗ isServer s) ∗
    "_" ∷ True)

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.net.rpc :=
  define_is_pkg_init isInit
instance get_isPkgInit_wf_inst : GetIsPkgInitWf (IProp GF) pkg_id.net.rpc :=
  build_get_is_pkg_init_wf

theorem isInit_access :
    isPkgInit (PROP := IProp GF) pkg_id.net.rpc ⊢ isInit (GF := GF) := by
  with_unfolding_all exact isPkgInit_access (PROP := IProp GF) pkg_id.net.rpc

end init

end net.rpc

end Perennial
