/-- The kit whose protobuf codec the program registers: its package path (generated by kitgen
into the kit's goal from kit.toml's `[protobuf]`). -/
class google_golang_org.protobuf.proto.PbKit where
  /-- the package of the kit's generated `registerProto`, `pbMarshal` and `pbUnmarshal` -/
  pkg : GoString

namespace google_golang_org.protobuf.proto

/-- The kit's generated function `name` (in `PbKit.pkg`). -/
def kitFn [GooseExts] [GoSemanticsFunctions] [PbKit] (name : GoString) : GoFunc :=
  functions (PbKit.pkg ++ go!"." ++ name) []

section init
variable [PbKit]
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- The `*Codec` `c` holds the kit's codec functions, for good (persistent). -/
def codecFns (c : Loc) : IProp GF :=
  iprop(structFieldRef Codec go!"Marshal" c ↦□ kitFn go!"pbMarshal" ∗
    structFieldRef Codec go!"Unmarshal" c ↦□ kitFn go!"pbUnmarshal")

instance codecFns_persistent (c : Loc) : Persistent (codecFns (GF := GF) c) := by
  unfold codecFns; infer_instance

/-- The invariant of `codecMu`: `codec` is nil, or a non-nil codec holding the kit's functions,
that stays. -/
def codecInv : IProp GF :=
  iprop(globalAddr codec ↦ (null : Loc) ∨
    ∃ c : Loc, ⌜c ≠ null⌝ ∗ globalAddr codec ↦□ c ∗ codecFns c)

/-- The package-initialized state of `protobuf/proto` (persistent). -/
abbrev isInit : IProp GF :=
  iprop("#HcodecMu" ∷ sync.isMutex (globalAddr codecMu) codecInv ∗ "_" ∷ True)

instance isPkgInit_inst : IsPkgInit (IProp GF) pkg_id.google_golang_org.protobuf.proto :=
  define_is_pkg_init isInit
instance get_isPkgInit_wf_inst :
    GetIsPkgInitWf (IProp GF) pkg_id.google_golang_org.protobuf.proto :=
  build_get_is_pkg_init_wf

theorem isInit_access :
    isPkgInit (PROP := IProp GF) pkg_id.google_golang_org.protobuf.proto ⊢ isInit (GF := GF) := by
  with_unfolding_all exact isPkgInit_access (PROP := IProp GF) pkg_id.google_golang_org.protobuf.proto

end init
end google_golang_org.protobuf.proto

namespace google_golang_org.grpc

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
