+  subst Hx
+  ipureintro
+  have h := H1.2.symm.trans H2.2
+  simp only [Prod.mk.injEq] at h
+  obtain ⟨h1, h2, h3, h4, h5⟩ := h
+  cases sn1; cases sn2; simp only at h1 h2 h3 h4 h5; subst h1 h2 h3 h4 h5; rfl
+
+/-- A node's table entry names its storage names. -/
