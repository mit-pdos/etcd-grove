+snapshot it handed out (which `Advance` applies: `appliedSnap`). -/
+def nodeAppliedLbU (γ : Cluster) (id : w64) (k : Nat) : IProp GF :=
+  iprop(⌜k = 0⌝ ∨ ∃ sn : StorNames, nodeStorNames γ id sn ∗
