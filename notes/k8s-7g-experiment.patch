+// TestD30gRealModel: the seeded key's no-op update against the real Model, unpatched and
+// patched (the store rewrites the non-canonical data; nonissues/k8s-correctness-model-noop-rewrite.md).
+func TestD30gRealModel(t *testing.T) {
+	setRVDecimal = true
+	st0 := mstore{items: []item{{key: "ns-1/pod-1", obj: Obj{Namespace: "ns-1", Name: "pod-1", Value: "x", ResourceVersion: 2}, canon: false}}, rv: 2}
+	in := Input{Kind: KUpdate, Key: "ns-1/pod-1", NoOp: true}
+	// the store's answer (the driver's model, which is the store's rule): a rewrite at RV 3
+	_, o := mstep(in, st0)
+	if o.RV != 3 {
+		t.Fatalf("driver's model: RV %d, want 3", o.RV)
+	}
+	resp := correctness.Response{Object: &Obj{Namespace: "ns-1", Name: "pod-1", Value: "x", ResourceVersion: 3}}
+	req := correctness.Request{Op: correctness.OpUpdate, Key: storeKey(in.Key), Update: correctness.UpdateRequest{UpdateFunc: tryUpdateFor(in)}}
+	for _, patched := range []bool{false, true} {
+		m := initialModel(st0, patched)
+		ok, _, ch := m.Step(req, resp)
+		t.Logf("patched %v: Model accepts the rewrite: %v (change %v)", patched, ok, ch != nil)
+		if ok != patched {
+			t.Errorf("patched %v: got %v", patched, ok)
+		}
+	}
+	_ = types.UID("")
+	_ = metav1.StatusFailure
+}
