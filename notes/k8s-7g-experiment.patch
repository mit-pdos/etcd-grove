+package etcd3
+
+// Stage 7g experiment (notes/k8s-7g-scope.md): run Kubernetes' own checker (a copy of
+// k8s.io/apiserver/pkg/storage/testing/correctness, with or without the D30g patch) on the
+// driver's real histories, as TestCorrectness does: porcupine with correctness.Model over the
+// unary operations, Replay along porcupine's linearization, Replay.Validate of every operation,
+// WatchValidator of every watch. The driver's own check (RunLin2 with Model) runs as before; the
+// raw requests and responses are recorded beside it.
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/anishathalye/porcupine"
+	"go.uber.org/zap"
+
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/client/v3/kubernetes"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/apiserver/pkg/storage"
+
+	"github.com/mit-pdos/etcd-grove/examples/k8s/etcd3/correctness"
+	"github.com/mit-pdos/etcd-grove/examples/lib/cluster3"
+	"github.com/mit-pdos/etcd-grove/examples/lib/etcdstart"
+	"github.com/mit-pdos/etcd-grove/examples/lib/lintest"
+)
+
+type rawRec struct {
+	in    Input
+	req   correctness.Request
+	resp  correctness.Response
+	wreq  correctness.WatchRequest
+	wresp correctness.WatchResponse
+	// a watch whose Watch call failed, or a skipped one
+	wfailed bool
+	skip    bool
+}
+
+type recorder struct {
+	mu   sync.Mutex
+	recs map[int][]rawRec
+}
+
+func (r *recorder) add(id int, rec rawRec) {
+	r.mu.Lock()
+	r.recs[id] = append(r.recs[id], rec)
+	r.mu.Unlock()
+}
+
+// rawCall is call, keeping the raw request and response.
+func rawCall(s storage.Interface, in Input) (correctness.Request, correctness.Response, Output) {
+	ctx := context.Background()
+	if in.Kind == KList {
+		l := &ObjList{}
+		opts := listOptions(in)
+		req := correctness.Request{Op: correctness.OpList, Key: in.ListKey, List: correctness.ListRequest{Options: opts}}
+		if err := s.GetList(ctx, in.ListKey, opts, l); err != nil {
+			return req, correctness.Response{Err: err}, errOut(err)
+		}
+		return req, correctness.Response{Object: l}, listOut(l)
+	}
+	out := &Obj{}
+	var err error
+	var req correctness.Request
+	key := storeKey(in.Key)
+	if in.Kind == KCreate {
+		ns, name := splitKey(in.Key)
+		obj := &Obj{Namespace: ns, Name: name, UID: in.UID, Value: in.Val, Node: in.Node, App: in.App}
+		req = correctness.Request{Op: correctness.OpCreate, Key: key, Create: correctness.CreateRequest{Object: obj.DeepCopyObject()}}
+		err = s.Create(ctx, key, obj, out, 0)
+	} else if in.Kind == KDelete {
+		req = correctness.Request{Op: correctness.OpDelete, Key: key, Delete: correctness.DeleteRequest{
+			Preconditions: preconditions(in), ValidateDeletion: validateFor(in.HasReject, in.Reject),
+			CachedExistingObject: cachedObj(in)}}
+		err = s.Delete(ctx, key, out, preconditions(in), validateFor(in.HasReject, in.Reject),
+			cachedObj(in), storage.DeleteOptions{})
+	} else if in.Kind == KUpdate {
+		req = correctness.Request{Op: correctness.OpUpdate, Key: key, Update: correctness.UpdateRequest{
+			UpdateFunc: tryUpdateFor(in), IgnoreNotFound: in.IgnoreNotFound,
+			Preconditions: preconditions(in), CachedExistingObject: cachedObj(in)}}
+		err = s.GuaranteedUpdate(ctx, key, out, in.IgnoreNotFound, preconditions(in),
+			tryUpdateFor(in), cachedObj(in))
+	} else {
+		opts := storage.GetOptions{IgnoreNotFound: in.IgnoreNotFound, ResourceVersion: in.MinRV}
+		req = correctness.Request{Op: correctness.OpGet, Key: key, Get: correctness.GetRequest{Options: opts}}
+		err = s.Get(ctx, key, opts, out)
+	}
+	if err != nil {
+		return req, correctness.Response{Err: err}, errOut(err)
+	}
+	return req, correctness.Response{Object: out}, objOut(*out)
+}
+
+// rawConsume is consume, keeping the raw events.
+func rawConsume(w watch.Interface, in Input) ([]WEvent, []watch.Event) {
+	timer := time.NewTimer(watchDuration)
+	defer timer.Stop()
+	if in.Behavior == BStalled {
+		<-time.After(hiccupDuration)
+		return nil, nil
+	}
+	initialDone := in.SendInit != 2
+	hiccupDone := in.Behavior != BHiccup
+	var evs []WEvent
+	var raw []watch.Event
+	for {
+		if initialDone {
+			var delay time.Duration
+			if !hiccupDone && len(evs) > 0 {
+				delay = hiccupDuration
+				hiccupDone = true
+			} else if in.Behavior == BSlow {
+				delay = slowDelay
+			}
+			if delay > 0 {
+				select {
+				case <-timer.C:
+					return evs, raw
+				case <-time.After(delay):
+				}
+			}
+		}
+		select {
+		case <-timer.C:
+			return evs, raw
+		case ev, open := <-w.ResultChan():
+			if !open {
+				return evs, raw
+			}
+			we := toWEvent(ev)
+			evs = append(evs, we)
+			raw = append(raw, ev)
+			if we.Type == WBookmark {
+				initialDone = true
+			}
+			if len(evs) >= maxEvents {
+				return evs, raw
+			}
+		}
+	}
+}
+
+func rawWatch(s storage.Interface, in Input) (Output, Obj, bool, rawRec) {
+	rec := rawRec{in: in}
+	if in.Skip {
+		rec.skip = true
+		return Output{WFailed: true}, Obj{}, false, rec
+	}
+	start := time.Now()
+	opts := watchOptions(in)
+	rec.wreq = correctness.WatchRequest{Key: in.WKey, Options: opts}
+	ctx, cancel := context.WithCancel(context.Background())
+	w, err := s.Watch(ctx, in.WKey, opts)
+	var evs []WEvent
+	if err != nil {
+		cancel()
+		rec.wfailed = true
+		rec.wresp = correctness.WatchResponse{Err: err}
+	} else {
+		var raw []watch.Event
+		evs, raw = rawConsume(w, in)
+		w.Stop()
+		cancel()
+		rec.wresp = correctness.WatchResponse{Events: raw}
+	}
+	if d := time.Since(start); d < hiccupDuration {
+		time.Sleep(hiccupDuration - d)
+	}
+	if rec.wfailed {
+		return Output{WFailed: true}, Obj{}, false, rec
+	}
+	o, ok := lastObj(evs)
+	return Output{WEvents: encodeWEvents(evs)}, o, ok, rec
+}
+
+// rawApply is Apply, recording the raw request and response.
+func rawApply(s storage.Interface, tbl *cache, rc *recorder, input any) any {
+	in := input.(Input)
+	if in.Kind == KWatch {
+		out, last, ok, rec := rawWatch(s, in)
+		if ok {
+			tbl.putW(in.Client, last)
+		}
+		rc.add(in.Client, rec)
+		return out
+	}
+	req, resp, out := rawCall(s, in)
+	if out.Err == ENone && out.Name != "" {
+		tbl.put(in.Client, objOf(out))
+	}
+	tbl.done.Add(1)
+	rc.add(in.Client, rawRec{in: in, req: req, resp: resp})
+	return out
+}
+
+func toPorcupineModel(s *correctness.Model) porcupine.Model {
+	return porcupine.Model{
+		Init: func() any { return s.Clone() },
+		Step: func(state, input, output any) (bool, any) {
+			ok, next, _ := state.(*correctness.Model).Step(input.(correctness.Request), output.(correctness.Response))
+			return ok, next
+		},
+		Equal: func(a, b any) bool { return a.(*correctness.Model).Equal(b.(*correctness.Model)) },
+	}
+}
+
+func keyFunc(obj runtime.Object) (string, error) {
+	o, ok := obj.(*Obj)
+	if !ok {
+		return "", fmt.Errorf("not an Obj: %T", obj)
+	}
+	return storeKey(o.Namespace + "/" + o.Name), nil
+}
+
+// initialModel is the Model of the seeded store st0: its items, its resource version, and (with
+// the D30g patch) the keys whose stored data is not canonical.
+func initialModel(st0 mstore, patched bool) *correctness.Model {
+	m := correctness.NewEmptyModel(Prefix, newObj, func() runtime.Object { return &ObjList{} }, versioner{})
+	m.ResourceVersion = st0.rv
+	for _, it := range st0.items {
+		o := it.obj
+		m.Items[storeKey(it.key)] = &o
+		if patched && !it.canon {
+			if m.NeedsRewrite == nil {
+				m.NeedsRewrite = map[string]bool{}
+			}
+			m.NeedsRewrite[storeKey(it.key)] = true
+		}
+	}
+	return m
+}
+
+type realStats struct {
+	unary, failedUnary, watches, failedWatches, skipped, errorEvents, eventsAfterError int
+	verdict                                                                          string
+}
+
+// truncateAtError is the events up to and including the first Error event.
+func truncateAtError(evs []watch.Event) ([]watch.Event, bool) {
+	for i, ev := range evs {
+		if ev.Type == watch.Error {
+			return evs[:i+1], i+1 < len(evs)
+		}
+	}
+	return evs, false
+}
+
+// realCheck runs the maintainers' checker on the recorded history (the driver's linearized ops
+// give the call and return times).
+func realCheck(t *testing.T, st0 mstore, ops []porcupine.Operation, rc *recorder, patched bool, truncate bool) realStats {
+	var st realStats
+	// map each op to its raw record: per client, by call time
+	byClient := map[int][]porcupine.Operation{}
+	for _, op := range ops {
+		byClient[op.ClientId] = append(byClient[op.ClientId], op)
+	}
+	var unary []correctness.Operation
+	var watches []correctness.WatchOperation
+	for id, cops := range byClient {
+		sort.Slice(cops, func(i, j int) bool { return cops[i].Call < cops[j].Call })
+		recs := rc.recs[id]
+		if len(recs) != len(cops) {
+			t.Fatalf("client %d: %d records, %d ops", id, len(recs), len(cops))
+		}
+		for i, op := range cops {
+			rec := recs[i]
+			if rec.in.Kind == KWatch {
+				if rec.skip {
+					st.skipped++
+					continue
+				}
+				st.watches++
+				if rec.wfailed {
+					st.failedWatches++
+				}
+				evs := rec.wresp.Events
+				for _, ev := range evs {
+					if ev.Type == watch.Error {
+						st.errorEvents++
+						break
+					}
+				}
+				if tr, after := truncateAtError(evs); after {
+					st.eventsAfterError++
+					if truncate {
+						evs = tr
+					}
+				}
+				watches = append(watches, correctness.WatchOperation{Request: rec.wreq,
+					Response: correctness.WatchResponse{Events: evs, Err: rec.wresp.Err}})
+				continue
+			}
+			st.unary++
+			if op.Output.(Output).Err == EOther {
+				st.failedUnary++
+			}
+			unary = append(unary, correctness.Operation{ClientID: id, Request: rec.req, Response: rec.resp,
+				Start: time.Unix(0, op.Call), End: time.Unix(0, op.Return)})
+		}
+	}
+	init := initialModel(st0, patched)
+	pops := make([]porcupine.Operation, len(unary))
+	for i, op := range unary {
+		pops[i] = porcupine.Operation{ClientId: op.ClientID, Input: op.Request, Call: op.Start.UnixNano(),
+			Output: op.Response, Return: op.End.UnixNano()}
+	}
+	res, info := porcupine.CheckOperationsVerbose(toPorcupineModel(init), pops, time.Minute)
+	if res != porcupine.Ok {
+		st.verdict = fmt.Sprintf("porcupine %v", res)
+		return st
+	}
+	lins := info.PartialLinearizations()
+	if len(lins) != 1 || len(lins[0]) != 1 {
+		st.verdict = "no linearization"
+		return st
+	}
+	ordered := make([]correctness.Operation, len(lins[0][0]))
+	for i, idx := range lins[0][0] {
+		ordered[i] = unary[idx]
+	}
+	replay, err := correctness.NewReplay(init, ordered)
+	if err != nil {
+		st.verdict = "NewReplay: " + err.Error()
+		return st
+	}
+	var bad []string
+	for _, op := range ordered {
+		if err := replay.Validate(op.Request, op.Response); err != nil {
+			bad = append(bad, "Validate: "+firstLine(err.Error()))
+		}
+	}
+	validator := correctness.NewWatchValidator(versioner{}, replay, keyFunc)
+	for _, w := range watches {
+		if err := validator.ValidateWatch(w.Request, w.Response); err != nil {
+			bad = append(bad, "ValidateWatch: "+firstLine(err.Error()))
+		}
+	}
+	if len(bad) > 0 {
+		kinds := map[string]int{}
+		for _, b := range bad {
+			k := b
+			if i := strings.IndexAny(b, "0123456789"); i >= 0 {
+				k = b[:i]
+			}
+			kinds[k]++
+		}
+		st.verdict = fmt.Sprintf("%d failures %v; first: %s", len(bad), kinds, strings.Join(bad[:min(len(bad), 3)], " | "))
+		return st
+	}
+	st.verdict = "Ok"
+	return st
+}
+
+func firstLine(s string) string {
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		return s[:i]
+	}
+	if len(s) > 300 {
+		return s[:300]
+	}
+	return s
+}
+
+func envBool(name string, def bool) bool {
+	switch os.Getenv(name) {
+	case "1", "true":
+		return true
+	case "0", "false":
+		return false
+	}
+	return def
+}
+
+// runReal runs the driver's check with the raw recording, then the real checker.
+func runReal(t *testing.T, s storage.Interface, st0 mstore, h0 []mstore, clients, ops, watchers, wops int) {
+	rc := &recorder{recs: map[int][]rawRec{}}
+	if envBool("K8S7G_FLOOR", false) {
+		floorRV = st0.rv
+	}
+	t.Logf("floorRV %d", floorRV)
+	tbl := newWCache(clients, int64(clients)*int64(ops))
+	apply := func(input any) any { return rawApply(s, tbl, rc, input) }
+	gen := func(id int) any { return Gen(tbl, id) }
+	r, lops := lintest.RunLin2(Model(st0, h0), apply, gen, lintest.CounterClock(), clients, ops, watchers, wops, 0)
+	t.Logf("driver's check: %v", r)
+	if r != porcupine.Ok {
+		t.Fatalf("driver's check %v", r)
+	}
+	patched := envBool("K8S7G_PATCH", true)
+	truncate := envBool("K8S7G_TRUNC", true)
+	st := realCheck(t, st0, lops, rc, patched, truncate)
+	t.Logf("real checker (D30g patch %v, SetResourceVersion decimal %v, truncate at Error %v): %s", patched, setRVDecimal, truncate, st.verdict)
+	t.Logf("unary %d (failed %d), watches %d (failed %d, with Error %d, events after Error %d), skipped %d",
+		st.unary, st.failedUnary, st.watches, st.failedWatches, st.errorEvents, st.eventsAfterError, st.skipped)
+	if os.Getenv("K8S7G_REQUIRE_OK") == "1" && st.verdict != "Ok" {
+		t.Errorf("real checker: %s", st.verdict)
+	}
+}
