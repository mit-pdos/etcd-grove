--- a/examples/k8s/etcd3/watch_test.go
+++ b/examples/k8s/etcd3/watch_test.go
@@ -0,0 +1,255 @@
+package etcd3
+
+import (
+	"os"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/anishathalye/porcupine"
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/client/v3/kubernetes"
+	"go.uber.org/zap"
+
+	"github.com/mit-pdos/etcd-grove/examples/lib/cluster3"
+	"github.com/mit-pdos/etcd-grove/examples/lib/etcdstart"
+)
+
+// watchStats counts a run's watches: by behaviour and outcome, their events by type, the watches
+// with initial events, with an error event, with events after an error event.
+type watchStats struct {
+	mu                                     sync.Mutex
+	watches, failed, skipped, withEvents   int
+	initial, withErr, afterErr             int
+	byType                                 [5]int
+	byBeh                                  [4]int
+	maxRev                                 uint64
+	unaryFails                             atomic.Int64
+}
+
+func (ws *watchStats) hook(in Input, out Output) Output {
+	if in.Kind != KWatch {
+		if out.Err == EOther {
+			ws.unaryFails.Add(1)
+		}
+		return out
+	}
+	ws.mu.Lock()
+	defer ws.mu.Unlock()
+	if in.Skip {
+		ws.skipped++
+		return out
+	}
+	ws.watches++
+	ws.byBeh[in.Behavior]++
+	if out.WFailed {
+		ws.failed++
+	}
+	if len(out.WEvents) > 0 {
+		ws.withEvents++
+	}
+	if in.SendInit == 2 && len(out.WEvents) > 0 {
+		ws.initial++
+	}
+	errAt := -1
+	for i, ev := range out.WEvents {
+		ws.byType[ev.Type]++
+		if ev.Type == WError && errAt < 0 {
+			errAt = i
+		}
+		if ev.Obj.ResourceVersion > ws.maxRev {
+			ws.maxRev = ev.Obj.ResourceVersion
+		}
+	}
+	if errAt >= 0 {
+		ws.withErr++
+		if errAt != len(out.WEvents)-1 {
+			ws.afterErr++
+		}
+	}
+	return out
+}
+
+func (ws *watchStats) log(t *testing.T) {
+	t.Logf("watches %d (fast/slow/hiccup/stalled %v), failed %d, skipped %d, with events %d, "+
+		"watch-list with events %d, with an error %d, events after an error %d; events "+
+		"added/modified/deleted/bookmark/error %v; max revision %d; failed unary calls %d",
+		ws.watches, ws.byBeh, ws.failed, ws.skipped, ws.withEvents, ws.initial, ws.withErr,
+		ws.afterErr, ws.byType, ws.maxRev, ws.unaryFails.Load())
+}
+
+// peakRSS is the process's peak resident set (VmHWM), for the memory reports.
+func peakRSS() string {
+	b, err := os.ReadFile("/proc/self/status")
+	if err != nil {
+		return "?"
+	}
+	for _, l := range splitLines(string(b)) {
+		if len(l) > 6 && l[:6] == "VmHWM:" {
+			return l[6:]
+		}
+	}
+	return "?"
+}
+
+func splitLines(s string) []string {
+	var out []string
+	start := 0
+	for i := range s {
+		if s[i] == '\n' {
+			out = append(out, s[start:i])
+			start = i + 1
+		}
+	}
+	return out
+}
+
+// singleW is MainW's setup and check, with the hook.
+func singleW(t *testing.T, clients, ops, watchers, wops int, hook func(Input, Output) Output) porcupine.CheckResult {
+	lg := zap.NewNop()
+	srv, err := etcdstart.StartServer("k8setcd3", "127.0.0.1:23906", clientAddr, lg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := etcdstart.Serve(srv, clientAddr); err != nil {
+		t.Fatal(err)
+	}
+	kc, err := kubernetes.New(clientv3.Config{Endpoints: []string{clientAddr}, Logger: lg, MaxUnaryRetries: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	st0, h0, ok := seed(kc.Client)
+	if !ok {
+		t.Fatal("seed")
+	}
+	s, ok := newStoreW(kc)
+	if !ok {
+		t.Fatal("store")
+	}
+	r, _ := checkWWith(s, Model(st0, h0), clients, ops, watchers, wops, 0, hook)
+	return r
+}
+
+// TestMainWatch runs the driver with watchers on one member: Ok, and the counts.
+func TestMainWatch(t *testing.T) {
+	inChild(t, "TestMainWatch", "", func(t *testing.T) {
+		ws := &watchStats{}
+		start := time.Now()
+		r := singleW(t, 8, 300, 16, 8, ws.hook)
+		ws.log(t)
+		t.Logf("%v in %v, peak RSS %s", r, time.Since(start), peakRSS())
+		if r != porcupine.Ok {
+			t.Fatalf("got %v, want Ok", r)
+		}
+	})
+}
+
+// corruptions are the ways TestWatchCorrupt corrupts the first watch with a change event: the
+// event's object's value, its resource version, its type, the event dropped, an event duplicated.
+var corruptions = map[string]func(evs []WEvent, i int) []WEvent{
+	"value": func(evs []WEvent, i int) []WEvent { evs[i].Obj.Value += "!"; return evs },
+	"rv":    func(evs []WEvent, i int) []WEvent { evs[i].Obj.ResourceVersion++; return evs },
+	"type": func(evs []WEvent, i int) []WEvent {
+		evs[i].Type = (evs[i].Type + 1) % 3
+		return evs
+	},
+	"drop": func(evs []WEvent, i int) []WEvent { return append(evs[:i:i], evs[i+1:]...) },
+	"dup": func(evs []WEvent, i int) []WEvent {
+		out := append(evs[:i+1:i+1], evs[i])
+		return append(out, evs[i+1:]...)
+	},
+}
+
+// TestWatchCorrupt runs the driver with watchers on one member, corrupting the first watch that
+// received a change event (corruptions; K8SETCD3_SCHED names one, all by default): porcupine then
+// answers Illegal.
+func TestWatchCorrupt(t *testing.T) {
+	only := os.Getenv("K8SETCD3_SCHED")
+	for name, f := range corruptions {
+		if only != "" && name != only {
+			continue
+		}
+		t.Run(name, func(t *testing.T) {
+			inChild(t, "TestWatchCorrupt", name, func(t *testing.T) {
+				var done atomic.Bool
+				hook := func(in Input, out Output) Output {
+					if in.Kind != KWatch || done.Load() {
+						return out
+					}
+					for i, ev := range out.WEvents {
+						if ev.Type <= WDeleted && !(in.SendInit == 2 && !hasBookmarkBefore(out.WEvents, i)) {
+							if done.CompareAndSwap(false, true) {
+								evs := append([]WEvent{}, out.WEvents...)
+								out.WEvents = f(evs, i)
+								t.Logf("corrupted (%s) event %d of a watch of %q", name, i, in.WKey)
+							}
+							break
+						}
+					}
+					return out
+				}
+				r := singleW(t, 4, 60, 8, 6, hook)
+				if !done.Load() {
+					t.Fatalf("no watch received a change event")
+				}
+				if r != porcupine.Illegal {
+					t.Fatalf("got %v, want Illegal", r)
+				}
+			})
+		})
+	}
+}
+
+func hasBookmarkBefore(evs []WEvent, i int) bool {
+	for j := 0; j < i; j++ {
+		if evs[j].Type == WBookmark {
+			return true
+		}
+	}
+	return false
+}
+
+// TestMainPartitionWatch runs MainPartitionW's setup once per schedule (K8SETCD3_SCHED names one),
+// each in a process of its own: Ok, the counts, the time and the peak memory.
+func TestMainPartitionWatch(t *testing.T) {
+	only := os.Getenv("K8SETCD3_SCHED")
+	scheds := partitionSchedules()
+	// no leader anywhere for 6s (every peer link cut), longer than the 3 election timeouts after
+	// which a member cancels its require-leader streams (the store's watches): the watches end
+	// with a no-leader error
+	ms := time.Millisecond
+	scheds["noleader"] = []cluster3.Step{
+		{Delay: 300 * ms, Kind: cluster3.PeerCut, A: 0, B: 1},
+		{Kind: cluster3.PeerCut, A: 0, B: 2},
+		{Kind: cluster3.PeerCut, A: 1, B: 2},
+		{Delay: 6 * time.Second, Kind: cluster3.PeerMend, A: 0, B: 1},
+		{Kind: cluster3.PeerMend, A: 0, B: 2},
+		{Kind: cluster3.PeerMend, A: 1, B: 2},
+	}
+	for name, sched := range scheds {
+		if only != "" && name != only {
+			continue
+		}
+		t.Run(name, func(t *testing.T) {
+			inChild(t, "TestMainPartitionWatch", name, func(t *testing.T) {
+				srvs, brs, s, st0, h0, ok := clusterW()
+				if !ok {
+					t.Fatal("cluster")
+				}
+				go cluster3.Partitioner(srvs, brs, sched)
+				ws := &watchStats{}
+				start := time.Now()
+				r, _ := checkWWith(s, Model(st0, h0), 4, 60, 8, 12, 0, ws.hook)
+				ws.log(t)
+				var m runtime.MemStats
+				runtime.ReadMemStats(&m)
+				t.Logf("%s: %v in %v, peak RSS %s", name, r, time.Since(start), peakRSS())
+				if r != porcupine.Ok {
+					t.Fatalf("got %v, want Ok", r)
+				}
+			})
+		})
+	}
+}
