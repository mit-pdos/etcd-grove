+// watchStats counts a run's watches: by behaviour and outcome, their events by type, the watches
+// with initial events, with an error event, with events after an error event.
+type watchStats struct {
+	mu                                   sync.Mutex
+	watches, failed, skipped, withEvents int
+	initial, withErr, afterErr           int
+	byType                               [6]int
+	byBeh                                [4]int
+	maxRev                               uint64
+	unaryFails                           atomic.Int64
+}
+
+func (ws *watchStats) hook(in Input, out Output) Output {
+	if in.Kind != KWatch {
+		if out.Err == EOther {
+			ws.unaryFails.Add(1)
+		}
+		return out
+	}
+	ws.mu.Lock()
+	defer ws.mu.Unlock()
+	if in.Skip {
+		ws.skipped++
+		return out
+	}
+	ws.watches++
+	ws.byBeh[in.Behavior]++
+	if out.WFailed {
+		ws.failed++
+	}
+	evs, _ := decodeWEvents(out.WEvents)
+	if len(evs) > 0 {
+		ws.withEvents++
+	}
+	if in.SendInit == 2 && len(evs) > 0 {
+		ws.initial++
+	}
+	errAt := -1
+	for i, ev := range evs {
+		ws.byType[ev.Type]++
+		if ev.Type == WError && errAt < 0 {
+			errAt = i
+		}
+		if ev.Obj.ResourceVersion > ws.maxRev {
+			ws.maxRev = ev.Obj.ResourceVersion
+		}
+	}
+	if errAt >= 0 {
+		ws.withErr++
+		if errAt != len(evs)-1 {
+			ws.afterErr++
+		}
+	}
+	return out
+}
+
+func (ws *watchStats) log(t *testing.T) {
+	t.Logf("watches %d (fast/slow/hiccup/stalled %v), failed %d, skipped %d, with events %d, "+
+		"watch-list with events %d, with an error %d, events after an error %d; events "+
+		"added/modified/deleted/bookmark/error/bad %v; max revision %d; failed unary calls %d",
+		ws.watches, ws.byBeh, ws.failed, ws.skipped, ws.withEvents, ws.initial, ws.withErr,
+		ws.afterErr, ws.byType, ws.maxRev, ws.unaryFails.Load())
+}
+
+// peakRSS is the process's peak resident set (VmHWM), for the memory reports.
+func peakRSS() string {
+	b, err := os.ReadFile("/proc/self/status")
+	if err != nil {
+		return "?"
+	}
+	s := string(b)
+	for len(s) > 0 {
+		i := 0
+		for i < len(s) && s[i] != '\n' {
+			i++
+		}
+		if l := s[:i]; len(l) > 6 && l[:6] == "VmHWM:" {
+			return l[6:]
+		}
+		if i == len(s) {
+			break
+		}
+		s = s[i+1:]
+	}
+	return "?"
+}
+
+// singleW is Main's setup and check (watchers included), with the hook.
+func singleW(t *testing.T, clients, ops, watchers, wops int, hook func(Input, Output) Output) porcupine.CheckResult {
+	return singleWAt(t, 0, clients, ops, watchers, wops, hook)
+}
+
+// singleWAt is singleW on a member of its own for attempt a (its name and addresses), so that a
+// process can run several.
+func singleWAt(t *testing.T, a int, clients, ops, watchers, wops int, hook func(Input, Output) Output) porcupine.CheckResult {
+	lg := zap.NewNop()
+	name, peer, cl := "k8setcd3", "127.0.0.1:23906", clientAddr
+	if a > 0 {
+		name = fmt.Sprintf("k8setcd3w%d", a)
+		peer = fmt.Sprintf("127.0.0.1:%d", 23970+a)
+		cl = fmt.Sprintf("127.0.0.1:%d", 23980+a)
+	}
+	srv, err := etcdstart.StartServer(name, peer, cl, lg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := etcdstart.Serve(srv, cl); err != nil {
+		t.Fatal(err)
+	}
+	kc, err := kubernetes.New(clientv3.Config{Endpoints: []string{cl}, Logger: lg, MaxUnaryRetries: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	st0, h0, ok := seed(kc.Client)
+	if !ok {
+		t.Fatal("seed")
+	}
+	s, ok := newStoreW(kc)
+	if !ok {
+		t.Fatal("store")
+	}
+	r, _ := checkWWith(s, Model(st0, h0), clients, ops, watchers, wops, 0, hook)
+	return r
+}
