+package etcd3
+
+// The 7f prototype's gate and test helpers (notes/k8s-7f-scope.md).
+
+import (
+	"time"
+
+	"github.com/anishathalye/porcupine"
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"go.etcd.io/etcd/client/v3/kubernetes"
+	"go.etcd.io/etcd/server/v3/etcdserver"
+	"go.uber.org/zap"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/storage"
+	"k8s.io/apiserver/pkg/storage/etcd3"
+	utilfeature "k8s.io/apiserver/pkg/util/feature"
+
+	"github.com/mit-pdos/etcd-grove/examples/lib/cluster3"
+	"github.com/mit-pdos/etcd-grove/examples/lib/etcdstart"
+	"github.com/mit-pdos/etcd-grove/examples/lib/lintest"
+	"github.com/mit-pdos/etcd-grove/third_party/bridge"
+)
+
+// watchList turns the WatchList feature on (as the test's setupStore), or returns false.
+func watchList() bool {
+	return utilfeature.DefaultMutableFeatureGate.Set("WatchList=true") == nil
+}
+
+// checkWWith is Check with the model m and, if hook is not nil, every output passed through hook
+// before it is recorded (the tests' counts and corruptions).
+func checkWWith(s storage.Interface, m porcupine.Model, clients int, ops int, watchers int, wops int, timeout time.Duration, hook func(Input, Output) Output) (porcupine.CheckResult, []porcupine.Operation) {
+	tbl := newCache()
+	tbl.unary = clients
+	tbl.total = int64(clients) * int64(ops)
+	apply := func(input any) any {
+		out := Apply(s, tbl, input).(Output)
+		if hook != nil {
+			out = hook(input.(Input), out)
+		}
+		return out
+	}
+	gen := func(id int) any { return Gen(tbl, id) }
+	return lintest.RunLin2(m, apply, gen, lintest.CounterClock(), clients, ops, watchers, wops, timeout)
+}
+
+// newStoreW is the store over the kubernetes client kc, the features set (no streaming lists,
+// WatchList on), or false.
+func newStoreW(kc *kubernetes.Client) (storage.Interface, bool) {
+	if !noStreaming() || !watchList() {
+		return nil, false
+	}
+	s, err := etcd3.New(kc, noCompactor{}, codec{}, newObj, nil, nil, Prefix, ResourcePrefix,
+		schema.GroupResource{Resource: "objs"}, identity{}, etcd3.NewDefaultLeaseManagerConfig(),
+		decoder{}, versioner{})
+	if err != nil {
+		return nil, false
+	}
+	return s, true
+}
+
+// clusterW starts MainCluster's cluster and connects its client, seeds and makes the store.
+func clusterW() ([]*etcdserver.EtcdServer, []bridge.Bridge, storage.Interface, mstore, []mstore, bool) {
+	lg := zap.NewNop()
+	cfg := clusterConfig()
+	srvs, brs, ok := cluster3.StartCluster(cfg, lg)
+	if !ok {
+		return nil, nil, nil, mstore{}, nil, false
+	}
+	kc, err := kubernetes.New(clientv3.Config{
+		Endpoints:            []string{cfg.Bridge1, cfg.Bridge2, cfg.Bridge3},
+		DialTimeout:          etcdstart.DialTimeout,
+		DialKeepAliveTime:    etcdstart.KeepAliveTime,
+		DialKeepAliveTimeout: etcdstart.KeepAliveTimeout,
+		Logger:               lg,
+	})
+	if err != nil {
+		return nil, nil, nil, mstore{}, nil, false
+	}
+	st0, h0, ok := seed(kc.Client)
+	if !ok {
+		return nil, nil, nil, mstore{}, nil, false
+	}
+	s, ok := newStoreW(kc)
+	return srvs, brs, s, st0, h0, ok
+}
