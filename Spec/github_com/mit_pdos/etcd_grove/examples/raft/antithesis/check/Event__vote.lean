/-- `ev.vote`, where present (absent: an `EvalError`). -/
abbrev Event.vote.spec : Prop :=
  ∀ (p : Loc) (ev : Event) (x : Str),
  {{ isPkgInit (PROP := IProp GF) pkg_id.github_com.mit_pdos.etcd_grove.examples.raft.antithesis.check ∗
      eventRO p ev ∗ ⌜need ev.vote = .ok x⌝ }}
    (App (Val (p @!! go.GoType.PointerType github_com.mit_pdos.etcd_grove.examples.raft.antithesis.check.Event.ty @!! go!"vote")) (Val #()))
  {{ RET #x; True }}

end spec

