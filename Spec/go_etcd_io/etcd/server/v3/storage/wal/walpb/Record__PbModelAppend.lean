/-
`(*walpb.Record).PbModelAppend(b, cached)` (the protobuf model's append method, `pbmodel_gen.go`,
generated by `models/protobuf/pbgen.py --pbmodel` and translated through `etc/goose.py`'s overlay;
#37 stage S3) on a frozen record holding exactly `c` (`recRoC`): appends `c`'s encoding (`recEnc`,
`WalPbWire.lean`: the set fields in number order, then the unknown fields) to `b` and returns it and
`nil`, whatever `cached` (a `Record` has no message field, so no length prefix reads a cache). The
result may share `b`'s array (Go's `append`). Lean-first.
-/
module

public import Proof.go_etcd_io.etcd.server.v3.storage.wal.walpb.PbRecord

@[expose] public section

noncomputable section

namespace Perennial
namespace EtcdGrove

open Iris Iris.BI
open WalEnc

section spec
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]
variable [go_etcd_io.etcd.server.v3.storage.wal.walpb.Assumptions]

/-- See the file header. -/
abbrev go_etcd_io.etcd.server.v3.storage.wal.walpb.Record.PbModelAppend.spec : Prop :=
  ∀ (l : Loc) (c : RecC) (b : GoSlice) (bs : List w8) (cached : Bool),
  {{ recRoC (GF := GF) l c ∗ b ↦* bs ∗ ownSliceCap w8 b (DFrac.own 1) }}
    (App (App (Val (l @!! go.GoType.PointerType go_etcd_io.etcd.server.v3.storage.wal.walpb.Record.ty
      @!! go!"PbModelAppend")) (Val #b)) (Val #cached))
  {{ (b' : GoSlice), RET (PairV #b' #(GoInterface.nil));
      b' ↦* (bs ++ recEnc c) ∗ ownSliceCap w8 b' (DFrac.own 1) }}

end spec

end EtcdGrove
end Perennial
