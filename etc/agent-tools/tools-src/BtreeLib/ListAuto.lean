/-
`list_seg`: one tactic for the pure list side goals of slice-manipulating proofs.

    list_seg            -- close a pure list/length/index goal, or fail
    list_seg [h, foo]   -- the same, also using the given facts/lemmas
    sorted_seg          -- `Sorted lt l` goals for pieces of a sorted list

`list_seg` (see `list_seg_core` below for the exact pipeline):
1. clears the hypotheses that mention Iris entailments (so it is safe and cheap inside a
   proof-mode proof), introduces binders, evaluates word literals (`sint.nat (W64 0)` is `0`)
   and unfolds `subslice`, `Sorted`;
2. normalises goal and hypotheses with the `@[seg]`, `@[list_simp]` and `@[len]` simp sets:
   `take`/`drop`/`set`/`++`/`map`/`replicate`/`dropLast`/`getElem?` of these, lengths;
   conditional rewrites (`(l.set i x).take j = l.take j` if `j ≤ i`, ...) have their side
   conditions discharged by `omega`, then `word`;
3. closes the result with `omega`, `word`, `simp_all`, or `grind` (with the list lemmas of
   `seg_grind` below and the arguments), or, for a list equation, pointwise: `List.ext_getElem?`,
   simplification of each lookup, case split on the index, `omega`.
It never leaves a modified goal behind: either the goal is closed, or it fails with the
original goal. It never admits a goal (`sorry`).

Search for an existing lemma first in `LEMMAS.md` (generated by `etc/lemma-index.py`).
-/
import BtreeLib.ListAuto.Attr
import Perennial.Std.ListSolver
import Perennial.Std.List
import EtcdGrove.Btree.Model
import Perennial.Golang.Defn.Slice

namespace Perennial
namespace EtcdGrove
namespace Btree

/-! ## Generic list lemmas (the shapes slice code produces) -/

section lemmas
variable {A : Type}

/-- Overwriting slot `j` and dropping the prefix before it. -/
theorem seg_drop_set_self (l : List A) (j : Nat) (a : A) (hj : j < l.length) :
    (l.set j a).drop j = a :: l.drop (j + 1) := by
  rw [List.drop_set, if_neg (by omega), Nat.sub_self, List.drop_eq_getElem_cons hj]
  rfl

theorem seg_take_set_of_le (l : List A) (i j : Nat) (a : A) (h : j ≤ i) :
    (l.set i a).take j = l.take j := List.take_set_of_le h

theorem seg_drop_set_of_lt (l : List A) (i j : Nat) (a : A) (h : i < j) :
    (l.set i a).drop j = l.drop j := List.drop_set_of_lt h

theorem seg_take_drop_self (l : List A) (i : Nat) : l.take i ++ l.drop i = l :=
  List.take_append_drop i l

/-- `take i ++ l[i] :: drop (i+1)` is `l`. -/
theorem seg_take_cons_drop (l : List A) (i : Nat) (h : i < l.length) :
    l.take i ++ l[i] :: l.drop (i + 1) = l := by
  rw [← List.drop_eq_getElem_cons h, List.take_append_drop]

theorem seg_getElem?_mid (P Q : List A) (x : A) : (P ++ x :: Q)[P.length]? = some x := by simp

theorem seg_set_mid (P Q : List A) (a a' : A) :
    (P ++ a :: Q).set P.length a' = P ++ a' :: Q := by
  induction P <;> simp_all

theorem seg_take_mid (P Q : List A) (x : A) : (P ++ x :: Q).take P.length = P := by simp

theorem seg_drop_mid (P Q : List A) (x : A) : (P ++ x :: Q).drop (P.length + 1) = Q := by
  induction P <;> simp_all

theorem seg_take_length_append (P Q : List A) : (P ++ Q).take P.length = P := by simp

theorem seg_drop_length_append (P Q : List A) : (P ++ Q).drop P.length = Q := by simp

theorem seg_dropLast_eq_take (l : List A) : l.dropLast = l.take (l.length - 1) :=
  List.dropLast_eq_take

theorem seg_tail_eq_drop (l : List A) : l.tail = l.drop 1 := by cases l <;> simp

theorem seg_dropLast_append_singleton (l : List A) (x : A) : (l ++ [x]).dropLast = l := by simp

/-- A lookup that succeeds is in bounds. -/
theorem seg_lt_of_getElem? {l : List A} {i : Nat} {x : A} (h : l[i]? = some x) : i < l.length :=
  (List.getElem?_eq_some_iff.1 h).1

end lemmas

attribute [seg] seg_drop_set_self seg_take_set_of_le seg_drop_set_of_lt
  seg_take_drop_self seg_take_cons_drop seg_getElem?_mid seg_set_mid seg_take_mid seg_drop_mid
  seg_take_length_append seg_drop_length_append seg_dropLast_append_singleton
  List.length_take List.length_drop List.length_set List.length_append List.length_cons
  List.length_map List.length_replicate List.length_dropLast List.length_reverse List.length_nil
  List.length_tail List.length_singleton List.map_set List.map_cons List.map_nil
  List.getElem?_set_self' List.drop_length List.take_length List.take_append_drop
  List.drop_take List.getElem?_take List.take_succ_cons List.drop_succ_cons List.take_zero
  List.getElem?_cons_succ List.getElem?_cons_zero List.getElem_cons_zero
  List.set_append_left List.set_append_right List.set_cons_zero List.set_cons_succ
  List.getElem?_reverse List.reverse_append List.reverse_cons List.reverse_nil
  List.mem_append List.mem_cons List.not_mem_nil List.append_cancel_left_eq
  List.append_cancel_right_eq List.cons.injEq List.append_eq_nil_iff
  Option.some.injEq List.getElem?_eq_none_iff List.getElem_set_self
  subslice

/-! ## Sortedness (`Sorted lt l` is `l.Pairwise` on keys) -/

section sorted
variable {V K : Type} {lt : K → K → Prop}

theorem seg_sorted_iff (l : List (V × K)) : Sorted lt l ↔ l.Pairwise (fun a b => lt a.2 b.2) :=
  Iff.rfl

theorem seg_sorted_take {l : List (V × K)} (i : Nat) (h : Sorted lt l) : Sorted lt (l.take i) :=
  List.Pairwise.take h

theorem seg_sorted_drop {l : List (V × K)} (i : Nat) (h : Sorted lt l) : Sorted lt (l.drop i) :=
  List.Pairwise.drop h

theorem seg_sorted_sublist {l1 l2 : List (V × K)} (h : l1.Sublist l2) (hs : Sorted lt l2) :
    Sorted lt l1 := List.Pairwise.sublist h hs

theorem seg_sorted_append {l1 l2 : List (V × K)} :
    Sorted lt (l1 ++ l2) ↔ Sorted lt l1 ∧ Sorted lt l2 ∧ ∀ a ∈ l1, ∀ b ∈ l2, lt a.2 b.2 :=
  List.pairwise_append

theorem seg_sorted_cons {x : V × K} {l : List (V × K)} :
    Sorted lt (x :: l) ↔ (∀ b ∈ l, lt x.2 b.2) ∧ Sorted lt l := List.pairwise_cons

theorem seg_sorted_nil : Sorted lt ([] : List (V × K)) := List.Pairwise.nil

/-- The keys of a sorted list increase with the index. -/
theorem seg_sorted_getElem? {l : List (V × K)} (hs : Sorted lt l) {i j : Nat} {x y : V × K}
    (hij : i < j) (hx : l[i]? = some x) (hy : l[j]? = some y) : lt x.2 y.2 := by
  rw [List.getElem?_eq_some_iff] at hx hy
  obtain ⟨hi, rfl⟩ := hx; obtain ⟨hj, rfl⟩ := hy
  exact List.pairwise_iff_getElem.1 hs i j hi hj hij

/-- In a sorted `A ++ x :: B`, `A` is below `x` and `B` above. -/
theorem seg_sorted_mid {A B : List (V × K)} {x : V × K} (hs : Sorted lt (A ++ x :: B)) :
    (∀ e ∈ A, lt e.2 x.2) ∧ (∀ e ∈ B, lt x.2 e.2) := by
  rw [seg_sorted_append, seg_sorted_cons] at hs
  exact ⟨fun e he => hs.2.2 e he x (by simp), hs.2.1.1⟩

end sorted

/-! ## Model definitions `list_seg` may unfold (last resort) -/

attribute [seg_model] lookup ascRange descRange delete countLt ascIn descIn Sorted
  Tree.Shape Tree.RootBounds Tree.items Tree.children removeOp remIdx Target.code

/-! ## Slices: lengths of the slices Go code builds -/

section slices
variable [FfiSyntax] [GoSemanticsFunctions]

theorem seg_slice_len (sl : GoSlice) (V : Type) (lo hi : U64) :
    (slice.slice sl V lo hi).len = hi - lo := rfl
theorem seg_slice_cap (sl : GoSlice) (V : Type) (lo hi : U64) :
    (slice.slice sl V lo hi).cap = sl.cap - lo := rfl
theorem seg_fullSlice_len (sl : GoSlice) (V : Type) (lo hi mx : U64) :
    (slice.fullSlice sl V lo hi mx).len = hi - lo := rfl
theorem seg_fullSlice_cap (sl : GoSlice) (V : Type) (lo hi mx : U64) :
    (slice.fullSlice sl V lo hi mx).cap = mx - lo := rfl

end slices

attribute [seg] seg_slice_len seg_slice_cap seg_fullSlice_len seg_fullSlice_cap

/-! ## The tactic -/

/-- Internal: side conditions of the conditional `@[seg]` rewrites. -/
macro "seg_disch" : tactic => `(tactic| first
  | omega
  | (simp only [len, seg] at *; omega))

/-- Internal: normalise word literals and unfold the definitions `list_seg` sees through. -/
macro "seg_norm" : tactic => `(tactic| (
  try word_lit_simp
  try simp only [subslice, Sorted, seg_slice_len, seg_slice_cap, seg_fullSlice_len,
    seg_fullSlice_cap] at *))

/-- Internal: normalise goal and hypotheses with the `seg` simp sets. -/
macro "seg_simp" : tactic => `(tactic|
  simp_pure simp (disch := seg_disch) only [seg, list_simp, len, word.wordLitSintZ,
    word.wordLitUintZ, word.wordLitSintNat, word.wordLitUintNat])

/-- Internal: the (conditional) list lemmas `grind` gets on top of its own `@[grind]` ones.
Unconditional rewrites like `List.take_append` are left out on purpose: they make
`grind`'s E-matching blow up. -/
macro "seg_grind" : tactic => `(tactic|
  grind [seg_take_set_of_le, seg_drop_set_of_lt, seg_drop_set_self,
    seg_lt_of_getElem?, List.Pairwise.sublist, List.pairwise_cons, List.Sublist.length_le,
    List.takeWhile_sublist, List.filter_sublist, Tree.elems_node, Tree.elemsAux_nil,
    Tree.elemsAux_cons_cons, Tree.elemsAux_nil_cons])

/-- Internal: pointwise proof of a list equation. -/
macro "seg_ext" : tactic => `(tactic| (
  apply List.ext_getElem?; intro i
  (try simp (disch := seg_disch) only [seg, list_simp, len, List.getElem?_append,
     List.getElem?_set, List.getElem?_take, List.getElem?_drop, List.getElem?_replicate,
     List.getElem?_map, List.getElem?_cons])
  repeat' split
  all_goals first | rfl | omega | (simp_all; done) | (congr 1; omega) | seg_grind))

open Lean Elab Tactic Term Meta in
/-- Internal: for every hypothesis `ho : StrictOrder lt`, add its fields (`irrefl`, `trans`,
`total`) as hypotheses, for `grind`. -/
elab "seg_order_facts" : tactic => withMainContext do
  for h in ← getLCtx do
    if h.isImplementationDetail then continue
    let ty ← whnfR (← instantiateMVars h.type)
    if ty.isAppOf ``StrictOrder then
      let hs ← exprToSyntax h.toExpr
      evalTactic (← `(tactic| (have := ($hs).irrefl; have := ($hs).trans; have := ($hs).total)))

open Lean Elab Tactic Meta in
/-- Internal: clear the hypotheses unrelated to the goal: keep a hypothesis if it shares a
(non-type, non-function, non-instance) variable with the goal, or with a kept hypothesis
(two rounds). Proof-mode contexts have 50+ hypotheses; `grind` gets slow and lost in them. -/
elab "seg_prune" : tactic => withMainContext do
  let g ← getMainGoal
  let lctx ← getLCtx
  let isData (f : FVarId) : MetaM Bool := do
    let some d := lctx.find? f | return false
    let ty ← instantiateMVars d.type
    if ty.isSort then return false
    if (← isClass? ty).isSome then return false
    if (← isProp ty) then return false
    if (← whnfR ty).isForall then return false
    return true
  let dataVars (e : Lean.Expr) : MetaM (Array FVarId) := do
    let fs := (collectFVars {} (← instantiateMVars e)).fvarIds
    fs.filterM isData
  let mut rel : Std.HashSet FVarId := {}
  for f in ← dataVars (← g.getType) do rel := rel.insert f
  let mut keep : Std.HashSet FVarId := {}
  for _ in [0:2] do
    let mut add : Array FVarId := #[]
    for d in lctx do
      if d.isImplementationDetail || keep.contains d.fvarId then continue
      unless ← isProp d.type do continue
      let vs ← dataVars d.type
      if vs.any rel.contains then
        keep := keep.insert d.fvarId
        add := add ++ vs
    for f in add do rel := rel.insert f
  let mut drop : Array FVarId := #[]
  for d in lctx do
    if d.isImplementationDetail || keep.contains d.fvarId then continue
    if ← isProp d.type then drop := drop.push d.fvarId
  replaceMainGoal [← g.tryClearMany drop]

/-- Internal: last resort, unfold the model definitions (`@[seg_model]`). -/
macro "seg_model_stage" : tactic => `(tactic| (
  simp only [seg_model] at *
  try simp_all (disch := seg_disch) [seg]
  first | done | omega | seg_grind | word))

/-- Internal: the stages, each under a heartbeat budget (`word_bounded n`: n thousand
heartbeats, 1000 ≈ 0.1 s), so that a failure is quick. -/
macro "seg_stages" : tactic => `(tactic| first
  | done | rfl | omega
  | word_bounded 25000 seg_grind
  | word_bounded 25000 (seg_simp; first | done | omega | seg_grind)
  | word_bounded 15000 word
  | word_bounded 15000 seg_ext
  | word_bounded 25000 seg_model_stage)

/-- Internal: the pipeline (after the hints are in the context): all stages on the
hypotheses related to the goal (`seg_prune`), then `grind` on all of them. A failure costs
at most ~13 s (the heartbeat budgets), a success typically 0.1–1 s. -/
macro "list_seg_core" : tactic => `(tactic| no_sorry (
  intros
  word_filter iris
  seg_norm
  try seg_order_facts
  first
  | (seg_prune; seg_stages)
  | word_bounded 25000 seg_grind
  | fail "list_seg could not close the goal (the goal is unchanged). Try `list_seg [h, lemma]` \
      with the missing fact, or look it up in LEMMAS.md."))

/-- See the module docstring. -/
syntax (name := listSeg) "list_seg" (" [" term,* "]")? : tactic

macro_rules
  | `(tactic| list_seg) => `(tactic| list_seg_core)
  | `(tactic| list_seg [$ts,*]) => do
    let mut tac ← `(tactic| list_seg_core)
    for t in ts.getElems.reverse do
      tac ← `(tactic| (have := $t; $tac))
    return tac

/-- `Sorted lt l` for `l` a piece (`take`/`drop`/sublist/`++`) of sorted lists in the
context. -/
macro "sorted_seg" : tactic => `(tactic| no_sorry (
  intros
  word_filter iris
  simp only [Sorted, seg_sorted_iff] at *
  first
  | assumption
  | (apply List.Pairwise.take; assumption)
  | (apply List.Pairwise.drop; assumption)
  | seg_grind
  | (simp_all [List.pairwise_append, List.pairwise_cons]; done)
  | list_seg_core))

end Btree
end EtcdGrove
end Perennial
