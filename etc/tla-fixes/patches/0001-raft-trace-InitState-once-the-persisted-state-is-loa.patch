From e33597a4268afe2b6d413db7a5a31352f88224b5 Mon Sep 17 00:00:00 2001
From: Joseph Tassarotti <jt4767@nyu.edu>
Date: Sun, 8 Nov 2026 17:17:27 +0000
Subject: [PATCH 01/12] raft: trace InitState once the persisted state is
 loaded

issues/raft-tla-restart-initstate-unmatched.md (a change to raft.go, not the model).
---
 raft.go | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/raft.go b/raft.go
index 9f4ea9d..5a25af2 100644
--- a/raft.go
+++ b/raft.go
@@ -463,11 +463,8 @@ func newRaft(c *Config) *raft {
 		disableProposalForwarding:   c.DisableProposalForwarding,
 		disableConfChangeValidation: c.DisableConfChangeValidation,
 		stepDownOnRemoval:           c.StepDownOnRemoval,
-		traceLogger:                 c.TraceLogger,
 	}
 
-	traceInitState(r)
-
 	lastID := r.raftLog.lastEntryID()
 	cfg, trk, err := confchange.Restore(confchange.Changer{
 		Tracker:   r.trk,
@@ -486,6 +483,11 @@ func newRaft(c *Config) *raft {
 	}
 	r.becomeFollower(r.Term, None)
 
+	// Trace the state the node starts in, once the persisted state is loaded:
+	// restoring it is not traced as transitions of its own.
+	r.traceLogger = c.TraceLogger
+	traceInitState(r)
+
 	var nodesStrs []string
 	for _, n := range r.trk.VoterNodes() {
 		nodesStrs = append(nodesStrs, fmt.Sprintf("%x", n))
-- 
2.43.0

