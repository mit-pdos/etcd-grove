From 05d19e6a1b7f3baf2198258406a8e30700cb7e61 Mon Sep 17 00:00:00 2001
From: Joseph Tassarotti <jt4767@nyu.edu>
Date: Sun, 8 Nov 2026 17:17:37 +0000
Subject: [PATCH 05/10] tla: a follower installs a snapshot as raft.restore
 does

And answers it with an append response (subtype app).
issues/raft-tla-snapshot-committed-follower.md, issues/raft-tla-snapshot-response-subtype.md
---
 tla/etcdraft.tla | 40 ++++++++++++++++++++++++++++++++++++----
 1 file changed, 36 insertions(+), 4 deletions(-)

diff --git a/tla/etcdraft.tla b/tla/etcdraft.tla
index 5265051..12c6924 100644
--- a/tla/etcdraft.tla
+++ b/tla/etcdraft.tla
@@ -610,16 +610,48 @@ NoConflictAppendEntriesRequest(i, index, m) ==
     /\ log' = [log EXCEPT ![i] = @ \o SubSeq(m.mentries, Len(@)-index+2, Len(m.mentries))]
     /\ UNCHANGED <<messageVars, serverVars, commitIndex, durableState>>
 
+\* Server i receives a snapshot of j's log up to index Len(m.mentries), all of it committed.
+\* As raft.restore: a snapshot at or below i's commit index is ignored; when i has the
+\* snapshot's last entry, i fast-forwards its commit index to it and keeps its log; otherwise
+\* i's log is replaced by the snapshot's. Either way i acknowledges its commit index.
+\* (The configuration is installed by the ApplyConfChange event raft logs while restoring.)
+\* @type: (Int, Int, AEREQT) => Bool;
+HandleSnapshotRequest(i, j, m) ==
+    LET last == Len(m.mentries)
+        hasLast == last <= Len(log[i]) /\ log[i][last].term = m.mentries[last].term
+    IN
+    /\ \/ /\ last <= commitIndex[i]
+          /\ UNCHANGED <<logVars>>
+       \/ /\ last > commitIndex[i]
+          /\ hasLast
+          /\ CommitTo(i, last)
+          /\ UNCHANGED <<log>>
+       \/ /\ last > commitIndex[i]
+          /\ ~hasLast
+          /\ log' = [log EXCEPT ![i] = m.mentries]
+          /\ CommitTo(i, last)
+    /\ Reply([  mtype           |-> AppendEntriesResponse,
+                msubtype        |-> "app",
+                mterm           |-> currentTerm[i],
+                msuccess        |-> TRUE,
+                mmatchIndex     |-> Max({commitIndex[i], last}),
+                msource         |-> i,
+                mdest           |-> j],
+                m)
+    /\ UNCHANGED <<serverVars, configVars, durableState>>
+
 \* @type: (Int, Int, Bool, AEREQT) => Bool;
 AcceptAppendEntriesRequest(i, j, logOk, m) ==
     \* accept request
     /\ m.mterm = currentTerm[i]
     /\ state[i] = Follower
     /\ logOk
-    /\ LET index == m.mprevLogIndex + 1
-       IN \/ AppendEntriesAlreadyDone(i, j, index, m)
-          \/ ConflictAppendEntriesRequest(i, index, m)
-          \/ NoConflictAppendEntriesRequest(i, index, m)
+    /\ IF m.msubtype = "snapshot"
+       THEN HandleSnapshotRequest(i, j, m)
+       ELSE LET index == m.mprevLogIndex + 1
+            IN \/ AppendEntriesAlreadyDone(i, j, index, m)
+               \/ ConflictAppendEntriesRequest(i, index, m)
+               \/ NoConflictAppendEntriesRequest(i, index, m)
 
 \* Server i receives an AppendEntries request from server j with
 \* m.mterm <= currentTerm[i]. This just handles m.entries of length 0 or 1, but
