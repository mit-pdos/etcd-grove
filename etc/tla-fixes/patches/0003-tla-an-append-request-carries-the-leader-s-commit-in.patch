From c880282af30efdf34b13f3d426a3bdfc87f8c3ef Mon Sep 17 00:00:00 2001
From: Joseph Tassarotti <jt4767@nyu.edu>
Date: Sun, 8 Nov 2026 17:17:27 +0000
Subject: [PATCH 03/12] tla: an append request carries the leader's commit
 index

The receiver clamps it, as raft's maybeAppend and the Raft paper's Fig. 2.
issues/raft-tla-msgapp-commit-unclamped.md
---
 tla/etcdraft.tla | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tla/etcdraft.tla b/tla/etcdraft.tla
index 59518c1..1dde710 100644
--- a/tla/etcdraft.tla
+++ b/tla/etcdraft.tla
@@ -336,7 +336,13 @@ AppendEntriesInRangeToPeer(subtype, i, j, range) ==
         \* Send the entries
         lastEntry == Min({Len(log[i]), range[2]-1})
         entries == SubSeq(log[i], range[1], lastEntry)
-        commit == IF subtype = "heartbeat" THEN Min({commitIndex[i], matchIndex[i][j]}) ELSE Min({commitIndex[i], lastEntry})
+        \* An append request carries the leader's commit index whatever entries it
+        \* carries (raft's maybeSendAppend); the receiver commits only up to the last
+        \* entry it received (AppendEntriesAlreadyDone). A snapshot carries no commit
+        \* index (Traceetcdraft does not check it): the snapshot's index.
+        commit == CASE subtype = "heartbeat" -> Min({commitIndex[i], matchIndex[i][j]})
+                    [] subtype = "snapshot"  -> Min({commitIndex[i], lastEntry})
+                    [] OTHER                 -> commitIndex[i]
        IN /\ Send( [mtype          |-> AppendEntriesRequest,
                     msubtype       |-> subtype,
                     mterm          |-> currentTerm[i],
-- 
