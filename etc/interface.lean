/-
`etc/gen-interface.py`'s Lean side: print what a client sees of each given module.

    lake env lean --run etc/interface.lean (full|names) OUTDIR MODULE...

`names`: for each module, `OUTDIR/<module path>.names`, one line per declaration, its kind (and
`exposed` for a definition whose body a client sees) and its name: for the layout checks.

`full`: for each module, writes `OUTDIR/<module path>.txt`: the module's declarations as an ordinary
`import` of it shows them (`importModules (level := .exported)`, Lean's module system): every
public declaration's signature, and the body of every definition whose body is exported
(`@[expose]`); `private` declarations, proofs and sealed bodies are absent. A theorem and an
`axiom` look alike to a client (a statement); the private view (loaded too) tells them apart.
-/
import Lean
open Lean Meta

/-- A declaration's kind in the private view, where theorems and axioms differ. -/
def privKind (env : Environment) (c : Name) : String :=
  match env.find? c with
  | some (.thmInfo _) => "theorem"
  | some (.axiomInfo _) => "axiom"
  | some (.defnInfo _) => "def"
  | some (.opaqueInfo _) => "opaque"
  | some (.inductInfo _) => "inductive"
  | some (.ctorInfo _) => "constructor"
  | some (.recInfo _) => "recursor"
  | some (.quotInfo _) => "quot"
  | none => "?"

/-- Lean's auto-generated declarations of an inductive or structure (shown with it). -/
def autoSuffixes : List String :=
  ["sizeOf_spec", "inj", "injEq", "recOn", "casesOn", "noConfusion", "noConfusionType", "ctorIdx",
   "below", "brecOn", "ibelow", "binductionOn", "ctorElim", "ctorElimType", "eq_1", "eq_def", "ext",
   "ext_iff", "mk", "elim", "toCtorIdx", "ctorIdx_eq"]

def isInductiveName (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | some (.inductInfo _) => true
  | _ => false

/-- `c` is an auto-generated declaration of an inductive (`T.recOn`, `T.mk.inj`, ...). -/
def isAuto (env : Environment) (c : Name) : Bool :=
  match c with
  | .str p s =>
    let ofInd := isInductiveName env p ||
      (match p with
       | .str q _ => isInductiveName env q
       | _ => false)
    autoSuffixes.contains s && ofInd
  | _ => false

def skip (env : Environment) (c : Name) : Bool :=
  c.isInternal || c.isInternalDetail || c.isImplementationDetail ||
  env.isProjectionFn c || isAuxRecursor env c || isNoConfusion env c || isAuto env c

def runMeta (env : Environment) (x : MetaM α) : IO α := do
  let opts : Options := ({} : Options)
    |>.setBool `pp.universes false |>.setBool `pp.proofs false
    |>.setBool `pp.fieldNotation true
  let ctx : Core.Context := { fileName := "<interface>", fileMap := default, options := opts,
                              maxHeartbeats := 0, currNamespace := `Perennial.EtcdGrove,
                              openDecls := [`Perennial, `Iris, `Iris.BI, `Perennial.go_etcd_io.raft.v3].map
                                (OpenDecl.simple · []) }
  let (a, _) ← (x.run' {} {}).toIO ctx { env }
  return a

def ppSig (c : Name) : MetaM String := do
  return toString (← PrettyPrinter.ppSignature c).fmt

def ppE (e : Expr) : MetaM String := do
  return toString (← ppExpr e)

/-- `names` mode: one line per declaration, its kind and name (no pretty-printing). -/
def namesModule (pub priv : Environment) (outDir : System.FilePath) (mod : Name) : IO Unit := do
  let some idx := pub.getModuleIdx? mod | throw (IO.userError s!"module {mod} not imported")
  let mut out := ""
  for c in pub.header.moduleData[idx.toNat]!.constNames do
    if skip priv c then continue
    let kind := privKind priv c
    if kind == "constructor" || kind == "recursor" then continue
    let exposed := match pub.find? c with
      | some (.defnInfo _) => " exposed"
      | _ => ""
    out := out ++ s!"{kind}{exposed} {c}\n"
  let file := outDir / (System.mkFilePath (mod.components.map toString) |>.addExtension "names")
  if let some dir := file.parent then IO.FS.createDirAll dir
  IO.FS.writeFile file out

def dumpModule (pub priv : Environment) (outDir : System.FilePath) (mod : Name) : IO Unit := do
  let some idx := pub.getModuleIdx? mod | throw (IO.userError s!"module {mod} not imported")
  let mut out := s!"-- What a client importing `{mod}` sees of it (generated by \
    etc/gen-interface.py; do not edit).\n"
  for c in pub.header.moduleData[idx.toNat]!.constNames do
    if skip priv c then continue
    let kind := privKind priv c
    if kind == "constructor" || kind == "recursor" then continue
    let line ← runMeta pub do
      match pub.find? c with
      | some (.inductInfo i) =>
        if isStructure pub c then
          let fs ← (getStructureFieldsFlattened pub c (includeSubobjectFields := false)).mapM fun f => do
            let some pj := getProjFnForField? pub c f | return s!"  {f}"
            let some ci := pub.find? pj | return s!"  {f}"
            let ty ← forallTelescope ci.type fun _ b => ppE b
            return s!"  {f} : {ty}"
          return s!"structure {← ppSig c} where\n{"\n".intercalate fs.toList}"
        let ctors ← i.ctors.mapM fun k => do return s!"  | {← ppSig k}"
        return s!"inductive {← ppSig c}\n{"\n".intercalate ctors}"
      | some (.defnInfo d) =>
        if d.type.isConstOf ``Lean.ParserDescr || d.type.isConstOf ``Lean.TrailingParserDescr then
          return s!"syntax {c}"
        let body ← lambdaTelescope d.value fun _ b => ppE b
        return s!"def {← ppSig c} :=\n  {body.replace "\n" "\n  "}"
      | some ci =>
        if ci.type.isConstOf ``Lean.ParserDescr || ci.type.isConstOf ``Lean.TrailingParserDescr then
          return s!"syntax {c}"
        let k := if kind == "def" || kind == "opaque" then "def (sealed)" else kind
        return s!"{k} {← ppSig c}"
      | none => return s!"-- {c}: not visible"
    out := out ++ "\n" ++ line ++ "\n"
  let file := outDir / (System.mkFilePath (mod.components.map toString) |>.addExtension "txt")
  if let some dir := file.parent then IO.FS.createDirAll dir
  IO.FS.writeFile file out

unsafe def main (args : List String) : IO UInt32 := do
  match args with
  | mode :: outDir :: mods =>
    initSearchPath (← findSysroot)
    enableInitializersExecution
    let imports := mods.toArray.map fun m => ({ module := m.toName } : Import)
    let pub ← importModules imports {} (loadExts := mode == "full") (level := .exported)
    let priv ← importModules imports {} (loadExts := false) (level := .private)
    for m in mods do
      if mode == "full" then dumpModule pub priv outDir m.toName
      else namesModule pub priv outDir m.toName
    return 0
  | _ => IO.eprintln "usage: lake env lean --run etc/interface.lean (full|names) OUTDIR MODULE..."; return 1
