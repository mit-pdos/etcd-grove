{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/lab/ask-hook.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/lab/model-hook.sh"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true
}
