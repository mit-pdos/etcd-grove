+// The node's prophecy (prophecy-only code: etc/proph-patches/dsv-swiftpaxos). It predicts the
+// node's protocol events; each event resolves it once, with one value: the string of the event's
+// words (the Lean project's Spec/swift/L2Words.lean, `encE`), each word as ten one-byte strings,
+// its 7-bit chunks from the lowest. A client node's events are its
+// invocations and acceptances; a replica node's are swift's (its own `nodeProph`).
+var nodeProph primitive.ProphId
+
+func init() {
+	p := primitive.NewProph()
+	nodeProph = p
+}
+
+// resolveInvoke: client cl invokes command seq, (op, key, val) (prophecy-only). The words: op, cl,
+// seq, key, len(val), val's bytes.
+func resolveInvoke(op uint8, cl int32, seq int32, key int64, val []byte) {
+	s := ""
+	w := uint64(op)
+	s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	w = uint64(uint32(cl))
+	s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	w = uint64(uint32(seq))
+	s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	w = uint64(key)
+	s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	w = uint64(len(val))
+	s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	for i := 0; i < len(val); i++ {
+		w = uint64(val[i])
+		s += string(byte(w&127)) + string(byte(w>>7&127)) + string(byte(w>>14&127)) + string(byte(w>>21&127)) + string(byte(w>>28&127)) + string(byte(w>>35&127)) + string(byte(w>>42&127)) + string(byte(w>>49&127)) + string(byte(w>>56&127)) + string(byte(w>>63&127))
+	}
+	nodeProph.Resolve(s)
+}
