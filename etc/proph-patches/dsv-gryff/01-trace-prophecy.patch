+// Verification only (a prophecy patch, etc/proph-patches/dsv-gryff/; prophecy-only code, the lab's D9,
+// D13): the node's trace prophecy, created by the package's initialization (every node that
+// imports gryff creates one; a replica node holds its prediction before it registers with the
+// master), and its resolutions: under r.mtx, each event the run loop handles
+// (EPaxosRMWHandler.Loop) and each instance the executor executes (Exec.strongconnect), as
+// words: the event's kind (the comment names it), then the fields of the model's projection of
+// the event, in order (Dsverify/Proof/gryff/Model/Codec.lean, evCodec). A Go int32 or int8 is
+// resolved as uint64(x) (sign-extended), a uint8 as uint64(x), a list (a []state.Command, a
+// [DS]int32) as 1 before each element, then 0. primitive.NewProph and ProphId.ResolveU64 do
+// nothing in Go. The proofs: Dsverify/Proof/gryff/B/Resolve.lean (the helpers),
+// Replica2/Specs.lean.
+var traceProph primitive.ProphId
+
+func init() {
+	p := primitive.NewProph() // through a local (Goose's copy rule)
+	traceProph = p
+}
+
+func (r *Replica) resolveTag(t *gryffproto.Tag) {
+	traceProph.ResolveU64(uint64(t.Ts))
+	traceProph.ResolveU64(uint64(t.Cid))
+	traceProph.ResolveU64(uint64(t.Rmwc))
+}
+
+func (r *Replica) resolveValTag(vt *gryffproto.ValTag) {
+	traceProph.ResolveU64(uint64(vt.V))
+	r.resolveTag(&vt.T)
+}
+
+func (r *Replica) resolveDep(d *gryffproto.Dep) {
+	traceProph.ResolveU64(uint64(d.Key))
+	r.resolveValTag(&d.Vt)
+}
+
+func (r *Replica) resolveCmds(cmds []state.Command) {
+	for i := 0; i < len(cmds); i++ {
+		traceProph.ResolveU64(1)
+		traceProph.ResolveU64(uint64(cmds[i].Op))
+		traceProph.ResolveU64(uint64(cmds[i].K))
+		traceProph.ResolveU64(uint64(cmds[i].V))
+		traceProph.ResolveU64(uint64(cmds[i].OldValue))
+	}
+	traceProph.ResolveU64(0)
+}
+
+func (r *Replica) resolveDeps(deps [DS]int32) {
+	for i := 0; i < DS; i++ {
+		traceProph.ResolveU64(1)
+		traceProph.ResolveU64(uint64(deps[i]))
+	}
+	traceProph.ResolveU64(0)
+}
+
+func (r *Replica) resolveRead1(m *gryffproto.Read1Proxied) {
+	traceProph.ResolveU64(1) // evRead1
+	traceProph.ResolveU64(uint64(m.RequestId))
+	traceProph.ResolveU64(uint64(m.ClientId))
+	traceProph.ResolveU64(uint64(m.K))
+	r.resolveDep(&m.D)
+	traceProph.ResolveU64(uint64(m.ReplicaId))
+	r.resolveValTag(&m.Vt)
+}
+
+func (r *Replica) resolveRead2(m *gryffproto.Read2Proxied) {
+	traceProph.ResolveU64(2) // evRead2
+	traceProph.ResolveU64(uint64(m.RequestId))
+	traceProph.ResolveU64(uint64(m.ClientId))
+	traceProph.ResolveU64(uint64(m.K))
