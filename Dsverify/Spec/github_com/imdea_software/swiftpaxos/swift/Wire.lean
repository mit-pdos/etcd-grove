/-
Ported from dsverify-lab examples/swiftpaxos/proof/Spec/swift/Wire.lean (lab master 915f964, run swift-n2nofast-1; notes/dsv-swiftpaxos.md).
-/
/-
SwiftPaxos's wire formats, as pure Lean functions (no Iris): what the code's `Marshal` methods
(`swift/defs.go`, `replica/defs/defs.go`, `state/state.go`, generated by gobin-codegen), the
replicas' handshake (`replica/replica.go`) and the kit's rpc/gob codec (`examples/swiftnet/
rpc_gen.go`, the `encoding/gob` model) write. The protocols of `Spec/swift/Inv.lean` say which
sequences of these a stream may hold; the readers' proofs show that `Unmarshal` inverts them.

* `CmdId`, `Cmd`: a command's id (`swift.CommandId`: client id, sequence number) and the command
  (`state.Command`: operation, key, value).
* the generated `Marshal`'s pieces: 32/64-bit little-endian integers, `binary.PutVarint`'s
  zig-zag varint for slice lengths (`varintLen`), a `state.Value` (2-byte length, 2 zero bytes,
  the bytes), a dependency list, a checksum list (32 bytes per hash);
* `Msg`, the messages a SwiftPaxos stream carries in this deployment, `Msg.code` (the
  message-type byte: `defs.PROPOSE`, the beacons, and the rpc table's ids from
  `defs.RPC_TABLE = 9` in `initCs`'s registration order) and `Msg.body` (its `Marshal`); a frame
  is `code :: body` (`frame`);
* `helloBytes id`: what a replica dialing a peer writes first (`peerHello` = 0xFF, its id as 4
  bytes little-endian);
* the kit's codec (`rpc_gen.go`): `KitVal`, the values of the listed rpc types, and
  `KitVal.encode` (the type's tag as 8 bytes, then its fields; strings, slices and maps as an
  8-byte count then the elements). An `MSync`'s is kept as a size measure only (`SyncWire.cEnc`):
  `MSync.Marshal` writes it with the real `encoding/gob`;
* `GobFmt`, **the real `encoding/gob`'s format, abstractly**: `bytes m bs`, the bytes a fresh
  `gob.Encoder` writes for an `*MSync` holding `m` (its type descriptors, then the value), with
  the two laws of gob's format the readers need (`peel`: such streams are self-delimiting and
  determine `m`), and `fits` (the value's message is within gob's size limit) with its law
  `fits_of` (a bound on `m`'s size measure). A premise of the statement (a parent of
  `SwiftLibs`), true of Go's `encoding/gob`; see `GobFmt`'s docstring.

Messages registered in the rpc table but never sent in this deployment (`MSlowAck`, `MAccept`,
`MPing`, `MPingRep`, `MCollect`; `MAccept` is sent only with a proxy and optimistic execution
off, `swift/replychan.go`) are not in `Msg`: a protocol over `Msg` excludes them.
-/
module

public import Perennial.Std.Word.LittleEndian
public import Perennial.Std.Countable
public import Dsverify.Spec.github_com.imdea_software.swiftpaxos.examples.swiftnet.RpcWire
public import Perennial.Std.ByteString

@[expose] public section

noncomputable section

namespace Perennial.github_com.imdea_software.swiftpaxos

namespace sp

/-! ## Commands -/

/-- A command's id (`swift.CommandId`). -/
structure CmdId where
  /-- `ClientId` (the kit's client `c` has id `c + 1`) -/
  cl : w32
  /-- `SeqNum` (the client's sequence number, from 0) -/
  seq : w32
  deriving DecidableEq, Inhabited

instance CmdId.countable : Pos.Countable CmdId :=
  .ofInjective (fun x => Pos.Countable.encode (x.cl, x.seq))
    (by rintro ⟨a, b⟩ ⟨a', b'⟩ h; have h := Pos.encode_inj h; simp_all)

/-- `cmdIdLess` (`swift/dpath.go`): by client id, then sequence number, both signed. -/
def CmdId.lt (a b : CmdId) : Bool :=
  a.cl.toInt < b.cl.toInt || (a.cl = b.cl && a.seq.toInt < b.seq.toInt)

/-- A command (`state.Command`): `op` is `state.Operation` (`NONE` 0, `PUT` 1, `GET` 2, `SCAN` 3),
`key` `state.Key`, `val` `state.Value`. -/
structure Cmd where
  op : w8
  key : w64
  val : List w8
  deriving DecidableEq, Inhabited

instance Cmd.countable : Pos.Countable Cmd :=
  .ofInjective (fun c => Pos.Countable.encode (c.op, c.key, c.val))
    (by rintro ⟨a, b, c⟩ ⟨a', b', c'⟩ h; have h := Pos.encode_inj h; simp_all)

def opPUT : w8 := 1
def opGET : w8 := 2

def Cmd.isPut (c : Cmd) : Bool := c.op == opPUT
def Cmd.isGet (c : Cmd) : Bool := c.op == opGET

/-- A put of `v` at `k`. -/
def Cmd.put (k : w64) (v : List w8) : Cmd := ⟨opPUT, k, v⟩
/-- A get of `k` (`SendRead`: the value is `state.NIL()`, empty). -/
def Cmd.get (k : w64) : Cmd := ⟨opGET, k, []⟩

/-- `state.Conflict` for puts and gets (no `SCAN` is ever sent): the same key, and a put. -/
def Cmd.conflict (c d : Cmd) : Bool := c.key == d.key && (c.isPut || d.isPut)

/-! ## The generated `Marshal`'s pieces -/

def le32 (x : w32) : List w8 := u32Le x
def le64 (x : w64) : List w8 := u64Le x

/-- `binary.PutUvarint`: 7 bits per byte, the high bit set on all but the last. -/
def uvarint (n : Nat) : List w8 :=
  if h : n < 128 then [W8 n] else W8 (n % 128 + 128) :: uvarint (n / 128)
termination_by n
decreasing_by omega

/-- `binary.PutVarint` of a non-negative length (zig-zag: `2 n`). -/
def varintLen (n : Nat) : List w8 := uvarint (2 * n)

/-- `CommandId.Marshal`: client id, then sequence number. -/
def encCmdId (x : CmdId) : List w8 := le32 x.cl ++ le32 x.seq

/-- `state.Value.Marshal`: the length as 2 bytes little-endian, 2 zero bytes, the bytes (the
length is taken modulo 2^16: the kit's values are shorter). -/
def encValue (v : List w8) : List w8 :=
  [W8 (v.length % 256), W8 (v.length / 256 % 256), W8 0, W8 0] ++ v

/-- `state.Command.Marshal`: the operation (1 byte), the key (8 bytes), the value. -/
def encCmd (c : Cmd) : List w8 := [c.op] ++ le64 c.key ++ encValue c.val

/-- A `[]CommandId` field: its length (varint), then each id. -/
def encDep (d : List CmdId) : List w8 := varintLen d.length ++ (d.map encCmdId).flatten

/-- A hash (`SHash`): its 32 bytes. -/
abbrev Hash := List w8

/-- A `[]SHash` field: its length (varint), then each hash's bytes (32 each). -/
def encHashes (hs : List Hash) : List w8 := varintLen hs.length ++ hs.flatten

/-- A `[]byte` field (`MReply.Rep`): its length (varint), then the bytes. -/
def encBytes (bs : List w8) : List w8 := varintLen bs.length ++ bs

/-! ## Messages -/

/-- An entry of `MOptAcks.Acks` (`swift.Ack`). -/
structure Ack where
  id : CmdId
  dep : List CmdId
  cs : List Hash
  seqnum : w64

/-- An `MFastAck`. -/
structure FastAck where
  rep : w32
  bal : w32
  id : CmdId
  dep : List CmdId
  cs : List Hash
  seqnum : w64

/-- An `MLightSlowAck`. -/
structure SlowAck where
  rep : w32
  bal : w32
  id : CmdId

/-- An entry of an `MNewLeaderAckN` (a recovery report): the command's id, its phase
(`START` 0, `PRE_ACCEPT` 1, `ACCEPT` 2, `COMMIT` 3), the command, its dependencies. -/
structure RepEntry where
  id : CmdId
  phase : w64
  cmd : Cmd
  dep : List CmdId
  deriving DecidableEq

instance RepEntry.countable : Pos.Countable RepEntry :=
  .ofInjective (fun e => Pos.Countable.encode (e.id, e.phase, e.cmd, e.dep))
    (by rintro ⟨a, b, c, d⟩ ⟨a', b', c', d'⟩ h; have h := Pos.encode_inj h; simp_all)

def phSTART : w64 := 0
def phPREACCEPT : w64 := 1
def phACCEPT : w64 := 2
def phCOMMIT : w64 := 3

/-- The contents of an `MSync` as the codec encodes it: each map as the list of its entries in
the (arbitrary) order of Go's map iteration, or `none` for a nil map. -/
structure SyncWire where
  rep : w32
  bal : w32
  phases : Option (List (CmdId × w64))
  cmds : Option (List (CmdId × Cmd))
  deps : Option (List (CmdId × List CmdId))

/-- The messages a SwiftPaxos stream carries in this deployment (see the file header). -/
inductive Msg where
  /-- `defs.Propose` (client to replica): sequence number, client id, command, timestamp -/
  | propose (seq cl : w32) (cmd : Cmd) (ts : w64)
  /-- `defs.Beacon` (peer to peer) -/
  | beacon (ts : w64)
  /-- `defs.BeaconReply` (peer to peer) -/
  | beaconReply (ts : w64)
  /-- `MFastAck` -/
  | fastAck (f : FastAck)
  /-- `MFastAckClient` (replica to client): replica, ballot, id, checksum -/
  | fastAckClient (rep bal : w32) (id : CmdId) (cs : List Hash)
  /-- `MLightSlowAck` -/
  | lightSlowAck (s : SlowAck)
  /-- `MAcks` (peer to peer, the batcher's) -/
  | acks (fs : List FastAck) (ss : List SlowAck)
  /-- `MOptAcks` (peer to peer, the batcher's) -/
  | optAcks (rep bal : w32) (acks : List Ack)
  /-- `MReply` (the leader to a client): replica, ballot, id, checksum, result -/
  | reply (rep bal : w32) (id : CmdId) (cs : List Hash) (val : List w8)
  /-- `MNewLeader` -/
  | newLeader (rep bal : w32)
  /-- `MNewLeaderAckN` (a recovery report): replica, ballot, the reporter's `cballot`, entries -/
  | newLeaderAckN (rep bal cbal : w32) (es : List RepEntry)
  /-- `MSync`, written with `encoding/gob` as the bytes `bs` (`GobFmt.bytes m bs`, required
  by `Msg.wf`: the bytes are not a function of `m`, as a fresh encoder's type ids depend on the
  process's earlier uses of gob) -/
  | sync (m : SyncWire) (bs : List w8)

/-- `defs.RPC_TABLE`: the first rpc table id. -/
def rpcTable : Nat := 9

/-- The message-type byte (`defs`' constants; the rpc table's ids in `initCs`'s order:
fastAck, fastAckClient, slowAck, lightSlowAck, acks, optAcks, reply, newLeader, newLeaderAckN,
sync, ping, pingRep, collect, accept). -/
def Msg.code : Msg → w8
  | .propose .. => W8 0
  | .beacon .. => W8 6
  | .beaconReply .. => W8 7
  | .fastAck .. => W8 (rpcTable + 0)
  | .fastAckClient .. => W8 (rpcTable + 1)
  | .lightSlowAck .. => W8 (rpcTable + 3)
  | .acks .. => W8 (rpcTable + 4)
  | .optAcks .. => W8 (rpcTable + 5)
  | .reply .. => W8 (rpcTable + 6)
  | .newLeader .. => W8 (rpcTable + 7)
  | .newLeaderAckN .. => W8 (rpcTable + 8)
  | .sync .. => W8 (rpcTable + 9)

def FastAck.enc (f : FastAck) : List w8 :=
  le32 f.rep ++ le32 f.bal ++ encCmdId f.id ++ encDep f.dep ++ encHashes f.cs ++ le64 f.seqnum

def SlowAck.enc (s : SlowAck) : List w8 := le32 s.rep ++ le32 s.bal ++ encCmdId s.id

def Ack.enc (a : Ack) : List w8 := encCmdId a.id ++ encDep a.dep ++ encHashes a.cs ++ le64 a.seqnum

def RepEntry.encCmds (es : List RepEntry) : List w8 :=
  varintLen es.length ++ (es.map (fun e => encCmd e.cmd)).flatten

/-! ## The kit's codec (`rpc_gen.go`) and the gob model's frame -/

/-- `rpcPutU64`. -/
def cU64 (x : w64) : List w8 := u64Le x
/-- A string or byte slice: count, bytes. -/
def cBytes (s : List w8) : List w8 := cU64 (W64 s.length) ++ s
/-- `rpcEnc_int32`: sign-extended to 64 bits. -/
def cI32 (x : w32) : List w8 := cU64 (BitVec.signExtend 64 x)
def cBool (b : Bool) : List w8 := [if b then W8 1 else W8 0]
def cCmdId (x : CmdId) : List w8 := cI32 x.cl ++ cI32 x.seq
def cCmd (c : Cmd) : List w8 := cU64 (BitVec.zeroExtend 64 c.op) ++ cU64 c.key ++ cBytes c.val
def cList {A : Type} (f : A → List w8) (l : List A) : List w8 :=
  cU64 (W64 l.length) ++ (l.map f).flatten
/-- A map field of `MSync`: a presence byte (gob's nil), then the count and the entries. -/
def cMapOpt {A : Type} (f : A → List w8) : Option (List A) → List w8
  | none => [W8 0]
  | some l => W8 1 :: cList f l

/-- The values of the kit's listed rpc types (`kit.toml`'s `[rpc]`; `rpc_gen.go`'s tags). -/
inductive KitVal where
  | registerArgs (addr : GoString) (port : w64)
  | registerReply (id : w64) (nodes : List GoString) (ready isLeader : Bool)
  | getLeaderArgs
  | getLeaderReply (id : w64)
  | getReplicaListArgs
  | getReplicaListReply (replicas : List GoString) (alive : List Bool) (ready : Bool)
  | pingArgs (actAsLeader : w8)
  | pingReply
  | beTheLeaderArgs
  | beTheLeaderReply (leader nextLeader : w32)
  | msync (m : SyncWire)

/-- The value's type tag (`rpcTag_*`). -/
def KitVal.tag : KitVal → Nat
  | .registerArgs .. => 1 | .registerReply .. => 2 | .getLeaderArgs => 3
  | .getLeaderReply .. => 4 | .getReplicaListArgs => 5 | .getReplicaListReply .. => 6
  | .pingArgs .. => 7 | .pingReply => 8 | .beTheLeaderArgs => 9 | .beTheLeaderReply .. => 10
  | .msync .. => 17

def SyncWire.cEnc (m : SyncWire) : List w8 :=
  cI32 m.rep ++ cI32 m.bal ++
    cMapOpt (fun p : CmdId × w64 => cCmdId p.1 ++ cU64 p.2) m.phases ++
    cMapOpt (fun p : CmdId × Cmd => cCmdId p.1 ++ cCmd p.2) m.cmds ++
    cMapOpt (fun p : CmdId × List CmdId => cCmdId p.1 ++ cList cCmdId p.2) m.deps

/-- The codec's encoding of a value: the bytes the kit's generated net/rpc codec (`rpcEncode`,
`examples/swiftnet/rpc_gen.go`, rpcgen) writes for it (`netrpcw`, Spec/.../swiftnet/RpcWire.lean).
`MSync` is not an rpc type (it goes through the real `encoding/gob`, `GobFmt`): its case is
only the size measure `GobFmt.fits` is bounded by (`cU64` of its tag, then `SyncWire.cEnc`). -/
def KitVal.encode : KitVal → List w8
  | .registerArgs a p => netrpcw.encRegisterArgs a p
  | .registerReply i ns r l => netrpcw.encRegisterReply i ns r l
  | .getLeaderArgs => netrpcw.encGetLeaderArgs
  | .getLeaderReply i => netrpcw.encGetLeaderReply i
  | .getReplicaListArgs => netrpcw.encGetReplicaListArgs
  | .getReplicaListReply rs al r => netrpcw.encGetReplicaListReply rs al r
  | .pingArgs a => netrpcw.encPingArgs a
  | .pingReply => netrpcw.encPingReply
  | .beTheLeaderArgs => netrpcw.encBtlArgs
  | .beTheLeaderReply l n => netrpcw.encBtlReply l n
  | .msync m => cU64 (W64 17) ++ m.cEnc

/-- Two codec values that differ only in the iteration order of an `MSync`'s maps (the encoder
iterates Go maps in an arbitrary order). -/
def KitVal.equiv : KitVal → KitVal → Prop
  | .msync m, .msync m' => m.rep = m'.rep ∧ m.bal = m'.bal ∧
      Option.Rel List.Perm m.phases m'.phases ∧ Option.Rel List.Perm m.cmds m'.cmds ∧
      Option.Rel List.Perm m.deps m'.deps
  | x, y => x = y

/-- The value is well formed: an `MSync`'s map listings have distinct keys (what Go maps
encode). -/
def KitVal.wf : KitVal → Prop
  | .msync m => (m.phases.map (fun l => (l.map Prod.fst).Nodup)).getD True ∧
      (m.cmds.map (fun l => (l.map Prod.fst).Nodup)).getD True ∧
      (m.deps.map (fun l => (l.map Prod.fst).Nodup)).getD True
  | _ => True

/-- **The real `encoding/gob`'s format for an `*MSync`, abstractly** (a premise of the
statement, as a parent of `SwiftLibs`; the gob specs, `Spec/encoding/gob/*`, are stated over it).
Each field is true of Go's `encoding/gob` (go1.2x, `encoder.go`, `decoder.go`), taking for
`bytes` and `fits` their meaning below:

* `bytes m bs`: `bs` is what a fresh `gob.Encoder` may write for one `*MSync` whose struct holds
  `m`, its maps listed in the order the encoder iterates them: the type-definition messages
  (negative type ids) of the types it has not sent yet (all of them, the encoder being fresh),
  then the value's message (positive type id); each message is its length as a gob unsigned
  integer, then its contents. Not a function of `m`: the type ids are the process's (assigned
  at a type's first use).
* `peel`: such a stream is self-delimiting and determines `m`. A gob stream is read message by
  message, each delimited by its length; the first value message ends the value, so two such
  streams that agree up to the shorter's end are equal; and the value message (with the type
  definitions before it) determines the fields `Replica` and `Ballot` and each map (nil or not:
  gob sends a non-nil empty map, and not a nil one) with its entries in the order sent.
* `fits m`: the value's message is shorter than the encoder's limit (`tooBig`, `1 << 33` on
  64-bit platforms; `Encode` fails with `gob: encoder: message too big` otherwise, after
  writing the type definitions).
* `fits_of`: a value whose size measure `m.cEnc` (the lab codec's encoding: 8 bytes per integer,
  a byte for a map's presence) is below `2 ^ 31` bytes fits: gob writes each integer in at most
  9 bytes plus a 1-byte field delta, a struct's end in 1 byte, a map's or slice's count in at most
  9 bytes, so each item takes at most twice its measure (a `CommandId` 21 bytes against 16, a map
  entry of a `Cmd` `52 + |val|` against `40 + |val|`, a dependency list `9 + 21 n` against
  `8 + 16 n`), and the type id and the struct's end at most 10 bytes more: under
  `2 ^ 32 + 10 < 2 ^ 33`.
* `exists_bytes`: an `*MSync` holding `m` (distinct keys: a Go map's) that fits is encoded:
  `Encode` with no failing `Write` writes a stream of some listing of it. -/
class GobFmt where
  bytes : SyncWire → List w8 → Prop
  peel : ∀ {a b : SyncWire} {ba bb x y : List w8}, bytes a ba → bytes b bb →
    ba ++ x = bb ++ y → a = b ∧ ba = bb
  fits : SyncWire → Prop
  fits_of : ∀ m : SyncWire, m.cEnc.length < 2 ^ 31 → fits m
  exists_bytes : ∀ m : SyncWire, KitVal.wf (.msync m) → fits m →
    ∃ (m' : SyncWire) (bs : List w8), KitVal.equiv (.msync m) (.msync m') ∧ bytes m' bs

/-- A message's `Marshal`. -/
def Msg.body : Msg → List w8
  | .propose seq cl cmd ts => le32 seq ++ le32 cl ++ encCmd cmd ++ le64 ts
  | .beacon ts => le64 ts
  | .beaconReply ts => le64 ts
  | .fastAck f => f.enc
  | .fastAckClient r b x cs => le32 r ++ le32 b ++ encCmdId x ++ encHashes cs
  | .lightSlowAck s => s.enc
  | .acks fs ss => varintLen fs.length ++ (fs.map FastAck.enc).flatten ++
      varintLen ss.length ++ (ss.map SlowAck.enc).flatten
  | .optAcks r b al => le32 r ++ le32 b ++ varintLen al.length ++ (al.map Ack.enc).flatten
  | .reply r b x cs v => le32 r ++ le32 b ++ encCmdId x ++ encHashes cs ++ encBytes v
  | .newLeader r b => le32 r ++ le32 b
  | .newLeaderAckN r b c es => le32 r ++ le32 b ++ le32 c ++
      varintLen es.length ++ (es.map (fun e => encCmdId e.id)).flatten ++
      varintLen es.length ++ (es.map (fun e => le64 e.phase)).flatten ++
      RepEntry.encCmds es ++
      varintLen es.length ++ (es.map (fun e => encDep e.dep)).flatten
  | .sync _ bs => bs

/-- A message on the wire: its type byte, then its `Marshal`. -/
def Msg.frame (m : Msg) : List w8 := m.code :: m.body

/-- The frames of a sequence of messages. -/
def framesOf (ms : List Msg) : List w8 := (ms.map Msg.frame).flatten

/-- `peerHello` (0xFF) and the dialing replica's id (4 bytes little-endian): the first bytes a
replica writes on a connection it dials to a peer (`ConnectToPeers`). -/
def helloBytes (id : w32) : List w8 := W8 0xFF :: le32 id

end sp

end Perennial.github_com.imdea_software.swiftpaxos

end
