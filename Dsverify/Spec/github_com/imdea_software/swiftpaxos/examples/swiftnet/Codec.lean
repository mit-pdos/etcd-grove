/-
The kit's rpc codec as the specs see it (`examples/swiftnet/rpc_gen.go`, generated by kitgen; the
net/rpc model's `Codec` and the encoding/gob model's both hold its `rpcEncode` and `rpcDecode`):

* `kitNames`: the codec's `Name` (`rpcName`): `"Master"` for a `*master.Master`, `"Replica"` for a
  `*swift.Replica` (`""` for any other value, on which the Go function panics);
* `kitValOwn v dq x`: the Go value `v` (a non-nil pointer to a value of one of the listed types)
  holds the codec-level value `x : sp.KitVal` (`Spec/swift/Wire.lean`), with the fraction `dq` of
  the struct, its slices' contents and (for `MSync`) its maps;
* `kitCodec`: the kit's `RpcCodec` instance: `enc` (the encoding of the value, an `MSync`'s maps
  in any iteration order), `dec` (gob's decoding into a fully owned target: an encoding of a value
  `y` of the target's type is merged into it as gob does, `KitVal.merge`; other bytes leave the
  target of some value of its type, or fail), `call` (the dispatch `rpcCall` itself: a receiver's
  `rcvrOk` is proved through the generated dispatch function), `methods`;
* (the lab's `kitCodecOk_holds`, `kitNameOk_holds`, about kitgen's codec functions, are not
  ported: this kit's codec is rpcgen's, whose `CodecSpec` is to be related to `kitCodec` in step 5.)

Only pointers are covered by `kitValOwn` (every encode and decode of the deployment passes a
pointer: the `Call`s' arguments and replies, `MSync.Marshal`'s and `Unmarshal`'s receiver); the
dispatch encodes reply structs by value inside `rpcCall`, which `call` covers by its definition.
-/
module

public import Dsverify.Proof.github_com.imdea_software.swiftpaxos.Base
public import Dsverify.Spec.github_com.imdea_software.swiftpaxos.swift.Wire
public import Dsverify.Proof.github_com.imdea_software.swiftpaxos.lib.NetRpc
-- PORT: the lab kit's codec proofs (`examples/swiftnet/codec/Ok`, kitgen's `rpc_gen.go`) are not
-- imported: the kit's codec here is rpcgen's (notes/dsv-swiftpaxos.md, step 5).

@[expose] public section

noncomputable section

namespace Perennial.github_com.imdea_software.swiftpaxos

open Iris Iris.BI Iris.ProgramLogic Iris.Std Net

/-! ## Values of the listed types -/

namespace sp

-- `KitVal.equiv`, `KitVal.wf`: moved to Spec/swift/Wire.lean (eighth session; `GobFmt` uses them).

/-- gob's merge of a decoded value `y` into a target holding `x` of the same type
(`rpcMerge_*`): a zero field of `y` (gob does not send it), an empty slice, and a nil map leave
`x`'s; every other field is `y`'s. For two values of different types, `y`. -/
def KitVal.merge : KitVal → KitVal → KitVal
  | .registerArgs a p, .registerArgs a' p' =>
      .registerArgs (if a' = [] then a else a') (if p' = 0 then p else p')
  | .registerReply i ns r l, .registerReply i' ns' r' l' =>
      .registerReply (if i' = 0 then i else i') (if ns' = [] then ns else ns') (r || r') (l || l')
  | .getLeaderReply i, .getLeaderReply i' => .getLeaderReply (if i' = 0 then i else i')
  | .getReplicaListReply rs al r, .getReplicaListReply rs' al' r' =>
      .getReplicaListReply (if rs' = [] then rs else rs') (if al' = [] then al else al') (r || r')
  | .pingArgs a, .pingArgs a' => .pingArgs (if a' = 0 then a else a')
  | .beTheLeaderReply l n, .beTheLeaderReply l' n' =>
      .beTheLeaderReply (if l' = 0 then l else l') (if n' = 0 then n else n')
  | .msync m, .msync m' =>
      .msync ⟨if m'.rep = 0 then m.rep else m'.rep, if m'.bal = 0 then m.bal else m'.bal,
        m'.phases.or m.phases, m'.cmds.or m.cmds, m'.deps.or m.deps⟩
  | _, y => y

end sp

/-- The id of a `swift.CommandId` struct. -/
def goCmdId [GooseExts] (c : swift.CommandId) : sp.CmdId := ⟨c.ClientId', c.SeqNum'⟩

instance goCmdId_decEq [GooseExts] : DecidableEq swift.CommandId := fun a b =>
  decidable_of_iff (a.ClientId' = b.ClientId' ∧ a.SeqNum' = b.SeqNum') (by
    cases a; cases b; simp)

section own
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics] [examples.swiftnet.Assumptions]

/-- The Go command `c` holds `x` (its value's slice with fraction `dq`). -/
def cmdOwn (c : state.Command) (dq : DFrac) (x : sp.Cmd) : IProp GF :=
  iprop(⌜c.Op' = x.op ∧ c.K' = x.key⌝ ∗ c.V' ↦*{dq} x.val)

/-- The Go map at `mp` (`nil`: `none`) holds the entries `l`, in the order of the Go entries
`ps` (distinct keys) its value lists, with the fraction `dq`, the values related by `R`. (Stated
on the map's heap value as `ownMap`'s definition is, `Perennial/Golang/Theory/Map.lean`, without
`ownMap`'s instance `go.IntoValInj swift.CommandId`, which no module provides.) -/
def mapOwn {V A : Type} [ZeroVal V] (mp : GoMap) (dq : DFrac)
    (R : V → A → IProp GF) : Option (List (sp.CmdId × A)) → IProp GF
  | none => iprop(⌜mp = map.nil⌝)
  | some l => iprop(∃ (mv : val) (ps : List (swift.CommandId × V)),
      heapPointsto mp dq mv ∗
      ⌜mv = map.mapV #(zero_val V) (ps.map map.toE) ∧ (ps.map Prod.fst).Nodup ∧
        ps.map (fun p => goCmdId p.1) = l.map Prod.fst⌝ ∗
      [∗list] i ↦ e ∈ l, ∃ p : swift.CommandId × V, ⌜ps[i]? = some p⌝ ∗ R p.2 e.2)

/-- The struct value `s` of a listed type holds `x`, its slices' and maps' contents with the
fraction `dq` (pure fields equal). -/
def structOwn (ty : go.GoType) (p : Loc) (dq : DFrac) : sp.KitVal → IProp GF
  | .registerArgs a pt => iprop(⌜ty = replica.defs.RegisterArgs.ty⌝ ∗
      p ↦{dq} (⟨a, pt⟩ : replica.defs.RegisterArgs))
  | .registerReply i ns r l => iprop(⌜ty = replica.defs.RegisterReply.ty⌝ ∗
      ∃ sl : GoSlice, p ↦{dq} (⟨i, sl, r, l⟩ : replica.defs.RegisterReply) ∗ sl ↦*{dq} ns)
  | .getLeaderArgs => iprop(⌜ty = replica.defs.GetLeaderArgs.ty⌝ ∗
      ∃ s : replica.defs.GetLeaderArgs, p ↦{dq} s)
  | .getLeaderReply i => iprop(⌜ty = replica.defs.GetLeaderReply.ty⌝ ∗
      p ↦{dq} (⟨i⟩ : replica.defs.GetLeaderReply))
  | .getReplicaListArgs => iprop(⌜ty = replica.defs.GetReplicaListArgs.ty⌝ ∗
      ∃ s : replica.defs.GetReplicaListArgs, p ↦{dq} s)
  | .getReplicaListReply rs al r => iprop(⌜ty = replica.defs.GetReplicaListReply.ty⌝ ∗
      ∃ s1 s2 : GoSlice, p ↦{dq} (⟨s1, s2, r⟩ : replica.defs.GetReplicaListReply) ∗
        s1 ↦*{dq} rs ∗ s2 ↦*{dq} al)
  | .pingArgs a => iprop(⌜ty = replica.defs.PingArgs.ty⌝ ∗
      p ↦{dq} (⟨a⟩ : replica.defs.PingArgs))
  | .pingReply => iprop(⌜ty = replica.defs.PingReply.ty⌝ ∗
      ∃ s : replica.defs.PingReply, p ↦{dq} s)
  | .beTheLeaderArgs => iprop(⌜ty = replica.defs.BeTheLeaderArgs.ty⌝ ∗
      ∃ s : replica.defs.BeTheLeaderArgs, p ↦{dq} s)
  | .beTheLeaderReply l n => iprop(⌜ty = replica.defs.BeTheLeaderReply.ty⌝ ∗
      p ↦{dq} (⟨l, n⟩ : replica.defs.BeTheLeaderReply))
  | .msync m => iprop(⌜ty = swift.MSync.ty⌝ ∗
      ∃ ph cm dp : GoMap, p ↦{dq} (⟨m.rep, m.bal, ph, cm, dp⟩ : swift.MSync) ∗
        mapOwn (V := w64) ph dq (fun v a => iprop(⌜v = a⌝)) m.phases ∗
        mapOwn (V := state.Command) cm dq (fun c x => cmdOwn c dq x) m.cmds ∗
        mapOwn (V := swift.Dep) dp dq
          (fun sl d => iprop(∃ ids : List swift.CommandId, sl ↦*{dq} ids ∗
            ⌜ids.map goCmdId = d⌝)) m.deps)

/-- The Go value `v` is a non-nil pointer to a value of one of the kit's listed types holding
`x`, with the fraction `dq` (see `structOwn`). -/
def kitValOwn (v : GoInterface) (dq : DFrac) (x : sp.KitVal) : IProp GF :=
  iprop(∃ (ty : go.GoType) (p : Loc), ⌜v = interface.mkOk (go.GoType.PointerType ty) #p ∧
    p ≠ null⌝ ∗ structOwn ty p dq x)

end own

/-! ## The codec -/

/-- The codec's `Name` (`rpcName`): the service name `Register` gives a listed receiver. -/
instance kitNames [GooseExts] [GoGlobalContext] : net.rpc.RpcNames where
  name rcvr := open Classical in
    if ∃ p : Loc, rcvr = interface.mkOk (go.GoType.PointerType master.Master.ty) #p then
      go!"Master"
    else if ∃ p : Loc, rcvr = interface.mkOk (go.GoType.PointerType swift.Replica.ty) #p then
      go!"Replica"
    else go!""

section codec
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics] [examples.swiftnet.Assumptions]

/-- The kit's codec (see the file header).
* `enc v Ψ`: `v` holds some `x` (fraction `dq`); `Encode(v)` gives it back and the bytes of
  `x'.encode` for an `x'` equal to `x` up to the order of its maps.
* `dec bs ptr Ψ`: `ptr` is a fully owned pointer to a listed type holding `x0`; if `bs` is the
  encoding of a well-formed `y` of the same type, `Decode` succeeds and the target holds
  `KitVal.merge x0 y`; otherwise it fails or not, and the target holds some value of its type.
* `call rcvr m bs Ψ`: the dispatch `rpcCall(rcvr, m, s)` on a slice `s` holding `bs` returns a
  fresh reply slice with `Ψ reply msg found`.
* `methods rcvr`: `rcvr` is a `*master.Master` or a `*swift.Replica` (`rpcMethods` panics on
  any other value). -/
instance kitCodec : net.rpc.RpcCodec GF where
  enc v Ψ := iprop(∃ (dq : DFrac) (x : sp.KitVal), kitValOwn v dq x ∗
    ∀ x' : sp.KitVal, ⌜sp.KitVal.equiv x x'⌝ -∗ kitValOwn v dq x -∗ Ψ x'.encode)
  dec bs ptr Ψ := iprop(∃ x0 : sp.KitVal, kitValOwn ptr (DFrac.own 1) x0 ∗
    ((∀ y : sp.KitVal, ⌜bs = y.encode ∧ y.tag = x0.tag ∧ sp.KitVal.wf y⌝ -∗
        kitValOwn ptr (DFrac.own 1) (sp.KitVal.merge x0 y) -∗ Ψ true) ∧
      (⌜∀ y : sp.KitVal, y.tag = x0.tag → sp.KitVal.wf y → bs ≠ y.encode⌝ -∗
        ∀ ok : Bool, (∃ x1 : sp.KitVal, ⌜x1.tag = x0.tag⌝ ∗ kitValOwn ptr (DFrac.own 1) x1) -∗
          Ψ ok)))
  call rcvr m bs Ψ := iprop(∀ (s : GoSlice) (dq : DFrac), s ↦*{dq} bs -∗
    WP (App (App (App (Val #(net.rpc.kitFn go!"rpcCall")) (Val #rcvr)) (Val #m)) (Val #s))
      {{ v, ∃ (rep : GoSlice) (rbs : List w8) (msg : GoString) (found : Bool),
        ⌜v = PairV (PairV #rep #msg) #found⌝ ∗ rep ↦* rbs ∗ Ψ rbs msg found }})
  methods rcvr := iprop(⌜∃ p : Loc,
    rcvr = interface.mkOk (go.GoType.PointerType master.Master.ty) #p ∨
    rcvr = interface.mkOk (go.GoType.PointerType swift.Replica.ty) #p⌝)
  -- PORT (step 5): `Net/`'s `CodecSpec.rcv` (the server's receiver wrapper), rpcgen's `Receiver`;
  -- `False` until the kit's codec is related to rpcgen's.
  rcv _ _ := iprop(False)

end codec

end Perennial.github_com.imdea_software.swiftpaxos
