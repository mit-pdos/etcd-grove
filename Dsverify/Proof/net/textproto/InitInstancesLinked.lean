/-
**Test only** (the non-vacuity rule; dsv-gryff, 2026-11-24, after math-rand-isinit's tool): `net.textproto`'s hypothesis
initialization in the gryff kit's part (no `Init.lean` there): `local_wp_initialize'`,
the walk of the translated `initialize'` etc/gen-init.py makes for a translated package, over
the local axioms below for its names-only initializers. Generated by
math-rand-isinit's `etc/dsv/tools/inithyp-instances.py` run on the closure of net/rpc's and net/http's
initializers (notes/dsv-gryff.md, "Non-vacuity"), then edited where marked. No
statement or proof imports this module.
-/
module

public import Dsverify.Proof.net.textproto.Base
public import Net.Proof.runtime.PkgInitExt

@[expose] public section

set_option linter.iris.style.nameCheck false
set_option linter.unusedSectionVars false
set_option linter.iris.dupNamespace false

noncomputable section

namespace Perennial

/-- `x ∈ [a, ..., x, ...]`, linear in the list (`simp` overflows on the long ones). -/
local macro "mem_tac" : tactic =>
  `(tactic| repeat (first | exact List.Mem.head _ | apply List.Mem.tail))

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

section opaqueInits
namespace net.textproto
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- **Local axiom (test-only; in no statement's trust base): `net.textproto`'s untranslated variable initializers run.**
Goose translates them names only (each `X.init` an uninterpreted constant of the translation);
Go runs them at program start and they return without panicking (the kit's programs start). -/
axiom localOpaqueInitsOk :
    ∀ v ∈ ([errMessageTooLarge.init,
        colon.init,
        nl.init,
        crnl.init,
        dotcrnl.init] : List val),
    {{ (True : IProp GF) }} (App (Val v) (Val #())) {{ RET #(); True }}

end net.textproto
end opaqueInits

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : _root_.Perennial.net.textproto.Assumptions]

namespace net.textproto

theorem local_wp_initialize'_lb (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.net.textproto get_is_pkg_init) (σ0 : GMap GoString Bool) :
    {{ EtcdGrove.ownInitLb get_is_pkg_init σ0 }}
      (App (Val initialize') (Val #()))
    {{ RET #(); EtcdGrove.ownInitLb get_is_pkg_init σ0 ∗
        isPkgInit (PROP := IProp GF) pkg_id.net.textproto }} := by
  wp_start as Hown
  iapply EtcdGrove.wp_package_init_lb (heq := Hinit.1) $$ [Hown] HΦ
  iframe Hown
  iintro Hown
  wp_auto
  iapply wp_fupd
  wp_apply (localOpaqueInitsOk errMessageTooLarge.init (by mem_tac))
  wp_apply (localOpaqueInitsOk colon.init (by mem_tac))
  wp_apply (localOpaqueInitsOk nl.init (by mem_tac))
  wp_apply (localOpaqueInitsOk crnl.init (by mem_tac))
  wp_apply (localOpaqueInitsOk dotcrnl.init (by mem_tac))
  try wp_auto
  wp_apply _root_.Perennial.errors.wp_New as %xE -
  try wp_auto
  wp_apply wp_string_to_bytes _ as %scolon ⟨Scolon, -⟩
  try wp_auto
  try wp_auto
  wp_apply wp_string_to_bytes _ as %snl ⟨Snl, -⟩
  try wp_auto
  try wp_auto
  wp_apply (wp_slice_literal (l := _)); isplitr; (· ipureintro; rfl); iintro %scrnl ⟨Scrnl, -⟩
  try wp_auto
  try wp_auto
  wp_apply (wp_slice_literal (l := _)); isplitr; (· ipureintro; rfl); iintro %sdotcrnl ⟨Sdotcrnl, -⟩
  try wp_auto
  ihave HP : (net.textproto.commonHeaderVar : IProp GF) $$ [HcommonHeader]
  · unfold net.textproto.commonHeaderVar; iexists _; iexact HcommonHeader
  imod (_root_.Perennial.sync.init_Once _ _ net.textproto.commonHeaderOk ⊤) $$ [HcommonHeaderOnce HP] with #HOnce
  · iframe
  try wp_auto
  iframe Hown
  imodintro
  isplitr
  · ipureintro
    exact isPanic_intoVal _
  is_pkg_init_finish
  imodintro
  unfold net.textproto.textprotoInit net.textproto.textprotoInitLC
  iexact HOnce

/-- Perennial's form, from `wp_initialize'_lb`. -/
theorem local_wp_initialize' (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.net.textproto get_is_pkg_init) :
    {{ ownInitializing get_is_pkg_init }}
      (App (Val initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗
        isPkgInit (PROP := IProp GF) pkg_id.net.textproto }} :=
  EtcdGrove.wp_init_of_lb _ _ _ (local_wp_initialize'_lb get_is_pkg_init Hinit)



end net.textproto

end init

end Perennial
