theorem local_wp_initialize'_lb (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.net.rpc get_is_pkg_init) (σ0 : GMap GoString Bool) :
    {{ EtcdGrove.ownInitLb get_is_pkg_init σ0 }}
      (App (Val initialize') (Val #()))
    {{ RET #(); EtcdGrove.ownInitLb get_is_pkg_init σ0 ∗
        isPkgInit (PROP := IProp GF) pkg_id.net.rpc }} := by
  wp_start as Hown
  iapply EtcdGrove.wp_package_init_lb (heq := Hinit.1) $$ [Hown] HΦ
  iframe Hown
  iintro Hown
  wp_auto
  wp_apply wp_GlobalAlloc (V := _) connected _ as Hconnected
  wp_apply wp_GlobalAlloc (V := _) invalidRequest _ as HinvalidRequest
  wp_apply wp_GlobalAlloc (V := _) DefaultServer _ as HDefaultServer
  wp_apply wp_GlobalAlloc (V := _) debugLog _ as HdebugLog
  wp_apply wp_GlobalAlloc (V := _) errFrame _ as HerrFrame
  wp_apply wp_GlobalAlloc (V := _) codec _ as Hcodec
  wp_apply wp_GlobalAlloc (V := _) codecMu _ as HcodecMu
  wp_apply wp_GlobalAlloc (V := _) ErrShutdown _ as HErrShutdown
  wp_apply (_root_.Perennial.go.token.local_wp_initialize'_lb _ Hinit.2.2.2.2.2.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd8⟩
  wp_apply (EtcdGrove.initLb_of_spec pkg_id.sync _root_.Perennial.sync.initialize'
      EtcdGrove.ExternalInit.sync _root_.Perennial.sync.wp_initialize' _ Hinit.2.2.2.2.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd7⟩
  wp_apply (_root_.Perennial.net.http.local_wp_initialize'_lb _ Hinit.2.2.2.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd6⟩
  wp_apply (_root_.Perennial.net.wp_initialize'_lb _ Hinit.2.2.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd5⟩
  wp_apply (EtcdGrove.initLb_of_spec pkg_id.log _root_.Perennial.log.initialize'
      EtcdGrove.ExternalInit.log _root_.Perennial.log.wp_initialize' _ Hinit.2.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd4⟩
  wp_apply (EtcdGrove.initLb_of_spec pkg_id.io _root_.Perennial.io.initialize'
      EtcdGrove.ExternalInit.io _root_.Perennial.io.wp_initialize' _ Hinit.2.2.2.1) _ $$ Hown as ⟨Hown, #Hd3⟩
  wp_apply (EtcdGrove.initLb_of_spec pkg_id.errors _root_.Perennial.errors.initialize'
      EtcdGrove.ExternalInit.errors _root_.Perennial.errors.wp_initialize' _ Hinit.2.2.1) _ $$ Hown as ⟨Hown, #Hd2⟩
  wp_apply (_root_.Perennial.bufio.wp_initialize'_lb _ Hinit.2.1) _ $$ Hown as ⟨Hown, #Hd1⟩
  -- (edited) the translated initializers: `ErrShutdown`, `errFrame` (`errors.New`), `debugLog`
  -- (`false`), `DefaultServer` (`NewServer()`, Net's proved spec), `invalidRequest`, `connected`
  try wp_auto
  wp_apply _root_.Perennial.errors.wp_New_errorString as %x0 ⟨#_, #E0⟩
  try wp_auto
  wp_apply _root_.Perennial.errors.wp_New_errorString as %x1 ⟨#_, #E1⟩
  try wp_auto
  wp_apply (net.rpc.NewServer.wp_proof (π := ⟨default⟩)) as %s0 -
  try wp_auto
  iframe Hown
  is_pkg_init_finish

/-- Perennial's form, from `wp_initialize'_lb`. -/
theorem local_wp_initialize' (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.net.rpc get_is_pkg_init) :
    {{ ownInitializing get_is_pkg_init }}
      (App (Val initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗
        isPkgInit (PROP := IProp GF) pkg_id.net.rpc }} :=
  EtcdGrove.wp_init_of_lb _ _ _ (local_wp_initialize'_lb get_is_pkg_init Hinit)


/-- **The instance** (a theorem, not an `instance`: etc/dsv/README.md): `net.rpc`'s `InitHyp`. -/
theorem initHyp_holds : InitHyp GF := ⟨local_wp_initialize'⟩

