/-- Perennial's form, from `wp_initialize'_lb`. -/
theorem local_wp_initialize' (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.runtime get_is_pkg_init) :
    {{ ownInitializing get_is_pkg_init }}
