  wp_func_call
  wp_call
  wp_auto
  iexists _
  isplitr
  · ipureintro; rfl
  wp_func_call
  wp_call
  wp_auto
  wp_apply (HM p «$r0_ptr» w va Φ) $$ [HD Hp Hown «$r0»] as ⟨%wr, %vr, Hr, Hrown, HΦ⟩
  · iframe HD Hp Hown «$r0»
    isplitr
    · iexact HP
    · ipureintro; exact Hl
  (try wp_auto)
  iexists _
  isplitr
  · ipureintro; rfl
  unfold net.rpc.callRet
  ileft
  isplitr
  · ipureintro; rfl
  iapply enc_AdminReply
  iframe Hr Hrown
  iintro _ _
  iexact HΦ

