theorem enc_AdminArgs : encLaw (hraftCodec (GF := GF)) service.AdminArgs.ty adminArgsOwn encAdminArgs := by
  intro p dq w v Ψ
  iintro ⟨Hp, Hown, HΨ⟩
  simp only [hraftCodec]
  iintro %Φ HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  rcases w with ⟨a0, a1⟩
  unfold adminArgsOwn
  icases Hown with %Hv
  simp only at Hv
  obtain ⟨rfl, rfl⟩ := Hv
  wp_func_call
  wp_call
  wp_auto
  (try (rw [decide_eq_false Hnn]; wp_auto))
  wp_apply wp_rpcPutTag _ as %b ⟨Hb, Hcap⟩
  (try wp_auto)
  wp_apply (wp_rpcEnc_t37 (dq := dq)) $$ [$Hb $Hcap] as %b' ⟨Hb, Hcap, -⟩
  (try wp_auto)
  iapply HΦ $$ Hb Hcap
  unfold encAdminArgs tagged
  iapply HΨ $$ Hp []
  (try unfold adminArgsOwn)
  (try unfold hdrOwn)
  dsimp only
  iframe
  (try (ipureintro; and_intros <;> rfl))

theorem dec_AdminArgs : decLaw (hraftCodec (GF := GF)) service.AdminArgs.ty adminArgsOwn encAdminArgs := by
  intro p v Ψ
  iintro ⟨Hp, HΨ⟩
  simp only [hraftCodec]
  iintro %data %dq %Φ Hd HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  ihave %Hlen := ownSlice_lenZ _ _ _ $$ Hd
  have hl : (encAdminArgs v).length < 2 ^ 64 := by
    have : sint.Z data.len < 2 ^ 63 := by word
    omega
  wp_func_call
  wp_call
  wp_auto
  wp_apply wp_rpcGetTag data _ dq $$ Hd
  iintro %t %r %ok H
  unfold encAdminArgs at hl ⊢
  simp only [getTag_tagged _ _ hl]
  icases H with ⟨%Hok, Hr, Hback⟩
  obtain ⟨rfl, rfl⟩ := Hok
  wp_auto
  (try (rw [decide_eq_false Hnn]; wp_auto))
  rw [zero_AdminArgs]
  have e : strct [fStr v.id, fStr v.addr] = W8 1 :: (fStr v.id ++ (fStr v.addr ++ [])) := rfl
  rw [e]
  wp_apply (wp_rpcDec_t37_enc r dq p v.id v.addr []) $$ Hr Hp
  iintro %r2 Hr2 Hback2 Hown
  ihave %Hl2 := ownSlice_len _ _ _ $$ Hr2
  wp_auto
  rw [show r2.len = W64 0 by simp at Hl2; word]
  wp_auto
  ihave Hd := Hback $$ [Hback2 Hr2]
  · iapply Hback2 $$ Hr2
  iapply HΦ $$ %interface.nil %true Hd %(by simp) [HΨ Hown]
  · icases Hown with ⟨%w, Hp, Hown⟩
    iapply HΨ $$ Hp Hown
  simp only [ite_true]
  ipureintro; trivial

