  have hne : ptrI service.AdminArgs.ty p ≠ interface.nil := by simp [ptrI, interface.mkOk]
  ihave #Hdec : net.rpc.argDec hraftCodec (ptrI service.AdminArgs.ty p) (p ↦ (zero_val service.AdminArgs)) Sm
      (fun args ok => iprop(if ok then ∃ (w : service.AdminArgs) (va : AdminArgsV), ⌜args = encAdminArgs va ∧ args.length < 2 ^ 63⌝ ∗
          p ↦ w ∗ adminArgsOwn w (DFrac.own 1) va else True)) $$ []
