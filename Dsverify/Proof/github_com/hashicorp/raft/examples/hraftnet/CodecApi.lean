      icases ownSlice_tail R dq _ _ $$ Hr with ⟨%R1, %HR1, %hlT, Hr, HbackT⟩
      rw [HR1]
      wp_auto
      wp_apply (wp_rpcDec_t8 R1 _ dq _) $$ Hr Voters
      iintro %R2 %okd Hd2
      rw [getU64_enc a4 _]
      icases Hd2 with ⟨%Hok, Voters, Hr, Hback2⟩
      subst Hok
      wp_auto
      ihave HbackT := wand_trans _ _ _ $$ Hback2 HbackT
      ihave Hback := wand_trans _ _ _ $$ HbackT Hback
      wp_join_done
      (try (iexists _; iframe))
  ihave %hlR5 := ownSlice_lenZ _ _ _ $$ Hr
  (try wp_auto)
  iapply HΦ $$ Hr Hback
  iapply (asm_StatusReply _ Hnn)
  iframe

theorem enc_StatusReply : encLaw (hraftCodec (GF := GF)) service.StatusReply.ty statusReplyOwn encStatusReply := by
  intro p dq w v Ψ
  iintro ⟨Hp, Hown, HΨ⟩
  simp only [hraftCodec]
  iintro %Φ HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  rcases w with ⟨a0, a1, a2, a3, a4⟩
  unfold statusReplyOwn
  icases Hown with %Hv
  simp only at Hv
  obtain ⟨rfl, rfl, rfl, rfl, rfl⟩ := Hv
  wp_func_call
  wp_call
  wp_auto
  (try (rw [decide_eq_false Hnn]; wp_auto))
  wp_apply wp_rpcPutTag _ as %b ⟨Hb, Hcap⟩
  (try wp_auto)
  wp_apply (wp_rpcEnc_t49 (dq := dq)) $$ [$Hb $Hcap] as %b' ⟨Hb, Hcap, -⟩
  (try wp_auto)
  iapply HΦ $$ Hb Hcap
  unfold encStatusReply tagged
  iapply HΨ $$ Hp []
  (try unfold statusReplyOwn)
  (try unfold hdrOwn)
  dsimp only
  iframe
  (try (ipureintro; and_intros <;> rfl))

theorem dec_StatusReply : decLaw (hraftCodec (GF := GF)) service.StatusReply.ty statusReplyOwn encStatusReply := by
  intro p v Ψ
  iintro ⟨Hp, HΨ⟩
  simp only [hraftCodec]
  iintro %data %dq %Φ Hd HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  ihave %Hlen := ownSlice_lenZ _ _ _ $$ Hd
  have hl : (encStatusReply v).length < 2 ^ 64 := by
    have : sint.Z data.len < 2 ^ 63 := by word
    omega
  wp_func_call
  wp_call
  wp_auto
  wp_apply wp_rpcGetTag data _ dq $$ Hd
  iintro %t %r %ok H
  unfold encStatusReply at hl ⊢
  simp only [getTag_tagged _ _ hl]
  icases H with ⟨%Hok, Hr, Hback⟩
  obtain ⟨rfl, rfl⟩ := Hok
  wp_auto
  (try (rw [decide_eq_false Hnn]; wp_auto))
  rw [zero_StatusReply]
  have e : strct [fBool v.leader, fStr v.leaderID, fBool v.configured, fU64 v.servers, fU64 v.voters] = W8 1 :: (fBool v.leader ++ (fStr v.leaderID ++ (fBool v.configured ++ (fU64 v.servers ++ (fU64 v.voters ++ []))))) := rfl
  rw [e]
  wp_apply (wp_rpcDec_t49_enc r dq p v.leader v.leaderID v.configured v.servers v.voters []) $$ Hr Hp
  iintro %r2 Hr2 Hback2 Hown
  ihave %Hl2 := ownSlice_len _ _ _ $$ Hr2
  wp_auto
  rw [show r2.len = W64 0 by simp at Hl2; word]
  wp_auto
  ihave Hd := Hback $$ [Hback2 Hr2]
  · iapply Hback2 $$ Hr2
  iapply HΦ $$ %interface.nil %true Hd %(by simp) [HΨ Hown]
  · icases Hown with ⟨%w, Hp, Hown⟩
    iapply HΨ $$ Hp Hown
  simp only [ite_true]
  ipureintro; trivial

/-! ## The `*service.API` receiver -/

/-- What the receiver needs of an `API` method `M` of `s`, for the method spec `Sm` (with `P`, the
receiver's persistent facts): `rpcMeth.spec`, on a `*service.API`. -/
abbrev apiMeth.spec {A R AV RV : Type} [TypedPointsto (GF := GF) A] [TypedPointsto (GF := GF) R]
    [ZeroVal R] (P : IProp GF) (s : Loc) (M : GoString) (aOwn : A → DFrac → AV → IProp GF)
    (encA : AV → List w8) (rOwn : R → DFrac → RV → IProp GF) (encR : RV → List w8)
    (Sm : net.rpc.MSpec GF) : Prop :=
  ∀ (ap rp : Loc) (wa : A) (va : AV) (Φ : List w8 → GoString → IProp GF),
    {{ P ∗ ⌜(encA va).length < 2 ^ 63⌝ ∗ Sm (encA va) Φ ∗ ap ↦ wa ∗ aOwn wa (DFrac.own 1) va ∗
        rp ↦ (zero_val R) }}
      (App (App (Val (s @!! go.GoType.PointerType service.API.ty @!! M)) (Val #ap)) (Val #rp))
    {{ RET #interface.nil; ∃ (wr : R) (vr : RV), rp ↦ wr ∗ rOwn wr (DFrac.own 1) vr ∗ Φ (encR vr) [] }}

/-- The receiver's obligations of an `API` `s` for the service spec `S` (with `P`, its persistent
facts): each method's deposits are encodings of its argument, and the method meets `apiMeth.spec`. -/
structure ApiRcvLaws (P : IProp GF) (s : Loc) (S : net.rpc.MethodSpec GF) : Prop where
  enc_AddNonvoter : encOf (GF := GF) encAdminArgs (S go!"AddNonvoter")
  meth_AddNonvoter : apiMeth.spec P s go!"AddNonvoter" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"AddNonvoter")
  enc_AddVoter : encOf (GF := GF) encAdminArgs (S go!"AddVoter")
  meth_AddVoter : apiMeth.spec P s go!"AddVoter" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"AddVoter")
  enc_Apply : encOf (GF := GF) encApplyArgs (S go!"Apply")
  meth_Apply : apiMeth.spec P s go!"Apply" applyArgsOwn encApplyArgs applyReplyOwn encApplyReply (S go!"Apply")
  enc_DemoteVoter : encOf (GF := GF) encAdminArgs (S go!"DemoteVoter")
  meth_DemoteVoter : apiMeth.spec P s go!"DemoteVoter" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"DemoteVoter")
  enc_LeadershipTransfer : encOf (GF := GF) encAdminArgs (S go!"LeadershipTransfer")
  meth_LeadershipTransfer : apiMeth.spec P s go!"LeadershipTransfer" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"LeadershipTransfer")
  enc_Read : encOf (GF := GF) encReadArgs (S go!"Read")
  meth_Read : apiMeth.spec P s go!"Read" readArgsOwn encReadArgs readReplyOwn encReadReply (S go!"Read")
  enc_RemoveServer : encOf (GF := GF) encAdminArgs (S go!"RemoveServer")
  meth_RemoveServer : apiMeth.spec P s go!"RemoveServer" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"RemoveServer")
  enc_Snapshot : encOf (GF := GF) encAdminArgs (S go!"Snapshot")
  meth_Snapshot : apiMeth.spec P s go!"Snapshot" adminArgsOwn encAdminArgs adminReplyOwn encAdminReply (S go!"Snapshot")
  enc_Status : encOf (GF := GF) encAdminArgs (S go!"Status")
  meth_Status : apiMeth.spec P s go!"Status" adminArgsOwn encAdminArgs statusReplyOwn encStatusReply (S go!"Status")

