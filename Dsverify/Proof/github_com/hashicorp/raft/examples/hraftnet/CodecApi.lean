    iapply dec_len
    iintro %Hl
    iapply dec_AdminArgs
    iframe Hp
    iintro %w Hp Hown
    (try simp only [ite_true])
    iexists w, va
    iframe
    ipureintro; exact ⟨rfl, Hl⟩
  iapply HΨ $$ %_ %_ %_ %hne Hdec Hp
  iintro %args %Φ HD Hp
  (try simp only [ite_true])
  icases Hp with ⟨%w, %va, ⟨%Hargs, %Hl⟩, Hp, Hown⟩
