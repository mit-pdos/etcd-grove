/-
The hraft kit's generated codec: the decoders of the byte slices and of the wire structs
(`rpcDec_t6` `[]byte`, `rpcDec_t4` `Header`, ..., `rpcDec_t33` `TimeoutResp`), as craq's
(`Craq/CodecProof.lean`): each computes `CodecDefs.lean`'s pure decoder; on success the target
holds the decoded value (`∃ w, p ↦ w ∗ own w 1 v`, the wire structs' ownership of
`rpctransport/CodecLaws.lean`).
Generated by `etc/dsv/tools/hraft-codec.py` from the kit's `rpc_gen.go` (do not edit: change the script and rerun it).
-/
module

public import Dsverify.Proof.github_com.hashicorp.raft.examples.hraftnet.CodecPrim

@[expose] public section

set_option linter.iris.style.nameCheck false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

noncomputable section

namespace Perennial

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode Net

namespace github_com.hashicorp.raft.examples.hraftnet

open rpctransport

section proof
variable [GooseExts] [GooseSemantics] [GooseInterp] [HasExt netExt] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : Assumptions]
variable [bvi : go.BasicIntoValInj]

set_option goose.wp.extras true

/-! ## Byte slices -/

/-- A decoded byte slice: some slice holding the bytes. -/
abbrev bytesO (p : Loc) (x : List w8) : IProp GF := iprop(∃ sl : GoSlice, p ↦ sl ∗ sl ↦* x)

theorem bytesO_zero (p : Loc) : (p ↦ slice.nil : IProp GF) ⊢ bytesO p [] := by
  iintro Hp
  iexists slice.nil
  iframe
  iapply ownSlice_nil

theorem wp_rpcDec_t6 : decFn (GF := GF) rpcDec_t6 decBytes slice.nil bytesO := by
  intro b bs dq p Φ
  iintro Hb Hp HΦ
  wp_func_call
  wp_call
  wp_auto
  wp_apply wp_rpcGetU64 b bs dq $$ Hb
  iintro %x %r %ok H
  unfold decBytes
  rcases hg : getU64 bs with _ | ⟨n, rest⟩
  · simp only [hg]
    icases H with ⟨%Hok, Hb⟩
    subst Hok
    wp_auto
    iapply HΦ
    ipureintro; first | rfl | trivial
  · simp only [hg]
    icases H with ⟨%Hok, Hr, Hback⟩
    obtain ⟨rfl, rfl⟩ := Hok
    ihave %Hl := ownSlice_lenZ _ _ _ $$ Hr
    wp_auto
    by_cases hn : uint.nat x ≤ rest.length
    rotate_left
    · rw [decide_eq_true (show uint.Z r.len < uint.Z x by word)]
      wp_auto
      iapply HΦ
      rw [if_neg hn]
      ipureintro; first | rfl | trivial
    rw [decide_eq_false (show ¬ uint.Z r.len < uint.Z x by word)]
    wp_auto
    have hxs : sint.Z x = uint.Z x := by word
    rw [if_pos hn]
    by_cases hx0 : x = W64 0
    rw [decide_eq_false (by rw [hx0]; decide)]
    wp_auto
    rw [if_pos (by rw [hx0]; decide)]
    wp_auto
    ihave Hn := ownSlice_nil (V := w8) (DFrac.own 1)
    ihave Hs : (slice.slice slice.nil w8 (W64 0) x ↦* List.replicate (uint.nat x) (W8 0)) $$ [Hn]
    · subst hx0
      icases (ownSlice_slice (V := w8) (W64 0) (W64 0) slice.nil (DFrac.own 1) []
        ⟨by decide, by decide, by decide⟩).1 $$ Hn with ⟨-, Hs, -⟩
      have e : subslice (sint.nat (W64 0)) (sint.nat (W64 0)) ([] : List w8) =
          List.replicate (uint.nat (W64 0)) (W8 0) := by simp [subslice]
      rw [e]
      iexact Hs
    generalize slice.slice slice.nil w8 (W64 0) x = sl at *
    iclear Hn
    rotate_left
    rw [decide_eq_true (show uint.Z (0 : w64) < uint.Z x by
      have : uint.Z x ≠ 0 := fun h => hx0 (by word)
      have : (0 : Int) ≤ uint.Z x := by word
      show (0 : Int) < uint.Z x
      omega)]
    wp_auto
    wp_apply wp_slice_make2 (V := w8) x
    · ipureintro; word
    iintro %sl ⟨Hs, -⟩
    rw [show sint.nat x = uint.nat x by word, show zero_val w8 = W8 0 from rfl]
    wp_auto
    rotate_left
    all_goals
      ihave %hsl := ownSlice_lenZ _ _ _ $$ Hs
      simp only [List.length_replicate] at hsl
      ihave HI : (∃ (i : w64) (R : GoSlice) (acc cur : List w8),
          "i" ∷ i_ptr ↦ i ∗ "r" ∷ r_ptr ↦ R ∗ "ok" ∷ ok_ptr ↦ true ∗ "Hr" ∷ R ↦*{dq} cur ∗
          "Hback" ∷ (R ↦*{dq} cur -∗ b ↦*{dq} bs) ∗
          "Hs" ∷ sl ↦* (acc ++ List.replicate (uint.nat x - uint.nat i) (W8 0)) ∗
          "%Hi" ∷ ⌜acc.length = uint.nat i ∧ uint.nat i ≤ uint.nat x ∧
            decU8sGo (uint.nat x - uint.nat i) acc cur = decU8sGo (uint.nat x) [] rest⌝ : IProp GF)
          $$ [i r ok Hr Hback Hs]
      · iexists W64 0, r, [], rest
        simp only [show uint.nat (W64 0) = 0 from rfl, Nat.sub_zero, List.nil_append]
        iframe
        ipureintro
        simp
      wp_for HI
      wp_if_destruct
      · have hi : uint.Z i < uint.Z x := by
          first | exact Hif | exact of_decide_eq_true (go.intoVal_inj Hif)
        have hk : uint.nat x - uint.nat i = (uint.nat x - uint.nat i - 1) + 1 := by word
        rw [if_pos (show 0 ≤ sint.Z i ∧ sint.Z i < sint.Z sl.len by word)]
        have hlk : (acc ++ List.replicate (uint.nat x - uint.nat i) (W8 0))[(sint.Z i).toNat]? =
            some (W8 0) := by
          rw [show (sint.Z i).toNat = acc.length by word, hk]
          simp
        icases ownSlice_elem_acc (sint.Z i) (W8 0) sl _ _ (by word) hlk $$ Hs with ⟨He, Hs⟩
        wp_apply wp_rpcDec_t7 R cur dq _ $$ Hr He
        iintro %R2 %ok2 Hd
        rcases hd : decU8 cur with _ | ⟨v, cur2⟩
        · simp only [hd]
          icases Hd with %Hok
          subst Hok
          wp_auto
          rw [forPostcondition_unseal]; unfold forPostconditionDef; iright; iright; iright; ileft
          iexists #()
          isplitr
          · ipureintro; rfl
          dsimp only
          wp_auto
          have hres : decU8sGo (uint.nat x) [] rest = none := by
            rw [← Hi.2.2, hk]; simp [decU8sGo, hd]
          iapply HΦ
          rw [hres]
          ipureintro; first | rfl | trivial
        · simp only [hd]
          icases Hd with ⟨%Hok, He, Hr, Hback2⟩
          subst Hok
          ihave Hs := Hs $$ He
          wp_auto
          wp_for_post
          ihave Hback := wand_trans _ _ _ $$ Hback2 Hback
          have hi1 : uint.nat (i + W64 1) = uint.nat i + 1 := by word
          have hset : (acc ++ List.replicate (uint.nat x - uint.nat i) (W8 0)).set (sint.Z i).toNat v =
              (acc ++ [v]) ++ List.replicate (uint.nat x - uint.nat (i + W64 1)) (W8 0) := by
            rw [show (sint.Z i).toNat = acc.length by word, hk, hi1,
              show uint.nat x - (uint.nat i + 1) = uint.nat x - uint.nat i - 1 by omega]
            simp [List.replicate_succ]
          rw [hset]
          iframe
          iexists i + W64 1, R2, acc ++ [v], cur2
          iframe
          ipureintro
          refine ⟨by rw [List.length_append, Hi.1, hi1]; rfl, by rw [hi1]; omega, ?_⟩
          rw [← Hi.2.2, hk, hi1, show uint.nat x - (uint.nat i + 1) = uint.nat x - uint.nat i - 1 by omega]
          simp [decU8sGo, hd]
      · have hc : ¬ uint.Z i < uint.Z x := by
          first | exact Hif | exact fun h => Hif (by simp [h])
        (try (rw [decide_eq_false hc, if_pos (by simp)]))
        (try wp_auto)
        have hix : uint.nat x - uint.nat i = 0 := by word
        have hres : decU8sGo (uint.nat x) [] rest = some (acc, cur) := by
          rw [← Hi.2.2, hix]; rfl
        iapply HΦ
        rw [hres]
        dsimp only
        rw [hix, List.replicate_zero, List.append_nil]
        iframe
        isplitr
        · ipureintro; rfl
        iexists sl
        iframe

/-! ## Struct decoders -/

set_option hygiene false in
/-- A failed decoding: its pure decoder `D` computes `none`. -/
macro "dec_fail " D:ident : tactic => `(tactic| (
  iapply HΦ
  simp only [$D:ident, decStructHdr, decFld, ↓reduceIte, *]
  (try (ipureintro; first | rfl | trivial))))

set_option hygiene false in
/-- A struct decoder's header byte, after `iStructNamed`: leaves `Hr : R ↦*{dq} cur`, `Hback`,
`hlR`. -/
macro "dec_hdr " D:ident : tactic => `(tactic| (
  ihave %Hl := ownSlice_len _ _ _ $$ Hb
  ihave %Hwf := ownSlice_wf _ _ _ $$ Hb
  wp_func_call
  wp_call
  wp_auto
  rcases bs with _ | ⟨c, rest⟩
  · rw [decide_eq_true (show sint.Z b.len < sint.Z (W64 1) by simp at Hl; word)]
    wp_auto
    dec_fail $D:ident
  have hlen : sint.Z b.len = rest.length + 1 := by
    have := Hl.1; simp only [List.length_cons] at this
    have h2 : ((sint.Z b.len).toNat : Int) = sint.Z b.len := Int.toNat_of_nonneg Hl.2
    rw [show sint.nat b.len = (sint.Z b.len).toNat from rfl] at this; omega
  rw [decide_eq_false (show ¬ sint.Z b.len < sint.Z (W64 1) by
    rw [show sint.Z (W64 1) = 1 from rfl]; omega)]
  wp_auto
  rw [if_pos (show 0 ≤ sint.Z (W64 0) ∧ sint.Z (W64 0) < sint.Z b.len by
    rw [show sint.Z (W64 0) = 0 from rfl]; omega)]
  wp_apply wp_load_slice_index b _ _ dq _ (by decide) $$ [Hb] with Hb
  · iframe; ipureintro; rfl
  by_cases hc : c = W8 1
  rotate_left
  · simp only [hc, decide_false, Bool.not_false]
    wp_auto
    dec_fail $D:ident
  subst hc
  simp only [_root_.decide_true, Bool.not_true]
  wp_auto
  rw [if_pos (show 0 ≤ sint.Z (W64 1) ∧ sint.Z (W64 1) ≤ sint.Z b.len ∧ sint.Z b.len ≤ sint.Z b.cap by
    rw [show sint.Z (W64 1) = 1 from rfl]; omega)]
  icases ownSlice_tail b dq _ _ $$ Hb with ⟨%R, %HR, %hlR, Hr, Hback⟩
  rw [HR]
  wp_auto
  generalize hcur : rest = cur at *
  clear hcur))

set_option hygiene false in
/-- One field of a struct decoder: the state is `Hr : R ↦*{dq} cur`, `Hback` (back to `b`),
`hlR` (`R`'s length); `L` decodes the field into `F` (pure decoder `D`); `zt` turns a field left
at its zero value into its decoded form; the failures compute `none` (`dec_fail DS`). -/
macro "dec_fld " L:term:max D:term:max F:ident DS:ident " zero " zt:tacticSeq : tactic => `(tactic| (
  rcases cur with _ | ⟨c, cur⟩
  · rw [decide_eq_true (show sint.Z R.len < sint.Z (W64 1) by
      rw [show sint.Z (W64 1) = 1 from rfl]; simp only [List.length_nil] at hlR; omega)]
    wp_auto
    dec_fail $DS:ident
  rw [decide_eq_false (show ¬ sint.Z R.len < sint.Z (W64 1) by
    rw [show sint.Z (W64 1) = 1 from rfl]; simp only [List.length_cons] at hlR; omega)]
  wp_auto
  rw [if_pos]
  case hc => rw [show sint.Z (W64 0) = 0 from rfl]; simp only [List.length_cons] at hlR; omega
  wp_apply wp_load_slice_index R _ _ dq _ (by decide) $$ [Hr] with Hr
  · iframe; ipureintro; rfl
  by_cases h1 : 1 < uint.Z c
  · rw [decide_eq_true (show uint.Z (W8 1) < uint.Z c from h1)]
    wp_auto
    dec_fail $DS:ident
  rw [decide_eq_false (show ¬ uint.Z (W8 1) < uint.Z c from h1)]
  wp_auto
  rw [if_pos]
  case hc => rw [show sint.Z (W64 0) = 0 from rfl]; simp only [List.length_cons] at hlR; omega
  wp_apply wp_load_slice_index R _ _ dq _ (by decide) $$ [Hr] with Hr
  · iframe; ipureintro; rfl
  by_cases h2 : c = W8 1
  subst h2
  simp only [_root_.decide_true]
  wp_auto
  rw [if_pos]
  case hc => rw [show sint.Z (W64 1) = 1 from rfl]; simp only [List.length_cons] at hlR; omega
  icases ownSlice_tail R dq _ _ $$ Hr with ⟨%R1, %HR1, %hlR1, Hr, HbackT⟩
  rw [HR1]
  wp_auto
  wp_apply ($L R1 cur dq _) $$ Hr $F:ident
  iintro %R %okd Hd2
  rcases hd : $D cur with _ | ⟨v, cur⟩
  · simp only [hd]
    icases Hd2 with %Hok
    subst Hok
    wp_auto
    dec_fail $DS:ident
  simp only [hd]
  icases Hd2 with ⟨%Hok, $F:ident, Hr, Hback2⟩
  subst Hok
  wp_auto
  ihave %hlR := ownSlice_lenZ _ _ _ $$ Hr
  ihave HbackT := wand_trans _ _ _ $$ Hback2 HbackT
  ihave Hback := wand_trans _ _ _ $$ HbackT Hback
  rotate_left
  simp only [h2, decide_false]
  wp_auto
  rw [if_pos]
  case hc => rw [show sint.Z (W64 1) = 1 from rfl]; simp only [List.length_cons] at hlR; omega
  icases ownSlice_tail R dq _ _ $$ Hr with ⟨%R, %HR1, %hlR, Hr, HbackT⟩
  rw [HR1]
  wp_auto
  ihave Hback := wand_trans _ _ _ $$ HbackT Hback
  ($zt)))

set_option hygiene false in
/-- Close a struct decoder's proof: the pure decoder `D` computed, the struct put back together
by its assembly lemma `A`. -/
macro "dec_close " D:ident A:term:max : tactic => `(tactic| (
  iapply HΦ
  simp only [$D:ident, decStructHdr, decFld, ↓reduceIte, *]
  iframe
  iapply ($A _ Hnn)
  iframe))

theorem asm_Header (p : Loc) (Hnn : p ≠ null) {a0 : w64} {a1 : List w8} {a2 : List w8} :
    ((structFieldRef rpctransport.Header go!"ProtocolVersion" p) ↦ a0 ∗ bytesO (structFieldRef rpctransport.Header go!"ID" p) a1 ∗ bytesO (structFieldRef rpctransport.Header go!"Addr" p) a2 : IProp GF) ⊢
    ∃ w, p ↦ w ∗ hdrOwn w (DFrac.own 1) ⟨a0, a1, a2⟩ := by
  iintro ⟨H0, ⟨%s1, H1, Hs1⟩, ⟨%s2, H2, Hs2⟩⟩
  iexists (rpctransport.Header.mk a0 s1 s2)
  isplitl [H0 H1 H2]
  · iapply typedPointsto_combine _ _ _ Hnn
    simp only [TypedPointsto.typedPointstoDef]
    iframe
  · unfold hdrOwn
    iframe
    (try (ipureintro; and_intros <;> rfl))

theorem zero_Header : (zero_val rpctransport.Header : rpctransport.Header) = (rpctransport.Header.mk (W64 0) slice.nil slice.nil) := rfl

theorem wp_rpcDec_t4 : decFn (GF := GF) rpcDec_t4 decHeaderV (rpctransport.Header.mk (W64 0) slice.nil slice.nil)
    (fun p v => iprop(∃ w, p ↦ w ∗ hdrOwn w (DFrac.own 1) v)) := by
  intro b bs dq p Φ
  iintro Hb Hp HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  iStructNamed Hp
  dec_hdr decHeaderV
  all_goals dec_fld wp_rpcDec_t5 getU64 ProtocolVersion decHeaderV zero skip
  all_goals dec_fld wp_rpcDec_t6 decBytes ID decHeaderV zero (ihave ID := bytesO_zero _ $$ ID)
  all_goals dec_fld wp_rpcDec_t6 decBytes Addr decHeaderV zero (ihave Addr := bytesO_zero _ $$ Addr)
  all_goals ((try wp_auto); dec_close decHeaderV asm_Header)

theorem asm_Entry (p : Loc) (Hnn : p ≠ null) {a0 : w64} {a1 : w64} {a2 : w8} {a3 : List w8} {a4 : List w8} :
    ((structFieldRef rpctransport.Entry go!"Index" p) ↦ a0 ∗ (structFieldRef rpctransport.Entry go!"Term" p) ↦ a1 ∗ (structFieldRef rpctransport.Entry go!"Type" p) ↦ a2 ∗ bytesO (structFieldRef rpctransport.Entry go!"Data" p) a3 ∗ bytesO (structFieldRef rpctransport.Entry go!"Extensions" p) a4 : IProp GF) ⊢
    ∃ w, p ↦ w ∗ entOwn w (DFrac.own 1) ⟨a0, a1, a2, a3, a4⟩ := by
  iintro ⟨H0, H1, H2, ⟨%s3, H3, Hs3⟩, ⟨%s4, H4, Hs4⟩⟩
  iexists (rpctransport.Entry.mk a0 a1 a2 s3 s4)
  isplitl [H0 H1 H2 H3 H4]
  · iapply typedPointsto_combine _ _ _ Hnn
    simp only [TypedPointsto.typedPointstoDef]
    iframe
  · unfold entOwn
    iframe
    (try (ipureintro; and_intros <;> rfl))

theorem zero_Entry : (zero_val rpctransport.Entry : rpctransport.Entry) = (rpctransport.Entry.mk (W64 0) (W64 0) (W8 0) slice.nil slice.nil) := rfl

set_option maxHeartbeats 2000000 in
theorem wp_rpcDec_t10 : decFn (GF := GF) rpcDec_t10 decEntV (rpctransport.Entry.mk (W64 0) (W64 0) (W8 0) slice.nil slice.nil)
    (fun p v => iprop(∃ w, p ↦ w ∗ entOwn w (DFrac.own 1) v)) := by
  intro b bs dq p Φ
  iintro Hb Hp HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  iStructNamed Hp
  irename : (structFieldRef rpctransport.Entry go!"Type" p ↦ (W8 0) : IProp GF) => FType
  dec_hdr decEntV
  all_goals dec_fld wp_rpcDec_t8 getU64 Index decEntV zero skip
  all_goals dec_fld wp_rpcDec_t8 getU64 Term decEntV zero skip
  all_goals dec_fld wp_rpcDec_t11 decU8 FType decEntV zero skip
  all_goals dec_fld wp_rpcDec_t6 decBytes Data decEntV zero (ihave Data := bytesO_zero _ $$ Data)
  all_goals dec_fld wp_rpcDec_t6 decBytes Extensions decEntV zero (ihave Extensions := bytesO_zero _ $$ Extensions)
  all_goals ((try wp_auto); dec_close decEntV asm_Entry)

/-- A decoded header. -/
abbrev hdrO (p : Loc) (h : HdrV) : IProp GF := iprop(∃ w, p ↦ w ∗ hdrOwn w (DFrac.own 1) h)

theorem hdrO_zero (p : Loc) : (p ↦ (rpctransport.Header.mk (W64 0) slice.nil slice.nil) : IProp GF) ⊢ hdrO p hdr0 := by
  iintro Hp
  iexists _
  iframe
  unfold hdrOwn
  isplitr
  · ipureintro; rfl
  isplitl
  · iapply ownSlice_nil
  · iapply ownSlice_nil

/-- `TimeoutReq`'s ownership: its header's. -/
abbrev timeoutReqOwn (w : rpctransport.TimeoutReq) (dq : DFrac) (h : HdrV) : IProp GF :=
  hdrOwn w.Hdr' dq h

/-- A decoded `[]Entry`. -/
abbrev entsO (p : Loc) (xs : List EntV) : IProp GF := iprop(∃ sl : GoSlice, p ↦ sl ∗ entsOwn sl (DFrac.own 1) xs)

theorem entsO_zero (p : Loc) : (p ↦ slice.nil : IProp GF) ⊢ entsO p [] := by
  iintro Hp
  iexists slice.nil
  iframe
  unfold entsOwn
  iexists []
  isplitl
  · iapply ownSlice_nil
  · iapply BigSepL2.bigSepL2_nil.2; iempintro

/-- The zero `Entry`. -/
abbrev zEnt : rpctransport.Entry := rpctransport.Entry.mk (W64 0) (W64 0) (W8 0) slice.nil slice.nil

theorem wp_rpcDec_t9 : decFn (GF := GF) rpcDec_t9 decEnts slice.nil entsO := by
  intro b bs dq p Φ
  iintro Hb Hp HΦ
  wp_func_call
  wp_call
  wp_auto
  wp_apply wp_rpcGetU64 b bs dq $$ Hb
  iintro %x %r %ok H
  unfold decEnts
  rcases hg : getU64 bs with _ | ⟨n, rest⟩
  · simp only [hg]
    icases H with ⟨%Hok, Hb⟩
    subst Hok
    wp_auto
    iapply HΦ
    ipureintro; first | rfl | trivial
  · simp only [hg]
    icases H with ⟨%Hok, Hr, Hback⟩
    obtain ⟨rfl, rfl⟩ := Hok
    ihave %Hl := ownSlice_lenZ _ _ _ $$ Hr
    wp_auto
    by_cases hn : uint.nat x ≤ rest.length
    rotate_left
    · rw [decide_eq_true (show uint.Z r.len < uint.Z x by word)]
      wp_auto
      iapply HΦ
      rw [if_neg hn]
      ipureintro; first | rfl | trivial
    rw [decide_eq_false (show ¬ uint.Z r.len < uint.Z x by word)]
    wp_auto
    have hxs : sint.Z x = uint.Z x := by word
    rw [if_pos hn]
    by_cases hx0 : x = W64 0
    rw [decide_eq_false (by rw [hx0]; decide)]
    wp_auto
    rw [if_pos (by rw [hx0]; decide)]
    wp_auto
    ihave Hn := ownSlice_nil (V := rpctransport.Entry) (DFrac.own 1)
    ihave Hs : (slice.slice slice.nil rpctransport.Entry (W64 0) x ↦*
        List.replicate (uint.nat x) zEnt) $$ [Hn]
    · subst hx0
      icases (ownSlice_slice (V := rpctransport.Entry) (W64 0) (W64 0) slice.nil (DFrac.own 1) []
        ⟨by decide, by decide, by decide⟩).1 $$ Hn with ⟨-, Hs, -⟩
      have e : subslice (sint.nat (W64 0)) (sint.nat (W64 0)) ([] : List rpctransport.Entry) =
          List.replicate (uint.nat (W64 0)) zEnt := by simp [subslice]
      rw [e]
      iexact Hs
    generalize slice.slice slice.nil rpctransport.Entry (W64 0) x = sl at *
    iclear Hn
    rotate_left
    rw [decide_eq_true (show uint.Z (0 : w64) < uint.Z x by
      have : uint.Z x ≠ 0 := fun h => hx0 (by word)
      have : (0 : Int) ≤ uint.Z x := by word
      show (0 : Int) < uint.Z x
      omega)]
    wp_auto
    wp_apply wp_slice_make2 (V := rpctransport.Entry) x
    · ipureintro; word
    iintro %sl ⟨Hs, -⟩
    rw [show sint.nat x = uint.nat x by word, show zero_val rpctransport.Entry = zEnt from rfl]
    wp_auto
    rotate_left
    all_goals
      ihave %hsl := ownSlice_len _ _ _ $$ Hs
      simp only [List.length_replicate] at hsl
      ihave HI : (∃ (i : w64) (R : GoSlice) (es : List rpctransport.Entry)
          (acc : List EntV) (cur : List w8),
          "i" ∷ i_ptr ↦ i ∗ "r" ∷ r_ptr ↦ R ∗ "ok" ∷ ok_ptr ↦ true ∗ "Hr" ∷ R ↦*{dq} cur ∗
          "Hback" ∷ (R ↦*{dq} cur -∗ b ↦*{dq} bs) ∗
          "Hs" ∷ sl ↦* (es ++ List.replicate (uint.nat x - uint.nat i) zEnt) ∗
          "HV" ∷ ([∗list] e;v ∈ es;acc, entOwn e (DFrac.own 1) v) ∗
          "%Hi" ∷ ⌜es.length = uint.nat i ∧ acc.length = uint.nat i ∧ uint.nat i ≤ uint.nat x ∧
            decEntsGo (uint.nat x - uint.nat i) acc cur = decEntsGo (uint.nat x) [] rest⌝ : IProp GF)
          $$ [i r ok Hr Hback Hs]
      · iexists W64 0, r, [], [], rest
        simp only [show uint.nat (W64 0) = 0 from rfl, Nat.sub_zero, List.nil_append]
        iframe
        isplitl []
        · iapply BigSepL2.bigSepL2_nil.2; iempintro
        ipureintro
        simp
      wp_for HI
      wp_if_destruct
      · have hi : uint.Z i < uint.Z x := by
          first | exact Hif | exact of_decide_eq_true (go.intoVal_inj Hif)
        have hk : uint.nat x - uint.nat i = (uint.nat x - uint.nat i - 1) + 1 := by word
        rw [if_pos (show 0 ≤ sint.Z i ∧ sint.Z i < sint.Z sl.len by
          have := hsl.1; have := hsl.2
          have h2 : ((sint.Z sl.len).toNat : Int) = sint.Z sl.len := Int.toNat_of_nonneg hsl.2
          rw [show sint.nat sl.len = (sint.Z sl.len).toNat from rfl] at *
          word)]
        have hlk : (es ++ List.replicate (uint.nat x - uint.nat i) zEnt)[(sint.Z i).toNat]? =
            some zEnt := by
          rw [show (sint.Z i).toNat = es.length by word, hk]
          simp
        icases ownSlice_elem_acc (sint.Z i) zEnt sl _ _ (by word) hlk $$ Hs with ⟨He, Hs⟩
        wp_apply wp_rpcDec_t10 R cur dq _ $$ Hr He
        iintro %R2 %ok2 Hd
        rcases hd : decEntV cur with _ | ⟨v, cur2⟩
        · simp only [hd]
          icases Hd with %Hok
          subst Hok
          wp_auto
          rw [forPostcondition_unseal]; unfold forPostconditionDef; iright; iright; iright; ileft
          iexists #()
          isplitr
          · ipureintro; rfl
          dsimp only
          wp_auto
          have hres : decEntsGo (uint.nat x) [] rest = none := by
            rw [← Hi.2.2.2, hk]; simp [decEntsGo, hd]
          iapply HΦ
          rw [hres]
          ipureintro; first | rfl | trivial
        · simp only [hd]
          icases Hd with ⟨%Hok, ⟨%w, He, Hw⟩, Hr, Hback2⟩
          subst Hok
          ihave Hs := Hs $$ He
          wp_auto
          wp_for_post
          ihave Hback := wand_trans _ _ _ $$ Hback2 Hback
          ihave HV : ([∗list] e;v ∈ es ++ [w];acc ++ [v], entOwn e (DFrac.own 1) v) $$ [HV Hw]
          · iapply BigSepL2.bigSepL2_snoc.2
            iframe
          have hi1 : uint.nat (i + W64 1) = uint.nat i + 1 := by word
          have hset : (es ++ List.replicate (uint.nat x - uint.nat i) zEnt).set (sint.Z i).toNat w =
              (es ++ [w]) ++ List.replicate (uint.nat x - uint.nat (i + W64 1)) zEnt := by
            rw [show (sint.Z i).toNat = es.length by word, hk, hi1,
              show uint.nat x - (uint.nat i + 1) = uint.nat x - uint.nat i - 1 by omega]
            simp [List.replicate_succ]
          rw [hset]
          iframe
          iexists i + W64 1, R2, es ++ [w], acc ++ [v], cur2
          iframe
          ipureintro
          refine ⟨by rw [List.length_append, Hi.1, hi1]; rfl, by rw [List.length_append, Hi.2.1, hi1]; rfl,
            by rw [hi1]; omega, ?_⟩
          rw [← Hi.2.2.2, hk, hi1, show uint.nat x - (uint.nat i + 1) = uint.nat x - uint.nat i - 1 by omega]
          simp [decEntsGo, hd]
      · have hc : ¬ uint.Z i < uint.Z x := by
          first | exact Hif | exact fun h => Hif (by simp [h])
        (try (rw [decide_eq_false hc, if_pos (by simp)]))
        (try wp_auto)
        have hix : uint.nat x - uint.nat i = 0 := by
          word
        have hres : decEntsGo (uint.nat x) [] rest = some (acc, cur) := by
          rw [← Hi.2.2.2, hix]; rfl
        iapply HΦ
        rw [hres]
        dsimp only
        rw [hix, List.replicate_zero, List.append_nil]
        iframe
        isplitr
        · ipureintro; rfl
        iexists sl
        iframe
        unfold entsOwn
        iexists es
        iframe

/-! ### A field's encoding, by whether it is sent -/

theorem fU64_split (a : w64) (T : List w8) :
    fU64 a ++ T = (if a = W64 0 then W8 0 else W8 1) :: ((if a = W64 0 then [] else u64Le a) ++ T) := by
  by_cases h : a = W64 0 <;> simp_all [fU64, fld, encU64]

theorem fU8_split (a : w8) (T : List w8) :
    fU8 a ++ T = (if a = W8 0 then W8 0 else W8 1) ::
      ((if a = W8 0 then [] else u64Le (W64 (uint.Z a))) ++ T) := by
  by_cases h : a = W8 0 <;> simp_all [fU8, fld, encU64]

theorem fBool_split (a : Bool) (T : List w8) :
    fBool a ++ T = (if a = false then W8 0 else W8 1) :: ((if a = false then [] else encBool a) ++ T) := by
  cases a <;> simp [fBool, fld, encBool]

theorem fStr_split (a : GoString) (T : List w8) :
    fStr a ++ T = (if a = [] then W8 0 else W8 1) ::
      ((if a = [] then [] else rpctransport.encStr a) ++ T) := by
  by_cases h : a = [] <;> simp_all [fStr, fld]

theorem fBytes_split (a : List w8) (T : List w8) :
    fBytes a ++ T = (if a = [] then W8 0 else W8 1) :: ((if a = [] then [] else encBytes a) ++ T) := by
  by_cases h : a = [] <;> simp_all [fBytes, fld]

theorem fEnts_split (a : List EntV) (T : List w8) :
    fEnts a ++ T = (if a = [] then W8 0 else W8 1) ::
      ((if a = [] then [] else (encU64 (W64 a.length) ++ (a.map encEnt).flatten)) ++ T) := by
  by_cases h : a = [] <;> simp_all [fEnts, fld]

theorem fStruct_split (body T : List w8) : fStruct body ++ T = W8 1 :: (body ++ T) := by
  simp [fStruct, fld]

