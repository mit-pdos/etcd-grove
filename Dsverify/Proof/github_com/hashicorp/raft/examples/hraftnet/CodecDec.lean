theorem wp_rpcDec_t3_enc (b : GoSlice) (dq : DFrac) (p : Loc) (a0 : HdrV) (a1 : w64) (a2 : List w8) (a3 : w64) (a4 : w64) (a5 : List EntV) (a6 : w64) (rest : List w8)
    (Φ : val → IProp GF) :
    b ↦*{dq} (W8 1 :: (fStruct (encHdr a0) ++ (fU64 a1 ++ (fBytes a2 ++ (fU64 a3 ++ (fU64 a4 ++ (fEnts a5 ++ (fU64 a6 ++ rest)))))))) -∗ p ↦ (rpctransport.AppendReq.mk (rpctransport.Header.mk (W64 0) slice.nil slice.nil) (W64 0) slice.nil (W64 0) (W64 0) slice.nil (W64 0)) -∗
    ▷ (∀ r : GoSlice, r ↦*{dq} rest -∗ (r ↦*{dq} rest -∗ b ↦*{dq} (W8 1 :: (fStruct (encHdr a0) ++ (fU64 a1 ++ (fBytes a2 ++ (fU64 a3 ++ (fU64 a4 ++ (fEnts a5 ++ (fU64 a6 ++ rest))))))))) -∗
        (∃ w, p ↦ w ∗ aeReqOwn w (DFrac.own 1) ⟨a0, a1, a2, a3, a4, a5, a6⟩) -∗ Φ (PairV #r #true)) -∗
    WP (App (App (Val (@! rpcDec_t3)) (Val #b)) (Val #p)) {{ Φ }} := by
  iintro Hb Hp HΦ
