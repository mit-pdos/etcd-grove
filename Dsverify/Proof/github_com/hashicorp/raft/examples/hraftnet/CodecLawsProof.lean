theorem dec_AppendReq : decLaw (hraftCodec (GF := GF)) rpctransport.AppendReq.ty aeReqOwn encAEReq := by
  intro p v Ψ
  iintro ⟨Hp, HΨ⟩
  simp only [hraftCodec]
  iintro %data %dq %Φ Hd HΦ
  ihave %Hnn := typedPointsto_not_null _ _ _ $$ Hp
  ihave %Hlen := ownSlice_lenZ _ _ _ $$ Hd
  have hl : (encAEReq v).length < 2 ^ 64 := by
    have : sint.Z data.len < 2 ^ 63 := by word
    omega
  wp_func_call
  wp_call
  wp_auto
  wp_apply wp_rpcGetTag data _ dq $$ Hd
  iintro %t %r %ok H
  unfold encAEReq at hl ⊢
  simp only [getTag_tagged _ _ hl]
  icases H with ⟨%Hok, Hr, Hback⟩
  obtain ⟨rfl, rfl⟩ := Hok
  wp_auto
  (try (rw [decide_eq_false Hnn]; wp_auto))
  rw [zero_AppendReq]
  have e : strct [fStruct (encHdr v.hdr), fU64 v.term, fBytes v.leader, fU64 v.prev, fU64 v.prevTerm, fEnts v.ents, fU64 v.lci] = W8 1 :: (fStruct (encHdr v.hdr) ++ (fU64 v.term ++ (fBytes v.leader ++ (fU64 v.prev ++ (fU64 v.prevTerm ++ (fEnts v.ents ++ (fU64 v.lci ++ []))))))) := rfl
  rw [e]
  wp_apply (wp_rpcDec_t3_enc r dq p v.hdr v.term v.leader v.prev v.prevTerm v.ents v.lci []) $$ Hr Hp
  iintro %r2 Hr2 Hback2 Hown
  ihave %Hl2 := ownSlice_len _ _ _ $$ Hr2
  wp_auto
  rw [show r2.len = W64 0 by simp at Hl2; word]
  wp_auto
  ihave Hd := Hback $$ [Hback2 Hr2]
  · iapply Hback2 $$ Hr2
  iapply HΦ $$ %interface.nil %true Hd %(by simp) [HΨ Hown]
  · icases Hown with ⟨%w, Hp, Hown⟩
    iapply HΨ $$ Hp Hown
  simp only [ite_true]
  ipureintro; trivial

