/-- `rpcSent_t4`: a struct is always sent. -/
theorem wp_rpcSent_t4 (h : Header) :
    {{ (True : IProp GF) }} (App (Val (@! rpcSent_t4)) (Val #h)) {{ RET #true; True }} := by
  wp_start
  wp_auto
  iapply HΦ
  ipureintro; trivial

theorem wp_rpcSent_t9' (sl : GoSlice) (dq : DFrac) (xes : List EntV) :
    {{ (entsOwn sl dq xes : IProp GF) }} (App (Val (@! rpcSent_t9)) (Val #sl))
    {{ RET #(decide (xes ≠ [])); entsOwn sl dq xes }} := by
  iintro %Φ Hes HΦ
  unfold entsOwn
  icases Hes with ⟨%egs, Hsl, HE⟩
  ihave %HlE := BigSepL2.bigSepL2_length $$ HE
  wp_apply wp_rpcSent_t9 sl dq egs $$ [$Hsl] as Hsl
  have e : (egs = []) ↔ (xes = []) := by
    rw [← List.length_eq_zero_iff, HlE, List.length_eq_zero_iff]
  have e2 : decide (egs ≠ []) = decide (xes ≠ []) := by simp only [ne_eq, e]
  rw [e2]
  iapply HΦ
  iexists egs
  iframe

theorem wp_rpcEnc_t9 (sl : GoSlice) (dq : DFrac) (xes : List EntV) :
    encFn (GF := GF) rpcEnc_t9 #sl (encU64 (W64 xes.length) ++ (xes.map encEnt).flatten)
      (entsOwn sl dq xes) := by
  intro b bs
  wp_start as ⟨Hb, Hcap, Hes⟩
  unfold entsOwn
  icases Hes with ⟨%egs, Hsl, HE⟩
  ihave %HlE := BigSepL2.bigSepL2_length $$ HE
  ihave %Hl := ownSlice_len _ _ _ $$ Hsl
  wp_auto
  wp_apply wp_rpcPutU64 $$ [$Hb $Hcap] as %b1 ⟨Hb, Hcap⟩
  have hlen : sl.len = W64 xes.length := by rw [← HlE, Hl.1]; word
  ihave HI : (∃ (i : w64) (bb : GoSlice) (y : Entry),
      "i" ∷ i_ptr ↦ i ∗ "b" ∷ b_ptr ↦ bb ∗ "x" ∷ x_ptr ↦ y ∗
      "Hb" ∷ bb ↦* (bs ++ u64Le sl.len ++ ((xes.take (sint.nat i)).map encEnt).flatten) ∗
      "Hcap" ∷ ownSliceCap w8 bb (DFrac.own 1) ∗
      "%Hi" ∷ ⌜0 ≤ sint.Z i ∧ sint.Z i ≤ sint.Z sl.len⌝ : IProp GF) $$ [i b x Hb Hcap]
  · iexists W64 0, b1, _
    simp only [show sint.nat (W64 0) = 0 from rfl, List.take_zero, List.map_nil, List.flatten_nil,
      List.append_nil]
    iframe
    ipureintro
    exact ⟨by decide, Hl.2⟩
  wp_for HI
  wp_if_destruct
  · have hi : sint.Z i < sint.Z sl.len := Hif
    have hix : sint.nat i < xes.length := by rw [← HlE, Hl.1]; word
    have hie : sint.nat i < egs.length := by rw [Hl.1]; word
    obtain ⟨e, He⟩ : ∃ e, egs[sint.nat i]? = some e := ⟨_, List.getElem?_eq_getElem hie⟩
    obtain ⟨xe, Hxe⟩ : ∃ xe, xes[sint.nat i]? = some xe := ⟨_, List.getElem?_eq_getElem hix⟩
    rw [ite_eq_left ⟨Hi.1, hi⟩]
    wp_apply wp_load_slice_index sl (sint.Z i) egs dq e Hi.1 $$ [Hsl] with Hsl
    · iframe; ipureintro; exact He
    icases BigSepL2.bigSepL2_lookup_acc He Hxe $$ HE with ⟨Hent, HEback⟩
    rcases e with ⟨ix, tm, ty, dsl, esl⟩
    unfold entOwn
    icases Hent with ⟨%Hev, Hd, Hx⟩
    dsimp only at Hev
    obtain ⟨rfl, rfl, rfl⟩ := Hev
    wp_apply wp_rpcEnc_t10 _ _ _ _ _ _ _ dq _ _ $$ [$Hb $Hcap $Hd $Hx] as %b2 ⟨Hb, Hcap, Hd, Hx⟩
    ihave HE := HEback $$ [Hd Hx]
    · iframe; ipureintro; exact ⟨rfl, rfl, rfl⟩
    wp_for_post
    iframe
    iexists i + W64 1, b2, _
    rw [show sint.nat (i + W64 1) = sint.nat i + 1 by word,
      List.take_add_one, Hxe, Option.toList_some, List.map_append, List.flatten_append]
    simp only [List.map_cons, List.map_nil, List.flatten_cons, List.flatten_nil, List.append_nil,
      ← List.append_assoc, encEnt]
    iframe
    ipureintro; word
  · have hn : sint.nat i = xes.length := by rw [← HlE, Hl.1]; word
    (try wp_auto)
    iapply HΦ
    iframe Hcap
    isplitl [Hb]
    · unfold encU64
      rw [← hlen, List.append_assoc,
        show (xes.map encEnt).flatten = ((xes.take (sint.nat i)).map encEnt).flatten by
          rw [hn, List.take_length]]
      iexact Hb
    iexists egs
    iframe

