theorem hraftCodec_rcv_eq (rcvr : GoInterface) (Ψ : Loc → IProp GF) :
    (hraftCodec (GF := GF)).rcv rcvr Ψ = iprop(∀ Φ : val → IProp GF, ▷ (∀ rp : Loc, Ψ rp -∗ Φ #rp) -∗
      WP (App (Val #(functions rpcReceiver [])) (Val #rcvr)) {{ Φ }}) := rfl

/-- **A server's `*RaftRPC` `s` is a net/rpc receiver of the service spec `S`** (`Register`'s premise),
from its methods' obligations. -/
theorem raftRcv (P : IProp GF) [Persistent P] (s : Loc) (S : net.rpc.MethodSpec GF)
    (L : RaftRcvLaws P s S) :
    ⌜s ≠ null⌝ ∗ net.rpc.codecSet (hraftCodec (GF := GF)) ∗ P ⊢
    (hraftCodec (GF := GF)).rcv (ptrI RaftRPC.ty s)
      (net.rpc.rcvrIs hraftCodec (ptrI RaftRPC.ty s) S go!"RaftRPC" false) := by
  iintro ⟨%Hnn, #Hcs, #HP⟩
  rw [hraftCodec_rcv_eq]
  iintro %Φ HΦ
  iapply wp_fupd
  wp_func_call
  wp_call
  wp_auto
  wp_apply (wp_map_make1 (K := GoString) (V := Loc) _ _) as %mp Hm
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  wp_alloc m0 as H0
  ipersist H0
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  wp_alloc m1 as H1
  ipersist H1
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  wp_alloc m2 as H2
  ipersist H2
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  wp_alloc m3 as H3
  ipersist H3
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  wp_alloc m4 as H4
  ipersist H4
  repeat (first | (wp_apply wp_mapInsert $$ Hm as Hm) | wp_auto)
  ipersist «$r0»
  imod ownMap_persist $$ Hm with #Hm
  iapply HΦ
  unfold net.rpc.rcvrIs
  iexists _, _
  iframe «$r0» Hm
  isplitr
  · ipureintro
