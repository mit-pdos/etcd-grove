/-
The hraft kit's generated codec, the receiver's side: `rpcReceiver` on a server's `*RaftRPC` (the
transport's receiver, registered as "RaftRPC") gives a `*Receiver` meeting Net's `rcvrIs` for a
service spec `S` (`raftRcv`), which `Server.Register` asks for. Per method (`methodOk`): `NewArg()`
allocates the zero argument, whose decoding of a deposit's argument bytes (`S m args Φ`, which say
the bytes are an encoding, `encOf`) is `CodecLawsProof.lean`'s `dec_*` (Net's `argDec`); the call
obligation: `NewReply()`, then `Call`, which calls the `RaftRPC` method (its spec a hypothesis,
`rpcMeth.spec`: the transport's, S4b's), whose reply encodes (`enc_*`) into the deposit's success
answer. As net/rpcdriver's `Rcvr.lean` and craq's `Netrpc/Bindings.lean`.
Generated by `etc/dsv/tools/hraft-codec.py` from the kit's `rpc_gen.go` (do not edit: change the script and rerun it).
-/
module

public import Dsverify.Proof.github_com.hashicorp.raft.examples.hraftnet.CodecLawsProof
public import Dsverify.Proof.github_com.hashicorp.raft.examples.hraftnet.rpctransport.Facts

@[expose] public section

set_option linter.iris.style.nameCheck false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

noncomputable section

namespace Perennial

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode Net

namespace github_com.hashicorp.raft.examples.hraftnet

open rpctransport

/-- The generated `Method` of the functions named `na`, `nr`, `cl`. -/
abbrev mOf [GooseExts] [GoSemanticsFunctions] [GoGlobalContext] (na nr cl : GoString) :
    net.rpc.Method :=
  net.rpc.Method.mk (functions na []) (functions nr []) (functions cl [])

section proof
variable [GooseExts] [GooseSemantics] [GooseInterp] [HasExt netExt] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : Assumptions]
variable [bvi : go.BasicIntoValInj]
variable [net.rpc.Assumptions] [π : NetProtoGS]

attribute [local instance] GooseGlobalGS.gooseInvGS

set_option goose.wp.extras true

/-- What the receiver needs of a `RaftRPC` method `M` of `s`, for the method spec `Sm` (with `P`, the
receiver's persistent facts): from a deposit of a request's encoding `encA va` and the decoded
request `wa` (holding `va`; the encoding shorter than `2 ^ 63`, as a slice's bytes, so that the
request is the deposit's: `encAEReq_inj`, ...), into the zero reply, it returns `nil` with a reply holding some `vr`
whose encoding is the deposit's success answer. -/
abbrev rpcMeth.spec {A R AV RV : Type} [TypedPointsto (GF := GF) A] [TypedPointsto (GF := GF) R]
    [ZeroVal R] (P : IProp GF) (s : Loc) (M : GoString) (aOwn : A → DFrac → AV → IProp GF)
    (encA : AV → List w8) (rOwn : R → DFrac → RV → IProp GF) (encR : RV → List w8)
    (Sm : net.rpc.MSpec GF) : Prop :=
  ∀ (ap rp : Loc) (wa : A) (va : AV) (Φ : List w8 → GoString → IProp GF),
    {{ P ∗ ⌜(encA va).length < 2 ^ 63⌝ ∗ Sm (encA va) Φ ∗ ap ↦ wa ∗ aOwn wa (DFrac.own 1) va ∗
        rp ↦ (zero_val R) }}
      (App (App (Val (s @!! go.GoType.PointerType RaftRPC.ty @!! M)) (Val #ap)) (Val #rp))
    {{ RET #interface.nil; ∃ (wr : R) (vr : RV), rp ↦ wr ∗ rOwn wr (DFrac.own 1) vr ∗ Φ (encR vr) [] }}

/-- The method spec `Sm`'s deposits are of encodings (`encA`'s). -/
abbrev encOf {AV : Type} (encA : AV → List w8) (Sm : net.rpc.MSpec GF) : Prop :=
  ∀ (args : List w8) (Φ : List w8 → GoString → IProp GF), Sm args Φ ⊢ ⌜∃ va, args = encA va⌝

/-- A decoding's bytes are a slice's: shorter than `2 ^ 63`. -/
theorem dec_len (bs : List w8) (ptr : GoInterface) (Ψ : Bool → IProp GF) :
    (⌜bs.length < 2 ^ 63⌝ -∗ (hraftCodec (GF := GF)).dec bs ptr Ψ) ⊢ hraftCodec.dec bs ptr Ψ := by
  iintro H
  simp only [hraftCodec]
  iintro %data %dq %Φ Hd HΦ
  ihave %Hl := ownSlice_lenZ _ _ _ $$ Hd
  have hb : bs.length < 2 ^ 63 := by
    have : sint.Z data.len < 2 ^ 63 := by word
    omega
  ihave H2 := H $$ %hb
  iapply H2 $$ Hd HΦ

/-- What a method's `NewArg` must meet (`methodOk`'s body). -/
def newArgOk (C : net.rpc.CodecSpec GF) (rcvr : GoInterface) (Sm : net.rpc.MSpec GF)
    (v : net.rpc.Method) : IProp GF :=
  iprop(□ ∀ Ψ : val → IProp GF,
      ▷ (∀ (argv : GoInterface) (D : IProp GF) (Θ : List w8 → Bool → IProp GF),
          ⌜argv ≠ interface.nil⌝ -∗ net.rpc.argDec C argv D Sm Θ -∗ D -∗
          (∀ (args : List w8) (Φ : List w8 → GoString → IProp GF), Sm args Φ -∗ Θ args true -∗
            net.rpc.callObl C rcvr v argv Φ) -∗ Ψ #argv) -∗
      WP (App (Val #v.NewArg') (Val #())) {{ Ψ }})

instance newArgOk_persistent (C : net.rpc.CodecSpec GF) (rcvr : GoInterface)
    (Sm : net.rpc.MSpec GF) (v : net.rpc.Method) :
    Persistent (newArgOk (hG := hG) C rcvr Sm v) := by
  unfold newArgOk; infer_instance

theorem methodOk_of (C : net.rpc.CodecSpec GF) (rcvr : GoInterface) (Sm : net.rpc.MSpec GF)
    (mm : Loc) (v : net.rpc.Method) :
    mm ↦□ v ∗ newArgOk C rcvr Sm v ⊢ net.rpc.methodOk C rcvr Sm mm := by
  unfold net.rpc.methodOk newArgOk
  iintro ⟨#Hm, #Hn⟩
  iexists v
  iframe Hm
  iexact Hn

/-- The receiver's obligations of a `RaftRPC` `s` for the service spec `S` (with `P`, its persistent
facts): each method's deposits are encodings of its request, and the method meets `rpcMeth.spec`. -/
structure RaftRcvLaws (P : IProp GF) (s : Loc) (S : net.rpc.MethodSpec GF) : Prop where
  enc_AppendEntries : encOf (GF := GF) encAEReq (S go!"AppendEntries")
  meth_AppendEntries : rpcMeth.spec P s go!"AppendEntries" aeReqOwn encAEReq aeRespOwn encAEResp (S go!"AppendEntries")
  enc_InstallSnapshot : encOf (GF := GF) encSnapReq (S go!"InstallSnapshot")
  meth_InstallSnapshot : rpcMeth.spec P s go!"InstallSnapshot" snapReqOwn encSnapReq snapRespOwn encSnapResp (S go!"InstallSnapshot")
  enc_RequestPreVote : encOf (GF := GF) encPreVoteReq (S go!"RequestPreVote")
  meth_RequestPreVote : rpcMeth.spec P s go!"RequestPreVote" preVoteReqOwn encPreVoteReq preVoteRespOwn encPreVoteResp (S go!"RequestPreVote")
  enc_RequestVote : encOf (GF := GF) encVoteReq (S go!"RequestVote")
  meth_RequestVote : rpcMeth.spec P s go!"RequestVote" voteReqOwn encVoteReq voteRespOwn encVoteResp (S go!"RequestVote")
  enc_TimeoutNow : encOf (GF := GF) encTimeoutReq (S go!"TimeoutNow")
  meth_TimeoutNow : rpcMeth.spec P s go!"TimeoutNow" (fun (w : rpctransport.TimeoutReq) dq h => hdrOwn (GF := GF) w.Hdr' dq h) encTimeoutReq timeoutRespOwn encTimeoutResp (S go!"TimeoutNow")

theorem newArg_AppendEntries (P : IProp GF) [Persistent P] (s : Loc) (Sm : net.rpc.MSpec GF)
    (hS : encOf (GF := GF) encAEReq Sm)
    (HM : rpcMeth.spec P s go!"AppendEntries" aeReqOwn encAEReq aeRespOwn encAEResp Sm) :
    net.rpc.codecSet (hraftCodec (GF := GF)) ∗ P ⊢
    newArgOk hraftCodec (ptrI RaftRPC.ty s) Sm
      (mOf rpcNewArg_r0_AppendEntries rpcNewReply_r0_AppendEntries rpcCall_r0_AppendEntries) := by
  iintro ⟨#Hcs, #HP⟩
  unfold newArgOk
  imodintro
  iintro %Ψ HΨ
  simp only [mOf]
  wp_func_call
  wp_call
  wp_auto
  wp_alloc p as Hp
  wp_auto
  have hne : ptrI AppendReq.ty p ≠ interface.nil := by simp [ptrI, interface.mkOk]
  ihave #Hdec : net.rpc.argDec hraftCodec (ptrI AppendReq.ty p) (p ↦ (zero_val AppendReq)) Sm
      (fun args ok => iprop(if ok then ∃ (w : AppendReq) (va : AEReqV), ⌜args = encAEReq va ∧ args.length < 2 ^ 63⌝ ∗
          p ↦ w ∗ aeReqOwn w (DFrac.own 1) va else True)) $$ []
  · unfold net.rpc.argDec
    iframe Hcs
    imodintro
    iintro Hp %args %Φ HD
    ihave ⟨%Hex, HD⟩ := (persistent_entails_right (hS args Φ)) $$ HD
    obtain ⟨va, rfl⟩ := Hex
    iframe HD
    iapply dec_len
    iintro %Hl
    iapply dec_AppendReq
    iframe Hp
    iintro %w Hp Hown
    (try simp only [ite_true])
    iexists w, va
    iframe
    ipureintro; exact ⟨rfl, Hl⟩
  iapply HΨ $$ %_ %_ %_ %hne Hdec Hp
  iintro %args %Φ HD Hp
  (try simp only [ite_true])
  icases Hp with ⟨%w, %va, ⟨%Hargs, %Hl⟩, Hp, Hown⟩
  subst Hargs
  unfold net.rpc.callObl
  wp_func_call
  wp_call
  wp_auto
  iexists _
  isplitr
  · ipureintro; rfl
  wp_func_call
  wp_call
  wp_auto
  wp_apply (HM p «$r0_ptr» w va Φ) $$ [HD Hp Hown «$r0»] as ⟨%wr, %vr, Hr, Hrown, HΦ⟩
  · iframe HD Hp Hown «$r0»
    isplitr
    · iexact HP
    · ipureintro; exact Hl
  (try wp_auto)
  iexists _
  isplitr
  · ipureintro; rfl
  unfold net.rpc.callRet
  ileft
  isplitr
  · ipureintro; rfl
  iapply enc_AppendResp
  iframe Hr Hrown
  iintro _ _
  iexact HΦ

