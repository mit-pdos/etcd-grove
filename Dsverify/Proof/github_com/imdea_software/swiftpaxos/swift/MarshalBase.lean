theorem set16 {A : Type} (l : List A) (hl : l.length = 16)
    (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 : A) :
    ((((((((((((((((l.set (Int.toNat 0) a0).set 1 a1).set 2 a2).set 3 a3).set 4 a4).set 5 a5).set 6
      a6).set 7 a7).set 8 a8).set 9 a9).set 10 a10).set 11 a11).set 12 a12).set 13 a13).set 14
      a14).set 15 a15) =
      [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15] := by
  match l, hl with
  | [_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _], _ => rfl

theorem le32x4_sbytes (x y z u : w32) :
    [W8 (sint.Z x), W8 (sint.Z (BitVec.sshiftRight' x (W64 8))),
      W8 (sint.Z (BitVec.sshiftRight' x (W64 16))), W8 (sint.Z (BitVec.sshiftRight' x (W64 24))),
      W8 (sint.Z y), W8 (sint.Z (BitVec.sshiftRight' y (W64 8))),
      W8 (sint.Z (BitVec.sshiftRight' y (W64 16))), W8 (sint.Z (BitVec.sshiftRight' y (W64 24))),
      W8 (sint.Z z), W8 (sint.Z (BitVec.sshiftRight' z (W64 8))),
      W8 (sint.Z (BitVec.sshiftRight' z (W64 16))), W8 (sint.Z (BitVec.sshiftRight' z (W64 24))),
      W8 (sint.Z u), W8 (sint.Z (BitVec.sshiftRight' u (W64 8))),
      W8 (sint.Z (BitVec.sshiftRight' u (W64 16))), W8 (sint.Z (BitVec.sshiftRight' u (W64 24)))] =
      sp.le32 x ++ sp.le32 y ++ sp.le32 z ++ sp.le32 u := by
  rw [← le32_sbytes, ← le32_sbytes, ← le32_sbytes, ← le32_sbytes]; rfl

