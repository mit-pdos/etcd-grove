  · iframe Hb; ipureintro; simp only [List.length_singleton]; decide
  rw [List.set_cons_zero]
  try wp_auto
  wp_apply HW $$ HS [] Hb as %nn %err HS Hb
  · iapply Qp $$ Hpc HQk
    ipureintro
    simp))

