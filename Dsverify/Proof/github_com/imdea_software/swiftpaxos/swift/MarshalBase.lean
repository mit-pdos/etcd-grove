/-- A prefix of an allowed stream is allowed. -/
theorem Qpre (Q : List w8 → IProp netDistGF) (A C : List w8) (B : List w8) (h : C = A ++ B) :
    bufio.prefixClosed Q ∗ □ Q C ⊢ □ Q A := by
  iintro ⟨#Hpc, #HQ⟩
  iunfold bufio.prefixClosed at Hpc
  imodintro
  subst h
  iapply Hpc $$ %A %B HQ

/-- A prefix of an allowed stream is allowed (curried, for `iapply`). -/
theorem Qp (Q : List w8 → IProp netDistGF) (A C : List w8) :
    bufio.prefixClosed Q ⊢ □ Q C -∗ ⌜A <+: C⌝ -∗ □ Q A := by
  iintro #Hpc #HQ %h
  obtain ⟨t, rfl⟩ := h
  iapply Qpre Q A _ t rfl
  iframe Hpc HQ

/-- The first `k` bytes of a buffer `b[:n]` as `b[:k]`, and back. -/
theorem slice_pre (p : Loc) (n k : w64) (vs : List w8)
    (hk : 0 ≤ sint.Z k ∧ sint.Z k ≤ sint.Z n) :
    (slice.mk p n n ↦* vs : IProp netDistGF) ⊢ slice.mk p k n ↦* vs.take (sint.nat k) ∗
      (∀ vs', slice.mk p k n ↦* vs' -∗ ⌜vs'.length = sint.nat k⌝ -∗
        slice.mk p n n ↦* (vs' ++ vs.drop (sint.nat k))) := by
  have e := ownSlice_split_all (V := w8) (GF := netDistGF) k (slice.mk p n n) (DFrac.own 1) vs hk
  have h1 : slice.slice (slice.mk p n n) w8 (W64 0) k = slice.mk p k n := by
    simp only [slice.slice, sliceIndexRef]
    rw [show sint.Z (W64 0) = 0 from rfl, go.arrayIndexRef_0]
    congr 1 <;> simp
  iintro H
  icases e.1 $$ H with ⟨H1, H2⟩
  rw [h1]
  iframe H1
  iintro %vs' H1' %Hl
  have hc := ownSlice_combine (V := w8) (GF := netDistGF) k (slice.mk p n n) (DFrac.own 1) vs'
    (vs.drop (sint.nat k)) (W64 0) n ⟨by rw [Hl]; have : sint.nat (W64 0) = 0 := rfl; omega,
      by decide, hk.1, hk.2⟩
  rw [h1] at hc
  ihave H := hc $$ H1' H2
  iExactEq H
  simp only [slice.slice, sliceIndexRef]
  rw [show sint.Z (W64 0) = 0 from rfl, go.arrayIndexRef_0]
  congr 1 <;> simp

/-- Loading byte `j` of the hash `i` of a `[]SHash`. -/
theorem wp_load_hbyte (sl : GoSlice) (dq : DFrac) (hs : List sp.Hash) (i j : Int) (h : sp.Hash)
    (x : w8) (hi : 0 ≤ i) (hh : hs[i.toNat]? = some h) (hj : 0 ≤ j) (hx : h[j.toNat]? = some x) :
    {{ (sl ↦*{dq} hs.map swift.handler.shashOf : IProp netDistGF) }}
      (App (Val (GoInstruction (GoLoad go.byte)))
        (Val #(arrayIndexRef w8 j (structFieldRef swift.SHash go!"H" (sliceIndexRef swift.SHash i sl)))))
    {{ RET #x; sl ↦*{dq} hs.map swift.handler.shashOf }} := by
  iintro %Φ Hsl HΦ
  have hh' : (hs.map swift.handler.shashOf)[i.toNat]? = some (swift.handler.shashOf h) := by
    simp [hh]
  icases ownSlice_elem_acc i _ sl _ _ hi hh' $$ Hsl with ⟨He, Hsl⟩
  icases typedPointsto_not_null_dup _ _ _ $$ He with ⟨He, %Hnn⟩
  icases typedPointsto_split _ _ _ $$ He with He
  simp only [TypedPointsto.typedPointstoDef, swift.handler.shashOf]
  icases He with ⟨H, -⟩
  icases array_acc (V := w8) _ j _ 32 ⟨h⟩ x hj hx $$ H with ⟨Hv, Hw⟩
  wp_apply IntoValTyped.wp_load (t := go.byte) _ _ _ $$ Hv as Hv
  iapply HΦ
  ihave H := Hw $$ %x Hv
  ihave He : typedPointsto (sliceIndexRef swift.SHash i sl) (swift.handler.shashOf h) dq $$ [H]
  · iapply typedPointsto_combine _ _ _ Hnn
    simp only [TypedPointsto.typedPointstoDef, swift.handler.shashOf]
    rw [list_set_lookup_self h j.toNat x hx]
    iframe H
  ihave Hsl := Hsl $$ He
  rw [list_set_lookup_self _ i.toNat _ hh']
  iexact Hsl

/-- Loading a field of the id `i` of a `[]CommandId`. -/
theorem wp_load_cl (sl : GoSlice) (dq : DFrac) (xs : List swift.CommandId) (i : Int)
    (x : swift.CommandId) (hi : 0 ≤ i) (hx : xs[i.toNat]? = some x) :
    {{ (sl ↦*{dq} xs : IProp netDistGF) }}
      (App (Val (GoInstruction (GoLoad go.int32)))
        (Val #(structFieldRef swift.CommandId go!"ClientId" (sliceIndexRef swift.CommandId i sl))))
    {{ RET #x.ClientId'; sl ↦*{dq} xs }} := by
  iintro %Φ Hsl HΦ
  icases ownSlice_elem_acc i _ sl _ _ hi hx $$ Hsl with ⟨He, Hsl⟩
  icases typedPointsto_not_null_dup _ _ _ $$ He with ⟨He, %Hnn⟩
  icases typedPointsto_split _ _ _ $$ He with He
  simp only [TypedPointsto.typedPointstoDef]
  icases He with ⟨H, H2⟩
  wp_apply IntoValTyped.wp_load (t := go.int32) _ _ _ $$ H as H
  iapply HΦ
  ihave He : typedPointsto (sliceIndexRef swift.CommandId i sl) x dq $$ [H H2]
  · iapply typedPointsto_combine _ _ _ Hnn
    simp only [TypedPointsto.typedPointstoDef]
    iframe
  ihave Hsl := Hsl $$ He
  rw [list_set_lookup_self _ i.toNat _ hx]
  iexact Hsl

theorem wp_load_seq (sl : GoSlice) (dq : DFrac) (xs : List swift.CommandId) (i : Int)
    (x : swift.CommandId) (hi : 0 ≤ i) (hx : xs[i.toNat]? = some x) :
    {{ (sl ↦*{dq} xs : IProp netDistGF) }}
      (App (Val (GoInstruction (GoLoad go.int32)))
        (Val #(structFieldRef swift.CommandId go!"SeqNum" (sliceIndexRef swift.CommandId i sl))))
