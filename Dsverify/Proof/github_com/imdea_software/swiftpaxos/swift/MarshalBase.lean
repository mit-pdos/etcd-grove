/-- `(*MLightSlowAck).Marshal(wire)`: its 16 bytes. -/
theorem swift.MLightSlowAck.Marshal.wp (l : Loc) (dq : DFrac) (sa : swift.MLightSlowAck)
    (s : sp.SlowAck) (hs : swift.slowAckRepr sa s)
    (wr : GoInterface) (S Q : List w8 → IProp netDistGF) (W : List w8) :
    {{ sinkOk wr S Q ∗ S W ∗ □ Q (W ++ s.enc) ∗ l ↦{dq} sa }}
      (App (Val (l @!! go.GoType.PointerType swift.MLightSlowAck.ty @!! go!"Marshal")) (Val #wr))
    {{ RET #(); S (W ++ s.enc) ∗ l ↦{dq} sa }} := by
  wp_start as ⟨#Hsink, HS, #HQ, Ht⟩
  ihave %Htn := typedPointsto_not_null $$ Ht
  iStructNamed Ht
  ihave %Hcn := typedPointsto_not_null $$ CmdId
  iStructNamed CmdId
  wp_auto
  ihave Hsl := slice_array b_ptr 16 (Perennial.zero_val (GoArray w8 16)) (by decide) $$ b
  rw [show sint.Z (W64 0) = 0 from rfl, go.arrayIndexRef_0, show W64 16 - W64 0 = W64 16 from rfl]
  rw [show (Perennial.zero_val (GoArray w8 16)).arr = List.replicate 16 (W8 0) from rfl]
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  mstore
  rw [set16 _ (by simp), le32x4_sbytes]
  obtain ⟨h1, h2, h3⟩ := hs
  have he : sp.le32 sa.Replica' ++ sp.le32 sa.Ballot' ++ sp.le32 sa.CmdId'.ClientId' ++
      sp.le32 sa.CmdId'.SeqNum' = s.enc := by
    simp only [sp.SlowAck.enc, sp.encCmdId, ← h1, ← h2, ← h3, swift.toCmdId, List.append_assoc]
  rw [he]
  iunfold sinkOk at Hsink
  icases Hsink with ⟨%e, %He, #HW⟩
  subst He
  wp_pures
  wp_apply HW $$ HS HQ Hsl as %nn %err HS Hsl
  iapply HΦ
  iframe HS
  iapply typedPointsto_combine _ _ _ Htn
  simp only [TypedPointsto.typedPointstoDef]
  iframe
  iapply typedPointsto_combine _ _ _ Hcn
  simp only [TypedPointsto.typedPointstoDef]
  iframe

/-- **`swift.MLightSlowAck.marshalH`**. -/
theorem swift.MLightSlowAck.marshal_proof : swift.MLightSlowAck.marshalH (hG := hG) := by
  intro l sa s hs
  unfold sp.marshalOk
  iexists ⟨go.GoType.PointerType swift.MLightSlowAck.ty, #l⟩
  isplitr
  · ipureintro; rfl
  imodintro
  iintro %wr %S %Q %W %Φ Hl #Hsink HS #Hpc #HQ HΦ
  rw [show (sp.Msg.lightSlowAck s).body = s.enc from rfl]
  wp_apply swift.MLightSlowAck.Marshal.wp l _ sa s hs wr S Q W $$ [$Hsink $HS $HQ $Hl]
    as ⟨HS, Hl⟩
  iapply HΦ $$ Hl HS

