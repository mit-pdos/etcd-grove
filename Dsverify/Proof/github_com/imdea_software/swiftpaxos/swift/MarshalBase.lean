  try rw [ite_eq_left_of_eq_true _ _ (eq_true hbnd)]
  try wp_auto
  wp_apply wp_load_hbyte _ _ _ _ _ _ _ hk0 hh' (by decide) (by rfl) $$ [Hcs] as Hcs
