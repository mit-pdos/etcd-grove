  icases typedPointsto_not_null_dup _ _ _ $$ He with ⟨He, %Hnn⟩
  icases typedPointsto_split _ _ _ $$ He with He
  simp only [TypedPointsto.typedPointstoDef]
  icases He with ⟨H1, H, H3⟩
  wp_apply IntoValTyped.wp_load (t := go.int32) _ _ _ $$ H as H
  iapply HΦ
  ihave He : typedPointsto (sliceIndexRef swift.CommandId i sl) x dq $$ [H1 H H3]
