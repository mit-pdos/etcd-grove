/-- A length's varint: 1 to 10 bytes. -/
theorem varintLen_length (n : Nat) (h : n < 2 ^ 62) :
    1 ≤ (sp.varintLen n).length ∧ (sp.varintLen n).length ≤ 10 := by
  unfold sp.varintLen
  refine ⟨?_, sp.uvarint_length _ 10 (by decide) (by omega)⟩
  rw [sp.uvarint]; split <;> simp

theorem take_of_len {A : Type} (arr : List A) (k : w64) (n : Nat) (h : n ≤ arr.length)
    (hk : sint.nat k = n) : ∃ l, arr.take (sint.nat k) = l ∧ l.length = n :=
  ⟨_, rfl, by simp; omega⟩

theorem take1_of_len {A : Type} (arr : List A) (h : 1 ≤ arr.length) :
    ∃ y, arr.take (sint.nat (W64 1)) = [y] := by
  match arr, h with
  | a :: _, _ => exact ⟨a, rfl⟩

theorem len_restore {A : Type} (l1 arr : List A) (n k : w64) (hk : l1.length = sint.nat k)
    (h : arr.length = sint.nat n) (hkn : sint.nat k ≤ sint.nat n) :
    (l1 ++ arr.drop (sint.nat k)).length = sint.nat n := by
  simp; omega

theorem set4 {A : Type} (l : List A) (hl : l.length = 4) (a b c d : A) :
    ((((l.set (Int.toNat 0) a).set 1 b).set 2 c).set 3 d) = [a, b, c, d] := by
  match l, hl with
  | [_, _, _, _], _ => rfl

theorem set4' {A : Type} (l : List A) (hl : l.length = 4) (a b c d : A) :
    ((((l.set 0 a).set 1 b).set 2 c).set 3 d) = [a, b, c, d] := by
  match l, hl with
  | [_, _, _, _], _ => rfl

