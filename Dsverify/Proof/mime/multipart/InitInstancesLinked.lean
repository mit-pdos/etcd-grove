initialization in the gryff kit's part (no `Init.lean` there): `local_wp_initialize'`,
the walk of the translated `initialize'` etc/gen-init.py makes for a translated package, over
the local axioms below for its names-only initializers. Generated by
math-rand-isinit's `etc/dsv/tools/inithyp-instances.py` run on the closure of net/rpc's and net/http's
initializers (notes/dsv-gryff.md, "Non-vacuity"), then edited where marked. No
statement or proof imports this module.
-/
module

public import Dsverify.Proof.mime.multipart.Base
public import Dsverify.Proof.net.textproto.InitInstancesLinked
public import Net.Proof.runtime.PkgInitExt

@[expose] public section

set_option linter.iris.style.nameCheck false
set_option linter.unusedSectionVars false
set_option linter.iris.dupNamespace false

noncomputable section

namespace Perennial

/-- `x ∈ [a, ..., x, ...]`, linear in the list (`simp` overflows on the long ones). -/
local macro "mem_tac" : tactic =>
  `(tactic| repeat (first | exact List.Mem.head _ | apply List.Mem.tail))

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

section opaqueInits
namespace mime.multipart
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [sem : go.Semantics]

/-- **Local axiom (test-only; in no statement's trust base): `mime.multipart`'s untranslated variable initializers run.**
Goose translates them names only (each `X.init` an uninterpreted constant of the translation);
Go runs them at program start and they return without panicking (the kit's programs start). -/
axiom localOpaqueInitsOk :
    ∀ v ∈ ([ErrMessageTooLarge.init,
        multipartfiles.init,
        multipartmaxparts.init,
        emptyParams.init,
        multipartmaxheaders.init,
        quoteEscaper.init] : List val),
    {{ (True : IProp GF) }} (App (Val v) (Val #())) {{ RET #(); True }}

end mime.multipart
end opaqueInits

section init
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF]
variable [sem : go.Semantics]
variable [package_sem : _root_.Perennial.mime.multipart.Assumptions]

namespace mime.multipart

theorem local_wp_initialize'_lb (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.mime.multipart get_is_pkg_init) (σ0 : GMap GoString Bool) :
    {{ EtcdGrove.ownInitLb get_is_pkg_init σ0 }}
      (App (Val initialize') (Val #()))
    {{ RET #(); EtcdGrove.ownInitLb get_is_pkg_init σ0 ∗
        isPkgInit (PROP := IProp GF) pkg_id.mime.multipart }} := by
  wp_start as Hown
  iapply EtcdGrove.wp_package_init_lb (heq := Hinit.1) $$ [Hown] HΦ
  iframe Hown
  iintro Hown
  wp_auto
  wp_apply (_root_.Perennial.net.textproto.local_wp_initialize'_lb _ Hinit.2.1) _ $$ Hown as ⟨Hown, #Hd1⟩
  wp_apply (localOpaqueInitsOk ErrMessageTooLarge.init (by mem_tac))
  wp_apply (localOpaqueInitsOk multipartfiles.init (by mem_tac))
  wp_apply (localOpaqueInitsOk multipartmaxparts.init (by mem_tac))
  wp_apply (localOpaqueInitsOk emptyParams.init (by mem_tac))
  wp_apply (localOpaqueInitsOk multipartmaxheaders.init (by mem_tac))
  wp_apply (localOpaqueInitsOk quoteEscaper.init (by mem_tac))
  iframe Hown
  is_pkg_init_finish

/-- Perennial's form, from `wp_initialize'_lb`. -/
theorem local_wp_initialize' (get_is_pkg_init : GoString → IProp GF)
    (Hinit : GetIsPkgInitProp pkg_id.mime.multipart get_is_pkg_init) :
    {{ ownInitializing get_is_pkg_init }}
      (App (Val initialize') (Val #()))
    {{ RET #(); ownInitializing get_is_pkg_init ∗
        isPkgInit (PROP := IProp GF) pkg_id.mime.multipart }} :=
  EtcdGrove.wp_init_of_lb _ _ _ (local_wp_initialize'_lb get_is_pkg_init Hinit)



end mime.multipart

end init

end Perennial
