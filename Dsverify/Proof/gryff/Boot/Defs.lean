/-
A replica node's boot keeps what `gryff`'s initializer makes (notes/dsv-gryff.md, "Package
initializers"; ported from dsverify-lab examples/gryff/proof/GryffProof/B/Init.lean and
Server/SpecsDefs.lean's `gryffGlobals`, run gryff-bump-1).

`gryff`'s initializer allocates mutable package variables (`stack`, `cpMarker`, the counters, the
message buffers, `deferMap`, `bf_PT`) and its `init()` creates the trace prophecy (`traceProph =
primitive.NewProph()`, ghost code, D13). These are owned resources, which a package fact (a
persistent `isPkgInit`) cannot carry, so the generated `wp_initialize'` (`gryff/src/gryff/Init.lean`)
drops them. A replica node gets them from its own boot instead: `wp_initialize'_own`
(`cmd/server{2,3,4}/Boot.lean`), its program's initialization from a fresh process (`ownGoState ∅`)
to `ownInitializing getIsPkgInit ∗ isPkgInit ∗ gryffGlobals ∗ traceProph ↦ p ∗ proph p pvs`. The
proof runs every package before `gryff` with `gNo g` (`g`, but `False` at `gryff`, `gryffnet` and
the commands: none of them initialized yet), so that `gryff`'s, `gryffnet`'s and the command's
`package.init` take their first branch (`wp_package_init_gen`). The facts `GetIsPkgInitProp q (gNo
g)` are the program table's, package by package (`BootTable.lean`, generated by
`etc/dsv/_gryff_boot.py` from the generated `PkgTable.lean`).
-/
module

public import Dsverify.GeneratedProof.gryff.src.gryff
public import Perennial.Proof.github_com.goose_lang.primitive.Link
public import Dsverify.Proof.gryff.Rpc.RpcHttpHyps

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

namespace gryff.boot

/-- The packages not yet initialized when `gryff`'s initializer starts on a replica node: `gryff`,
`gryffnet` and the commands (the commands' packages import `gryffnet`, which imports `gryff`). -/
def noPkgs : List GoString :=
  [go!"gryff/src/gryff", go!"gryff/examples/gryffnet"] ++
  ([go!"orch", go!"client0", go!"client1", go!"client2", go!"client3", go!"client4",
    go!"client5", go!"server1", go!"server2", go!"server3", go!"server4"].map
    fun c => go!"gryff/examples/gryffnet/cmd/" ++ c)

/-- `g`, but `False` at the packages `S` (not initialized yet). -/
def gEx {PROP : Type _} [BI PROP] (S : List GoString) (g : GoString → PROP) : GoString → PROP :=
  fun p => if p ∈ S then iprop(False) else g p

theorem gEx_ne {PROP : Type _} [BI PROP] (S : List GoString) (g : GoString → PROP) (p : GoString)
    (h : p ∉ S) : gEx S g p = g p := by
  unfold gEx; rw [if_neg h]

theorem gEx_no {PROP : Type _} [BI PROP] (S : List GoString) (g : GoString → PROP) (p : GoString)
    (h : p ∈ S) : gEx S g p ⊢ False := by
  unfold gEx; rw [if_pos h]

/-- `g`, but `False` at `noPkgs`: before `gryff`'s initializer, none of them is initialized. -/
def gNo {PROP : Type _} [BI PROP] (g : GoString → PROP) : GoString → PROP := gEx noPkgs g

theorem gNo_ne {PROP : Type _} [BI PROP] (g : GoString → PROP) (p : GoString)
    (h : p ∉ noPkgs) : gNo g p = g p := gEx_ne _ _ _ h

theorem gNo_no {PROP : Type _} [BI PROP] (g : GoString → PROP) (p : GoString)
    (h : p ∈ noPkgs) : gNo g p ⊢ False := gEx_no _ _ _ h

theorem gNo_le {PROP : Type _} [BI PROP] (g : GoString → PROP) (p : GoString) :
    gNo g p ⊢ g p := by
  unfold gNo gEx
  split
  · exact false_elim
  · exact .rfl

/-- The packages not yet initialized when `serverlib`'s initializer starts on a server machine
(`noPkgsS0`), after net/http's (`noPkgsS1`), after net/rpc's (`noPkgsS2`): `serverlib` is the
first package of the servers' programs to import net/http and net/rpc (`_gryff_boot.py` checks
it), and imports net/http before net/rpc. -/
def noPkgsS2 : List GoString := go!"gryff/src/serverlib" :: noPkgs
def noPkgsS1 : List GoString := pkg_id.net.rpc :: noPkgsS2
def noPkgsS0 : List GoString := pkg_id.net.http :: noPkgsS1

/-- After `serverlib`'s imports, only `noPkgs` are left. -/
theorem gEx_S2_le {PROP : Type _} [BI PROP] (g : GoString → PROP) (p : GoString) :
    gEx noPkgsS2 g p ⊢ gNo g p := by
  unfold gNo gEx noPkgsS2
  by_cases h : p ∈ noPkgs
  · rw [if_pos (List.mem_cons_of_mem _ h)]; exact false_elim
  · rw [if_neg h]
    split
    · exact false_elim
    · exact .rfl

/-- One more package excluded, as `RpcBootHyp`'s `gNoPkg`. -/
theorem gEx_cons_le {PROP : Type _} [BI PROP] (q : GoString) (S : List GoString)
    (g : GoString → PROP) (p : GoString) :
    gEx (q :: S) g p ⊢ gNoPkg q (gEx S g) p := by
  unfold gEx gNoPkg
  dsimp only
  by_cases h1 : p = q
  · subst h1; rw [if_pos List.mem_cons_self]; exact false_elim
  · rw [if_neg h1]
    by_cases h2 : p ∈ S
    · rw [if_pos (List.mem_cons_of_mem _ h2)]; exact false_elim
    · rw [if_neg (by simp [h1, h2]), if_neg h2]

section gen
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [GoGlobalContext]
variable {hlc : HasLC} {GF : BundledGFunctors} [hG : HeapGS hlc GF]
variable [GoSemanticsFunctions] [go.PreSemantics]

/-- `ownInitializing` is monotone in the predicates. -/
theorem ownInitializing_weaken (g1 g2 : GoString → IProp GF) (h : ∀ p, g1 p ⊢ g2 p) :
    ownInitializing g1 ⊢ ownInitializing g2 := by
  rw [ownInitializing_unseal]
  unfold ownInitializingDef
  iintro ⟨%σ, Hg, #Hinit⟩
  iexists σ
  iframe Hg
  iintro !>
  iapply BigSepM.bigSepM_mono (fun {k b} _ => ?_) $$ Hinit
  cases b
  · exact .rfl
  · exact h k

/-- No package initialized. -/
theorem ownInitializing_empty (g : GoString → IProp GF) :
    ownGoState ∅ ⊢ ownInitializing g := by
  rw [ownInitializing_unseal]
  unfold ownInitializingDef
  iintro Hg
  iexists ∅
  iframe Hg
  iintro !>
  iapply BigSepM.bigSepM_empty.2
  iempintro

/-- A package's initialization run from `ownInitializing g1` (whose predicate at the package is
`False`: it is not initialized yet), its body ending in `ownInitializing g2` with extra resources
`R`. -/
theorem wp_package_init_gen (pkg_name : GoString) [PkgInfo pkg_name] (f x : Binder) (body : Expr)
    (g1 g2 : GoString → IProp GF) (P R : IProp GF) (Φ : val → IProp GF)
    (heq : g2 pkg_name = P) (hno : g1 pkg_name ⊢ False) :
    let init_func := RecV f x body
    iprop(ownInitializing g1 ∗
      (ownInitializing g1 -∗
        WP (App (Val init_func) (Val #())) {{ v, ⌜v.isPanic = false⌝ ∗ □ P ∗
          ownInitializing g2 ∗ R }}))
    ⊢ iprop((ownInitializing g2 ∗ P ∗ R -∗ Φ #()) -∗
      WP (App (Val (package.init pkg_name)) (Val init_func)) {{ Φ }}) := by
  intro init_func
  have hinit : init_func.isPanic = false := rfl
  clear_value init_func
  subst heq
  rw [ownInitializing_unseal, package.init_unseal]
  unfold ownInitializingDef
  iintro ⟨Hown, Hpre⟩ HΦ
  wp_call
  icases Hown with ⟨%σ, Hg, #Hinit⟩
  wp_apply_core wp_PackageInitCheck pkg_name σ $$ Hg
  iintro Hg
  cases hσ : (σ !! pkg_name).getD false
  · wp_pures
    wp_apply_core wp_PackageInitStart pkg_name σ $$ Hg
    iintro Hg
    wp_pures
    ihave Hpre := Hpre $$ [Hg]
    · iexists (<[pkg_name := false]> σ)
      iframe Hg
      imodintro
      iapply BigSepM.bigSepM_insert_elim $$ [] Hinit
      simp only [Bool.false_eq_true, ↓reduceIte]
      itrivial
    wp_apply_core wp_wand $$ Hpre
    iintro %_ ⟨%Hnp, #Hinitd, Hown, HR⟩
    icases Hown with ⟨%σ', Hg, #Hinit'⟩
    wp_pures
    wp_apply_core wp_PackageInitFinish pkg_name σ' $$ Hg
    iintro Hg
    iapply HΦ
    iframe Hinitd HR
    iexists (<[pkg_name := true]> σ')
    iframe Hg
    imodintro
    iapply BigSepM.bigSepM_insert_elim $$ [] Hinit'
    simp only [↓reduceIte]
    iexact Hinitd
  · cases hl : σ !! pkg_name with
    | none => simp [hl] at hσ
    | some b =>
      simp [hl] at hσ
      subst hσ
      ihave Hx := BigSepM.bigSepM_lookup (Φ := fun k (b : Bool) =>
        if b then g1 k else iprop(True)) hl $$ Hinit
      simp only [↓reduceIte]
      iexfalso
      iapply hno $$ Hx

end gen

section defs
variable [GooseExts] [GooseSemantics] [GooseInterp]
variable [GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]

/-- **`gryff`'s mutable package variables**, owned by the replica (D3): `stack` an empty slice
of capacity 100 with its capacity, and the others some value. -/
@[irreducible] def gryffGlobals : IProp GF :=
  iprop((∃ s : GoSlice, globalAddr gryff.src.gryff.stack ↦ s ∗ s ↦* ([] : List Loc) ∗
      ownSliceCap Loc s (DFrac.own 1) ∗ ⌜0 < sint.Z s.cap ∧ sint.Z s.cap < 2 ^ 60⌝) ∗
    (∃ v : gryff.src.gryffproto.PreAccept, globalAddr gryff.src.gryff.pa ↦ v) ∗
    (∃ v : gryff.src.gryffproto.EAccept, globalAddr gryff.src.gryff.ea ↦ v) ∗
    (∃ v : gryff.src.gryffproto.ECommit, globalAddr gryff.src.gryff.ec ↦ v) ∗
    (∃ v : gryff.src.epaxosproto.CommitShort, globalAddr gryff.src.gryff.ecs ↦ v) ∗
    (∃ v : w64, globalAddr gryff.src.gryff.conflicted ↦ v) ∗
    (∃ v : w64, globalAddr gryff.src.gryff.happy ↦ v) ∗
    (∃ v : w64, globalAddr gryff.src.gryff.slow ↦ v) ∗
    (∃ v : w64, globalAddr gryff.src.gryff.weird ↦ v) ∗
    (∃ v : w64, globalAddr gryff.src.gryff.cpcounter ↦ v) ∗
    (∃ v : GoSlice, globalAddr gryff.src.gryff.cpMarker ↦ v) ∗
    (∃ v : gryff.src.gryffproto.TryPreAccept, globalAddr gryff.src.gryff.tpa ↦ v) ∗
    (∃ v : gryff.src.gryffproto.PreAcceptOKReply, globalAddr gryff.src.gryff.paokr ↦ v) ∗
    (∃ v : gryff.src.gryffproto.AcceptOKReply, globalAddr gryff.src.gryff.aokr ↦ v) ∗
    (∃ v : GoMap, globalAddr gryff.src.gryff.deferMap ↦ v) ∗
    (∃ v : w32, globalAddr gryff.src.gryff.bf_PT ↦ v))

open github_com.goose_lang.primitive (ProphId) in
/-- **The node's trace prophecy** as `gryff`'s `init()` leaves it: `traceProph` holds `p`,
unresolved (its values `pvs`). -/
def bootProph : IProp GF :=
  iprop(∃ (p : ProphId) (pvs : List val),
    globalAddr gryff.src.gryff.traceProph ↦ p ∗ proph p pvs)

end defs

section rpcboot
open Net
variable [GooseExts] [GooseSemantics] [GooseInterp] [HasExt netExt]
variable [GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]
variable [net.rpc.Assumptions] [net.FieldAssumptions] [π : NetProtoGS]
variable [RA : Perennial.gryff.RpcHttpAddr GF] [H : Perennial.gryff.RpcHttpHyp GF] [B : Perennial.gryff.RpcBootHyp GF]

open Perennial.gryff in
/-- net/http's owned initialization (`RpcBootHyp.wp_http_own`) in a table `gEx S0 g` with
`S0 = net/http :: S`. -/
theorem wp_http_own (S0 S : List GoString) (hS : S0 = pkg_id.net.http :: S) (g : GoString → IProp GF)
    (hwf : GetIsPkgInitProp pkg_id.net.http (gEx S g)) :
    {{ ownInitializing (gEx S0 g) }} (App (Val net.http.initialize') (Val #()))
    {{ RET #(); ownInitializing (gEx S g) ∗ isPkgInit (PROP := IProp GF) pkg_id.net.http ∗
        httpInitRes (GF := GF) }} := by
  subst hS
  iintro %Φ Hown HΦ
  ihave Hown := ownInitializing_weaken _ _ (gEx_cons_le pkg_id.net.http S g) $$ Hown
  iapply B.wp_http_own (gEx S g) hwf $$ Hown HΦ

open Perennial.gryff in
/-- net/rpc's owned initialization (`RpcBootHyp.wp_init_own`) in a table `gEx S0 g` with
`S0 = net/rpc :: S`. -/
theorem wp_rpc_own (S0 S : List GoString) (hS : S0 = pkg_id.net.rpc :: S) (g : GoString → IProp GF)
    (hwf : GetIsPkgInitProp pkg_id.net.rpc (gEx S g)) :
    {{ ownInitializing (gEx S0 g) }} (App (Val net.rpc.initialize') (Val #()))
    {{ RET #(); ownInitializing (gEx S g) ∗ isPkgInit (PROP := IProp GF) pkg_id.net.rpc ∗
        rpcInitRes (GF := GF) }} := by
  subst hS
  iintro %Φ Hown HΦ
  ihave Hown := ownInitializing_weaken _ _ (gEx_cons_le pkg_id.net.rpc S g) $$ Hown
  iapply B.wp_init_own (gEx S g) hwf $$ Hown HΦ

end rpcboot

end gryff.boot

end Perennial
