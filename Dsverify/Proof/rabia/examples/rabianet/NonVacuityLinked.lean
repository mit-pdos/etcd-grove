/-
**Test only** (the NON-VACUITY rule; kitgen's `NonVacuityLinked.lean`): every hypothesis-class
premise of rabia's statement (`Dsverify/Spec/rabia/examples/rabianet/TopLevelRobustness.lean`) has
an instance, built as a `theorem` (no `instance` of an `InitHyp` anywhere: etc/dsv/README.md):
* go-redis v8's `InitHyp` (its initializer kept a premise, dsv-fix3): its initializer's walk
  (`Dsverify/Proof/github_com/go_redis/redis/v8/InitInstancesLinked.lean`, generated by
  `etc/dsv/tools/inithyp-instances.py`), over local axioms for its names-only initializers;
* `zerolog.Hyps` (kept a premise, dsv-fix4: its axiom review refuted `New` with `Msg`,
  `notes/axiom-review/dsv-fix4/zerolog.md`): here, each field a **local axiom**, the class's own
  statement, as before dsv-fix4.
(Until dsv-fix4 also gogo `proto.Hyps`, `math.rand.Hyps` and `os.signal.NoSignals quietSigs`: they
are per-function trust-boundary axioms now, and the proof discharges them.) No statement or proof
imports this module: its local axioms are in no trust base.
-/
module

public import Dsverify.Spec.rabia.examples.rabianet.TopLevelRobustness
public import Dsverify.Proof.github_com.go_redis.redis.v8.InitInstancesLinked

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial
namespace rabia.examples.rabianet.instances

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

section axioms
variable [GooseExts] [GooseSemantics] [GooseInterp] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]
variable [github_com.rs.zerolog.Assumptions]

/-- Real zerolog's event token: `e` is `nil`, or a pooled `*Event` of one of the five levels that
its holder alone uses (`Spec.lean`'s header). Opaque. -/
opaque eventTok : Loc → IProp GF := fun _ => iprop(True)

/-- **Local axiom (test-only)**: zerolog's event specs over its token (`EventSpecs`' fields, each
argued in `Spec.lean`). -/
axiom local_zerolog_events : github_com.rs.zerolog.EventSpecs GF (eventTok (GF := GF))

/-- **Local axiom (test-only)**: `ParseLevel("warn")` is `(WarnLevel, nil)`. -/
axiom local_zerolog_ParseLevel_warn : github_com.rs.zerolog.ParseLevel.warn.spec (GF := GF)

/-- **Local axiom (test-only)**: `SetGlobalLevel(l)` returns (an atomic store of the level). -/
axiom local_zerolog_SetGlobalLevel : github_com.rs.zerolog.SetGlobalLevel.spec (GF := GF)

/-- **Local axiom (test-only)**: `New(w)` returns some logger (a struct value). -/
axiom local_zerolog_New : github_com.rs.zerolog.New.spec (GF := GF)

theorem zerolog_hyps_holds : github_com.rs.zerolog.Hyps GF :=
  ⟨⟨eventTok, local_zerolog_events⟩, local_zerolog_ParseLevel_warn, local_zerolog_SetGlobalLevel,
    local_zerolog_New⟩

end axioms

section statement
open github_com.mit_pdos.etcd_grove.examples.lib.remote.counter (remoteGF)
attribute [local instance] Net.netExts Net.netExtsSemantics Net.netExtsInterp Net.netExts_hasNet
variable [GoGlobalContext] [lctx : GoLocalContext] [go.Semantics]
variable [github_com.go_redis.redis.v8.Assumptions] [github_com.rs.zerolog.Assumptions]

/-- **The non-vacuity instance** (the NON-VACUITY rule): rabia's hypothesis-class premises, in the
statement's own form (`rabia_remote_robust.spec`: at `remoteGF` and every machine's heap). -/
theorem nonvacuous_premises : ∀ G L, letI := heapAt G L;
    github_com.go_redis.redis.v8.InitHyp remoteGF ∧ github_com.rs.zerolog.Hyps remoteGF := by
  intro G L
  exact ⟨github_com.go_redis.redis.v8.initHyp_holds (GF := remoteGF) (hG := heapAt G L),
    zerolog_hyps_holds (GF := remoteGF) (hG := heapAt G L)⟩

end statement

end rabia.examples.rabianet.instances
end Perennial
