/-
**Test only** (the NON-VACUITY rule; math-rand-isinit, 2026-11-24; kitgen's `NonVacuityLinked.lean`): every hypothesis-class premise
of rabia's statement (`Dsverify/Spec/rabia/examples/rabianet/TopLevelRobustness.lean`) has an
instance, built as a `theorem` (no `instance` of an `InitHyp` anywhere: etc/dsv/README.md):
* go-redis v8's `InitHyp` (the initializer kept a premise, dsv-fix3): its initializer's walk
  (`Dsverify/Proof/github_com/go_redis/redis/v8/InitInstancesLinked.lean`, generated by
  `etc/dsv/tools/inithyp-instances.py`), over local axioms for its names-only initializers;
* `math.rand.Hyps`: `Dsverify/Proof/math/rand/RandsInstancesLinked.lean` (`(*Rand).Intn` proved,
  `NewSource`/`New`/`(*rngSource).Int63` local axioms);
* `zerolog.Hyps`, gogo `proto.Hyps`, `os.signal.NoSignals quietSigs`: here, each field a **local
  axiom** (the functions are names only in the part: no model, no proved spec), each the class's
  own statement, whose docstrings argue it of the real library (`Spec.lean` of each package).
No statement or proof imports this module: its local axioms are in no trust base.
-/
module

public import Dsverify.Spec.rabia.examples.rabianet.TopLevelRobustness
public import Dsverify.Proof.github_com.go_redis.redis.v8.InitInstancesLinked
public import Dsverify.Proof.math.rand.RandsInstancesLinked

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial
namespace rabia.examples.rabianet.instances

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode

section axioms
variable [GooseExts] [GooseSemantics] [GooseInterp] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]

/-! ### zerolog (`Dsverify/Proof/github_com/rs/zerolog/Spec.lean`) -/

/-- Real zerolog's event token: `e` is `nil`, or a pooled `*Event` of one of the five levels that
its holder alone uses (`Spec.lean`'s header). Opaque. -/
opaque eventTok : Loc → IProp GF := fun _ => iprop(True)

section zl
variable [github_com.rs.zerolog.Assumptions]

/-- **Local axiom (test-only)**: zerolog's event specs over its token (`EventSpecs`' fields, each
argued in `Spec.lean`). -/
axiom local_zerolog_events : github_com.rs.zerolog.EventSpecs GF (eventTok (GF := GF))

/-- **Local axiom (test-only)**: `ParseLevel("warn")` is `(WarnLevel, nil)`. -/
axiom local_zerolog_ParseLevel_warn : github_com.rs.zerolog.ParseLevel.warn.spec (GF := GF)

/-- **Local axiom (test-only)**: `SetGlobalLevel(l)` returns (an atomic store of the level). -/
axiom local_zerolog_SetGlobalLevel : github_com.rs.zerolog.SetGlobalLevel.spec (GF := GF)

/-- **Local axiom (test-only)**: `New(w)` returns some logger (a struct value). -/
axiom local_zerolog_New : github_com.rs.zerolog.New.spec (GF := GF)

theorem zerolog_hyps_holds : github_com.rs.zerolog.Hyps GF :=
  ⟨⟨eventTok, local_zerolog_events⟩, local_zerolog_ParseLevel_warn, local_zerolog_SetGlobalLevel,
    local_zerolog_New⟩

end zl

/-! ### gogo `proto` (`Dsverify/Proof/github_com/gogo/protobuf/proto/Spec.lean`) -/

/-- **Local axiom (test-only)**: `RegisterEnum("message.MsgType", ...)`, inside `message`'s
initialization, once (`Spec.lean`: it writes `enumValueMaps` and returns; a second registration of
the name panics, which the consumed `MsgType_value` points-to excludes). -/
axiom local_proto_RegisterEnum : ∀ (σ : GMap GoString Bool) (nameMap valueMap : Loc),
    {{ (ownGoState σ : IProp GF) ∗
        globalAddr rabia.internal.message.MsgType_value ↦ valueMap }}
      (App (App (App (Val #(functions github_com.gogo.protobuf.proto.RegisterEnum []))
        (Val #(go!"message.MsgType"))) (Val #nameMap)) (Val #valueMap))
    {{ RET #(); ownGoState σ }}

/-- **Local axiom (test-only)**: `RegisterType(x, name)` on a non-`nil` interface writes its registry
maps and returns (a duplicate is logged, not a panic; a `nil` interface panics). -/
axiom local_proto_RegisterType : ∀ (σ : GMap GoString Bool) (x : GoInterface) (name : GoString),
    {{ ⌜x ≠ interface.nil⌝ ∗ (ownGoState σ : IProp GF) }}
      (App (App (Val #(functions github_com.gogo.protobuf.proto.RegisterType [])) (Val #x)) (Val #name))
    {{ RET #(); ownGoState σ }}

/-- **Local axiom (test-only)**: `RegisterFile(filename, descriptor)` writes `protoFiles` and
returns. -/
axiom local_proto_RegisterFile : ∀ (σ : GMap GoString Bool) (filename : GoString) (descriptor : GoSlice),
    {{ (ownGoState σ : IProp GF) }}
      (App (App (Val #(functions github_com.gogo.protobuf.proto.RegisterFile [])) (Val #filename))
        (Val #descriptor))
    {{ RET #(); ownGoState σ }}

theorem proto_hyps_holds : github_com.gogo.protobuf.proto.Hyps GF :=
  ⟨local_proto_RegisterEnum, local_proto_RegisterType, local_proto_RegisterFile⟩

/-! ### `os/signal` (`Dsverify/Proof/os/signal/Spec.lean`) -/

section sig
variable [HasExt Net.netExt]

/-- **Local axiom (test-only; the environment assumption)**: nobody sends SIGINT or SIGTERM to the
deployment's processes, so `Notify(c, SIGINT, SIGTERM)` registers a channel that never receives
(`Spec.lean`'s `NoSignals`). -/
axiom local_notifyQuiet : os.signal.NotifyQuiet.spec (GF := GF) os.signal.quietSigs

theorem noSignals_holds : os.signal.NoSignals os.signal.quietSigs GF := ⟨local_notifyQuiet⟩

end sig

end axioms

/-! ### The premises together -/

section bundle
variable [GooseExts] [GooseSemantics] [GooseInterp] [HasExt Net.netExt] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]
variable [github_com.rs.zerolog.Assumptions] [github_com.gogo.protobuf.proto.Assumptions]
  [github_com.gogo.protobuf.gogoproto.Assumptions] [github_com.go_redis.redis.v8.Assumptions]
  [os.signal.Assumptions] [math.rand.Assumptions]

/-- **rabia's hypothesis-class premises hold**, in the statement's order, at every heap (the
statement takes each at `remoteGF` and every machine's heap `heapAt G L`). -/
theorem premises_hold :
    github_com.gogo.protobuf.proto.Hyps GF ∧ github_com.go_redis.redis.v8.InitHyp GF ∧
    github_com.rs.zerolog.Hyps GF ∧ math.rand.Hyps GF ∧
    os.signal.NoSignals os.signal.quietSigs GF :=
  ⟨proto_hyps_holds, github_com.go_redis.redis.v8.initHyp_holds, zerolog_hyps_holds, math.rand.instances.hyps_holds, noSignals_holds⟩

end bundle

/-! ### At the statement's heaps -/

section statement
open github_com.mit_pdos.etcd_grove.examples.lib.remote.counter (remoteGF)
attribute [local instance] Net.netExts Net.netExtsSemantics Net.netExtsInterp Net.netExts_hasNet
variable [GoGlobalContext] [lctx : GoLocalContext] [go.Semantics]
variable [github_com.rs.zerolog.Assumptions] [github_com.gogo.protobuf.proto.Assumptions]
  [github_com.gogo.protobuf.gogoproto.Assumptions] [github_com.go_redis.redis.v8.Assumptions]
  [os.signal.Assumptions] [math.rand.Assumptions]

/-- **The non-vacuity instance** (the NON-VACUITY rule): rabia's hypothesis-class premises, in the
statement's own form (`rabia_remote_robust.spec`: each at `remoteGF` and every machine's heap). -/
theorem nonvacuous_premises : ∀ G L, letI := heapAt G L;
    github_com.gogo.protobuf.proto.Hyps remoteGF ∧ github_com.go_redis.redis.v8.InitHyp remoteGF ∧
    github_com.rs.zerolog.Hyps remoteGF ∧ math.rand.Hyps remoteGF ∧
    os.signal.NoSignals os.signal.quietSigs remoteGF := by
  intro G L
  exact premises_hold (GF := remoteGF) (hG := heapAt G L)

end statement

end rabia.examples.rabianet.instances
end Perennial
