/-
**Test only** (the NON-VACUITY rule; math-rand-isinit, 2026-11-24; kitgen's `NonVacuityLinked.lean` name): every hypothesis-class premise
of QuePaxa's statement (`Dsverify/Spec/raxos/examples/quepaxanet/TopLevelRobustness.lean`) has an
instance, built as a `theorem` (no `instance` of an `InitHyp` anywhere: etc/dsv/README.md):
* the `InitHyp`s of go-redis v8 and grpc (the two initializers kept premises, dsv-fix3): their
  initializers' walks (`Dsverify/Proof/<pkg>/InitInstancesLinked.lean`, generated by
  `etc/dsv/tools/inithyp-instances.py`), over local axioms for their names-only initializers;
* a vocabulary `qv` (the statement quantifies over it): **local axioms** declaring real gRPC's and
  `sync.Map`'s representation predicates (`local_grpcV`, `local_mapOwn`) and `sync.Map`'s typed
  points-to (`local_syncMap_tp`);
* the hypothesis classes `PbHyp` (kept a premise: its axiom review refuted it), `grpc.GrpcHyp qv.grpc`, `grpc.GrpcWorldHyp qv.grpc`, `sync.MapHyp
  qv.map`: each field a **local axiom** (every function they specify is names only: grpc (the
  part's own), `sync.Map`'s methods (Perennial's)), each the class's own statement, argued of the
  real library in `Dsverify/Proof/raxos/Hyp.lean`. (Until dsv-fix4 also `RandHyp`,
  `UtcHyp`, `SortHyp`, `PrintlnHyp`: per-function trust-boundary axioms now, which the proof
  discharges them from.)
  One field is about Perennial's model, not Go's library: `MapHyp.ivt` (`sync.Map`'s memory respects
  the points-to `tp`). Perennial's own instances of it are `sorry` (`internal/sync.HashTrieMap` is an
  axiomatized type; `Hyp.lean`, `StoreInst.lean`): `local_syncMap_ivt` restates them.
No statement or proof imports this module: its local axioms are in no trust base.
-/
module

public import Dsverify.Spec.raxos.examples.quepaxanet.TopLevelRobustness
public import Dsverify.Proof.github_com.go_redis.redis.v8.InitInstancesLinked
public import Dsverify.Proof.google_golang_org.grpc.InitInstancesLinked

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Perennial
namespace raxos.examples.quepaxanet.instances

open Iris Iris.BI Iris.ProgramLogic Iris.Std Iris.ProofMode Net
open _root_.Perennial.raxos.hyp

/-! ### The vocabulary -/

section vocab
variable [GooseExts]
variable {GF : BundledGFunctors}

/-- **Local axiom (test-only)**: real gRPC's representation predicates (the vocabulary
`GrpcVocab`'s fields: protocols of an address, a world's registry, a server and its tokens, a client
connection, a handler's error, the credentials option), which the lab's model defined. -/
axiom local_grpcV : grpc.GrpcVocab GF

/-- Real `sync.Map`'s contents predicate (exclusive; opaque). -/
opaque local_mapOwn : Loc → GMap GoString GoInterface → IProp GF := fun _ _ => iprop(True)

/-- **Local axiom (test-only; about Perennial's model)**: a typed points-to of `sync.Map` (as
Perennial's generated one, over `internal/sync.HashTrieMap`'s `sorry` instance). -/
axiom local_syncMap_tp : TypedPointsto (GF := GF) Perennial.sync.Map

/-- **The vocabulary** the instances below are about (it depends on no heap: the statement takes
one `qv` for every machine's heap). -/
def local_qv : QpVocab GF := ⟨local_grpcV, ⟨local_mapOwn, local_syncMap_tp⟩⟩

end vocab

/-! ### The hypotheses' fields -/

section axioms
variable [GooseExts] [GooseSemantics] [GooseInterp] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]

/-- **Local axiom (test-only)**: protobuf's `Marshal` of QuePaxa's messages (`Hyp.lean`). -/
axiom local_pb_Marshal : proto.Marshal.spec (GF := GF)
/-- **Local axiom (test-only)**: protobuf's `Unmarshal` into QuePaxa's messages (`Hyp.lean`). -/
axiom local_pb_Unmarshal : proto.Unmarshal.spec (GF := GF)
theorem pb_holds : PbHyp GF := ⟨local_pb_Marshal, local_pb_Unmarshal⟩

section grpc
variable [HasExt netExt] [π : NetProtoGS]
local instance qpCd : models_lab.pbcodec.PbCodec GF := qpCodec

/-- **Local axioms (test-only)**: grpc's unary path over the vocabulary (`Hyp.lean`'s
`GrpcHyp` fields, argued there of grpc-go). -/
axiom local_grpc_NewServer : grpc.NewServer.spec (local_grpcV (GF := GF))
axiom local_grpc_RegisterService : grpc.Server.RegisterService.spec (local_grpcV (GF := GF))
axiom local_grpc_Serve : grpc.Server.Serve.spec (local_grpcV (GF := GF))
axiom local_grpc_WithInsecure : grpc.WithInsecure.spec (local_grpcV (GF := GF))
axiom local_grpc_Dial : grpc.Dial.spec (local_grpcV (GF := GF))
axiom local_grpc_Invoke : grpc.ClientConn.Invoke.spec (local_grpcV (GF := GF))

theorem grpc_holds : grpc.GrpcHyp (cd := qpCodec) (local_qv (GF := GF)).grpc :=
  ⟨local_grpc_NewServer, local_grpc_RegisterService, local_grpc_Serve, local_grpc_WithInsecure,
    local_grpc_Dial, local_grpc_Invoke⟩

end grpc

/-- **Local axiom (test-only; about Perennial's model)**: `sync.Map`'s memory respects
`local_syncMap_tp` (Perennial's `sorry` instances of `internal/sync.HashTrieMap`, restated). -/
axiom local_syncMap_ivt : @IntoValTypedUnderlying _ _ _ _ HasLC.hasLC GF hG Perennial.sync.Map
    Perennial.sync.Map.underlying _ (local_syncMap_tp (GF := GF)) _

/-- **Local axiom (test-only)**: `sync.Map`'s contents predicate is timeless. -/
axiom local_mapOwn_timeless : ∀ (m : Loc) (M : GMap GoString GoInterface),
  Timeless (local_mapOwn (GF := GF) m M)

/-- **Local axiom (test-only)**: a zero `sync.Map` holds nothing. -/
axiom local_mapOwn_zero : ∀ m : Loc,
  ⊢ @typedPointsto GF _ (local_syncMap_tp (GF := GF)) m (zero_val Perennial.sync.Map) (DFrac.own 1) ==∗
    local_mapOwn (GF := GF) m ∅

/-- **Local axioms (test-only)**: `sync.Map`'s `Load`/`Store`/`Delete` with string keys,
logically atomic (`Hyp.lean`; `sync.Map` is safe for concurrent use). -/
axiom local_map_Load : sync.Map.Load.spec (local_qv (GF := GF)).map
axiom local_map_Store : sync.Map.Store.spec (local_qv (GF := GF)).map
axiom local_map_Delete : sync.Map.Delete.spec (local_qv (GF := GF)).map

theorem map_holds : sync.MapHyp (local_qv (GF := GF)).map :=
  ⟨local_syncMap_ivt, local_mapOwn_timeless, local_mapOwn_zero, local_map_Load, local_map_Store,
    local_map_Delete⟩

end axioms

section world
variable [GooseExts] [GooseInterp] {GF : BundledGFunctors}
attribute [local instance] GooseGlobalGS.gooseInvGS

/-- **Local axiom (test-only)**: a world's registry can be allocated, for any method specs (the
lab's `world_alloc`, a ghost allocation in its model). -/
axiom local_world_alloc [Gg : GooseGlobalGS HasLC.hasLC GF] :
  ∀ (MS : GoString → GoString → Option (grpc.UnarySpec GF)) (E : CoPset),
    ⊢ |={E}=> ∃ reg : GName, (local_grpcV (GF := GF)).worldOk ⟨MS, reg⟩

theorem world_holds [Gg : GooseGlobalGS HasLC.hasLC GF] :
    grpc.GrpcWorldHyp (Gg := Gg) (local_grpcV (GF := GF)) :=
  ⟨local_world_alloc⟩

end world

/-! ### The premises together -/

section bundle
variable [GooseExts] [GooseSemantics] [GooseInterp] [HasExt netExt] [go_gctx : GoGlobalContext]
variable {GF : BundledGFunctors} [hG : HeapGS HasLC.hasLC GF] [sem : go.Semantics]
variable [_root_.Perennial.github_com.go_redis.redis.v8.Assumptions]
  [_root_.Perennial.google_golang_org.grpc.Assumptions]

/-- **QuePaxa's hypothesis-class premises hold**, in the statement's order, at every heap and
every global ghost state, for the vocabulary `local_qv` (the statement takes each at `remoteGF` and
every machine's heap `heapAt G L`). -/
theorem premises_hold :
    _root_.Perennial.github_com.go_redis.redis.v8.InitHyp GF ∧
    _root_.Perennial.google_golang_org.grpc.InitHyp GF ∧ PbHyp GF ∧
    (∀ [NetProtoGS], grpc.GrpcHyp (cd := qpCodec) (local_qv (GF := GF)).grpc) ∧
    (∀ G : GooseGlobalGS HasLC.hasLC GF, grpc.GrpcWorldHyp (Gg := G) (local_qv (GF := GF)).grpc) ∧
    sync.MapHyp (local_qv (GF := GF)).map :=
  ⟨_root_.Perennial.github_com.go_redis.redis.v8.initHyp_holds,
    _root_.Perennial.google_golang_org.grpc.initHyp_holds, pb_holds,
    fun {_} => grpc_holds, fun G => world_holds (Gg := G), map_holds⟩

end bundle

/-! ### At the statement's heaps -/

section statement
open github_com.mit_pdos.etcd_grove.examples.lib.remote.counter (remoteGF)
attribute [local instance] netExts netExtsSemantics netExtsInterp netExts_hasNet
variable [GoGlobalContext] [lctx : GoLocalContext] [go.Semantics]
variable [_root_.Perennial.github_com.go_redis.redis.v8.Assumptions]
  [_root_.Perennial.google_golang_org.grpc.Assumptions]

/-- **The non-vacuity instance** (the NON-VACUITY rule): QuePaxa's hypothesis-class premises, in the
statement's own form (`quepaxa_remote_robust.spec`), for the vocabulary `local_qv`. -/
theorem nonvacuous_premises :
    (∀ G L, letI := heapAt G L;
      _root_.Perennial.github_com.go_redis.redis.v8.InitHyp remoteGF ∧
      _root_.Perennial.google_golang_org.grpc.InitHyp remoteGF ∧ PbHyp remoteGF ∧
      (∀ [NetProtoGS], grpc.GrpcHyp (cd := qpCodec) (local_qv (GF := remoteGF)).grpc) ∧
      sync.MapHyp (local_qv (GF := remoteGF)).map) ∧
    (∀ G : GooseGlobalGS HasLC.hasLC remoteGF, grpc.GrpcWorldHyp (Gg := G) (local_qv (GF := remoteGF)).grpc) := by
  refine ⟨fun G L => ?_, fun G => world_holds (Gg := G)⟩
  obtain ⟨h2, h5, h7, h12, -, h14⟩ := premises_hold (GF := remoteGF)
    (hG := heapAt G L)
  exact ⟨h2, h5, h7, h12, h14⟩

end statement

end raxos.examples.quepaxanet.instances
end Perennial
