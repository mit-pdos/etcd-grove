+// createMayHaveSucceeded reports whether a failed pod create may nonetheless
+// have been committed by the API server: any error but a 4xx status, which
+// the server sends only for a request it rejected. A 5xx (a 504 from the
+// request timeout, a 500 from an etcd timeout), a client-side timeout or a
+// broken connection leave the outcome unknown.
+func createMayHaveSucceeded(err error) bool {
+	var status apierrors.APIStatus
+	if errors.As(err, &status) {
+		code := status.Status().Code
+		return code < 400 || code >= 500
+	}
+	return true
+}
+
+// recordUnknownPodWrites follows pod creates whose outcome is unknown: it
+// lists the DaemonSet's pods from the API server (a quorum read) and records
+// the newest resource version of those it controls in the consistency store,
+// so that the next sync waits until the pod informer has seen every pod that
+// exists now, including one an ambiguous create committed. (A create the
+// server commits after this list, which its request timeout allows, is not
+// covered.)
+func (dsc *DaemonSetsController) recordUnknownPodWrites(ctx context.Context, ds *apps.DaemonSet) error {
+	selector, err := metav1.LabelSelectorAsSelector(ds.Spec.Selector)
+	if err != nil {
+		return err
+	}
+	pods, err := dsc.kubeClient.CoreV1().Pods(ds.Namespace).List(ctx, metav1.ListOptions{LabelSelector: selector.String()})
+	if err != nil {
+		return err
+	}
+	owner := types.NamespacedName{Namespace: ds.Namespace, Name: ds.Name}
+	for i := range pods.Items {
+		pod := &pods.Items[i]
+		if ref := metav1.GetControllerOf(pod); ref != nil && ref.UID == ds.UID {
+			dsc.consistencyStore.WroteAt(owner, ds.UID, podGroupResource, pod.ResourceVersion)
+		}
+	}
+	return nil
+}
