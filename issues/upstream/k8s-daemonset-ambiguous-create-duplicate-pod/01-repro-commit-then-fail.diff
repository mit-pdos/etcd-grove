 		Namespace:   info.Namespace,
 		Name:        info.Name,
 	}); httpErr != nil {
+		if httpErr.AfterCommit {
+			// Forward the request; whatever the server did stays done, but
+			// the caller only sees the injected error.
+			resp, err := t.realTransport.RoundTrip(req)
+			if err != nil {
+				return nil, err
+			}
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+			return synthesizeResponse(*httpErr)
+		}
 		if req.Body != nil {
 			_ = req.Body.Close()
 		}
