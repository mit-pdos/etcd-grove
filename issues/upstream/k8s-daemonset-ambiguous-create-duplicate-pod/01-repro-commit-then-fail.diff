+
+	// AfterCommit makes the fault ambiguous: the request is forwarded to the
+	// API server (which may commit it) and its response is replaced by this
+	// error, as when a response is lost or the request times out after the
+	// write was applied. A client cannot tell the two cases apart.
+	AfterCommit bool
 }
 
 func (e HTTPStatusError) Error() string {
@@ -69,6 +75,13 @@ func NewHTTPStatusError(statusCode int, reason metav1.StatusReason, message stri
 	}
 }
 
+// CommitThenFail returns err as an ambiguous fault: the request reaches the
+// API server, and the client sees err instead of the server's response.
+func CommitThenFail(err HTTPStatusError) HTTPStatusError {
+	err.AfterCommit = true
+	return err
+}
+
 // FaultInjectingTransport wraps http.RoundTripper and triggers faults on matching REST API calls.
 type FaultInjectingTransport struct {
 	realTransport http.RoundTripper
