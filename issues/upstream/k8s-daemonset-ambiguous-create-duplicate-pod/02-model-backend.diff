+// The model backend's counterpart of FaultInjectingTransport: a clientset
+// wrapper that, per call, builds the ClientFacts the transport would build
+// for the HTTP request client-go sends for that call (method, group,
+// resource, subresource, namespace, name), records mutations for the settle
+// detector, resolves the registry, and turns an HTTPStatusError into the
+// *apierrors.StatusError client-go would decode from the synthesized
+// response. An AfterCommit error first calls through. Watches are wrapped to
+// resolve every event, as watchEventReader does.
+//
+// Only the resources and methods the DaemonSet controller and its informers
+// use are wrapped; other calls go straight to the model (which panics on
+// what it does not implement).
+
+func newFaultInjectingClientset(inner clientset.Interface, registry *FaultRegistry, activity *activityTracker) clientset.Interface {
+	return &faultClientset{Interface: inner, f: faultSite{registry: registry, activity: activity}}
+}
+
+// faultSite holds what every wrapped call needs.
+type faultSite struct {
+	registry *FaultRegistry
+	activity *activityTracker
+}
+
+func statusError(e HTTPStatusError) error {
+	status := e.Status
+	if status.Code == 0 {
+		status.Code = int32(e.StatusCode)
+	}
+	return &apierrors.StatusError{ErrStatus: status}
+}
+
+// do runs call as the REST request facts describes.
+func (s faultSite) do(ctx context.Context, facts ClientFacts, call func() error) error {
+	switch facts.Verb {
+	case http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete:
+		s.activity.recordMutation()
+	}
+	if e := s.registry.ResolveTransport(ctx, facts); e != nil {
+		if e.AfterCommit {
+			_ = call()
+		}
+		return statusError(*e)
+	}
+	return call()
+}
+
+// watch opens a watch through open and resolves the registry per event.
+func (s faultSite) watch(ctx context.Context, facts ClientFacts, open func() (watch.Interface, error)) (watch.Interface, error) {
+	w, err := open()
+	if err != nil {
+		return nil, err
+	}
+	fw := &faultWatch{inner: w, ch: make(chan watch.Event), stop: make(chan struct{})}
+	facts.Verb = VerbWatch
+	go fw.run(ctx, s.registry, facts)
+	return fw, nil
+}
+
+type faultWatch struct {
+	inner watch.Interface
+	ch    chan watch.Event
+	stop  chan struct{}
+	once  sync.Once
+}
+
+func (w *faultWatch) run(ctx context.Context, registry *FaultRegistry, facts ClientFacts) {
+	defer close(w.ch)
+	for {
+		var ev watch.Event
+		var ok bool
+		select {
+		case ev, ok = <-w.inner.ResultChan():
+			if !ok {
+				return
+			}
+		case <-w.stop:
+			return
+		}
+		f := facts
+		if m, err := meta.Accessor(ev.Object); err == nil {
+			f.Name = m.GetName()
+			f.Namespace = m.GetNamespace()
+		}
+		registry.ResolveWatchEvent(ctx, f)
+		select {
+		case w.ch <- ev:
+		case <-w.stop:
+			return
+		}
+	}
+}
+
+func (w *faultWatch) ResultChan() <-chan watch.Event { return w.ch }
+
+func (w *faultWatch) Stop() {
+	w.once.Do(func() { close(w.stop) })
+	w.inner.Stop()
+}
