index 00000000..1f33d5bd
--- /dev/null
+++ b/test/utils/robustness/apimodel/doc.go
@@ -0,0 +1,109 @@
+// This package is copied unchanged (except this paragraph) from
+// github.com/mit-pdos/etcd-grove, examples/k8sdaemonset/apimodel, where it is
+// the trusted model of the API server for a verification of the DaemonSet
+// controller; references to notes/ are to that repository. The robustness
+// fixture runs over it with KUBE_ROBUSTNESS_BACKEND=model.
+
+// Package apimodel is a model of the Kubernetes API server behind client-go's clientset
+// (k8s.io/client-go/kubernetes.Interface), for running the real DaemonSet controller and
+// client-go's informers against it. It covers only what the DaemonSet controller and its
+// informers call (notes/k8s-daemonset-plan.md, D49, D50).
+//
+// The model is part of the trusted computing base: a theorem about a program that runs over it
+// is a theorem about the real controller only insofar as this package behaves like
+// kube-apiserver. Its code is written to be read, by people comparing it with the API server
+// and by the proofs that step through it: one lock, plain maps, one append-only change log per
+// resource, and nondeterminism only through math/rand's Int63n (Config says where).
+//
+// # State
+//
+// One Server holds, per resource (pods, nodes, daemonsets, controllerrevisions), the stored
+// objects keyed by namespace and name, and the log of every change to the resource. Resource
+// versions are global, as etcd's revisions are: every change takes the next number, its string
+// form (strconv.FormatUint in base 10, injective) is written into the stored object, and the model
+// keeps the numbers it issued by string, so it never parses a resource version.
+//
+// # Operations (at client-go's signatures)
+//
+//   - Create: the object is copied; a namespaced object gets the request's namespace (a
+//     different one is a 400); an empty name is generated from GenerateName (the prefix and a
+//     fresh number; kube-apiserver uses random characters), an empty name and GenerateName are a
+//     400; a set ResourceVersion is a 400; an existing name is a 409 AlreadyExists. The server
+//     sets the UID, CreationTimestamp and ResourceVersion, then applies the resource's create
+//     strategy (below).
+//   - Get: a copy of the stored object, or 404.
+//   - List: copies of the objects in the namespace (all namespaces for ""), in an arbitrary
+//     order (kube-apiserver: by key), with ListMeta.ResourceVersion the current resource
+//     version: a consistent snapshot, whatever ResourceVersion the request gives (a list may be
+//     served at any version at least the one requested; the newest always qualifies). Limit is
+//     ignored and no continue token is returned (a server may ignore Limit). Label and field
+//     selectors are rejected with a 400 (nothing here uses them).
+//   - Watch: every change to the resource after the requested version, in order (a Deleted
+//     event carries the object's last state at the deletion's version). For "" or "0", the
+//     current objects as Added events, then every later change. An unknown version (not issued
+//     by this server) is a 410 Expired, as for a compacted one; with Config.ExpireWatches an
+//     issued but old version may be too. With AllowWatchBookmarks and Config.Bookmarks, a watch
+//     that has sent every change may send a Bookmark at the current version. With
+//     Config.EndWatches the server may end a watch at any point (close its channel), as a real
+//     server does on a timeout or restart; client-go's reflector then watches again from the
+//     last version it saw. SendInitialEvents (the watch-list mode) is a 400: run the informers
+//     with client-go's WatchListClient off.
+//   - Update (controllerrevisions) and UpdateStatus (daemonsets): 404 if the object is gone, 409
+//     Conflict if the request's ResourceVersion is set and is not the stored one (an empty one is
+//     an unconditional update, which both resources' strategies allow). The stored object's
+//     identity (name, namespace, UID, CreationTimestamp) is kept. UpdateStatus replaces only the
+//     status (the status strategy keeps the stored spec; this model also keeps the stored
+//     metadata); an UpdateStatus that leaves the status unchanged writes nothing and returns the
+//     stored object at its current version, as kube-apiserver skips no-op writes. Update always
+//     writes (kube-apiserver would skip an unchanged object; the DaemonSet controller does not
+//     reach Update).
+//   - Delete: 404 if the object is gone; 409 if DeleteOptions.Preconditions (UID,
+//     ResourceVersion) do not hold. A pod is deleted gracefully (kept, with DeletionTimestamp
+//     and DeletionGracePeriodSeconds set, a Modified event) when it is bound to a node, has not
+//     finished, and its grace period (the options', else the pod's
+//     TerminationGracePeriodSeconds) is positive, as pod's CheckGracefulDelete decides; with no
+//     kubelet in the model it then stays. An object with finalizers is likewise kept with
+//     DeletionTimestamp set. Otherwise it is removed (a Deleted event). Deleting an object that
+//     is already being deleted changes nothing.
+//   - Events (core/v1): accepted and dropped (the controller's event recorder writes them; no
+//     one reads them).
+//
+// Every other method of client-go's interfaces is absent: the clients embed client-go's
+// interfaces with a nil value, so calling one panics, and a no-panic theorem shows none is
+// called.
+//
+// # Create strategies (what kube-apiserver does to a created object)
+//
+//   - DaemonSet: the defaults of SetDefaults_DaemonSet (k8s.io/kubernetes/pkg/apis/apps/v1:
+//     UpdateStrategy RollingUpdate, MaxUnavailable 1, MaxSurge 0, RevisionHistoryLimit 10); the
+//     create strategy (pkg/registry/apps/daemonset): Status cleared, Generation 1, the template
+//     generation at least 1 (in apps/v1, the annotation DeprecatedTemplateGeneration: set to "1"
+//     if absent; a present value is kept as is, where kube-apiserver would parse it and raise
+//     values below 1). The pod template's own defaults are not applied.
+//   - Pod: Generation 1, Status {Phase: Pending} (pkg/registry/core/pod); the defaults
+//     TerminationGracePeriodSeconds 30, RestartPolicy Always, DNSPolicy ClusterFirst,
+//     SchedulerName "default-scheduler" when unset. Not modeled: the containers' defaults,
+//     admission (ServiceAccount, Priority, ...), scheduling gates.
+//   - Node, ControllerRevision: stored as given.
+//
+// No validation beyond the above: the caller that creates the DaemonSet and the nodes (the test
+// program) is trusted to create valid objects; the objects the controller creates are its own.
+//
+// # Failures (Config)
+//
+//   - FailWrites: a write may fail before taking effect (500).
+//   - AmbiguousWrites: a write may take effect and still report failure (a timeout after the
+//     commit). Off by default: the theorem's premise "a failed write had no effect" is this flag
+//     off (notes/k8s-daemonset-plan.md, the suspected bug).
+//   - FailReads: a Get or List may fail (500); a Watch may fail to start (500).
+//   - EndWatches, ExpireWatches, Bookmarks: above.
+//
+// A client from AdminClientset never sees a failure (the test program's own setup and checks).
+// In Go, a flagged choice happens with probability Config.FaultPercent / 100; a proof treats
+// every flagged choice as arbitrary, so the percentage matters only for testing.
+//
+// Not modeled: request contexts (cancellation is ignored), authentication and authorization,
+// admission webhooks, server-side apply and patches, field managers, the watch cache's own
+// staleness (a list or watch here is never older than the last write), and any resource other
+// than the four.
+package apimodel
diff --git a/test/utils/robustness/apimodel/server.go b/test/utils/robustness/apimodel/server.go
new file mode 100644
index 00000000..5ca9294b
--- /dev/null
+++ b/test/utils/robustness/apimodel/server.go
@@ -0,0 +1,317 @@
+package apimodel
+
+import (
+	"errors"
+	"math/rand"
+	"strconv"
+	"sync"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+// Config says which nondeterministic failures the server may produce (see the package
+// documentation).
+type Config struct {
+	FailWrites      bool
+	AmbiguousWrites bool
+	FailReads       bool
+	EndWatches      bool
+	ExpireWatches   bool
+	Bookmarks       bool
+	// FaultPercent is the probability, in percent, of each flagged choice when run in Go.
+	FaultPercent int64
+}
+
+// object is what the server stores: every API type the model serves is both.
+type object interface {
+	runtime.Object
+	metav1.Object
+}
+
+// change is one entry of a resource's log: the object's state after the change (for a
+// deletion, its last state), at the change's resource version.
+type change struct {
+	typ watch.EventType
+	rv  uint64
+	obj object
+}
+
+// table is one resource's state.
+type table struct {
+	resource   schema.GroupResource
+	namespaced bool
+	objs       map[types.NamespacedName]object
+	log        []change
+	// empty returns a new empty object of the resource's type (for bookmarks).
+	empty func() object
+}
+
+// Server is the model API server.
+type Server struct {
+	mu sync.Mutex
+	// changed is broadcast on every change to any table and when a watch stops.
+	changed *sync.Cond
+
+	cfg Config
+	// rev is the last resource version issued (0: none yet).
+	rev uint64
+	// rvs maps every resource version issued to its number.
+	rvs map[string]uint64
+	// uids is the number of UIDs issued.
+	uids uint64
+
+	pods       *table
+	nodes      *table
+	daemonSets *table
+	revisions  *table
+}
+
+// NewServer returns an empty server with the given failure configuration.
+func NewServer(cfg Config) *Server {
+	s := &Server{cfg: cfg, rvs: make(map[string]uint64)}
+	s.changed = sync.NewCond(&s.mu)
+	s.pods = newTable(schema.GroupResource{Resource: "pods"}, true, emptyPod)
+	s.nodes = newTable(schema.GroupResource{Resource: "nodes"}, false, emptyNode)
+	s.daemonSets = newTable(schema.GroupResource{Group: "apps", Resource: "daemonsets"}, true, emptyDaemonSet)
+	s.revisions = newTable(schema.GroupResource{Group: "apps", Resource: "controllerrevisions"}, true, emptyRevision)
+	return s
+}
+
+func newTable(gr schema.GroupResource, namespaced bool, empty func() object) *table {
+	return &table{resource: gr, namespaced: namespaced, objs: make(map[types.NamespacedName]object), empty: empty}
+}
+
+// chance reports whether a flagged nondeterministic choice happens. Admin clients never fail.
+func (s *Server) chance(flag bool, admin bool) bool {
+	if !flag || admin {
+		return false
+	}
+	return rand.Int63n(100) < s.cfg.FaultPercent
+}
+
+// rvString is a resource version's string form (decimal; injective).
+func rvString(n uint64) string {
+	return strconv.FormatUint(n, 10)
+}
+
+func copyObject(o object) object {
+	return o.DeepCopyObject().(object)
+}
+
+// nextRV issues the next resource version. Called with mu held.
+func (s *Server) nextRV() (uint64, string) {
+	s.rev = s.rev + 1
+	rv := rvString(s.rev)
+	s.rvs[rv] = s.rev
+	return s.rev, rv
+}
+
+// record stores obj (already at its new resource version) and appends the change. Called with
+// mu held.
+func (s *Server) record(t *table, typ watch.EventType, rv uint64, obj object) {
+	key := types.NamespacedName{Namespace: obj.GetNamespace(), Name: obj.GetName()}
+	if typ == watch.Deleted {
+		delete(t.objs, key)
+	} else {
+		t.objs[key] = obj
+	}
+	t.log = append(t.log, change{typ: typ, rv: rv, obj: copyObject(obj)})
+	s.changed.Broadcast()
+}
+
+var (
+	errStorage   = errors.New("model: storage write failed")
+	errRead      = errors.New("model: storage read failed")
+	errAmbiguous = "model: the request timed out after the write was committed"
+)
+
+// create stores a new object (the package documentation's Create). prepare is the resource's
+// create strategy.
+func (s *Server) create(t *table, ns string, in object, prepare func(object), admin bool) (object, error) {
+	if s.chance(s.cfg.FailWrites, admin) {
+		return nil, apierrors.NewInternalError(errStorage)
+	}
+	obj := copyObject(in)
+	if t.namespaced {
+		if obj.GetNamespace() == "" {
+			obj.SetNamespace(ns)
+		} else if obj.GetNamespace() != ns {
+			return nil, apierrors.NewBadRequest("the namespace of the provided object does not match the namespace sent on the request")
+		}
+	} else {
+		obj.SetNamespace("")
+	}
+	if obj.GetResourceVersion() != "" {
+		return nil, apierrors.NewBadRequest("resourceVersion should not be set on objects to be created")
+	}
+
+	s.mu.Lock()
+	if obj.GetName() == "" {
+		if obj.GetGenerateName() == "" {
+			s.mu.Unlock()
+			return nil, apierrors.NewBadRequest("name or generateName is required")
+		}
+		obj.SetName(obj.GetGenerateName() + rvString(s.rev+1))
+	}
+	key := types.NamespacedName{Namespace: obj.GetNamespace(), Name: obj.GetName()}
+	if _, ok := t.objs[key]; ok {
+		s.mu.Unlock()
+		return nil, apierrors.NewAlreadyExists(t.resource, obj.GetName())
+	}
+	s.uids = s.uids + 1
+	obj.SetUID(types.UID("uid-" + rvString(s.uids)))
+	obj.SetCreationTimestamp(metav1.Now())
+	prepare(obj)
+	n, rv := s.nextRV()
+	obj.SetResourceVersion(rv)
+	s.record(t, watch.Added, n, obj)
+	out := copyObject(obj)
+	s.mu.Unlock()
+
+	if s.chance(s.cfg.AmbiguousWrites, admin) {
+		return nil, apierrors.NewTimeoutError(errAmbiguous, 0)
+	}
+	return out, nil
+}
+
+// get returns a copy of the stored object.
+func (s *Server) get(t *table, ns string, name string, admin bool) (object, error) {
+	if s.chance(s.cfg.FailReads, admin) {
+		return nil, apierrors.NewInternalError(errRead)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	obj, ok := t.objs[types.NamespacedName{Namespace: ns, Name: name}]
+	if !ok {
+		return nil, apierrors.NewNotFound(t.resource, name)
+	}
+	return copyObject(obj), nil
+}
+
+// list returns copies of the objects in ns ("": all) and the current resource version.
+func (s *Server) list(t *table, ns string, opts metav1.ListOptions, admin bool) ([]object, string, error) {
+	if opts.LabelSelector != "" || opts.FieldSelector != "" {
+		return nil, "", apierrors.NewBadRequest("model: selectors are not supported")
+	}
+	if s.chance(s.cfg.FailReads, admin) {
+		return nil, "", apierrors.NewInternalError(errRead)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var out []object
+	for key, obj := range t.objs {
+		if ns == "" || key.Namespace == ns {
+			out = append(out, copyObject(obj))
+		}
+	}
+	return out, rvString(s.rev), nil
+}
+
+// update replaces a stored object (the package documentation's Update and UpdateStatus).
+// mutate returns the object to store from the stored one and the request's (both copies), or
+// nil when the update changes nothing.
+func (s *Server) update(t *table, ns string, in object, mutate func(old object, req object) object, admin bool) (object, error) {
+	if s.chance(s.cfg.FailWrites, admin) {
+		return nil, apierrors.NewInternalError(errStorage)
+	}
+	req := copyObject(in)
+	if t.namespaced && req.GetNamespace() != "" && req.GetNamespace() != ns {
+		return nil, apierrors.NewBadRequest("the namespace of the provided object does not match the namespace sent on the request")
+	}
+
+	s.mu.Lock()
+	key := types.NamespacedName{Namespace: ns, Name: req.GetName()}
+	if !t.namespaced {
+		key.Namespace = ""
+	}
+	stored, ok := t.objs[key]
+	if !ok {
+		s.mu.Unlock()
+		return nil, apierrors.NewNotFound(t.resource, req.GetName())
+	}
+	if req.GetResourceVersion() != "" && req.GetResourceVersion() != stored.GetResourceVersion() {
+		s.mu.Unlock()
+		return nil, apierrors.NewConflict(t.resource, req.GetName(),
+			errors.New("the object has been modified; please apply your changes to the latest version and try again"))
+	}
+	obj := mutate(copyObject(stored), req)
+	if obj == nil {
+		out := copyObject(stored)
+		s.mu.Unlock()
+		return out, nil
+	}
+	obj.SetName(stored.GetName())
+	obj.SetNamespace(stored.GetNamespace())
+	obj.SetUID(stored.GetUID())
+	obj.SetCreationTimestamp(stored.GetCreationTimestamp())
+	n, rv := s.nextRV()
+	obj.SetResourceVersion(rv)
+	s.record(t, watch.Modified, n, obj)
+	out := copyObject(obj)
+	s.mu.Unlock()
+
+	if s.chance(s.cfg.AmbiguousWrites, admin) {
+		return nil, apierrors.NewTimeoutError(errAmbiguous, 0)
+	}
+	return out, nil
+}
+
+// remove deletes a stored object (the package documentation's Delete). grace returns the
+// graceful-deletion period of the stored object under the options (0: delete at once).
+func (s *Server) remove(t *table, ns string, name string, opts metav1.DeleteOptions, grace func(object, metav1.DeleteOptions) int64, admin bool) error {
+	if s.chance(s.cfg.FailWrites, admin) {
+		return apierrors.NewInternalError(errStorage)
+	}
+
+	s.mu.Lock()
+	key := types.NamespacedName{Namespace: ns, Name: name}
+	if !t.namespaced {
+		key.Namespace = ""
+	}
+	stored, ok := t.objs[key]
+	if !ok {
+		s.mu.Unlock()
+		return apierrors.NewNotFound(t.resource, name)
+	}
+	if opts.Preconditions != nil {
+		p := opts.Preconditions
+		if (p.UID != nil && *p.UID != stored.GetUID()) ||
+			(p.ResourceVersion != nil && *p.ResourceVersion != stored.GetResourceVersion()) {
+			s.mu.Unlock()
+			return apierrors.NewConflict(t.resource, name, errors.New("the object's preconditions do not hold"))
+		}
+	}
+	if stored.GetDeletionTimestamp() != nil {
+		// already being deleted: nothing changes
+		s.mu.Unlock()
+		return nil
+	}
+	period := grace(stored, opts)
+	obj := copyObject(stored)
+	n, rv := s.nextRV()
+	obj.SetResourceVersion(rv)
+	if period > 0 || len(obj.GetFinalizers()) > 0 {
+		now := metav1.Now()
+		obj.SetDeletionTimestamp(&now)
+		obj.SetDeletionGracePeriodSeconds(&period)
+		s.record(t, watch.Modified, n, obj)
+	} else {
+		s.record(t, watch.Deleted, n, obj)
+	}
+	s.mu.Unlock()
+
+	if s.chance(s.cfg.AmbiguousWrites, admin) {
+		return apierrors.NewTimeoutError(errAmbiguous, 0)
+	}
+	return nil
+}
+
+// noGrace is the grace function of resources deleted at once.
+func noGrace(object, metav1.DeleteOptions) int64 {
+	return 0
+}
