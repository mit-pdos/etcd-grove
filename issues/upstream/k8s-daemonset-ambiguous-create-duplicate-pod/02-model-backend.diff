@@ -230,3 +230,63 @@ func rootWriteConflicts(p ControllerProfile, cond FaultCondition) []FaultRule {
 	}
 	return rules
 }
+
+// AmbiguousChildCreateScenarios returns scenarios in which the controller's
+// first child create fails. In the Ambiguous ones the create reaches the API
+// server and is committed, but the client sees the error (CommitThenFail); in
+// the Failed ones (the controls) it never reaches the server. In the
+// StaleChildWatch ones the child watch stalls for WatchStall at its first
+// event, so the first committed child stays out of the controller's cache.
+func AmbiguousChildCreateScenarios() []ChaosScenario {
+	type variant struct {
+		name   string
+		err    HTTPStatusError
+		commit bool
+		stall  bool
+	}
+	timeout := NewHTTPStatusError(http.StatusGatewayTimeout, metav1.StatusReasonTimeout, "Timeout: request did not complete within requested timeout - context deadline exceeded")
+	internal := NewHTTPStatusError(http.StatusInternalServerError, metav1.StatusReasonInternalError, "Internal error occurred: etcdserver: request timed out")
+	variants := []variant{
+		{"AmbiguousChildCreate504StaleChildWatch", timeout, true, true},
+		{"AmbiguousChildCreate500StaleChildWatch", internal, true, true},
+		{"FailedChildCreate504StaleChildWatch", timeout, false, true},
+		{"FailedChildCreate500StaleChildWatch", internal, false, true},
+		{"AmbiguousChildCreate504", timeout, true, false},
+		{"AmbiguousChildCreate500", internal, true, false},
+	}
+	var scenarios []ChaosScenario
+	for _, v := range variants {
+		scenarios = append(scenarios, ChaosScenario{
+			Name: v.name,
+			Faults: func(p ControllerProfile, _ *FaultRegistry) []FaultRule {
+				if !p.HasChildCache() || !p.CreatesChildren() || (v.stall && p.WatchStall == 0) {
+					return nil
+				}
+				action := v.err
+				if v.commit {
+					action = CommitThenFail(action)
+				}
+				rules := []FaultRule{{
+					Name:            "FirstChildCreateFails",
+					Match:           p.ChildCreateMatch(),
+					Condition:       TriggerOnOccurrence(1),
+					Action:          action,
+					ExpectTriggered: true,
+				}}
+				if v.stall {
+					// The first child watch event is the first committed child:
+					// the ambiguous one, or (control) the retried one.
+					rules = append(rules, FaultRule{
+						Name:            "StallChildWatch",
+						Match:           p.ChildWatchMatch(),
+						Condition:       TriggerOnOccurrence(1),
+						Action:          InjectDelay{Duration: p.WatchStall},
+						ExpectTriggered: true,
+					})
+				}
+				return rules
+			},
+		})
+	}
+	return scenarios
+}
