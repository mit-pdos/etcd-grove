diff --git a/rawnode_test.go b/rawnode_test.go
index 24b92a3..a6329d9 100644
--- a/rawnode_test.go
+++ b/rawnode_test.go
@@ -1066,3 +1066,74 @@ func benchmarkRawNodeImpl(b *testing.B, peers ...uint64) {
