+package raft
+
+// Tests of the guards against overlapping configuration changes when the
+// application lets the applied index run ahead of ApplyConfChange: it calls
+// Advance (or, with AsyncStorageWrites, delivers the MsgStorageApplyResp)
+// before it has called ApplyConfChange for the conf changes of that Ready,
+// which doc.go step 4 allows. The guards (hasUnappliedConfChanges, the leader's
+// pendingConfIndex check) must go by the conf changes actually applied, not by
+// the applied index: otherwise two entries can be committed at the same index
+// (TestConfChangeLagLeaderLag), and a node whose removal is committed can
+// campaign, be removed while a candidate, win, and panic in becomeLeader
+// (TestConfChangeLagRemovedCandidate).
+//
+// Everything goes through the public RawNode API and MemoryStorage; messages
+// are routed by hand.
+
+import (
+	"bytes"
+	"testing"
+
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+type lagNode struct {
+	id      uint64
+	rn      *RawNode
+	st      *MemoryStorage
+	async   bool // AsyncStorageWrites
+	lagging bool // the applied index runs ahead of ApplyConfChange
+	// conf changes committed, Advanced past (or their MsgStorageApplyResp
+	// delivered), not yet passed to ApplyConfChange.
+	pendingCC []pb.ConfChangeI
+	committed map[uint64]pb.Entry // what the application was told is committed
+}
+
+type lagCluster struct {
+	t     *testing.T
+	nodes map[uint64]*lagNode
+	queue []pb.Message
+	drop  func(m pb.Message) bool // network partition (local messages are never dropped)
+}
+
+func newLagNode(t *testing.T, id uint64, voters []uint64, async, lagging bool) *lagNode {
+	st := NewMemoryStorage()
+	if len(voters) > 0 {
+		if err := st.ApplySnapshot(pb.Snapshot{Metadata: pb.SnapshotMetadata{
+			ConfState: pb.ConfState{Voters: voters},
+		}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	rn, err := NewRawNode(&Config{
+		ID:                 id,
+		ElectionTick:       10,
+		HeartbeatTick:      1,
+		Storage:            st,
+		MaxSizePerMsg:      noLimit,
+		MaxInflightMsgs:    256,
+		AsyncStorageWrites: async,
+		// The fix under test; set it to false to see the tests fail.
+		TrackConfChangeApplication: true,
+		Logger:                     discardLogger,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &lagNode{id: id, rn: rn, st: st, async: async, lagging: lagging, committed: map[uint64]pb.Entry{}}
+}
+
+func lagDecodeCC(t *testing.T, e pb.Entry) pb.ConfChangeI {
+	switch e.Type {
+	case pb.EntryConfChange:
+		var cc pb.ConfChange
+		if err := cc.Unmarshal(e.Data); err != nil {
+			t.Fatal(err)
+		}
+		return cc
+	case pb.EntryConfChangeV2:
+		var cc pb.ConfChangeV2
+		if err := cc.Unmarshal(e.Data); err != nil {
+			t.Fatal(err)
+		}
+		return cc
+	}
+	return nil
+}
+
+// apply records committed entries and applies (or, lagging, holds back) their
+// conf changes.
+func (c *lagCluster) apply(n *lagNode, ents []pb.Entry) {
+	for _, e := range ents {
+		if old, ok := n.committed[e.Index]; ok && (old.Term != e.Term || !bytes.Equal(old.Data, e.Data)) {
+			c.t.Fatalf("node %d: index %d committed twice differently", n.id, e.Index)
+		}
+		n.committed[e.Index] = e
+		if cc := lagDecodeCC(c.t, e); cc != nil {
+			if n.lagging {
+				n.pendingCC = append(n.pendingCC, cc)
+			} else {
+				n.rn.ApplyConfChange(cc)
+			}
+		}
+	}
+}
+
+func (c *lagCluster) persist(n *lagNode, hs pb.HardState, ents []pb.Entry, snap pb.Snapshot) {
+	if !IsEmptyHardState(hs) {
+		if err := n.st.SetHardState(hs); err != nil {
+			c.t.Fatal(err)
+		}
+	}
+	if !IsEmptySnap(snap) {
+		if err := n.st.ApplySnapshot(snap); err != nil {
+			c.t.Fatal(err)
+		}
+	}
+	if err := n.st.Append(ents); err != nil {
+		c.t.Fatal(err)
+	}
+}
+
+func (c *lagCluster) handleReady(n *lagNode) {
+	rd := n.rn.Ready()
+	if !n.async {
+		c.persist(n, rd.HardState, rd.Entries, rd.Snapshot)
+		c.queue = append(c.queue, rd.Messages...)
+		c.apply(n, rd.CommittedEntries)
+		n.rn.Advance(rd)
+		return
+	}
+	for _, m := range rd.Messages {
+		switch m.To {
+		case LocalAppendThread:
+			var snap pb.Snapshot
+			if m.Snapshot != nil {
+				snap = *m.Snapshot
+			}
+			c.persist(n, pb.HardState{Term: m.Term, Vote: m.Vote, Commit: m.Commit}, m.Entries, snap)
+			c.queue = append(c.queue, m.Responses...)
+		case LocalApplyThread:
+			// The apply thread applies the entries and delivers the
+			// MsgStorageApplyResp; a lagging application has its raft
+			// goroutine call ApplyConfChange only later.
+			c.apply(n, m.Entries)
+			c.queue = append(c.queue, m.Responses...)
+		default:
+			c.queue = append(c.queue, m)
+		}
+	}
+}
+
+func (c *lagCluster) stabilize() {
+	for i := 0; i < 10000; i++ {
+		progress := false
+		for id := uint64(1); id <= 4; id++ {
+			if n := c.nodes[id]; n != nil && n.rn.HasReady() {
+				c.handleReady(n)
+				progress = true
+			}
+		}
+		msgs := c.queue
+		c.queue = nil
+		for _, m := range msgs {
+			to := c.nodes[m.To]
+			local := IsLocalMsgTarget(m.From) || IsLocalMsgTarget(m.To)
+			if to == nil || (!local && c.drop(m)) {
+				continue
+			}
+			progress = true
+			_ = to.rn.Step(m)
+		}
+		if !progress {
+			return
+		}
+	}
+	c.t.Fatal("did not stabilize")
+}
+
+func (c *lagCluster) applyPending(id uint64) {
+	n := c.nodes[id]
+	for _, cc := range n.pendingCC {
+		n.rn.ApplyConfChange(cc)
+	}
+	n.pendingCC = nil
+}
+
+func (c *lagCluster) cfg(id uint64) string { return c.nodes[id].rn.Status().Config.String() }
+
+// checkCommitted fails if two nodes report different entries committed at the
+// same index.
+func (c *lagCluster) checkCommitted() {
+	for i, a := range c.nodes {
+		for j, b := range c.nodes {
+			if i >= j {
+				continue
+			}
+			for idx, ea := range a.committed {
+				if eb, ok := b.committed[idx]; ok && (ea.Term != eb.Term || !bytes.Equal(ea.Data, eb.Data)) {
+					c.t.Fatalf("SAFETY VIOLATION: index %d committed as %q (term %d) on node %d and as %q (term %d) on node %d",
+						idx, ea.Data, ea.Term, i, eb.Data, eb.Term, j)
+				}
+			}
+		}
+	}
+}
+
+func isolateFn(ids ...uint64) func(pb.Message) bool {
+	in := map[uint64]bool{}
+	for _, id := range ids {
+		in[id] = true
+	}
+	return func(m pb.Message) bool { return in[m.From] != in[m.To] }
+}
+
+func noDrop(pb.Message) bool { return false }
+
+// leaderLagSetup: C0 = {1,2,3}, node 1 leads term 1 and commits C1 = add 4
+// (index 2), its application holding back ApplyConfChange; node 1 proposes
+// C2 = remove 2.
+func leaderLagSetup(t *testing.T, async bool) *lagCluster {
+	c := &lagCluster{t: t, drop: noDrop, nodes: map[uint64]*lagNode{
+		1: newLagNode(t, 1, []uint64{1, 2, 3}, async, true),
+		2: newLagNode(t, 2, []uint64{1, 2, 3}, false, false),
+		3: newLagNode(t, 3, []uint64{1, 2, 3}, false, false),
+		// Node 4 joins starting from C0 (with an empty ConfState it would fold the
+		// conf changes onto an empty configuration and could win alone).
+		4: newLagNode(t, 4, []uint64{1, 2, 3}, false, false),
+	}}
+	if err := c.nodes[1].rn.Campaign(); err != nil {
+		t.Fatal(err)
+	}
+	c.stabilize()
+	if c.nodes[1].rn.BasicStatus().RaftState != StateLeader {
+		t.Fatal("node 1 is not leader")
+	}
+	if err := c.nodes[1].rn.ProposeConfChange(pb.ConfChange{Type: pb.ConfChangeAddNode, NodeId: 4}); err != nil {
+		t.Fatal(err)
+	}
+	c.stabilize()
+	if e := c.nodes[1].committed[2]; e.Type != pb.EntryConfChange || len(c.nodes[1].pendingCC) != 1 {
+		t.Fatalf("C1 not committed and held back at index 2: %+v", e)
+	}
+	if got := c.nodes[1].rn.raft.raftLog.applied; got != 2 {
+		t.Fatalf("node 1 applied index = %d, want 2 (ahead of ApplyConfChange)", got)
+	}
+	if err := c.nodes[1].rn.ProposeConfChange(pb.ConfChange{Type: pb.ConfChangeRemoveNode, NodeId: 2}); err != nil {
+		t.Fatal(err)
+	}
+	c.stabilize()
+	return c
+}
+
+// The leader-lag execution of issues/raft-advance-before-applyconfchange.md:
+// with the fix, C2 is refused (C1 is not applied to the leader's configuration),
+// so node 3 stays on {1,2,3,4} and cannot win with {3,4}.
+func TestConfChangeLagLeaderLag(t *testing.T) {
+	for _, async := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sync", true: "async"}[async], func(t *testing.T) {
+			c := leaderLagSetup(t, async)
+			if e := c.nodes[1].committed[3]; e.Type != pb.EntryNormal || len(e.Data) != 0 {
+				t.Fatalf("C2 should have been refused (replaced by an empty normal entry), got %+v", e)
+			}
+			t.Logf("node 1 config %v (unapplied: %d); node 3 config %v", c.cfg(1), len(c.nodes[1].pendingCC), c.cfg(3))
+
+			c.drop = isolateFn(3, 4)
+			if err := c.nodes[1].rn.Propose([]byte("x")); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize()
+
+			c.drop = isolateFn(1, 2)
+			if err := c.nodes[3].rn.Campaign(); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize()
+			if st := c.nodes[3].rn.BasicStatus().RaftState; st == StateLeader {
+				t.Fatalf("node 3 won with {3,4} (config %v)", c.cfg(3))
+			}
+			c.applyPending(1)
+			c.checkCommitted()
+		})
+	}
+}
+
+// Liveness: once the lagging application applies C1, C2 is accepted and
+// commits; a lagging follower cannot campaign until it applies.
+func TestConfChangeLagLiveness(t *testing.T) {
+	for _, async := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sync", true: "async"}[async], func(t *testing.T) {
+			c := leaderLagSetup(t, async)
+			c.nodes[2].lagging = true
+			c.applyPending(1)
+			if err := c.nodes[1].rn.ProposeConfChange(pb.ConfChange{Type: pb.ConfChangeRemoveNode, NodeId: 2}); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize()
+			if e := c.nodes[1].committed[4]; e.Type != pb.EntryConfChange {
+				t.Fatalf("C2 not accepted after C1 was applied: %+v", e)
+			}
+			c.applyPending(1)
+			if got, want := c.cfg(1), "voters=(1 3 4)"; got != want {
+				t.Fatalf("node 1 config %s, want %s", got, want)
+			}
+			// Node 2 (lagging) holds C2 = remove 2 back: it must not campaign.
+			if len(c.nodes[2].pendingCC) != 1 {
+				t.Fatalf("node 2 holds %d conf changes back, want 1", len(c.nodes[2].pendingCC))
+			}
+			term := c.nodes[2].rn.BasicStatus().Term
+			if err := c.nodes[2].rn.Campaign(); err != nil {
+				t.Fatal(err)
+			}
+			if bs := c.nodes[2].rn.BasicStatus(); bs.RaftState != StateFollower || bs.Term != term {
+				t.Fatalf("node 2 campaigned with an unapplied conf change: %v term %d", bs.RaftState, bs.Term)
+			}
+			c.checkCommitted()
+		})
+	}
+}
+
+// A lagging follower whose own removal is committed: without the fix it can
+// campaign, be removed while a candidate (ApplyConfChange), get the votes of
+// the remaining voters and panic in becomeLeader (no Progress for itself).
+func TestConfChangeLagRemovedCandidate(t *testing.T) {
+	for _, async := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sync", true: "async"}[async], func(t *testing.T) {
+			c := &lagCluster{t: t, drop: noDrop, nodes: map[uint64]*lagNode{
+				1: newLagNode(t, 1, []uint64{1, 2, 3}, false, false),
+				2: newLagNode(t, 2, []uint64{1, 2, 3}, false, false),
+				3: newLagNode(t, 3, []uint64{1, 2, 3}, async, true),
+			}}
+			if err := c.nodes[1].rn.Campaign(); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize()
+			if err := c.nodes[1].rn.ProposeConfChange(pb.ConfChange{Type: pb.ConfChangeRemoveNode, NodeId: 3}); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize()
+			if len(c.nodes[3].pendingCC) != 1 || c.nodes[3].rn.raft.raftLog.applied != 2 {
+				t.Fatalf("node 3 should have Advanced past its removal without applying it")
+			}
+			if err := c.nodes[3].rn.Campaign(); err != nil {
+				t.Fatal(err)
+			}
+			if st := c.nodes[3].rn.BasicStatus().RaftState; st != StateFollower {
+				t.Fatalf("node 3 campaigned with its removal unapplied: %v", st)
+			}
+			c.applyPending(3) // node 3 is removed
+			if err := c.nodes[3].rn.Campaign(); err != nil {
+				t.Fatal(err)
+			}
+			c.stabilize() // no panic
+			if st := c.nodes[3].rn.BasicStatus().RaftState; st == StateLeader {
+				t.Fatal("removed node 3 became leader")
+			}
+			c.checkCommitted()
+		})
+	}
+}
+
+// Auto-leave: a leader that enters a joint configuration with auto-leave after
+// the applied index passed the entry still initiates the transition out of it
+// (from ApplyConfChange, since appliedTo saw the old configuration).
+func TestConfChangeLagAutoLeave(t *testing.T) {
+	c := &lagCluster{t: t, drop: noDrop, nodes: map[uint64]*lagNode{
+		1: newLagNode(t, 1, []uint64{1, 2, 3}, false, true),
+		2: newLagNode(t, 2, []uint64{1, 2, 3}, false, false),
+		3: newLagNode(t, 3, []uint64{1, 2, 3}, false, false),
+	}}
+	if err := c.nodes[1].rn.Campaign(); err != nil {
+		t.Fatal(err)
+	}
+	c.stabilize()
+	cc := pb.ConfChangeV2{Transition: pb.ConfChangeTransitionJointImplicit, Changes: []pb.ConfChangeSingle{
+		{Type: pb.ConfChangeRemoveNode, NodeId: 3},
+	}}
+	if err := c.nodes[1].rn.ProposeConfChange(cc); err != nil {
+		t.Fatal(err)
+	}
+	c.stabilize()
+	c.applyPending(1) // enters the joint config after Advance; proposes leaving it
+	c.stabilize()
+	c.applyPending(1) // leaves it
+	if got, want := c.cfg(1), "voters=(1 2)"; got != want {
+		t.Fatalf("node 1 config %s, want %s", got, want)
+	}
+	c.checkCommitted()
+}
+
+// Restart: the entries above the applied index are handed out again, and so is
+// a conf change among them; until the application has passed it to
+// ApplyConfChange again, the node does not campaign.
+func TestConfChangeLagRestart(t *testing.T) {
+	c := leaderLagSetup(t, false)
+	c.applyPending(1)
+	old := c.nodes[3]
+	rn, err := NewRawNode(&Config{
+		ID:                         3,
+		ElectionTick:               10,
+		HeartbeatTick:              1,
+		Storage:                    old.st,
+		MaxSizePerMsg:              noLimit,
+		MaxInflightMsgs:            256,
+		Logger:                     discardLogger,
+		TrackConfChangeApplication: true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := &lagNode{id: 3, rn: rn, st: old.st, lagging: true, committed: map[uint64]pb.Entry{}}
+	c.nodes[3] = n
+	c.drop = isolateFn(3) // node 3 is cut off
+	c.stabilize()         // node 3 replays its log, C1 = add 4 among it
+	if len(n.pendingCC) != 1 {
+		t.Fatalf("node 3 replayed %d conf changes, want 1", len(n.pendingCC))
+	}
+	if err := n.rn.Campaign(); err != nil {
+		t.Fatal(err)
+	}
+	if st := n.rn.BasicStatus().RaftState; st != StateFollower {
+		t.Fatalf("node 3 campaigned with a replayed conf change unapplied: %v", st)
+	}
+	c.applyPending(3)
+	if err := n.rn.Campaign(); err != nil {
+		t.Fatal(err)
+	}
+	if st := n.rn.BasicStatus().RaftState; st != StateCandidate {
+		t.Fatalf("node 3 cannot campaign after applying the replayed conf change: %v", st)
+	}
+}
+
+// A snapshot restored while the application is still applying the previous
+// Ready (node.run steps messages while it waits for Advance): the application's
+// ApplyConfChange call for that Ready's conf change is ignored, since the
+// snapshot's configuration reflects it already. Without tracking it is applied
+// on top of the snapshot's configuration: voters=(1 2 3 4) below, and a panic
+// ("config is already joint") for a joint configuration.
+func TestConfChangeLagSnapshotDuringApply(t *testing.T) {
+	enterJoint := pb.ConfChangeV2{Transition: pb.ConfChangeTransitionJointExplicit,
+		Changes: []pb.ConfChangeSingle{{Type: pb.ConfChangeAddNode, NodeId: 4}}}
+	for _, tt := range []struct {
+		name string
+		cc   pb.ConfChangeI
+		snap pb.ConfState // at index 3, after the conf change at index 1
+	}{
+		{"simple", pb.ConfChange{Type: pb.ConfChangeAddNode, NodeId: 4}, pb.ConfState{Voters: []uint64{1, 2, 3}}},
+		{"joint", enterJoint, pb.ConfState{Voters: []uint64{1, 2, 3, 4}, VotersOutgoing: []uint64{1, 2, 3}}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			n := newLagNode(t, 2, []uint64{1, 2, 3}, false, false)
+			ent := pb.Entry{Term: 1, Index: 1, Type: pb.EntryConfChange}
+			var err error
+			if v1, ok := tt.cc.(pb.ConfChange); ok {
+				ent.Data, err = v1.Marshal()
+			} else {
+				ent.Type = pb.EntryConfChangeV2
+				v2 := tt.cc.AsV2()
+				ent.Data, err = v2.Marshal()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := n.rn.Step(pb.Message{From: 1, To: 2, Term: 1, Type: pb.MsgApp,
+				Entries: []pb.Entry{ent}, Commit: 1}); err != nil {
+				t.Fatal(err)
+			}
+			rd := n.rn.Ready()
+			if len(rd.CommittedEntries) != 1 {
+				t.Fatalf("expected the conf change committed, got %+v", rd.CommittedEntries)
+			}
+			if err := n.st.SetHardState(rd.HardState); err != nil {
+				t.Fatal(err)
+			}
+			if err := n.st.Append(rd.Entries); err != nil {
+				t.Fatal(err)
+			}
+			snap := pb.Snapshot{Metadata: pb.SnapshotMetadata{Index: 3, Term: 1, ConfState: tt.snap}}
+			if err := n.rn.Step(pb.Message{From: 1, To: 2, Term: 1, Type: pb.MsgSnap, Snapshot: &snap}); err != nil {
+				t.Fatal(err)
+			}
+			want := n.rn.Status().Config.String()
+			n.rn.ApplyConfChange(tt.cc) // the application finishes applying the entry
+			n.rn.Advance(rd)
+			if got := n.rn.Status().Config.String(); got != want {
+				t.Fatalf("configuration %s after the stale conf change, want the snapshot's %s", got, want)
+			}
+		})
+	}
+}
