 	for _, peer := range peers {
 		rn.raft.applyConfChange(pb.ConfChange{NodeId: peer.ID, Type: pb.ConfChangeAddNode}.AsV2())
 	}
+	// The configuration in use reflects these entries already: they are not
+	// conf changes the application has yet to apply (raft.confChangesToApply),
+	// whether or not it passes them to ApplyConfChange.
+	if rn.raft.trackConfChanges {
+		rn.raft.bootstrapLastIndex = uint64(len(ents))
