+package integration
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/etcd/tests/v3/framework/integration"
+	gofail "go.etcd.io/gofail/runtime"
+)
+
+// TestCompactBeforeAdvanceThenLeaderTransfer restarts a follower whose WAL holds
+// more than memorySnapshotCount (100) committed entries and no disk snapshot. Its
+// first Ready replays them all while raft's applied index is 0; the apply loop
+// snapshots in memory and compacts the raft log at 1 before raftNode.start calls
+// Advance. A leader transfer to that follower in this window (MsgTimeoutNow) makes
+// raft scan [applied+1, committed+1) for conf changes, below the first index.
+//
+// The failpoint raftBeforeAdvanceOnMember (server/etcdserver/raft.go) only widens
+// the window, on the restarted member. Run with gofail enabled.
+func TestCompactBeforeAdvanceThenLeaderTransfer(t *testing.T) {
+	integration.BeforeTest(t)
+	integration.SkipIfNoGoFail(t)
+
+	clus := integration.NewCluster(t, &integration.ClusterConfig{Size: 3})
+	defer clus.Terminate(t)
+
+	lead := clus.WaitLeader(t)
+	f := (lead + 1) % 3
+	cli := clus.Client(lead)
+	for i := 0; i < 150; i++ {
+		_, err := cli.Put(context.Background(), fmt.Sprintf("k%d", i), "v")
+		require.NoError(t, err)
+	}
+	leadIdx := clus.Members[lead].Server.AppliedIndex()
+	require.Eventually(t, func() bool {
+		return clus.Members[f].Server.AppliedIndex() >= leadIdx
+	}, 10*time.Second, 10*time.Millisecond)
+
+	leadID, fID := clus.Members[lead].ID(), clus.Members[f].ID()
+	clus.Members[f].Stop(t)
+
+	require.NoError(t, gofail.Enable("raftBeforeAdvanceOnMember", fmt.Sprintf(`return(%q)`, fID.String())))
+	defer gofail.Disable("raftBeforeAdvanceOnMember") //nolint:errcheck // may already be disabled
+	require.NoError(t, clus.Members[f].Restart(t))
+
+	// The restarted member is now in its first Ready's window (5s). Without a fix,
+	// it panics here: "error scanning unapplied entries [1, N): requested index
+	// is unavailable due to compaction". With one, raft refuses the campaign
+	// (unapplied conf changes) and the transfer times out.
+	time.Sleep(time.Second)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	err := clus.Members[lead].Server.MoveLeader(ctx, uint64(leadID), uint64(fID))
+	t.Logf("MoveLeader: %v", err)
+	require.NoError(t, gofail.Disable("raftBeforeAdvanceOnMember"))
+
+	// The restarted member is alive and serves.
+	clus.WaitLeader(t)
+	pctx, pcancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer pcancel()
+	_, err = clus.Client(f).Put(pctx, "after", "v")
+	require.NoError(t, err)
+}
