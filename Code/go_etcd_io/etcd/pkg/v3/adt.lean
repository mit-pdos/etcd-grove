    "Introduction to Algorithms" (Cormen et al, 3rd ed.), chapter 13.2, p313

    	LEFT-ROTATE(T, x)

    	y = x.right
    	x.right = y.left

    	if y.left ≠ T.nil
    		y.left.p = x

    	y.p = x.p

    	if x.p == T.nil
    		T.root = y
    	else if x == x.p.left
    		x.p.left = y
    	else
    		x.p.right = y

    	y.left = x
    	x.p = y

