// Added to Go's own net package at build time by examples/net/conform/overlay (go build
// -overlay); not part of Go and not part of any program. The overlay renames each traced
// function and method of net.go, dial.go, tcpsock.go and tcpsock_unix.go to netextOrig<Name>;
// the definitions below take the public names, call the original, and append to this
// process's trace file one record when the call starts ("B") and one when it returns ("E").
// The trace format is examples/net/conform/README.md's, which is the contract: change both
// together (and the format version, netextVersion).
//
// With NET_TRACE_DIR unset or empty every wrapper calls the original at once.
//
// Records are JSON lines, each written with one write(2) under a lock (no buffering: a process
// stopped by os.Exit or SIGKILL loses no call that returned). Times are runtime.nanotime(),
// Linux's CLOCK_MONOTONIC, which every process in one time namespace shares.

package net

import (
	"context"
	"errors"
	"internal/reflectlite"
	"io"
	"net/netip"
	"os"
	"runtime"
	"strconv"
	"sync"
	"sync/atomic"
	"syscall"
	"time"
	"unicode/utf8"
	_ "unsafe"
	"weak"
)

const netextVersion = 1

//go:linkname netextNanotime runtime.nanotime
func netextNanotime() int64

// netextGoid is the calling goroutine's id (runtime/zz_netext_goid.go, added by the same
// overlay).
//
//go:linkname netextGoid runtime.netextGoid
func netextGoid() uint64

var netextT struct {
	on     bool
	prefix []byte // `,"pid":P,"node":"N"`, in every B and E record
	seq    atomic.Int64

	fmu sync.Mutex // the file: one record per write(2), in emission order
	f   *os.File

	imu  sync.Mutex // the socket ids
	ids  map[weak.Pointer[netFD]]string
	next int
}

func init() {
	dir, ok := syscall.Getenv("NET_TRACE_DIR")
	if !ok || dir == "" {
		return
	}
	node, _ := syscall.Getenv("NET_NODE")
	if node == "" && len(os.Args) > 0 {
		node = netextBase(os.Args[0])
	}
	pid := os.Getpid()
	start := netextNanotime()
	name := dir + "/" + netextFileName(node) + "." + strconv.Itoa(pid) + "." + strconv.FormatInt(start, 10) + ".jsonl"
	f, err := os.OpenFile(name, os.O_CREATE|os.O_WRONLY|os.O_APPEND|os.O_EXCL, 0o644)
	if err != nil {
		// A conformance run that silently lost a process's trace would be checked as if the
		// process had made no call: refuse to run instead.
		os.Stderr.WriteString("net trace: cannot open the trace file: " + err.Error() + "\n")
		os.Exit(97)
	}
	netextT.f = f
	netextT.ids = make(map[weak.Pointer[netFD]]string)
	p := &netextRec{}
	p.int("pid", int64(pid))
	p.str("node", node)
	netextT.prefix = append([]byte{','}, p.b...)
	netextT.on = true

	h := &netextRec{b: []byte(`{"k":"H"`)}
	h.int("v", netextVersion)
	h.str("role", "node")
	h.int("pid", int64(pid))
	h.int("ppid", int64(os.Getppid()))
	h.str("node", node)
	exe, _ := os.Executable()
	h.str("exe", exe)
	h.key("args")
	h.b = append(h.b, '[')
	for i, a := range os.Args {
		if i > 0 {
			h.b = append(h.b, ',')
		}
		h.quote(a)
	}
	h.b = append(h.b, ']')
	h.str("go", runtime.Version())
	host, _ := os.Hostname()
	h.str("host", host)
	tns, _ := os.Readlink("/proc/self/ns/time")
	netns, _ := os.Readlink("/proc/self/ns/net")
	h.str("timens", tns)
	h.str("netns", netns)
	h.str("file", name)
	t0 := netextNanotime()
	wall := time.Now().UnixNano()
	t1 := netextNanotime()
	h.int("t0", t0)
	h.int("wall", wall)
	h.int("t1", t1)
	h.emit()
}

func netextBase(p string) string {
	for i := len(p) - 1; i >= 0; i-- {
		if p[i] == '/' {
			return p[i+1:]
		}
	}
	return p
}

// netextFileName is node with every byte outside [A-Za-z0-9._-] replaced by '_'.
func netextFileName(node string) string {
	b := []byte(node)
	for i, c := range b {
		if !('a' <= c && c <= 'z' || 'A' <= c && c <= 'Z' || '0' <= c && c <= '9' || c == '.' || c == '_' || c == '-') {
			b[i] = '_'
		}
	}
	if len(b) == 0 {
		return "_"
	}
	return string(b)
}

/* ---- records ---- */

// netextRec is one JSON record under construction.
type netextRec struct{ b []byte }

// key starts the member k (with no comma right after an opening brace).
func (r *netextRec) key(k string) {
	if n := len(r.b); n > 0 && r.b[n-1] != '{' {
		r.b = append(r.b, ',')
	}
	r.b = append(r.b, '"')
	r.b = append(r.b, k...)
	r.b = append(r.b, '"', ':')
}

const netextHex = "0123456789abcdef"

// quote appends v as a JSON string: valid UTF-8 kept, control characters escaped, every byte
// of an invalid sequence replaced by U+FFFD.
func (r *netextRec) quote(v string) {
	r.b = append(r.b, '"')
	for i := 0; i < len(v); {
		c := v[i]
		if c < utf8.RuneSelf {
			switch {
			case c == '"' || c == '\\':
				r.b = append(r.b, '\\', c)
			case c < 0x20:
				r.b = append(r.b, '\\', 'u', '0', '0', netextHex[c>>4], netextHex[c&15])
			default:
				r.b = append(r.b, c)
			}
			i++
			continue
		}
		ru, size := utf8.DecodeRuneInString(v[i:])
		if ru == utf8.RuneError && size == 1 {
			r.b = append(r.b, `�`...)
		} else {
			r.b = append(r.b, v[i:i+size]...)
		}
		i += size
	}
	r.b = append(r.b, '"')
}

func (r *netextRec) str(k, v string) {
	r.key(k)
	r.quote(v)
}

func (r *netextRec) int(k string, v int64) {
	r.key(k)
	r.b = strconv.AppendInt(r.b, v, 10)
}

func (r *netextRec) bool(k string, v bool) {
	r.key(k)
	r.b = strconv.AppendBool(r.b, v)
}

func (r *netextRec) null(k string) {
	r.key(k)
	r.b = append(r.b, "null"...)
}

func (r *netextRec) hex(k string, p []byte) {
	r.key(k)
	r.b = append(r.b, '"')
	n := len(r.b)
	if need := n + 2*len(p) + 256; cap(r.b) < need {
		nb := make([]byte, n, need)
		copy(nb, r.b)
		r.b = nb
	}
	dst := r.b[n : n+2*len(p)]
	for i, c := range p {
		dst[2*i] = netextHex[c>>4]
		dst[2*i+1] = netextHex[c&15]
	}
	r.b = r.b[:n+2*len(p)]
	r.b = append(r.b, '"')
}

func (r *netextRec) emit() {
	r.b = append(r.b, '}', '\n')
	netextT.fmu.Lock()
	netextT.f.Write(r.b)
	netextT.fmu.Unlock()
}

// netextBegin starts the B record of a call of op on the socket id ("" for none): the call's
// number, the goroutine, the operation. The caller adds the arguments, then calls start.
func netextBegin(op, id string) (int64, *netextRec) {
	s := netextT.seq.Add(1)
	r := &netextRec{b: make([]byte, 0, 160)}
	r.b = append(r.b, `{"k":"B"`...)
	r.b = append(r.b, netextT.prefix...)
	r.int("s", s)
	r.int("g", int64(netextGoid()))
	r.str("op", op)
	if id != "" {
		r.str("id", id)
	}
	return s, r
}

// start takes the call's start time (the last moment before the original is called) and
// writes the B record.
func (r *netextRec) start() {
	r.int("t", netextNanotime())
	r.emit()
}

// netextEnd starts the E record of call s of op on id, which returned at t (taken at once
// after the original returned).
func netextEnd(s int64, op, id string, t int64) *netextRec {
	r := &netextRec{b: make([]byte, 0, 160)}
	r.b = append(r.b, `{"k":"E"`...)
	r.b = append(r.b, netextT.prefix...)
	r.int("s", s)
	r.int("g", int64(netextGoid()))
	r.str("op", op)
	if id != "" {
		r.str("id", id)
	}
	r.int("t", t)
	return r
}

func netextType(x any) string {
	if x == nil {
		return "nil"
	}
	return reflectlite.TypeOf(x).String()
}

// err records err's facts (README.md, "Errors").
func (r *netextRec) err(err error) {
	if err == nil {
		r.null("err")
		return
	}
	r.key("err")
	r.b = append(r.b, '{')
	r.str("type", netextType(err))
	r.str("msg", err.Error())
	r.bool("eof", err == io.EOF)
	r.bool("isEOF", errors.Is(err, io.EOF))
	r.bool("isClosed", errors.Is(err, ErrClosed))
	r.bool("isDeadline", errors.Is(err, os.ErrDeadlineExceeded))
	if t, ok := err.(interface{ Timeout() bool }); ok {
		r.bool("timeout", t.Timeout())
	}
	if t, ok := err.(interface{ Temporary() bool }); ok {
		r.bool("temporary", t.Temporary())
	}
	inner := err
	if oe, ok := err.(*OpError); ok && oe != nil {
		r.str("op", oe.Op)
		r.str("net", oe.Net)
		r.addr("source", oe.Source)
		r.addr("addr", oe.Addr)
		r.str("inner", netextType(oe.Err))
		inner = oe.Err
	}
	switch e := inner.(type) {
	case *os.SyscallError:
		if e != nil {
			r.str("syscall", e.Syscall)
			if en, ok := e.Err.(syscall.Errno); ok {
				r.int("errno", int64(en))
			}
		}
	case syscall.Errno:
		r.int("errno", int64(e))
	}
	r.b = append(r.b, '}')
}

// addr records an address: null for a nil interface; else its dynamic type, and its Network()
// and String() unless it is a nil pointer.
func (r *netextRec) addr(k string, a Addr) {
	if a == nil {
		r.null(k)
		return
	}
	r.key(k)
	r.b = append(r.b, '{')
	r.str("type", netextType(a))
	switch a := a.(type) {
	case *TCPAddr:
		if a == nil {
			r.bool("nil", true)
			r.b = append(r.b, '}')
			return
		}
	case *UDPAddr:
		if a == nil {
			r.bool("nil", true)
			r.b = append(r.b, '}')
			return
		}
	case *UnixAddr:
		if a == nil {
			r.bool("nil", true)
			r.b = append(r.b, '}')
			return
		}
	case *IPAddr:
		if a == nil {
			r.bool("nil", true)
			r.b = append(r.b, '}')
			return
		}
	}
	r.str("net", a.Network())
	r.str("s", a.String())
	r.b = append(r.b, '}')
}

/* ---- socket ids ---- */

// netextID is the trace's name of the socket fd: "c<k>" for a connection Dial or Accept (or an
// out-of-scope API) returned, "l<k>" for a listener Listen returned, "u<k>" for a socket first
// seen by an operation on it (made by an API that is not traced), "nil" for no socket (a nil or
// zero-value Conn). k counts from 1 in each process. The map holds weak pointers, so tracing
// keeps no socket alive (Go's finalizer still closes a leaked one), and a name is never reused:
// a new netFD at a reclaimed one's address has a new weak pointer.
func netextID(fd *netFD, prefix string) string {
	if fd == nil {
		return "nil"
	}
	w := weak.Make(fd)
	netextT.imu.Lock()
	defer netextT.imu.Unlock()
	if id, ok := netextT.ids[w]; ok {
		return id
	}
	netextT.next++
	id := prefix + strconv.Itoa(netextT.next)
	netextT.ids[w] = id
	runtime.AddCleanup(fd, func(w weak.Pointer[netFD]) {
		netextT.imu.Lock()
		delete(netextT.ids, w)
		netextT.imu.Unlock()
	}, w)
	return id
}

func (c *conn) netextFD() *netFD {
	if c == nil {
		return nil
	}
	return c.fd
}

func (l *TCPListener) netextFD() *netFD {
	if l == nil {
		return nil
	}
	return l.fd
}

// netextConnFD is the netFD of a Conn that a dial or an accept returned.
func netextConnFD(c Conn) *netFD {
	switch c := c.(type) {
	case *TCPConn:
		if c != nil {
			return c.fd
		}
	case *UnixConn:
		if c != nil {
			return c.fd
		}
	case *UDPConn:
		if c != nil {
			return c.fd
		}
	case *IPConn:
		if c != nil {
			return c.fd
		}
	}
	return nil
}

// newSock records the socket a call returned: its id, network, and its local and remote
// addresses (Go's fd.laddr and fd.raddr, what LocalAddr and RemoteAddr return).
func (r *netextRec) newSock(fd *netFD, prefix string) {
	if fd == nil {
		r.null("new")
		return
	}
	r.key("new")
	r.b = append(r.b, '{')
	r.str("id", netextID(fd, prefix))
	r.str("net", fd.net)
	r.addr("local", fd.laddr)
	r.addr("remote", fd.raddr)
	r.b = append(r.b, '}')
}

/* ---- *conn: Read, Write, Close, addresses, deadlines ---- */

func (c *conn) Read(b []byte) (int, error) {
	if !netextT.on {
		return c.netextOrigRead(b)
	}
	id := netextID(c.netextFD(), "u")
	s, r := netextBegin("Read", id)
	r.int("n", int64(len(b)))
	r.start()
	n, err := c.netextOrigRead(b)
	e := netextEnd(s, "Read", id, netextNanotime())
	e.int("n", int64(n))
	if n > 0 && n <= len(b) {
		e.hex("data", b[:n])
	}
	e.err(err)
	e.emit()
	return n, err
}

func (c *conn) Write(b []byte) (int, error) {
	if !netextT.on {
		return c.netextOrigWrite(b)
	}
	id := netextID(c.netextFD(), "u")
	s, r := netextBegin("Write", id)
	r.int("n", int64(len(b)))
	r.hex("data", b)
	r.start()
	n, err := c.netextOrigWrite(b)
	e := netextEnd(s, "Write", id, netextNanotime())
	e.int("n", int64(n))
	e.err(err)
	e.emit()
	return n, err
}

// netextErrCall traces a call on the socket fd that takes no traced argument and returns only
// an error.
func netextErrCall(op string, fd *netFD, f func() error) error {
	if !netextT.on {
		return f()
	}
	id := netextID(fd, "u")
	s, r := netextBegin(op, id)
	r.start()
	err := f()
	e := netextEnd(s, op, id, netextNanotime())
	e.err(err)
	e.emit()
	return err
}

func (c *conn) Close() error {
	return netextErrCall("Close", c.netextFD(), c.netextOrigClose)
}

func (c *TCPConn) CloseWrite() error {
	var fd *netFD
	if c != nil {
		fd = c.fd
	}
	return netextErrCall("CloseWrite", fd, c.netextOrigCloseWrite)
}

func netextAddrCall(op string, fd *netFD, f func() Addr) Addr {
	if !netextT.on {
		return f()
	}
	id := netextID(fd, "u")
	s, r := netextBegin(op, id)
	r.start()
	a := f()
	e := netextEnd(s, op, id, netextNanotime())
	e.addr("addr", a)
	e.emit()
	return a
}

func (c *conn) LocalAddr() Addr {
	return netextAddrCall("LocalAddr", c.netextFD(), c.netextOrigLocalAddr)
}

func (c *conn) RemoteAddr() Addr {
	return netextAddrCall("RemoteAddr", c.netextFD(), c.netextOrigRemoteAddr)
}

// netextDeadline traces SetDeadline ("both"), SetReadDeadline ("read") and SetWriteDeadline
// ("write") as one operation: set is !t.IsZero() (a zero time clears the deadline).
func (c *conn) netextDeadline(which string, t time.Time, f func(time.Time) error) error {
	if !netextT.on {
		return f(t)
	}
	id := netextID(c.netextFD(), "u")
	s, r := netextBegin("SetDeadline", id)
	r.str("which", which)
	r.bool("set", !t.IsZero())
	if !t.IsZero() {
		r.int("in", int64(time.Until(t)))
		r.int("wall", t.UnixNano())
	}
	r.start()
	err := f(t)
	e := netextEnd(s, "SetDeadline", id, netextNanotime())
	e.err(err)
	e.emit()
	return err
}

func (c *conn) SetDeadline(t time.Time) error {
	return c.netextDeadline("both", t, c.netextOrigSetDeadline)
}

func (c *conn) SetReadDeadline(t time.Time) error {
	return c.netextDeadline("read", t, c.netextOrigSetReadDeadline)
}

func (c *conn) SetWriteDeadline(t time.Time) error {
	return c.netextDeadline("write", t, c.netextOrigSetWriteDeadline)
}

/* ---- Methods the model does not have: op "Unmodeled", with the Go API's name ---- */

func netextUnmodeled(api string, fd *netFD, f func() error) error {
	if !netextT.on {
		return f()
	}
	id := netextID(fd, "u")
	s, r := netextBegin("Unmodeled", id)
	r.str("api", api)
	r.start()
	err := f()
	e := netextEnd(s, "Unmodeled", id, netextNanotime())
	e.str("api", api)
	e.err(err)
	e.emit()
	return err
}

func (c *conn) SetReadBuffer(bytes int) error {
	return netextUnmodeled("conn.SetReadBuffer", c.netextFD(), func() error { return c.netextOrigSetReadBuffer(bytes) })
}

func (c *conn) SetWriteBuffer(bytes int) error {
	return netextUnmodeled("conn.SetWriteBuffer", c.netextFD(), func() error { return c.netextOrigSetWriteBuffer(bytes) })
}

func (c *conn) File() (f *os.File, err error) {
	netextUnmodeled("conn.File", c.netextFD(), func() error { f, err = c.netextOrigFile(); return err })
	return
}

func (c *TCPConn) netextTCPFD() *netFD {
	if c == nil {
		return nil
	}
	return c.fd
}

func (c *TCPConn) SyscallConn() (rc syscall.RawConn, err error) {
	netextUnmodeled("TCPConn.SyscallConn", c.netextTCPFD(), func() error { rc, err = c.netextOrigSyscallConn(); return err })
	return
}

func (c *TCPConn) ReadFrom(r io.Reader) (n int64, err error) {
	netextUnmodeled("TCPConn.ReadFrom", c.netextTCPFD(), func() error { n, err = c.netextOrigReadFrom(r); return err })
	return
}

func (c *TCPConn) WriteTo(w io.Writer) (n int64, err error) {
	netextUnmodeled("TCPConn.WriteTo", c.netextTCPFD(), func() error { n, err = c.netextOrigWriteTo(w); return err })
	return
}

func (c *TCPConn) CloseRead() error {
	return netextUnmodeled("TCPConn.CloseRead", c.netextTCPFD(), c.netextOrigCloseRead)
}

func (c *TCPConn) SetLinger(sec int) error {
	return netextUnmodeled("TCPConn.SetLinger", c.netextTCPFD(), func() error { return c.netextOrigSetLinger(sec) })
}

func (c *TCPConn) SetKeepAlive(keepalive bool) error {
	return netextUnmodeled("TCPConn.SetKeepAlive", c.netextTCPFD(), func() error { return c.netextOrigSetKeepAlive(keepalive) })
}

func (c *TCPConn) SetKeepAlivePeriod(d time.Duration) error {
	return netextUnmodeled("TCPConn.SetKeepAlivePeriod", c.netextTCPFD(), func() error { return c.netextOrigSetKeepAlivePeriod(d) })
}

func (c *TCPConn) SetKeepAliveConfig(config KeepAliveConfig) error {
	return netextUnmodeled("TCPConn.SetKeepAliveConfig", c.netextTCPFD(), func() error { return c.netextOrigSetKeepAliveConfig(config) })
}

func (c *TCPConn) SetNoDelay(noDelay bool) error {
	return netextUnmodeled("TCPConn.SetNoDelay", c.netextTCPFD(), func() error { return c.netextOrigSetNoDelay(noDelay) })
}

func (c *TCPConn) MultipathTCP() (b bool, err error) {
	netextUnmodeled("TCPConn.MultipathTCP", c.netextTCPFD(), func() error { b, err = c.netextOrigMultipathTCP(); return err })
	return
}

func (l *TCPListener) SyscallConn() (rc syscall.RawConn, err error) {
	netextUnmodeled("TCPListener.SyscallConn", l.netextFD(), func() error { rc, err = l.netextOrigSyscallConn(); return err })
	return
}

func (l *TCPListener) SetDeadline(t time.Time) error {
	return netextUnmodeled("TCPListener.SetDeadline", l.netextFD(), func() error { return l.netextOrigSetDeadline(t) })
}

func (l *TCPListener) File() (f *os.File, err error) {
	netextUnmodeled("TCPListener.File", l.netextFD(), func() error { f, err = l.netextOrigFile(); return err })
	return
}

/* ---- Dial ---- */

// netextDial traces one dial: op "Dial" or "DialTimeout" (in the model), or "Unmodeled" with
// api the Go API's name. The Dialer's timeout is recorded for DialTimeout and whenever it is set.
func netextDial(op, api, network, address string, d *Dialer, ctx context.Context, dial func() (Conn, error)) (Conn, error) {
	if !netextT.on {
		return dial()
	}
	s, r := netextBegin(op, "")
	if api != "" {
		r.str("api", api)
	}
	r.str("net", network)
	r.str("addr", address)
	if d != nil {
		if op == "DialTimeout" || d.Timeout != 0 {
			r.int("timeout", int64(d.Timeout))
		}
		if d.LocalAddr != nil {
			r.addr("laddr", d.LocalAddr)
		}
	}
	if ctx != nil {
		if dl, ok := ctx.Deadline(); ok {
			r.int("ctxDeadlineIn", int64(time.Until(dl)))
		}
	}
	r.start()
	c, err := dial()
	e := netextEnd(s, op, "", netextNanotime())
	if api != "" {
		e.str("api", api)
	}
	if err == nil {
		e.newSock(netextConnFD(c), "c")
	}
	e.err(err)
	e.emit()
	return c, err
}

// The bodies of Dial, DialTimeout and Dialer.Dial, which call Dialer.DialContext; the overlay
// checks that Go's are exactly these (overlay.go, bodies).

func Dial(network, address string) (Conn, error) {
	var d Dialer
	return netextDial("Dial", "", network, address, nil, nil, func() (Conn, error) {
		return d.netextOrigDialContext(context.Background(), network, address)
	})
}

func DialTimeout(network, address string, timeout time.Duration) (Conn, error) {
	d := Dialer{Timeout: timeout}
	return netextDial("DialTimeout", "", network, address, &d, nil, func() (Conn, error) {
		return d.netextOrigDialContext(context.Background(), network, address)
	})
}

func (d *Dialer) Dial(network, address string) (Conn, error) {
	return netextDial("Unmodeled", "Dialer.Dial", network, address, d, nil, func() (Conn, error) {
		return d.netextOrigDialContext(context.Background(), network, address)
	})
}

func (d *Dialer) DialContext(ctx context.Context, network, address string) (Conn, error) {
	return netextDial("Unmodeled", "Dialer.DialContext", network, address, d, ctx, func() (Conn, error) {
		return d.netextOrigDialContext(ctx, network, address)
	})
}

func (d *Dialer) DialTCP(ctx context.Context, network string, laddr netip.AddrPort, raddr netip.AddrPort) (*TCPConn, error) {
	var tc *TCPConn
	_, err := netextDial("Unmodeled", "Dialer.DialTCP", network, raddr.String(), d, ctx, func() (Conn, error) {
		c, err := d.netextOrigDialTCP(ctx, network, laddr, raddr)
		tc = c
		if c == nil {
			return nil, err
		}
		return c, err
	})
	return tc, err
}

func DialTCP(network string, laddr, raddr *TCPAddr) (*TCPConn, error) {
	var tc *TCPConn
	_, err := netextDial("Unmodeled", "DialTCP", network, raddr.String(), nil, nil, func() (Conn, error) {
		c, err := netextOrigDialTCP(network, laddr, raddr)
		tc = c
		if c == nil {
			return nil, err
		}
		return c, err
	})
	return tc, err
}

/* ---- Listen, Accept, a listener's Close and Addr ---- */

func netextListenerFD(l Listener) *netFD {
	switch l := l.(type) {
	case *TCPListener:
		if l != nil {
			return l.fd
		}
	case *UnixListener:
		if l != nil {
			return l.fd
		}
	}
	return nil
}

func netextListen(op, api, network, address string, listen func() (Listener, error)) (Listener, error) {
	if !netextT.on {
		return listen()
	}
	s, r := netextBegin(op, "")
	if api != "" {
		r.str("api", api)
	}
	r.str("net", network)
	r.str("addr", address)
	r.start()
	l, err := listen()
	e := netextEnd(s, op, "", netextNanotime())
	if api != "" {
		e.str("api", api)
	}
	if err == nil {
		e.newSock(netextListenerFD(l), "l")
	}
	e.err(err)
	e.emit()
	return l, err
}

// Listen's body calls ListenConfig.Listen (checked by the overlay).
func Listen(network, address string) (Listener, error) {
	var lc ListenConfig
	return netextListen("Listen", "", network, address, func() (Listener, error) {
		return lc.netextOrigListen(context.Background(), network, address)
	})
}

func (lc *ListenConfig) Listen(ctx context.Context, network, address string) (Listener, error) {
	return netextListen("Unmodeled", "ListenConfig.Listen", network, address, func() (Listener, error) {
		return lc.netextOrigListen(ctx, network, address)
	})
}

func ListenTCP(network string, laddr *TCPAddr) (*TCPListener, error) {
	var tl *TCPListener
	_, err := netextListen("Unmodeled", "ListenTCP", network, laddr.String(), func() (Listener, error) {
		l, err := netextOrigListenTCP(network, laddr)
		tl = l
		if l == nil {
			return nil, err
		}
		return l, err
	})
	return tl, err
}

func (l *TCPListener) netextAccept(op, api string, accept func() (Conn, error)) (Conn, error) {
	if !netextT.on {
		return accept()
	}
	id := netextID(l.netextFD(), "u")
	s, r := netextBegin(op, id)
	if api != "" {
		r.str("api", api)
	}
	r.start()
	c, err := accept()
	e := netextEnd(s, op, id, netextNanotime())
	if api != "" {
		e.str("api", api)
	}
	if err == nil {
		e.newSock(netextConnFD(c), "c")
	}
	e.err(err)
	e.emit()
	return c, err
}

func (l *TCPListener) Accept() (Conn, error) {
	return l.netextAccept("Accept", "", l.netextOrigAccept)
}

func (l *TCPListener) AcceptTCP() (*TCPConn, error) {
	var tc *TCPConn
	_, err := l.netextAccept("Unmodeled", "TCPListener.AcceptTCP", func() (Conn, error) {
		c, err := l.netextOrigAcceptTCP()
		tc = c
		if c == nil {
			return nil, err
		}
		return c, err
	})
	return tc, err
}

func (l *TCPListener) Close() error {
	return netextErrCall("ListenerClose", l.netextFD(), l.netextOrigClose)
}

func (l *TCPListener) Addr() Addr {
	return netextAddrCall("ListenerAddr", l.netextFD(), l.netextOrigAddr)
}
