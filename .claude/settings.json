{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/etc/agent-notes/session-start.py\"",
            "timeout": 15,
            "statusMessage": "Loading notes/"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/etc/agent-notes/stop-check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
